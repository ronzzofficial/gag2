    end

    return number
end

function ZanjiDailyDealLiveNormalizeEntry(entry, fallbackName)

    local fallback =
        ZanjiCleanText(
            fallbackName
            or ""
        )

    if type(entry) ~= "table" then

        local multiplier =
            ZanjiDailyDealLiveReadNumber(
                entry
            )

        if fallback ~= ""
        and multiplier > 0 then

            return {
                Name =
                    fallback,

                Multiplier =
                    multiplier,

                Tier =
                    "",
            }
        end

        return nil
    end

    local name =
        ZanjiCleanText(
            entry.StockName
            or entry.stockName
            or entry.Name
            or entry.name
            or entry.FruitName
            or entry.fruitName
            or entry.Fruit
            or entry.fruit
            or entry.ItemName
            or entry.itemName
            or entry.DisplayName
            or entry.displayName
            or fallback
            or ""
        )

    if name == "" then
        return nil
    end

    local multiplier =
        ZanjiDailyDealLiveReadNumber(
            entry.Multiplier
            or entry.multiplier
            or entry.StockMultiplier
            or entry.stockMultiplier
            or entry.ValueMultiplier
            or entry.valueMultiplier
            or entry.DailyMultiplier
            or entry.dailyMultiplier
            or entry.Value
            or entry.value
            or entry.X
            or entry.x
            or 0
        )

    if multiplier <= 0 then
        return nil
    end

    return {
        Name =
            name,

        Multiplier =
            multiplier,

        Tier =
            ZanjiCleanText(
                entry.Tier
                or entry.tier
                or entry.Rarity
                or entry.rarity
                or ""
            ),
