function ZanjiFruitAutomationCleanDisplayName(value)

    local text =
        ZanjiCleanText(
            value
        )

    text =
        text:gsub(
            "%s*%[[^%]]+%]",
            ""
        )

    text =
        text:gsub(
            "%s*%([^%)]+%)",
            ""
        )

    return ZanjiCleanText(
        text
    )
end

function ZanjiFruitAutomationReadNumber(value)

    if type(value) == "number" then
        return value
    end

    local text =
        tostring(value or "")

    local number =
        tonumber(
            text:match("%d+%.?%d*")
        )

    return tonumber(number)
        or 0
end

function ZanjiFruitAutomationReadDropLimit(value)

    local number =
        math.floor(
            ZanjiFruitAutomationReadNumber(
                value
            )
        )

    return math.max(
        0,
        number
    )
end

function ZanjiFruitAutomationDecodeData(raw)

    if type(raw) == "table" then
        return raw
    end

    if type(raw) ~= "string"
    or raw == "" then

        return {}
    end

    local ok,
        decoded =
        pcall(function()

            return HttpService:JSONDecode(
                raw
            )
        end)

    if ok == true
    and type(decoded) == "table" then

        return decoded
    end

    return {}
end

function ZanjiFruitAutomationReadAttribute(instance, names)

    if typeof(instance) ~= "Instance" then
        return nil
    end

    for _, name in ipairs(names or {}) do

        local ok,
            value =
            pcall(function()

                return instance:GetAttribute(
                    name
                )
            end)

        if ok == true
        and value ~= nil
        and tostring(value) ~= "" then

            return value
        end
    end

    return nil
end

function ZanjiFruitAutomationNormalizeFruitName(value)

    value =
        ZanjiCleanText(
            value
        )

    if value == "" then
        return ""
    end

    if type(ZanjiFarmNormalizePlantName) == "function" then

        return ZanjiFarmNormalizePlantName(
            value
        )
    end

    return value
end

function ZanjiFruitAutomationNormalizeFruitSelection(value)

    local raw =
        ZanjiShopSelectionArray(
            value
        )

    if #raw <= 0 then
        return {}
    end

    for _, fruitName in ipairs(raw) do

        if fruitName == "All" then
            return {}
        end
    end

    local validMap =
        {}

    if type(ZanjiFarmGetPlantValueMap) == "function" then

        validMap =
            ZanjiFarmGetPlantValueMap()
    end

    local output =
        {}

    local seen =
        {}

    for _, fruitName in ipairs(raw) do

        fruitName =
            ZanjiFruitAutomationNormalizeFruitName(
                fruitName
            )

        if fruitName ~= ""
        and fruitName ~= "All"
        and seen[fruitName] ~= true
        and (
            next(validMap) == nil
            or validMap[fruitName] == true
        ) then

            seen[fruitName] =
                true

            table.insert(
                output,
                fruitName
            )
        end
    end

    table.sort(output, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

function ZanjiFruitAutomationNormalizeMutationSelection(value)

    local raw =
        ZanjiShopSelectionArray(
            value
        )

    if #raw <= 0 then
        return {}
    end

    for _, mutationName in ipairs(raw) do

        if mutationName == "All" then
            return {}
        end
    end

    local validMap =
        {}

    if type(ZanjiFarmGetMutationValueMap) == "function" then

        validMap =
            ZanjiFarmGetMutationValueMap()
    end

    local output =
        {}

    local seen =
        {}

    for _, mutationName in ipairs(raw) do

        if type(ZanjiFarmNormalizeMutationName) == "function" then

            mutationName =
                ZanjiFarmNormalizeMutationName(
                    mutationName
                )

        else

            mutationName =
                ZanjiCleanText(
                    mutationName
                )
        end

        if mutationName ~= ""
        and mutationName ~= "All"
        and seen[mutationName] ~= true
        and (
            next(validMap) == nil
            or validMap[mutationName] == true
        ) then

            seen[mutationName] =
                true

            table.insert(
                output,
                mutationName
            )
        end
    end

    table.sort(output, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

function ZanjiFruitAutomationNormalizeWeightMode(value)

    local mode =
        ZanjiFarmNormalizeWeightMode(
            value
        )

    if mode == "Below" then
        return "Below"
    end

    return "Above"
end

function ZanjiFruitAutomationNormalizeValueMode(value)

    local mode =
        ZanjiFarmNormalizeWeightMode(
            value
        )

    if mode == "Above" then
        return "Above"
    end

    return "Below"
end

function ZanjiFruitAutomationReadValueThreshold(value)

    if type(ZanjiSniperReadMaxPrice) == "function" then

        return ZanjiSniperReadMaxPrice(
            value
        )
    end

    local text =
        ZanjiCleanText(
            value
        )

    text =
        text:gsub("¢", "")
            :gsub("%$", "")
            :gsub(",", "")
            :gsub("%s+", "")

    local lower =
        text:lower()

    if lower == ""
    or lower == "0"
    or lower == "none"
    or lower == "off"
    or lower == "no" then

        return 0
    end

    local multiplier =
        1

    if lower:find("b", 1, true) then

        multiplier =
            1000000000

    elseif lower:find("m", 1, true) then

        multiplier =
            1000000

    elseif lower:find("k", 1, true) then

        multiplier =
            1000
    end

    local rawNumber =
        lower:match("%d+%.?%d*")

    local number =
        tonumber(rawNumber)

    if number == nil then
        return 0
    end

    return math.max(
        0,
        math.floor(number * multiplier + 0.5)
    )
end

function ZanjiFruitAutomationBuildMutationText(info)

    info =
        type(info) == "table"
        and info
        or {}

    if ZanjiCleanText(info.RawMutation) ~= "" then

        return ZanjiCleanText(
            info.RawMutation
        )
    end

    local mutations =
        type(info.Mutations) == "table"
        and info.Mutations
        or {}

    local output =
        {}

    for _, mutationName in ipairs(mutations) do

        mutationName =
            ZanjiCleanText(
                mutationName
            )

        if mutationName ~= "" then

            table.insert(
                output,
                mutationName
            )
        end
    end

    return table.concat(
        output,
        ","
    )
end

function ZanjiFruitAutomationReadSizeMultiplierFromInfo(info)

    info =
        type(info) == "table"
        and info
        or {}

    local tool =
        info.Tool
        or info.Instance

    if typeof(tool) == "Instance" then

        local sizeMultiplier =
            tonumber(
                ZanjiFruitAutomationReadAttribute(
                    tool,
                    {
                        "SizeMultiplier",
                        "SizeMulti",
                        "ScaleMultiplier",
                        "ScaleMulti",
                        "Scale",
                        "SizeScale",
                    }
                )
            )

        if sizeMultiplier ~= nil
        and sizeMultiplier > 0 then

            return sizeMultiplier
        end
    end

    local weight =
        tonumber(
            info.WeightKg
        )
        or 0

    if weight > 0 then

        return math.max(
            0.01,
            weight
        )
    end

    return 1
end

function ZanjiFruitAutomationCalculateInfoValue(info)

    info =
        type(info) == "table"
        and info
        or {}

    local cached =
        tonumber(
            info.ValueNumber
            or info.Value
        )

    if cached ~= nil
    and cached > 0 then

        return cached
    end

    local tool =
        info.Tool
        or info.Instance

    local value =
        nil

    if type(ZanjiVisualReadFruitTool) == "function"
    and typeof(tool) == "Instance"
    and tool:IsA("Tool") then

        local ok,
            row =
            pcall(function()

                return ZanjiVisualReadFruitTool(
                    tool,
                    0
                )
            end)

        if ok == true
        and type(row) == "table" then

            value =
                tonumber(
                    row.Value
                )

            if value ~= nil
            and value > 0 then

                info.ValueNumber =
                    value

                info.ValueText =
                    row.ValueText
                    or (
                        type(ZanjiVisualFormatFruitValue) == "function"
                        and ZanjiVisualFormatFruitValue(value)
                    )
                    or tostring(value)

                return value
            end
        end
    end

    if value == nil
    and type(ZanjiVisualCalculateFruitValue) == "function" then

        local row = {
            Tool =
                tool,

            Name =
                ZanjiFruitAutomationNormalizeFruitName(
                    info.FruitName
                    or info.Name
                    or info.DisplayName
                ),

            RawName =
                ZanjiCleanText(
                    info.DisplayName
                    or info.FruitName
                    or ""
                ),

            RawMutation =
                ZanjiFruitAutomationBuildMutationText(
                    info
                ),

            Weight =
                tonumber(
                    info.WeightKg
                )
                or 0,

            SizeMultiplier =
                ZanjiFruitAutomationReadSizeMultiplierFromInfo(
                    info
                ),

            Index =
                0,
        }

        local ok,
            result =
            pcall(function()

                return ZanjiVisualCalculateFruitValue(
                    tool,
                    row
                )
            end)

        result =
            tonumber(result)

        if ok == true
        and result ~= nil
        and result > 0 then

            value =
                result
        end
    end

    value =
        tonumber(value)

    if value == nil
    or value <= 0 then

        return nil
    end

    value =
        math.floor(value + 0.5)

    info.ValueNumber =
        value

    if type(ZanjiVisualFormatFruitValue) == "function" then

        info.ValueText =
            ZanjiVisualFormatFruitValue(
                value
            )

    else

        info.ValueText =
            tostring(value)
    end

    return value
end

function ZanjiFruitAutomationPassesDropValueFilter(info)

    ZanjiFruitAutomationEnsureState()

    local threshold =
        ZanjiFruitAutomationReadValueThreshold(
            ZANJI_FRUIT_AUTOMATION_STATE.ValueThreshold
            or "0"
        )

    if threshold <= 0 then
        return true
    end

    local value =
        ZanjiFruitAutomationCalculateInfoValue(
            info
        )

    if value == nil
    or value <= 0 then

        return false
    end

    local mode =
        ZanjiFruitAutomationNormalizeValueMode(
            ZANJI_FRUIT_AUTOMATION_STATE.ValueMode
            or "Below"
        )

    if mode == "Above" then

        return value >= threshold
    end

    return value <= threshold
end

function ZanjiFruitAutomationPassesDropFilters(info)

    if ZanjiFruitAutomationPassesFilters(
        info
    ) ~= true then

        return false
    end

    return ZanjiFruitAutomationPassesDropValueFilter(
        info
    ) == true
end

function ZanjiFruitAutomationEnsureState()

    ZANJI_FRUIT_AUTOMATION_STATE =
        type(ZANJI_FRUIT_AUTOMATION_STATE) == "table"
        and ZANJI_FRUIT_AUTOMATION_STATE
        or {}

    ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits =
        ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true

    ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits =
        ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits == true

    if ZANJI_FRUIT_AUTOMATION_STATE.PickupMovement
        ~= "Nearby Only"
    and ZANJI_FRUIT_AUTOMATION_STATE.PickupMovement
        ~= "Walk to Fruits" then

        ZANJI_FRUIT_AUTOMATION_STATE.PickupMovement =
            "Nearby Only"
    end

    ZANJI_FRUIT_AUTOMATION_STATE.SelectedFruits =
        ZanjiFruitAutomationNormalizeFruitSelection(
            ZANJI_FRUIT_AUTOMATION_STATE.SelectedFruits
            or {}
        )

    ZANJI_FRUIT_AUTOMATION_STATE.SelectedMutations =
        ZanjiFruitAutomationNormalizeMutationSelection(
            ZANJI_FRUIT_AUTOMATION_STATE.SelectedMutations
            or {}
        )

    ZANJI_FRUIT_AUTOMATION_STATE.WeightKg =
        tostring(
            ZanjiFarmReadWeightThresholdKg(
                ZANJI_FRUIT_AUTOMATION_STATE.WeightKg
                or "0"
            )
        )

    ZANJI_FRUIT_AUTOMATION_STATE.WeightMode =
        ZanjiFruitAutomationNormalizeWeightMode(
            ZANJI_FRUIT_AUTOMATION_STATE.WeightMode
            or "Above"
        )

    ZANJI_FRUIT_AUTOMATION_STATE.ValueMode =
        ZanjiFruitAutomationNormalizeValueMode(
            ZANJI_FRUIT_AUTOMATION_STATE.ValueMode
            or "Below"
        )

    ZANJI_FRUIT_AUTOMATION_STATE.ValueThreshold =
        tostring(
            ZanjiFruitAutomationReadValueThreshold(
                ZANJI_FRUIT_AUTOMATION_STATE.ValueThreshold
                or "0"
            )
        )

    ZANJI_FRUIT_AUTOMATION_STATE.DropLimit =
        tostring(
            ZanjiFruitAutomationReadDropLimit(
                ZANJI_FRUIT_AUTOMATION_STATE.DropLimit
                or "0"
            )
        )

    return ZANJI_FRUIT_AUTOMATION_STATE
end

function ZanjiFruitAutomationEnsureRuntime()

    ZANJI_FRUIT_AUTOMATION_RUNTIME =
        type(ZANJI_FRUIT_AUTOMATION_RUNTIME) == "table"
        and ZANJI_FRUIT_AUTOMATION_RUNTIME
        or {}

    local runtime =
        ZANJI_FRUIT_AUTOMATION_RUNTIME

    runtime.DroppedConnections =
        type(runtime.DroppedConnections) == "table"
        and runtime.DroppedConnections
        or {}

    runtime.DroppedCache =
        type(runtime.DroppedCache) == "table"
        and runtime.DroppedCache
        or {}

    runtime.DroppedLastAttempt =
        type(runtime.DroppedLastAttempt) == "table"
        and runtime.DroppedLastAttempt
        or {}

    runtime.DropLastAttempt =
        type(runtime.DropLastAttempt) == "table"
        and runtime.DropLastAttempt
        or {}

    runtime.DroppedThisRun =
        tonumber(runtime.DroppedThisRun)
        or 0

    runtime.PickupRange3D =
        math.clamp(
            tonumber(runtime.PickupRange3D)
            or 14.75,
            10,
            15.25
        )

