function ZanjiFarmDetailsStart()

    local runtime =
        ZANJI_FARM_DETAILS_RUNTIME

    if runtime.Running == true then
        return false
    end

    runtime.Running =
        true

    runtime.Token =
        {}

    local token =
        runtime.Token

    runtime.Status =
        "Loading"

    if ZanjiFarmDetailsConnectEvents() == true then

        ZanjiFarmDetailsRequestSnapshot()

    else

        runtime.Status =
            "Unavailable"

        ZanjiFarmDetailsScheduleRender()
    end

    task.spawn(function()

        while runtime.Token == token do

            local now =
                os.clock()

            if runtime.EventsConnected ~= true
            and now
                - (
                    tonumber(runtime.LastRequestAt)
                    or 0
                )
                >= 5 then

                if ZanjiFarmDetailsConnectEvents() == true then

                    ZanjiFarmDetailsRequestSnapshot()
                end

            elseif runtime.SnapshotReady ~= true
            and now
                - (
                    tonumber(runtime.LastRequestAt)
                    or 0
                )
                >= 5 then

                ZanjiFarmDetailsRequestSnapshot()
            end

            local lowEnd =
                ZanjiLowEndModeEnabled()

            local dirtyInterval =
                lowEnd == true
                and 1.25
                or 0.50

            local safetyInterval =
                lowEnd == true
                and 5
                or 1

            local elapsed =
                now
                - (
                    tonumber(runtime.LastRenderAt)
                    or 0
                )

            local dirtyReady =
                runtime.RefreshQueued == true
                and elapsed >= dirtyInterval

            local safetyReady =
                elapsed >= safetyInterval

            if dirtyReady
            or safetyReady then

                runtime.RefreshQueued =
                    false

                runtime.LastRenderAt =
                    now

                ZanjiFarmDetailsRender()
            end

            task.wait(
                lowEnd == true
                and 0.25
                or 0.10
            )
        end
    end)

    return true
end

function ZanjiFarmDetailsStop(reason)

    local runtime =
        ZANJI_FARM_DETAILS_RUNTIME

    runtime.Token =
        nil

    runtime.Running =
        false

    ZanjiFarmDetailsDisconnect()

    return true
end


function ZanjiSniperAutoHopReset(reason)

    ZANJI_SNIPER_RUNTIME.NoMatchSince =
        0

    ZANJI_SNIPER_RUNTIME.NoMatchScans =
        0
end

function ZanjiSniperAutoHopDataReady()

    local wildRoot =
        ZanjiSniperGetWildPetRoot()

    local refRoot =
        ZanjiSniperGetWildPetRefRoot()

    return typeof(wildRoot) == "Instance"
        and typeof(refRoot) == "Instance"
end

function ZanjiSniperAutoHopCanRun()

    if ZANJI_SNIPER_STATE.ActivateSniper ~= true then

        ZanjiSniperAutoHopReset(
            "sniper off"
        )

        return false
    end

    if type(ZANJI_DEFENSE_RUNTIME) == "table"
    and ZANJI_DEFENSE_RUNTIME.Active == true then

        ZanjiSniperAutoHopReset(
            "pet defense active"
        )

        return false
    end

    if ZANJI_SNIPER_STATE.AutoHop ~= true then

        ZanjiSniperAutoHopReset(
            "auto hop off"
        )

        return false
    end

    if ZANJI_SNIPER_RUNTIME.AutoHopInProgress == true then
        return false
    end

    if ZanjiSniperServerSwitchBlocked(
        "Auto Hop",
        false
    ) == true then

        ZanjiSniperAutoHopReset(
            "sniper protection"
        )

        return false
    end

    if ZANJI_SNIPER_RUNTIME.Buying == true
    or ZANJI_SNIPER_RUNTIME.Returning == true then

        return false
    end

    if ZANJI_SNIPER_RUNTIME.BatchActive == true then
        return false
    end

    if type(ZANJI_SNIPER_STATE.Watchlist) ~= "table"
    or #ZANJI_SNIPER_STATE.Watchlist <= 0 then

        ZanjiSniperAutoHopReset(
            "no watchlist"
        )

        return false
    end

    if ZanjiSniperGetCharacterRoot() == nil then
        return false
    end

    return true
end

function ZanjiSniperBeginAutoHop(reason, token)

    if ZanjiSniperStillActive(token) ~= true then
        return false
    end

    if ZanjiSniperServerSwitchBlocked(
        "Auto Hop",
        false
    ) == true then

        return false
    end

    if ZANJI_SNIPER_RUNTIME.AutoHopInProgress == true then
        return false
    end

    ZANJI_SNIPER_RUNTIME.AutoHopInProgress =
        true

    ZANJI_SNIPER_RUNTIME.LastHopAt =
        os.clock()

    ZanjiSniperSetStatus(
        "Auto Hop: finding server..."
    )

    local queued,
        queueReason =
        ZanjiQueueSmartServerHop(
            tostring(reason or "auto hop"),
            function(_ok, errorText)

                ZANJI_SNIPER_RUNTIME.AutoHopInProgress =
                    false

                ZANJI_SNIPER_RUNTIME.HopFailureBackoffUntil =
                    os.clock() + 4

                ZanjiSniperSetStatus(
                    "Auto Hop failed: "
                    .. tostring(errorText)
                )
            end
        )

    if queued ~= true then

        ZANJI_SNIPER_RUNTIME.AutoHopInProgress =
            false

        ZANJI_SNIPER_RUNTIME.HopFailureBackoffUntil =
            os.clock() + 4

        ZanjiSniperSetStatus(
            "Auto Hop failed: "
            .. tostring(queueReason)
        )

        return false
    end

    return true
end

function ZanjiSniperAutoHopEvaluate(matches, phase, token)

    phase =
        tostring(phase or "Safe")

    local phaseLabel =
        phase == "Fast"
        and "Fast Hop"
        or "Safe Hop"

    if ZanjiSniperAutoHopCanRun() ~= true then
        return false
    end

    if ZanjiSniperAutoHopDataReady() ~= true then

        ZanjiSniperAutoHopReset(
            "pet data missing"
        )

        ZanjiSniperSetStatus(
            phaseLabel
            .. ": waiting for pet data"
        )

        return false
    end

    matches =
        type(matches) == "table"
        and matches
        or {}

    if #matches > 0 then

        ZanjiSniperAutoHopReset(
            "match found"
        )

        return false
    end

    local now =
        os.clock()

    local backoffUntil =
        tonumber(
            ZANJI_SNIPER_RUNTIME.HopFailureBackoffUntil
        )
        or 0

    if now < backoffUntil then

        ZanjiSniperSetStatus(
            phaseLabel
            .. ": retry in "
            .. ZanjiSniperFormatDelay(
                backoffUntil - now
            )
            .. "s"
        )

        return false
    end

    local startClock =
        tonumber(
            ZANJI_SNIPER_RUNTIME.StartClock
        )
        or now

    local minimumServerAge =
        tonumber(
            ZANJI_SNIPER_RUNTIME.AutoHopMinimumServerAge
        )
        or 8

    if now - startClock < minimumServerAge then

        ZanjiSniperSetStatus(
            phaseLabel
            .. ": waiting for save data..."
        )

        return false
    end

    if (
        tonumber(
            ZANJI_SNIPER_RUNTIME.NoMatchSince
        )
        or 0
    ) <= 0 then

        ZANJI_SNIPER_RUNTIME.NoMatchSince =
            now

        ZANJI_SNIPER_RUNTIME.NoMatchScans =
            0
    end

    ZANJI_SNIPER_RUNTIME.NoMatchScans =
        (
            tonumber(
                ZANJI_SNIPER_RUNTIME.NoMatchScans
            )
            or 0
        )
        + 1

    local requiredScans =
        phase == "Fast"
        and (
            tonumber(
                ZANJI_SNIPER_RUNTIME.EarlyHopRequiredScans
            )
            or 3
        )
        or (
            tonumber(
                ZANJI_SNIPER_RUNTIME.SafeHopRequiredScans
            )
            or 2
        )

    if phase == "Fast" then

        local minimumSeconds =
            tonumber(
                ZANJI_SNIPER_RUNTIME.EarlyHopMinimumSeconds
            )
            or 8

        if now - startClock < minimumSeconds then

            ZanjiSniperSetStatus(
                phaseLabel
                .. ": confirming server..."
            )

            return false
        end
    end

    if ZANJI_SNIPER_RUNTIME.NoMatchScans < requiredScans then

        ZanjiSniperSetStatus(
            phaseLabel
            .. ": confirming no match..."
        )

        return false
    end

    local delay =
        ZanjiSniperReadHopDelay(
            ZANJI_SNIPER_STATE.HopDelay
        )

    local elapsed =
        now
        - (
            tonumber(
                ZANJI_SNIPER_RUNTIME.NoMatchSince
            )
            or now
        )

    local remaining =
        math.max(
            0,
            delay - elapsed
        )

    if remaining > 0.05 then

        ZanjiSniperSetStatus(
            phaseLabel
            .. ": no match, hopping in "
            .. ZanjiSniperFormatDelay(remaining)
            .. "s"
        )

        return false
    end

    return ZanjiSniperBeginAutoHop(
        phaseLabel
        .. " no match",
        token
    )
end

function ZanjiSniperEarlyAutoHopTick(token)

    if ZanjiSniperNormalizeAutoHopTiming(
        ZANJI_SNIPER_STATE.AutoHopTiming
    ) ~= "Fast - During Loading" then

        return false
    end

    if ZanjiSniperAutoHopCanRun() ~= true then
        return false
    end

    if ZanjiSniperAutoHopDataReady() ~= true then

        ZanjiSniperAutoHopReset(
            "early data missing"
        )

        ZanjiSniperSetStatus(
            "Fast Hop: waiting for pet data"
        )

        return false
    end

    local matches =
        ZanjiSniperRunScan()

    if #matches > 0 then

        ZanjiSniperAutoHopReset(
            "early match found"
        )

        ZanjiSniperSetStatus(
            "Fast Hop: match found, waiting loading"
        )

        return false
    end

    return ZanjiSniperAutoHopEvaluate(
        matches,
        "Fast",
        token
    )
end

function ZanjiSniperTick(token)

    if ZANJI_SNIPER_RUNTIME.Buying == true
    or ZANJI_SNIPER_RUNTIME.Returning == true then

        return false
    end

    if type(ZANJI_DEFENSE_RUNTIME) == "table"
    and ZANJI_DEFENSE_RUNTIME.Active == true then

        ZanjiSniperAutoHopReset(
            "pet defense active"
        )

        ZanjiSniperSetStatus(
            "Paused: defending bought pet"
        )

        return false
    end

    if ZanjiSniperPetBuyProtectionBlocks(
        "Sniper",
        false
    ) == true then

        return false
    end

    local matches =
        ZanjiSniperRunScan()

    if #matches <= 0 then

        local returned =
            ZanjiSniperMaybeReturnAfterBatchNoMatches(
                token
            )

        if returned == true then

            ZanjiSniperAutoHopReset(
                "returned"
            )

            return true
        end

        local phase =
            ZanjiSniperNormalizeAutoHopTiming(
                ZANJI_SNIPER_STATE.AutoHopTiming
            ) == "Fast - During Loading"
            and "Fast"
            or "Safe"

        return ZanjiSniperAutoHopEvaluate(
            matches,
            phase,
            token
        )
    end

    ZanjiSniperAutoHopReset(
        "match found"
    )

    ZANJI_SNIPER_RUNTIME.BatchEmptySince =
        0

    return ZanjiSniperExecuteMatch(
        matches[1],
        token
    )
end

