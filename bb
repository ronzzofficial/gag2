function ZanjiWateringRejoinBindCharacter(character)

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if runtime.DiedConnection then

        pcall(function()

            runtime.DiedConnection:Disconnect()
        end)

        runtime.DiedConnection =
            nil
    end

    if typeof(character) ~= "Instance" then

        return false
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )
        or character:WaitForChild(
            "Humanoid",
            10
        )

    if typeof(humanoid) ~= "Instance" then

        return false
    end

    runtime.DiedConnection =
        humanoid.Died:Connect(function()

            ZanjiWateringRejoinHandleDeath()
        end)

    return true
end

function ZanjiWateringRejoinConnectCharacterWatcher()

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if runtime.CharacterConnection then

        return true
    end

    ZanjiWateringRejoinBindCharacter(
        LocalPlayer.Character
    )

    runtime.CharacterConnection =
        LocalPlayer.CharacterAdded:Connect(function(character)

            task.spawn(function()

                runtime.RespawnPending =
                    true

                runtime.RecoveryScheduled =
                    false

                runtime.Running =
                    false

                runtime.Busy =
                    false

                runtime.Generation +=
                    1

                local respawnGeneration =
                    runtime.Generation

                ZanjiWateringRejoinCancelTween()
                ZanjiWateringRejoinEnsureRollback()

                ZanjiWateringRejoinBindCharacter(
                    character
                )

                local humanoid =
                    character:WaitForChild(
                        "Humanoid",
                        15
                    )

                local root =
                    character:WaitForChild(
                        "HumanoidRootPart",
                        15
                    )

                if LocalPlayer.Character ~= character
                or typeof(humanoid) ~= "Instance"
                or typeof(root) ~= "Instance"
                or humanoid.Health <= 0 then

                    return
                end

                local readyDeadline =
                    os.clock()
                    + 15

                while ZANJI_WATERING_REJOIN_STATE.Enabled == true
                and runtime.Teleporting ~= true
                and runtime.Generation == respawnGeneration
                and LocalPlayer.Character == character
                and humanoid.Health > 0
                and ZanjiWateringRejoinOfflineAnimationActive() == true
                and os.clock() < readyDeadline do

                    task.wait(
                        0.25
                    )
                end

                if ZANJI_WATERING_REJOIN_STATE.Enabled == true
                and runtime.Teleporting ~= true
                and runtime.Generation == respawnGeneration
                and LocalPlayer.Character == character
                and humanoid.Health > 0 then

                    runtime.RespawnPending =
                        false

                    ZanjiWateringRejoinStart(
                        "respawn"
                    )
                end
            end)
        end)

    return true
end

function ZanjiWateringRejoinStart(reason)

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if ZanjiWateringRejoinHasSetup() ~= true then

        state.Enabled =
            false

        ZanjiWateringRejoinSaveSettings()

        ZanjiWateringRejoinSyncToggle(
            false
        )

        ZanjiNotify(
            "Watering Rejoin",
            "Set a target position before enabling.",
            5
        )

        return false
    end

    if runtime.Running == true
    and state.Enabled == true then

        ZanjiWateringRejoinEnsureRollback()

        return true
    end

    if tostring(reason) ~= "recovery"
    and tostring(reason) ~= "respawn"
    and type(ZanjiFarmMiddlePauseForWatering)
        == "function" then

        ZanjiFarmMiddlePauseForWatering(
            "watering rejoin started"
        )
    end

    state.Enabled =
        true

    if tostring(reason) ~= "respawn"
    and tostring(reason) ~= "recovery" then

        runtime.CompletedUses =
            0

        runtime.WateringFinished =
            false

        runtime.RejoinAt =
            nil
    end

    runtime.RespawnPending =
        false

    runtime.RecoveryScheduled =
        false

    runtime.Running =
        true

    runtime.Busy =
        true

    runtime.Teleporting =
        false

    runtime.Generation +=
        1

    local generation =
        runtime.Generation

    ZanjiWateringRejoinConnectCharacterWatcher()
    ZanjiWateringRejoinSaveSettings()

    ZanjiWateringRejoinSyncToggle(
        true
    )

    ZanjiWateringRejoinEnsureRollback()

    task.spawn(function()

        ZanjiWateringRejoinRunCycle(
            generation
        )

        if runtime.Generation == generation
        and runtime.Teleporting ~= true then

            runtime.Running =
                false

            runtime.Busy =
                false
        end
    end)

    return true
end

function ZanjiWateringRejoinStop(
    reason,
    preserveEnabled
)

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    runtime.Running =
        false

    runtime.Busy =
        false

    runtime.Teleporting =
        false

    runtime.RespawnPending =
        false

    runtime.RecoveryScheduled =
        false

    runtime.Generation +=
        1

    runtime.CompletedUses =
        0

    runtime.WateringFinished =
        false

    runtime.RejoinAt =
        nil

    ZanjiWateringRejoinCancelTween()
    ZanjiWateringRejoinDisconnectCharacterWatcher()
    ZanjiWateringRejoinRestoreSetupHook()
    ZanjiWateringRejoinRestorePlantCollision()

    if type(ZanjiRollbackSetOwner) == "function" then

        ZanjiRollbackSetOwner(
            "Watering",
            false
        )
    end

    local _,
        humanoid,
        root =
        ZanjiWateringRejoinGetCharacter()

    if humanoid
    and root then

        pcall(function()

            humanoid:MoveTo(
                root.Position
            )

            humanoid.AutoRotate =
                true
        end)
    end

    if preserveEnabled ~= true then

        state.Enabled =
            false

        ZanjiWateringRejoinSaveSettings()

        ZanjiWateringRejoinSyncToggle(
            false
        )

        if type(ZanjiFarmMiddleResumeAfterWatering)
            == "function" then

            task.defer(function()

                task.wait(
                    0.1
                )

                ZanjiFarmMiddleResumeAfterWatering()
            end)
        end
    end

    return true
end

