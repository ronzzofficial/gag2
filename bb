        return cachedButton
    end

    runtime.InventoryButtonCache[tool] =
        nil

    local grid =
        ZanjiFruitAutomationGetInventoryGrid()

    if typeof(grid) ~= "Instance" then

        return nil
    end

    local matchedButton =
        nil

    for _, object in ipairs(
        grid:GetDescendants()
    ) do

        if object:IsA("GuiButton") then

            local capturedTool =
                ZanjiFruitAutomationReadInventoryButtonTool(
                    object
                )

            if typeof(capturedTool) == "Instance" then

                runtime.InventoryButtonCache[capturedTool] =
                    object

                if capturedTool == tool then

                    matchedButton =
                        object
                end
            end
        end
    end

    return matchedButton
end

function ZanjiFruitAutomationEquipDropTool(
    source,
    character,
    humanoid
)

    if typeof(source) ~= "Instance"
    or source.Parent == nil
    or typeof(character) ~= "Instance"
    or typeof(humanoid) ~= "Instance"
    or humanoid.Health <= 0 then

        return nil
    end

    local isTool =
        source:IsA("Tool")

    local isFruitProxy =
        source:IsA("Configuration")
        and source:GetAttribute("FruitProxy") == true

    if isTool ~= true
    and isFruitProxy ~= true then

        return nil
    end

    local fruitId =
        tostring(
            source:GetAttribute("Id")
            or ""
        )

    if fruitId == "" then

        return nil
    end

    local function findEquippedTool()

        if typeof(character) ~= "Instance"
        or character.Parent == nil then

            return nil
        end

        for _, child in ipairs(character:GetChildren()) do

            if child:IsA("Tool")
            and child:GetAttribute("HarvestedFruit") == true
            and tostring(
                child:GetAttribute("Id")
                or ""
            ) == fruitId then

                return child
            end
        end

        return nil
    end

    local alreadyEquipped =
        findEquippedTool()

    if alreadyEquipped then

        return alreadyEquipped
    end

    pcall(function()

        humanoid:UnequipTools()
    end)

    task.wait(
        0.15
    )

    local inventoryButton =
        ZanjiFruitAutomationFindInventoryButton(
            source
        )

    local inventoryActivationSucceeded =
        false

    if typeof(inventoryButton) == "Instance"
    and type(firesignal) == "function" then

        inventoryActivationSucceeded =
            pcall(
                firesignal,
                inventoryButton.MouseButton1Click
            )
    end

    if inventoryActivationSucceeded ~= true
    and isTool == true
    and source.Parent ~= nil then

        pcall(function()

            humanoid:EquipTool(
                source
            )
        end)
    end

    local equipDeadline =
        os.clock()
        + 5

    local fallbackAt =
        os.clock()
        + 2

    local fallbackUsed =
        false

    while os.clock() < equipDeadline
    and ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true do

        local equippedTool =
            findEquippedTool()

        if equippedTool then

            return equippedTool
        end

        if fallbackUsed ~= true
        and isTool == true
        and source.Parent ~= nil
        and os.clock() >= fallbackAt then

            fallbackUsed =
                true

            pcall(function()

                humanoid:EquipTool(
                    source
                )
            end)
        end

        task.wait(
            0.05
        )
    end

    return findEquippedTool()
end

function ZanjiFruitAutomationDropTool(tool)

    if typeof(tool) ~= "Instance"
    or tool.Parent == nil then

        return false
    end

    local isTool =
        tool:IsA("Tool")

    local isFruitProxy =
        tool:IsA("Configuration")
        and tool:GetAttribute("FruitProxy") == true

    if isTool ~= true
    and isFruitProxy ~= true then

        return false
    end

    if tool:GetAttribute(
        "HarvestedFruit"
    ) ~= true then

        return false
    end

    local fruitId =
        tostring(
            tool:GetAttribute(
                "Id"
            )
            or ""
        )

    if fruitId == "" then
        return false
    end

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    local dropPacket =
        runtime.DropPacket

    if type(dropPacket) ~= "table"
    or type(dropPacket.Fire) ~= "function" then

        runtime.DropPacket =
            nil

        local sharedModules =
            ReplicatedStorage:FindFirstChild(
                "SharedModules"
            )

        local networkingModule =
            sharedModules
            and sharedModules:FindFirstChild(
                "Networking"
            )

        if typeof(networkingModule) ~= "Instance"
        or networkingModule:IsA("ModuleScript") ~= true then

            return false
        end

        local requireSuccess,
            networking =
            pcall(function()

                return require(
                    networkingModule
                )
            end)

        if requireSuccess ~= true
        or type(networking) ~= "table" then

            return false
        end

        dropPacket =
            type(networking.DroppedItem) == "table"
            and networking.DroppedItem.RequestDrop
            or nil

        if type(dropPacket) ~= "table"
        or type(dropPacket.Fire) ~= "function" then

            return false
        end

        runtime.DropPacket =
            dropPacket
    end

    local droppedFolder =
        workspace:FindFirstChild(
            "DroppedItems"
        )

    if typeof(droppedFolder) ~= "Instance" then

        return false
    end

    local character =
        ZanjiFruitAutomationGetCharacter()

    local humanoid =
        ZanjiFruitAutomationGetHumanoid()

    if typeof(character) ~= "Instance"
    or typeof(humanoid) ~= "Instance"
    or humanoid.Health <= 0 then

        return false
    end

    local equippedTool =
        ZanjiFruitAutomationEquipDropTool(
            tool,
            character,
            humanoid
        )

    if typeof(equippedTool) ~= "Instance"
    or equippedTool:IsA("Tool") ~= true
    or equippedTool.Parent ~= character then

        return false
    end

    if tostring(
        equippedTool:GetAttribute("Id")
        or ""
    ) ~= fruitId then

        return false
    end

    local equipSettledAt =
        os.clock()
        + 0.75

    while os.clock() < equipSettledAt
    and ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true do

        if equippedTool.Parent ~= character then

            return false
        end

        task.wait(
            0.05
        )
    end

    if ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits ~= true
    or equippedTool.Parent ~= character then

        return false
    end

    local addedItems =
        {}

    local childAddedConnection =
        droppedFolder.ChildAdded:Connect(function(item)

            table.insert(
                addedItems,
                item
            )
        end)

    local packetSuccess =
        pcall(function()

            dropPacket:Fire(
                "HarvestedFruits",
                fruitId
            )
        end)

    if packetSuccess ~= true then

        childAddedConnection:Disconnect()

        runtime.DropPacket =
            nil

        return false
    end

    local confirmationDeadline =
        os.clock()
        + 5

    local confirmedItem =
        nil

    while os.clock() < confirmationDeadline
    and ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true do

        for _, item in ipairs(addedItems) do

            if typeof(item) == "Instance" then

                local itemCategory =
                    tostring(
                        item:GetAttribute(
                            "ItemCategory"
                        )
                        or ""
                    )

                local itemName =
                    tostring(
                        item:GetAttribute(
                            "ItemName"
                        )
                        or ""
                    )

                local droppedBy =
                    tonumber(
                        item:GetAttribute(
                            "DroppedBy"
                        )
                    )

                if itemCategory == "HarvestedFruits"
                and itemName == fruitId
                and droppedBy == LocalPlayer.UserId then

                    confirmedItem =
                        item

                    break
                end
            end
        end

        if confirmedItem then
            break
        end

        task.wait(
            0.05
        )
    end

    childAddedConnection:Disconnect()

    if not confirmedItem then

        return false
    end

    local nextDropAt =
        os.clock()
        + 0.75

    while os.clock() < nextDropAt
    and ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true do

        task.wait(
            0.05
        )
    end

    return true
end

function ZanjiFruitAutomationTryDropInfo(info)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    info =
        type(info) == "table"
        and info
        or {}

    local tool =
        info.Tool

    if typeof(tool) ~= "Instance"
    or tool.Parent == nil then

        return false
    end

    local lastAttempt =
        tonumber(
            runtime.DropLastAttempt[tool]
        )
        or 0

    if os.clock() - lastAttempt < runtime.DropRetryDelay then
        return false
    end

    runtime.DropLastAttempt[tool] =
        os.clock()

    if ZanjiFruitAutomationPassesDropFilters(
        info
    ) ~= true then

        return false
    end

    local dropped =
        ZanjiFruitAutomationDropTool(
            tool
        )

    if dropped == true then

        runtime.DroppedThisRun =
            (
                tonumber(runtime.DroppedThisRun)
                or 0
            )
            + 1

        runtime.DropLastAttempt[tool] =
            nil

        return true
    end

    return false
end

function ZanjiFruitAutomationDropLimitReached()

    ZanjiFruitAutomationEnsureState()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    local limit =
        ZanjiFruitAutomationReadDropLimit(
            ZANJI_FRUIT_AUTOMATION_STATE.DropLimit
        )

    if limit <= 0 then
        return false
    end

    return (
        tonumber(runtime.DroppedThisRun)
        or 0
    ) >= limit
end

function ZanjiFruitAutomationSyncToggles()

    local ui =
        type(ZANJI_FRUIT_AUTOMATION_UI) == "table"
        and ZANJI_FRUIT_AUTOMATION_UI
        or {}

    if type(ui.AutoDropToggle) == "table"
    and type(ui.AutoDropToggle.SetValue) == "function" then

        pcall(function()

            ui.AutoDropToggle:SetValue(
                ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true,
                true
            )
        end)
    end

    if type(ui.AutoPickupToggle) == "table"
    and type(ui.AutoPickupToggle.SetValue) == "function" then

        pcall(function()

            ui.AutoPickupToggle:SetValue(
                ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits == true,
                true
            )
        end)
    end
end

function ZanjiFruitAutomationRunDropWorker(token)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    runtime.DropRunning =
        true

    runtime.DroppedThisRun =
        0

    while runtime.DropToken == token
    and ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits == true do

        if ZanjiFarmAutoCollectBlocked() == true then

            task.wait(
                0.20
            )

        elseif ZanjiFruitAutomationDropLimitReached() == true then

            ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits =
                false

            ZanjiSaveFruitAutomationSettings()
            ZanjiFruitAutomationSyncToggles()

            if type(ZanjiNotify) == "function" then

                ZanjiNotify(
                    "ZANJI Farm",
                    "Auto Drop Fruits reached the drop limit.",
                    4
                )
            end

            break

        else

            local targets =
                ZanjiFruitAutomationGetFruitTools()

            if #targets <= 0 then

                task.wait(
                    runtime.DropScanDelay
                )

            else

                for _, info in ipairs(targets) do

                    if runtime.DropToken ~= token
                    or ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits ~= true then

                        break
                    end

                    if ZanjiFruitAutomationDropLimitReached() == true then
                        break
                    end

                    ZanjiFruitAutomationTryDropInfo(
                        info
                    )

                    task.wait(
                        0.05
                    )
                end

                task.wait(
                    runtime.DropScanDelay
                )
            end
        end
    end

    if runtime.DropToken == token then

        runtime.DropRunning =
            false
    end
end

function ZanjiFruitAutomationStartDrop(reason)

    ZanjiFruitAutomationEnsureState()

    if ZANJI_FRUIT_AUTOMATION_STATE.AutoDropFruits ~= true then
        return false
    end

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    if runtime.DropRunning == true then
        return false
    end

    runtime.DropLastAttempt =
        {}

    runtime.DroppedThisRun =
        0

    runtime.DropToken =
        {}

    local token =
        runtime.DropToken

    runtime.DropRunning =
        true

    task.spawn(function()

        ZanjiFruitAutomationRunDropWorker(
            token
        )
    end)

    return true
end

function ZanjiFruitAutomationStopDrop(reason)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    runtime.DropToken =
        nil

    runtime.DropRunning =
        false

    runtime.DropLastAttempt =
        {}

    return true
end

function ZanjiFruitAutomationGetDroppedFolder()

    local folder =
        workspace:FindFirstChild(
            "DroppedItems"
        )

    if typeof(folder) == "Instance" then
        return folder
    end

    folder =
        workspace:FindFirstChild(
            "DroppedItems",
            true
        )

    if typeof(folder) == "Instance" then
        return folder
    end

    return nil
end

function ZanjiFruitAutomationGetDroppedPrompt(item)

    if typeof(item) ~= "Instance" then
        return nil
    end

    local anchor =
        item:FindFirstChild(
            "PromptAnchor",
            true
        )

    if typeof(anchor) == "Instance" then

        local prompt =
            anchor:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

        if typeof(prompt) == "Instance" then
            return prompt
        end
    end

    return item:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )
end

function ZanjiFruitAutomationGetDroppedPromptPart(item)

    local prompt =
        ZanjiFruitAutomationGetDroppedPrompt(
            item
        )

    if typeof(prompt) == "Instance" then

        local parent =
            prompt.Parent

        if typeof(parent) == "Instance" then

            if parent:IsA("BasePart") then
                return parent
            end

            if parent:IsA("Attachment")
            and typeof(parent.Parent) == "Instance"
            and parent.Parent:IsA("BasePart") then

                return parent.Parent
            end
        end
    end

    if typeof(item) == "Instance"
    and item:IsA("Model")
    and item.PrimaryPart then

        return item.PrimaryPart
    end

    if typeof(item) == "Instance" then

        return item:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    return nil
end

function ZanjiFruitAutomationDroppedGetDistances(item)

    local root =
        ZanjiFruitAutomationGetRoot()

    local part =
        ZanjiFruitAutomationGetDroppedPromptPart(
            item
        )

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or typeof(part) ~= "Instance"
    or part:IsA("BasePart") ~= true then

        return nil,
            nil,
            nil
    end

    local delta =
        root.Position
        - part.Position

    local horizontal =
        Vector3.new(
            delta.X,
            0,
            delta.Z
        ).Magnitude

    local vertical =
        math.abs(
            delta.Y
        )

    return delta.Magnitude,
        horizontal,
        vertical
end

function ZanjiFruitAutomationReadDroppedInfo(item, forceRefresh)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    if typeof(item) ~= "Instance"
    or item.Parent == nil then

        runtime.DroppedCache[item] =
            nil

        runtime.DroppedLastAttempt[item] =
            nil

        return nil
    end

    if forceRefresh ~= true
    and type(runtime.DroppedCache[item]) == "table" then

        local cached =
            runtime.DroppedCache[item]

        if cached.Item == item
        and item.Parent ~= nil then

            return cached
        end
    end

    local prompt =
        ZanjiFruitAutomationGetDroppedPrompt(
            item
        )

    if typeof(prompt) ~= "Instance"
    or prompt:IsA("ProximityPrompt") ~= true then

        return nil
    end

    local info =
        ZanjiFruitAutomationReadCommonFruitInfo(
            item,
            item:GetAttribute("DisplayName")
            or prompt.ObjectText
            or item.Name
        )

    if ZanjiFruitAutomationLooksLikeFruit(
        info
    ) ~= true then

        return nil
    end

    info.Item =
        item

    info.Prompt =
        prompt

    runtime.DroppedCache[item] =
        info

    return info
end

function ZanjiFruitAutomationDroppedDistanceAllowed(item)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    local distance3D,
        horizontal,
        vertical =
        ZanjiFruitAutomationDroppedGetDistances(
            item
        )

    if distance3D == nil then

        return false,
            distance3D,
            horizontal,
            vertical
    end

    if distance3D <= runtime.PickupRange3D then

        return true,
            distance3D,
            horizontal,
            vertical
    end

    if horizontal <= runtime.PickupHorizontalRange
    and vertical <= runtime.PickupVerticalRange then

        return true,
            distance3D,
            horizontal,
            vertical
    end

    return false,
        distance3D,
        horizontal,
        vertical
end

function ZanjiFruitAutomationFireDroppedPrompt(prompt)

    if typeof(prompt) ~= "Instance"
    or prompt:IsA("ProximityPrompt") ~= true
    or prompt.Parent == nil then

        return false,
            "missing prompt"
    end

    local oldEnabled =
        prompt.Enabled

    local oldDistance =
        prompt.MaxActivationDistance

    local oldHold =
        prompt.HoldDuration

    local oldLineOfSight =
        prompt.RequiresLineOfSight

    pcall(function()

        prompt.Enabled =
            true

        prompt.MaxActivationDistance =
            9999

        prompt.HoldDuration =
            0

        prompt.RequiresLineOfSight =
            false
    end)

    local ok,
        err =
        false,
        nil

    if type(fireproximityprompt) == "function" then

        ok,
            err =
            pcall(function()

                fireproximityprompt(
                    prompt
                )
            end)

    else

        ok,
            err =
            pcall(function()

                prompt:InputHoldBegin()

                task.wait(
                    0.06
                )

                prompt:InputHoldEnd()
            end)
    end

    task.delay(0.50, function()

        if typeof(prompt) == "Instance"
        and prompt.Parent ~= nil then

            pcall(function()

                prompt.Enabled =
                    oldEnabled

                prompt.MaxActivationDistance =
                    oldDistance

                prompt.HoldDuration =
                    oldHold

                prompt.RequiresLineOfSight =
                    oldLineOfSight
            end)
        end
    end)

    return ok == true,
        err
end

function ZanjiFruitAutomationWaitDroppedRemoved(item, timeout)

    local startedAt =
        os.clock()

    timeout =
        tonumber(timeout)
        or 2.35

    while os.clock() - startedAt <= timeout do

        if typeof(item) ~= "Instance"
        or item.Parent == nil then

            return true
        end

        task.wait(
            0.05
        )
    end

    return false
end

function ZanjiFruitAutomationTryPickupDroppedInfo(info)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    info =
        type(info) == "table"
        and info
        or {}

    local item =
        info.Item

    if typeof(item) ~= "Instance"
    or item.Parent == nil then

        runtime.DroppedCache[item] =
            nil

        runtime.DroppedLastAttempt[item] =
            nil

        return false
    end

    info =
        ZanjiFruitAutomationReadDroppedInfo(
            item,
            false
        )

    if ZanjiFruitAutomationPassesFilters(
        info
    ) ~= true then

        return false
    end

    local distanceAllowed =
        ZanjiFruitAutomationDroppedDistanceAllowed(
            item
        )

    if distanceAllowed ~= true then
        return false
    end

    local lastAttempt =
        tonumber(
            runtime.DroppedLastAttempt[item]
        )
        or 0

    if os.clock() - lastAttempt < runtime.PickupRetryDelay then
        return false
    end

    runtime.DroppedLastAttempt[item] =
        os.clock()

    local fired =
        ZanjiFruitAutomationFireDroppedPrompt(
            info.Prompt
        )

    if fired ~= true then
        return false
    end

    local removed =
        ZanjiFruitAutomationWaitDroppedRemoved(
            item,
            runtime.PickupResultTimeout
        )

    if removed == true then

        runtime.DroppedCache[item] =
            nil

        runtime.DroppedLastAttempt[item] =
            nil

        return true
    end

    return false
end

function ZanjiFruitAutomationGetDroppedTargets()

    local folder =
        ZanjiFruitAutomationGetDroppedFolder()

    local targets =
        {}

    if typeof(folder) ~= "Instance" then
        return targets
    end

    for _, item in ipairs(folder:GetChildren()) do

        if item:IsA("Model") then

            local info =
                ZanjiFruitAutomationReadDroppedInfo(
                    item,
                    false
                )

            if ZanjiFruitAutomationPassesFilters(
                info
            ) == true then

                table.insert(
                    targets,
                    info
                )
            end
        end
    end

    table.sort(targets, function(a, b)

        local distanceA =
            ZanjiFruitAutomationDroppedGetDistances(
                a.Item
            )
            or math.huge

        local distanceB =
            ZanjiFruitAutomationDroppedGetDistances(
                b.Item
            )
            or math.huge

        return distanceA < distanceB
    end)

    return targets
end

function ZanjiFruitAutomationConnectDroppedFolder()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    ZanjiFarmDisconnectConnectionList(
        runtime.DroppedConnections
    )

    runtime.DroppedConnections =
        {}

    local folder =
        ZanjiFruitAutomationGetDroppedFolder()

    if typeof(folder) ~= "Instance" then
        return false
    end

    table.insert(
        runtime.DroppedConnections,
        folder.ChildRemoved:Connect(function(item)

            runtime.DroppedCache[item] =
                nil

            runtime.DroppedLastAttempt[item] =
                nil
        end)
    )

    return true
end

function ZanjiFruitAutomationPickupMovementEnabled()

    ZanjiFruitAutomationEnsureState()

    return ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits == true
        and ZANJI_FRUIT_AUTOMATION_STATE.PickupMovement
            == "Walk to Fruits"
end

function ZanjiFruitAutomationOfflineCutsceneActive()

    local playerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local offlineGui =
        playerGui
        and playerGui:FindFirstChild(
            "OfflineAnimation"
        )

    if typeof(offlineGui) ~= "Instance"
    or offlineGui:IsA("ScreenGui") ~= true
    or offlineGui.Enabled ~= true then

        return false
    end

    local function visibleThroughParents(object)

        if typeof(object) ~= "Instance"
        or object:IsA("GuiObject") ~= true then

            return false
        end

        local current =
            object

        while current
        and current ~= offlineGui do

            if current:IsA("GuiObject")
            and current.Visible ~= true then

                return false
            end

            current =
                current.Parent
        end

        return current == offlineGui
    end

    local bottomBar =
        offlineGui:FindFirstChild(
            "BottomBar"
        )

    local topBar =
        offlineGui:FindFirstChild(
            "TopBar"
        )

    local holdLabel =
        bottomBar
        and bottomBar:FindFirstChild(
            "HTSLabel"
        )

    local title =
        topBar
        and topBar:FindFirstChild(
            "Title"
        )

    return visibleThroughParents(
        holdLabel
    )
    or visibleThroughParents(
        title
    )
end

function ZanjiFruitAutomationPickupHigherPriorityActive()

    if ZanjiFarmAutoCollectBlocked() == true then

        return true
    end

    if type(ZANJI_WATERING_REJOIN_STATE) == "table"
    and ZANJI_WATERING_REJOIN_STATE.Enabled == true then

        return true
    end

    if type(ZANJI_WATERING_REJOIN_RUNTIME) == "table"
    and (
        ZANJI_WATERING_REJOIN_RUNTIME.Running == true
        or ZANJI_WATERING_REJOIN_RUNTIME.Teleporting == true
    ) then

        return true
    end

    if ZanjiFruitAutomationOfflineCutsceneActive() == true then

        return true
    end

    return false
end

function ZanjiFruitAutomationStopPickupMovement()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    if runtime.PickupMoving ~= true then
        return false
    end

    runtime.PickupMoving =
        false

    local humanoid =
        ZanjiFruitAutomationGetHumanoid()

    local root =
        ZanjiFruitAutomationGetRoot()

    if humanoid
    and root then

        pcall(function()

            humanoid:MoveTo(
                root.Position
            )
        end)
    end

    return true
end

function ZanjiFruitAutomationAcquirePickupMovement()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    if runtime.PickupOwnsMovement == true then

        return true
    end

    runtime.PickupOwnsMovement =
        true

    if type(ZanjiFarmMiddleStop) == "function" then

        ZanjiFarmMiddleStop(
            "dropped fruit walking"
        )
    end

    return true
end

function ZanjiFruitAutomationReleasePickupMovement()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    local previouslyOwned =
        runtime.PickupOwnsMovement == true

    ZanjiFruitAutomationStopPickupMovement()

    runtime.PickupOwnsMovement =
        false

    runtime.PickupTarget =
        nil

    runtime.PickupLastDropPosition =
        nil

    if previouslyOwned ~= true then

        return false
    end

    task.defer(function()

        task.wait(
            0.15
        )

        if ZanjiFruitAutomationPickupMovementEnabled() == true then
            return
        end

        if ZanjiFruitAutomationPickupHigherPriorityActive() == true then
            return
        end

        if ZANJI_DEV_UI_STATE.AutoFarmMiddle == true
        and type(ZanjiFarmMiddleStart) == "function" then

            ZanjiFarmMiddleStart(
                "dropped fruit walking ended"
            )
        end
    end)

    return true
end

function ZanjiFruitAutomationPickupOwnsMovement()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    return ZanjiFruitAutomationPickupMovementEnabled() == true
        and runtime.PickupOwnsMovement == true
end

function ZanjiFruitAutomationWalkToDroppedInfo(
    info
)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    info =
        type(info) == "table"
        and info
        or {}

    local item =
        info.Item

    if typeof(item) ~= "Instance"
    or item.Parent == nil then

        runtime.PickupTarget =
            nil

        ZanjiFruitAutomationStopPickupMovement()

        return false
    end

    local part =
        ZanjiFruitAutomationGetDroppedPromptPart(
            item
        )

    local humanoid =
        ZanjiFruitAutomationGetHumanoid()

    local root =
        ZanjiFruitAutomationGetRoot()

    if typeof(part) ~= "Instance"
    or part:IsA("BasePart") ~= true
    or typeof(humanoid) ~= "Instance"
    or typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or humanoid.Health <= 0 then

        ZanjiFruitAutomationStopPickupMovement()

        return false
    end

    runtime.PickupTarget =
        item

    runtime.PickupLastDropPosition =
        part.Position

    local distanceAllowed =
        ZanjiFruitAutomationDroppedDistanceAllowed(
            item
        )

    if distanceAllowed == true then

        ZanjiFruitAutomationStopPickupMovement()

        return true
    end

    local now =
        os.clock()

    if now - runtime.PickupLastMoveAt
        >= runtime.PickupMoveInterval then

        runtime.PickupLastMoveAt =
            now

        runtime.PickupMoving =
            true

        pcall(function()

            humanoid.Sit =
                false

            humanoid.PlatformStand =
                false

            humanoid.AutoRotate =
                true

            humanoid:MoveTo(
                part.Position
            )
        end)
    end

    return false
end

function ZanjiFruitAutomationContinueToRemovedTarget()

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    local target =
        runtime.PickupTarget

    if typeof(target) ~= "Instance"
    or target.Parent ~= nil then

        return "None"
    end

    local savedPosition =
        runtime.PickupLastDropPosition

    if typeof(savedPosition) ~= "Vector3" then

        runtime.PickupTarget =
            nil

        ZanjiFruitAutomationStopPickupMovement()

        return "Unavailable"
    end

    local humanoid =
        ZanjiFruitAutomationGetHumanoid()

    local root =
        ZanjiFruitAutomationGetRoot()

    if typeof(humanoid) ~= "Instance"
    or typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or humanoid.Health <= 0 then

        return "Waiting"
    end

    local flatTarget =
        Vector3.new(
            savedPosition.X,
            root.Position.Y,
            savedPosition.Z
        )

    local delta =
        flatTarget
        - root.Position

    local horizontalDistance =
        Vector3.new(
            delta.X,
            0,
            delta.Z
        ).Magnitude

    if horizontalDistance <= 4.5 then

        ZanjiFruitAutomationStopPickupMovement()

        runtime.PickupTarget =
            nil

        runtime.PickupLastDropPosition =
            nil

        return "Arrived"
    end

    local now =
        os.clock()

    if now - runtime.PickupLastMoveAt
        >= runtime.PickupMoveInterval then

        runtime.PickupLastMoveAt =
            now

        runtime.PickupMoving =
            true

        pcall(function()

            humanoid.Sit =
                false

            humanoid.PlatformStand =
                false

            humanoid.AutoRotate =
                true

            humanoid:MoveTo(
                flatTarget
            )
        end)
    end

    return "Moving"
end

function ZanjiFruitAutomationRunPickupWorker(token)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    runtime.PickupRunning =
        true

    ZanjiFruitAutomationConnectDroppedFolder()

    while runtime.PickupToken == token
    and ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits == true do

        local walkingEnabled =
            ZanjiFruitAutomationPickupMovementEnabled()

        if walkingEnabled == true then

            ZanjiFruitAutomationAcquirePickupMovement()

        elseif runtime.PickupOwnsMovement == true then

            ZanjiFruitAutomationReleasePickupMovement()
        end

        if ZanjiFruitAutomationPickupHigherPriorityActive() == true then

            if runtime.PickupMoving == true then

                ZanjiFruitAutomationStopPickupMovement()
            end

            task.wait(
                0.20
            )

            continue
        end

        local removedTargetStatus =
            ZanjiFruitAutomationContinueToRemovedTarget()

        if removedTargetStatus == "Moving"
        or removedTargetStatus == "Waiting" then

            task.wait(
                runtime.PickupScanDelay
            )

            continue
        end

        local targets =
            ZanjiFruitAutomationGetDroppedTargets()

        if #targets <= 0 then

            if runtime.PickupMoving == true then

                ZanjiFruitAutomationStopPickupMovement()
            end

            runtime.PickupTarget =
                nil

            task.wait(
                runtime.PickupScanDelay
            )

            continue
        end

        if walkingEnabled == true then

            local info =
                targets[1]

            local inRange =
                ZanjiFruitAutomationWalkToDroppedInfo(
                    info
                )

            if inRange == true then

                ZanjiFruitAutomationTryPickupDroppedInfo(
                    info
                )

                ZanjiFruitAutomationStopPickupMovement()
            end

            task.wait(
                runtime.PickupScanDelay
            )

        else

            for _, info in ipairs(targets) do

                if runtime.PickupToken ~= token
                or ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits ~= true then

                    break
                end

                ZanjiFruitAutomationTryPickupDroppedInfo(
                    info
                )

                task.wait(
                    0.02
                )
            end

            task.wait(
                runtime.PickupScanDelay
            )
        end
    end

    if runtime.PickupToken == token then

        runtime.PickupRunning =
            false

        ZanjiFruitAutomationReleasePickupMovement()
    end
end

function ZanjiFruitAutomationStartPickup(reason)

    ZanjiFruitAutomationEnsureState()

    if ZANJI_FRUIT_AUTOMATION_STATE.AutoCollectDroppedFruits ~= true then

        return false
    end

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    if runtime.PickupRunning == true then

        if ZanjiFruitAutomationPickupMovementEnabled() == true then

            ZanjiFruitAutomationAcquirePickupMovement()
        end

        return false
    end

    runtime.DroppedCache =
        {}

    runtime.DroppedLastAttempt =
        {}

    runtime.PickupTarget =
        nil

    runtime.PickupMoving =
        false

    runtime.PickupLastMoveAt =
        0

    runtime.PickupToken =
        {}

    local token =
        runtime.PickupToken

    runtime.PickupRunning =
        true

    if ZanjiFruitAutomationPickupMovementEnabled() == true then

        ZanjiFruitAutomationAcquirePickupMovement()
    end

    task.spawn(function()

        ZanjiFruitAutomationRunPickupWorker(
            token
        )
    end)

    return true
end

function ZanjiFruitAutomationStopPickup(reason)

    local runtime =
        ZanjiFruitAutomationEnsureRuntime()

    runtime.PickupToken =
        nil

    runtime.PickupRunning =
        false

    ZanjiFruitAutomationReleasePickupMovement()

    ZanjiFarmDisconnectConnectionList(
        runtime.DroppedConnections
    )

    runtime.DroppedConnections =
        {}

    runtime.DroppedCache =
        {}

    runtime.DroppedLastAttempt =
        {}

    runtime.PickupTarget =
        nil

    return true
end

