            lot.displayName
            or lot.DisplayName
            or lot.name
            or lot.Name
        )

    if displayName ~= "" then

        return displayName
    end

    local auctioneer =
        ZanjiAuctionGetAuctioneerModule()

    if type(auctioneer) == "table"
    and type(auctioneer.DisplayName) == "function" then

        local ok,
            result =
            pcall(
                auctioneer.DisplayName,
                lot
            )

        if ok == true then

            displayName =
                ZanjiCleanText(
                    result
                )
        end
    end

    if displayName == "" then

        displayName =
            ZanjiCleanText(
                lot.item
                or lot.Item
                or lot.listingId
                or lot.LotId
                or lot.lotId
                or "Unknown Auction Item"
            )
    end

    return displayName
end

function ZanjiAuctionPrimitiveLot(lot)

    local result =
        {}

    for key, value in pairs(lot or {}) do

        local valueType =
            type(value)

        if valueType == "string"
        or valueType == "number"
        or valueType == "boolean" then

            result[tostring(key)] =
                value
        end
    end

    result.lotId =
        tostring(
            lot.lotId
            or lot.LotId
            or result.lotId
            or ""
        )

    result.displayName =
        ZanjiAuctionDisplayName(
            lot
        )

    return result
end

function ZanjiAuctionSaveManifestCache()

    ZanjiAuctionEnsureState()

    if ZanjiCanUseFiles() ~= true then
        return false
    end

    if #ZANJI_SHOP_STATE.AuctionManifest <= 0 then
        return false
    end

    ZanjiEnsureFolder()

    local safeLots =
        {}

    for _, lot in ipairs(ZANJI_SHOP_STATE.AuctionManifest) do

        table.insert(
            safeLots,
            ZanjiAuctionPrimitiveLot(
                lot
            )
        )
    end

    local payload = {
        Version =
            "ZANJI_AUCTION_MANIFEST_CACHE_V3",

        PlaceId =
            game.PlaceId,

        Cycle =
            ZANJI_SHOP_STATE.AuctionManifestCycle,

        Hash =
            ZANJI_SHOP_STATE.AuctionManifestHash,

        RollIntervalSeconds =
            ZANJI_SHOP_STATE.AuctionRollIntervalSeconds,

        SavedAt =
            os.time(),

        Lots =
            safeLots,
    }

    local encodedOk,
        encoded =
        pcall(function()

            return HttpService:JSONEncode(
                payload
            )
        end)

    if encodedOk ~= true then
        return false
    end

    return pcall(function()

        writefile(
            ZANJI_AUCTION_MANIFEST_CACHE_FILE,
            encoded
        )
    end)
end

function ZanjiAuctionRefreshNetworkReady()

    ZanjiAuctionEnsureState()

    local manifestCycle =
        tonumber(
            ZANJI_SHOP_STATE.AuctionManifestCycle
        )

    local stockCycle =
        ZanjiAuctionCalculateStockCycle()

    local ready =
        manifestCycle ~= nil
        and stockCycle ~= nil
        and manifestCycle == stockCycle
        and #ZANJI_SHOP_STATE.AuctionManifest > 0

    if ready == true then

        for _, lot in ipairs(ZANJI_SHOP_STATE.AuctionManifest) do

            local lotId =
                tostring(
                    lot.lotId
                    or lot.LotId
                    or ""
                )

            if lotId == ""
            or ZANJI_SHOP_STATE.AuctionStockMap[lotId] == nil then

                ready =
                    false

                break
            end
        end
    end

    ZANJI_SHOP_STATE.AuctionNetworkReady =
        ready

    if ready == true then

        ZANJI_SHOP_STATE.AuctionDataMode =
            "Network ready"

    elseif manifestCycle == nil then

        ZANJI_SHOP_STATE.AuctionDataMode =
            "Waiting manifest"

    elseif stockCycle == nil then

        ZANJI_SHOP_STATE.AuctionDataMode =
            "Waiting stock"

    else

        ZANJI_SHOP_STATE.AuctionDataMode =
            "Syncing cycles "
            .. tostring(manifestCycle)
            .. "/"
            .. tostring(stockCycle)
    end

    return ready
end

function ZanjiAuctionApplyManifestPayload(payload, source)

    ZanjiAuctionEnsureState()

    payload =
        type(payload) == "table"
        and payload
        or {}

    local manifest =
        type(payload.manifest) == "table"
        and payload.manifest
        or payload

    local sourceLots =
        type(manifest.lots) == "table"
        and manifest.lots
        or (
            type(manifest.Lots) == "table"
            and manifest.Lots
            or nil
        )

    if type(sourceLots) ~= "table" then

        return false,
            "manifest lots missing"
    end

    local lots =
        {}

    local byLotId =
        {}

    local cycleCounts =
        {}

    local bestCycle =
        nil

    local bestCycleCount =
        0

    for _, rawLot in pairs(sourceLots) do

        if type(rawLot) == "table" then

            local lot =
                rawLot

            local lotId =
                tostring(
                    lot.lotId
                    or lot.LotId
                    or ""
                )

            if lotId ~= "" then

                lot.lotId =
                    lotId

                lot.displayName =
                    ZanjiAuctionDisplayName(
                        lot
                    )

                table.insert(
                    lots,
                    lot
                )

                byLotId[lotId] =
                    lot

                local cycle =
                    ZanjiAuctionExtractCycle(
                        lotId
                    )

                if cycle ~= nil then

                    cycleCounts[cycle] =
                        (
                            cycleCounts[cycle]
                            or 0
                        )
                        + 1

                    if cycleCounts[cycle] > bestCycleCount then

                        bestCycle =
                            cycle

                        bestCycleCount =
                            cycleCounts[cycle]
                    end
                end
            end
        end
    end

    if #lots <= 0 then

        return false,
            "manifest contains no lots"
    end

    if bestCycle == nil then

        bestCycle =
            tonumber(
                payload.rollWindowUnix
                or manifest.rollWindowUnix
            )
    end

    table.sort(lots, function(a, b)

        return (
            ZanjiAuctionExtractSlot(
                a.lotId
            )
            or 999
        ) < (
            ZanjiAuctionExtractSlot(
                b.lotId
            )
            or 999
        )
    end)

    local previousCycle =
        tonumber(
            ZANJI_SHOP_STATE.AuctionManifestCycle
        )

    if previousCycle ~= nil
    and bestCycle ~= nil
    and previousCycle ~= bestCycle then

        -- Per-lot completion history belongs to the old cycle.
        ZANJI_SHOP_STATE.AuctionAttemptedLots =
            {}

        ZANJI_SHOP_STATE.AuctionNextRetryAt =
            0

        -- Do not clear AuctionNextBuyAt or pending-result state here.
        -- The server purchase cooldown is account-wide and can continue
        -- across an auction rotation.
    end

    ZANJI_SHOP_STATE.AuctionManifest =
        lots

    ZANJI_SHOP_STATE.AuctionManifestByLotId =
        byLotId

    ZANJI_SHOP_STATE.AuctionManifestCycle =
        bestCycle

    ZANJI_SHOP_STATE.AuctionManifestHash =
        tostring(
            manifest.hash
            or manifest.Hash
            or payload.hash
            or ""
        )

    ZANJI_SHOP_STATE.AuctionManifestSource =
        tostring(
            source
            or "Packet 335"
        )

    ZANJI_SHOP_STATE.AuctionManifestReceivedAt =
        os.clock()

    ZANJI_SHOP_STATE.AuctionRollIntervalSeconds =
        tonumber(
            payload.rollIntervalSeconds
            or manifest.rollIntervalSeconds
        )
        or ZANJI_SHOP_STATE.AuctionRollIntervalSeconds
        or 1800

    ZanjiAuctionSetServerClock(
        payload.serverNow
        or manifest.serverNow
    )

    -- Intentionally do not read payload.stock here.
    -- Snapshot stock can still belong to the previous cycle.

    for _, lot in ipairs(lots) do

        ZanjiAuctionRememberKnownItem(
            lot.displayName
        )
    end

    ZanjiAuctionRefreshNetworkReady()

    if source ~= "Cache" then

        ZanjiAuctionSaveManifestCache()
    end

    ZanjiAuctionRefreshDropdown(
        true
    )

    return true
end

function ZanjiAuctionLoadManifestCache()

    ZanjiAuctionEnsureState()

    if ZanjiCanUseFiles() ~= true then
        return false
    end

    local existsOk,
        exists =
        pcall(function()

            return isfile(
                ZANJI_AUCTION_MANIFEST_CACHE_FILE
            )
        end)

    if existsOk ~= true
    or exists ~= true then

        return false
    end

    local readOk,
        raw =
        pcall(function()

            return readfile(
                ZANJI_AUCTION_MANIFEST_CACHE_FILE
            )
        end)

    if readOk ~= true then
        return false
    end

    local decodeOk,
        cache =
        pcall(function()

            return HttpService:JSONDecode(
                raw
            )
        end)

    if decodeOk ~= true
    or type(cache) ~= "table"
    or tonumber(cache.PlaceId) ~= game.PlaceId
    or type(cache.Lots) ~= "table" then

        return false
    end

    return ZanjiAuctionApplyManifestPayload(
        {
            manifest = {
                lots =
                    cache.Lots,

                hash =
                    cache.Hash,
            },

            rollWindowUnix =
                cache.Cycle,

            rollIntervalSeconds =
                cache.RollIntervalSeconds,
        },
        "Cache"
    )
end

function ZanjiAuctionCurrentPrice(lot, serverNow)

    lot =
        type(lot) == "table"
        and lot
        or {}

    serverNow =
        tonumber(serverNow)
        or ZanjiAuctionEstimatedServerNow()

    if serverNow <= 0 then

        return nil,
            "server clock missing"
    end

    local auctioneer =
        ZanjiAuctionGetAuctioneerModule()

    if type(auctioneer) ~= "table"
    or type(auctioneer.CurrentPrice) ~= "function" then

        return nil,
            "Auctioneer.CurrentPrice missing"
    end

    local ok,
        price =
        pcall(
            auctioneer.CurrentPrice,
            lot,
            serverNow
        )

    price =
        tonumber(price)

    if ok ~= true
    or price == nil
    or price ~= price
    or price == math.huge
    or price <= 0 then

        return nil,
            "CurrentPrice failed"
    end

    return math.max(
        1,
        math.floor(
            price + 0.5
        )
    )
end

function ZanjiAuctionIsNetworkLotActive(lot, serverNow, stock)

    stock =
        math.max(
            0,
            math.floor(
                tonumber(stock)
                or 0
            )
        )

    if stock <= 0 then
        return false
    end

    local auctioneer =
        ZanjiAuctionGetAuctioneerModule()

    if type(auctioneer) == "table"
    and type(auctioneer.IsActive) == "function" then

        local ok,
            active =
            pcall(
                auctioneer.IsActive,
                lot,
                serverNow,
                stock
            )

        if ok == true
        and type(active) == "boolean" then

            return active
        end
    end

    local expiresAt =
        tonumber(
            lot.expiresAt
            or lot.ExpiresAt
        )

    if expiresAt ~= nil
    and serverNow > 0
    and serverNow >= expiresAt then

        return false
    end

    return true
end

function ZanjiAuctionRowStale(row, requireServerStock)

    ZanjiAuctionEnsureState()

    row =
        type(row) == "table"
        and row
        or {}

    if ZANJI_SHOP_STATE.AuctionNetworkReady ~= true then

        return true,
            "network not synchronized"
    end

    if row.Network ~= true then

        return true,
            "not network data"
    end

    local manifestCycle =
        tonumber(
            ZANJI_SHOP_STATE.AuctionManifestCycle
        )

    local stockCycle =
        tonumber(
            ZanjiAuctionGetStockCycle()
        )

    if manifestCycle == nil
    or stockCycle == nil
    or manifestCycle ~= stockCycle
    or tonumber(row.Cycle) ~= manifestCycle then

        return true,
            "cycle mismatch"
    end

    if requireServerStock == true then

        local lotId =
            tostring(
                row.LotId
                or ""
            )

        if ZANJI_SHOP_STATE.AuctionStockMap[lotId] == nil then

            return true,
                "stock missing"
        end
    end

    return false,
        ""
end

function ZanjiAuctionScanLiveLots()

    ZanjiAuctionEnsureState()

    ZanjiAuctionRestoreOffscreen()

    ZanjiAuctionRefreshNetworkReady()

    local rows =
        {}

    local serverNow =
        ZanjiAuctionEstimatedServerNow()

    local manifestCycle =
        tonumber(
            ZANJI_SHOP_STATE.AuctionManifestCycle
        )

    local rollInterval =
        tonumber(
            ZANJI_SHOP_STATE.AuctionRollIntervalSeconds
        )
        or 1800

    if manifestCycle ~= nil
    and serverNow > 0 then

        ZANJI_SHOP_STATE.AuctionRefreshSeconds =
            math.max(
                0,
                manifestCycle
                    + rollInterval
                    - serverNow
            )

        ZANJI_SHOP_STATE.AuctionRefreshReadAt =
            os.clock()

        ZANJI_SHOP_STATE.AuctionRefreshText =
            "Refresh in "
            .. ZanjiAuctionFormatDuration(
                ZANJI_SHOP_STATE.AuctionRefreshSeconds
            )
    end

    for _, lot in ipairs(ZANJI_SHOP_STATE.AuctionManifest) do

        local lotId =
            tostring(
                lot.lotId
                or lot.LotId
                or ""
            )

        local serverStock =
            ZANJI_SHOP_STATE.AuctionStockMap[
                lotId
            ]

        local passiveStock,
            passiveStockText =
            ZanjiAuctionReadPassiveStock(
                lotId
            )

        local stockValue =
            serverStock

        local stockSource =
            "Server"

        if stockValue == nil then

            stockValue =
                passiveStock

            stockSource =
                passiveStock ~= nil
                and "Display"
                or "Unknown"
        end

        local stockKnown =
            stockValue ~= nil

        local stock =
            math.max(
                0,
                math.floor(
                    tonumber(stockValue)
                    or 0
                )
            )

        local price =
            ZanjiAuctionCurrentPrice(
                lot,
                serverNow
            )

        local expiresAt =
            tonumber(
                lot.expiresAt
                or lot.ExpiresAt
            )

        local expired =
            expiresAt ~= nil
            and serverNow > 0
            and serverNow >= expiresAt

        local networkReady =
            ZANJI_SHOP_STATE.AuctionNetworkReady == true
            and serverStock ~= nil

        local active =
            stockKnown == true
            and price ~= nil
            and ZanjiAuctionIsNetworkLotActive(
                lot,
                serverNow,
                stock
            )

        local remaining =
            expiresAt ~= nil
            and serverNow > 0
            and math.max(
                0,
                expiresAt - serverNow
            )
            or math.max(
                0,
                ZANJI_SHOP_STATE.AuctionRefreshSeconds
                or 0
            )

        local count =
            math.max(
                1,
                math.floor(
                    tonumber(
                        lot.count
                        or lot.Count
                    )
                    or 1
                )
            )

        table.insert(
            rows,
            {
                LotId =
                    lotId,

                Cycle =
                    ZanjiAuctionExtractCycle(
                        lotId
                    ),

                Slot =
                    ZanjiAuctionExtractSlot(
                        lotId
                    ),

                Name =
                    ZanjiAuctionDisplayName(
                        lot
                    ),

                Stock =
                    stock,

                ServerStock =
                    serverStock,

                DisplayStock =
                    passiveStock,

                StockKnown =
                    stockKnown,

                StockSource =
                    stockSource,

                StockText =
                    stockKnown == true
                    and (
                        "x"
                        .. tostring(stock)
                    )
                    or "--",

                Price =
                    price or 0,

                PriceText =
                    price ~= nil
                    and ZanjiAuctionFormatMoney(
                        price
                    )
                    or "--",

                AmountText =
                    count > 1
                    and (
                        "x"
                        .. tostring(count)
                    )
                    or "",

                Timer =
                    ZanjiAuctionFormatDuration(
                        remaining
                    ),

                SoldOut =
                    stockKnown == true
                    and stock <= 0,

                Expired =
                    expired,

                Active =
                    active == true,

                SortIndex =
                    ZanjiAuctionExtractSlot(
                        lotId
                    )
                    or 999,

                Cached =
                    ZANJI_SHOP_STATE.AuctionManifestSource == "Cache",

                Network =
                    true,

                NetworkReady =
                    networkReady,

                Manifest =
                    lot,
            }
        )
    end

    table.sort(rows, function(a, b)

        local selectedA =
            ZanjiAuctionSelectionAllows(
                a.Name
            )

        local selectedB =
            ZanjiAuctionSelectionAllows(
                b.Name
            )

        if selectedA ~= selectedB then

            return selectedA == true
        end

        if a.Active ~= b.Active then

            return a.Active == true
        end

        return tonumber(a.SortIndex)
            < tonumber(b.SortIndex)
    end)

    ZANJI_SHOP_STATE.AuctionLastLots =
        rows

    ZANJI_SHOP_STATE.AuctionLastScanAt =
        os.clock()

    return rows
end

function ZanjiAuctionBuildLiveText(rows)

    rows =
        type(rows) == "table"
        and rows
        or ZanjiAuctionScanLiveLots()

    if #rows <= 0 then

        return "Live: Loading auctions..."
    end

    local parts =
        {}

    for index, row in ipairs(rows) do

        if index > 3 then
            break
        end

        local stockText =
            row.StockKnown == true
            and (
                "x"
                .. tostring(row.Stock)
            )
            or "--"

        parts[#parts + 1] =
            tostring(row.Name)
            .. " "
            .. stockText
            .. " "
            .. tostring(row.PriceText)
    end

    if #rows > 3 then

        parts[#parts + 1] =
            "+"
            .. tostring(#rows - 3)
            .. " more"
    end

    return "Live: "
        .. ZanjiAuctionRefreshHeaderText()
        .. " | "
        .. table.concat(
            parts,
            " | "
        )
end

function ZanjiAuctionRepriceRow(row)

    ZanjiAuctionEnsureState()

    if ZANJI_SHOP_STATE.AuctionNetworkReady ~= true then

        return nil,
            "network not synchronized"
    end

    local lotId =
        tostring(
            type(row) == "table"
            and row.LotId
            or ""
        )

    local manifestLot =
        ZANJI_SHOP_STATE.AuctionManifestByLotId[
            lotId
        ]

    if type(manifestLot) ~= "table" then

        return nil,
            "manifest lot missing"
    end

    local stock =
        ZANJI_SHOP_STATE.AuctionStockMap[
            lotId
        ]

    if stock == nil then

        return nil,
            "server stock missing"
    end

    local serverNow =
        ZanjiAuctionEstimatedServerNow()

    local price,
        priceReason =
        ZanjiAuctionCurrentPrice(
            manifestLot,
            serverNow
        )

    if price == nil then

        return nil,
            priceReason
    end

    local result =
        {}

    for key, value in pairs(row or {}) do

        result[key] =
            value
    end

    result.Price =
        price

    result.PriceText =
        ZanjiAuctionFormatMoney(
            price
        )

    result.Stock =
        math.max(
            0,
            math.floor(
                tonumber(stock)
                or 0
            )
        )

    result.ServerStock =
        stock

    result.Active =
        ZanjiAuctionIsNetworkLotActive(
            manifestLot,
            serverNow,
            stock
        )

    result.Network =
        true

    result.NetworkReady =
        true

    result.Manifest =
        manifestLot

    if result.Active ~= true then

        return nil,
            "Auction unavailable"
    end

    if ZanjiAuctionSelectionAllows(
        result.Name
    ) ~= true then

        return nil,
            "Item is not selected"
    end

    if ZanjiAuctionPriceAllows(
        result
    ) ~= true then

        return nil,
            "Price is above Max Price"
    end

    local stale,
        staleReason =
        ZanjiAuctionRowStale(
            result,
            true
        )

    if stale == true then

        return nil,
            staleReason == "stock stale"
            and "Waiting for stock"
            or "Auction data is updating"
    end

    if ZANJI_SHOP_STATE
        .AuctionBuyUntilSoldOut ~= true
    and ZANJI_SHOP_STATE
        .AuctionAttemptedLots[
            tostring(result.LotId)
        ] == true then

        return nil,
            "Bought once"
    end

    return result
end

function ZanjiAuctionFirePurchase(row)

    local finalRow,
        safetyReason =
        ZanjiAuctionRepriceRow(
            row
        )

    if type(finalRow) ~= "table" then

        return false,
            tostring(
                safetyReason
                or "reprice failed"
            )
    end

    local lotId =
        tostring(
            finalRow.LotId
        )

    local price =
        math.max(
            1,
            math.floor(
                tonumber(finalRow.Price)
                or 0
            )
        )

    if ZANJI_SHOP_STATE.AuctionDryRun == true then

        ZANJI_SHOP_STATE.AuctionLastDecision =
            "DRY RUN eligible: "
            .. tostring(finalRow.Name)
            .. " at "
            .. ZanjiAuctionFormatMoney(price)

        return true,
            "dry run",
            finalRow
    end

    local packet =
        ZanjiAuctionResolvePurchasePacket(
            false
        )

    if type(packet) ~= "table" then

        packet =
            ZanjiAuctionResolvePurchasePacket(
                true
            )
    end

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false,
            "PurchaseLot packet missing"
    end

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "PurchaseFireBegin",
            {
                LotId = lotId,
                Name = finalRow.Name,
                Price = price,
            }
        )
    end

    local ok,
        result =
        pcall(function()

            return packet:Fire(
                lotId,
                price
            )
        end)

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "PurchaseFireReturned",
            {
                LotId = lotId,
                Name = finalRow.Name,
                Price = price,
                LocalSuccess = ok == true,

                Error =
                    ok ~= true
                    and tostring(result)
                    or nil,
            },
            ok == true
            and "Info"
            or "Error"
        )
    end

    if ok ~= true then

        return false,
            tostring(result)
    end

    ZANJI_SHOP_STATE.AuctionAttemptedLots[lotId] =
        true

    ZANJI_SHOP_STATE.AuctionPendingLotId =
        lotId

    ZANJI_SHOP_STATE.AuctionPendingPrice =
        price

    local sentAt =
        os.clock()

    local sentName =
        tostring(
            finalRow.Name
            or "Auction item"
        )

    ZANJI_SHOP_STATE.AuctionPendingName =
        sentName

    ZANJI_SHOP_STATE.AuctionPendingSentAt =
        sentAt

    local provisionalCooldown =
        ZanjiAuctionReadServerCooldown()

    local provisionalGuard =
        math.max(
            1,
            ZanjiAuctionReadCooldownGuard()
        )

    ZANJI_SHOP_STATE.AuctionCooldownAnchorAt =
        sentAt

    ZANJI_SHOP_STATE.AuctionCooldownAnchorReason =
        "request sent (provisional)"

    ZANJI_SHOP_STATE.AuctionCooldownBase =
        provisionalCooldown

    ZANJI_SHOP_STATE.AuctionCooldownAppliedGuard =
        provisionalGuard

    ZANJI_SHOP_STATE.AuctionNextBuyAt =
        sentAt
        + provisionalCooldown
        + provisionalGuard

    ZANJI_SHOP_STATE.AuctionSchedulerState =
        "Pending"

    ZANJI_SHOP_STATE.AuctionUnknownOutcome =
        false

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "CooldownProvisional",
            {
                LotId =
                    lotId,

                SentAt =
                    sentAt,

                ServerCooldown =
                    provisionalCooldown,

                Guard =
                    provisionalGuard,

                CooldownUntil =
                    ZANJI_SHOP_STATE.AuctionNextBuyAt,
            }
        )
    end

    ZANJI_SHOP_STATE.AuctionLastSentLotId =
        lotId

    ZANJI_SHOP_STATE.AuctionLastSentName =
        sentName

    ZANJI_SHOP_STATE.AuctionLastSentAt =
        sentAt

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "PendingSet",
            {
                LotId = lotId,
                Name = sentName,
                Price = price,
                SentAt = sentAt,
            }
        )
    end

    ZANJI_SHOP_STATE.AuctionLastDecision =
        "Purchase sent: "
        .. tostring(finalRow.Name)
        .. " at "
        .. ZanjiAuctionFormatMoney(price)

    return true,
        "packet fired",
        finalRow
end

function ZanjiAuctionAttemptPurchase(reason, automatic)

    ZanjiAuctionEnsureState()

    if automatic == true
    and ZANJI_SHOP_STATE.AutoBuyAuctions ~= true then

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Idle"

        return false
    end

    local now =
        os.clock()

    local pendingLotId =
        ZanjiCleanText(
            ZANJI_SHOP_STATE.AuctionPendingLotId
        )

    local pendingSentAt =
        tonumber(
            ZANJI_SHOP_STATE.AuctionPendingSentAt
        )
        or 0

    local pendingTimeout =
        math.max(
            2,
            ZanjiAuctionReadDebounce()
                + 0.5
        )

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "PurchaseAttempt",
            {
                Reason =
                    tostring(
                        reason
                        or "unknown"
                    ),

                Automatic =
                    automatic == true,

                WorkerRunning =
                    ZANJI_SHOP_STATE.AuctionWorkerRunning
                    == true,

                SchedulerState =
                    ZANJI_SHOP_STATE.AuctionSchedulerState,

                PendingLotId =
                    pendingLotId,

                NextBuyIn =
                    math.max(
                        0,
                        (
                            tonumber(
                                ZANJI_SHOP_STATE.AuctionNextBuyAt
                            )
                            or 0
                        ) - now
                    ),

                Decision =
                    ZANJI_DEV_SUITE_RUNTIME.RecorderActive
                        == true
                    and type(ZanjiDevRecorderAuctionDecisionState)
                        == "function"
                    and ZanjiDevRecorderAuctionDecisionState()
                    or nil,
            }
        )
    end

    if pendingLotId ~= ""
    and pendingSentAt <= 0 then

        ZANJI_SHOP_STATE.AuctionPendingLotId =
            nil

        ZANJI_SHOP_STATE.AuctionPendingPrice =
            nil

        ZANJI_SHOP_STATE.AuctionPendingName =
            nil

        ZANJI_SHOP_STATE.AuctionPendingSentAt =
            0

        pendingLotId =
            ""
    end

    if pendingLotId ~= ""
    and pendingSentAt > 0
    and now - pendingSentAt < pendingTimeout then

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Pending"

        if type(ZanjiDevTrace) == "function" then

            ZanjiDevTrace(
                "Auction",
                "PurchaseBlocked",
                {
                    Reason =
                        "pending result",

                    LotId =
                        pendingLotId,

                    Remaining =
                        math.max(
                            0,
                            pendingTimeout
                            - (
                                now
                                - pendingSentAt
                            )
                        ),
                },
                "Warning"
            )
        end

        ZanjiAuctionSetStatus(
            "Processing purchase..."
        )

        return false
    end

    if pendingLotId ~= ""
    and pendingSentAt > 0
    and now - pendingSentAt >= pendingTimeout then

        local pendingName =
            ZanjiCleanText(
                ZANJI_SHOP_STATE.AuctionPendingName
            )

        if pendingName == "" then

            pendingName =
                ZanjiCleanText(
                    ZANJI_SHOP_STATE.AuctionLastSentName
                )
        end

        if pendingName == "" then

            pendingName =
                "Auction item"
        end

        ZanjiAuctionScheduleCooldown(
            pendingSentAt,
            "result timeout",
            false,
            true
        )

        ZANJI_SHOP_STATE.AuctionLastResultAt =
            now

        ZANJI_SHOP_STATE.AuctionLastResultSuccess =
            false

        ZANJI_SHOP_STATE.AuctionLastResultReason =
            "result timeout"

        ZANJI_SHOP_STATE.AuctionLastResultLotId =
            pendingLotId

        ZANJI_SHOP_STATE.AuctionLastResultName =
            pendingName

        ZANJI_SHOP_STATE.AuctionLastResultLatency =
            math.max(
                0,
                now - pendingSentAt
            )

        if type(ZanjiDevTrace) == "function" then

            ZanjiDevTrace(
                "Auction",
                "PendingExpired",
                {
                    LotId =
                        pendingLotId,

                    Name =
                        pendingName,

                    Age =
                        now - pendingSentAt,

                    Timeout =
                        pendingTimeout,

                    CooldownUntil =
                        ZANJI_SHOP_STATE.AuctionNextBuyAt,
                },
                "Warning"
            )
        end

        ZANJI_SHOP_STATE.AuctionPendingLotId =
            nil

        ZANJI_SHOP_STATE.AuctionPendingPrice =
            nil

        ZANJI_SHOP_STATE.AuctionPendingName =
            nil

        ZANJI_SHOP_STATE.AuctionPendingSentAt =
            0

        ZanjiAuctionSetStatus(
            "Waiting after unknown purchase result"
        )

        return false
    end

    local nextBuyAt =
        tonumber(
            ZANJI_SHOP_STATE.AuctionNextBuyAt
        )
        or 0

    if now < nextBuyAt then

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Cooldown"

        if type(ZanjiDevTrace) == "function" then

            ZanjiDevTrace(
                "Auction",
                "PurchaseBlocked",
                {
                    Reason =
                        "client cooldown",

                    Remaining =
                        nextBuyAt - now,

                    CooldownSource =
                        ZANJI_SHOP_STATE
                            .AuctionCooldownAnchorReason,
                },
                "Warning"
            )
        end

        ZanjiAuctionSetStatus(
            "Cooldown "
            .. tostring(
                math.max(
                    1,
                    math.ceil(
                        nextBuyAt - now
                    )
                )
            )
            .. "s"
        )

        return false
    end

    ZANJI_SHOP_STATE.AuctionSchedulerState =
        "Recheck"

    ZANJI_SHOP_STATE.AuctionUnknownOutcome =
        false

    local nextRetryAt =
        tonumber(
            ZANJI_SHOP_STATE.AuctionNextRetryAt
        )
        or 0

    if now < nextRetryAt then

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Waiting"

        if type(ZanjiDevTrace) == "function" then

            ZanjiDevTrace(
                "Auction",
                "PurchaseBlocked",
                {
                    Reason =
                        "retry delay",

                    Remaining =
                        nextRetryAt - now,
                }
            )
        end

        return false
    end

    local target,
        targetReason =
        ZanjiAuctionFindBuyTarget()

    if type(target) ~= "table" then

        targetReason =
            tostring(
                targetReason
                or "Waiting"
            )

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Waiting"

        ZANJI_SHOP_STATE.AuctionLastDecision =
            targetReason

        ZANJI_SHOP_STATE.AuctionLastBlockReason =
            targetReason

        if type(ZanjiDevTrace) == "function" then

            ZanjiDevTrace(
                "Auction",
                "NoTarget",
                {
                    Reason =
                        targetReason,

                    Decision =
                        ZANJI_DEV_SUITE_RUNTIME.RecorderActive
                            == true
                        and type(ZanjiDevRecorderAuctionDecisionState)
                            == "function"
                        and ZanjiDevRecorderAuctionDecisionState()
                        or nil,
                }
            )
        end

        local lowerReason =
            targetReason:lower()

        local retryDelay =
            1

        if lowerReason:find(
            "stock",
            1,
            true
        )
        or lowerReason:find(
            "updating",
            1,
            true
        ) then

            retryDelay =
                2

        elseif lowerReason:find(
            "bought once",
            1,
            true
        ) then

            retryDelay =
                5
        end

        ZANJI_SHOP_STATE.AuctionNextRetryAt =
            now + retryDelay

        ZanjiAuctionSetStatus(
            targetReason
        )

        return false
    end

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "TargetSelected",
            {
                LotId =
                    target.LotId,

                Name =
                    target.Name,

                Price =
                    target.Price,

                Stock =
                    target.Stock,

                WatchlistIndex =
                    target.WatchlistIndex,

                Decision =
                    ZANJI_DEV_SUITE_RUNTIME.RecorderActive
                        == true
                    and type(ZanjiDevRecorderAuctionDecisionState)
                        == "function"
                    and ZanjiDevRecorderAuctionDecisionState()
                    or nil,
            }
        )
    end

    local ok,
        fireMode,
        finalRow =
        ZanjiAuctionFirePurchase(
            target
        )

    if ok ~= true then

        local blockReason =
            tostring(
                fireMode
                or "Purchase unavailable"
            )

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Recheck"

        ZANJI_SHOP_STATE.AuctionLastBlockReason =
            blockReason

        ZANJI_SHOP_STATE.AuctionLastDecision =
            blockReason

        if type(ZanjiDevTrace) == "function" then

            ZanjiDevTrace(
                "Auction",
                "PurchaseRejectedLocally",
                {
                    Reason =
                        blockReason,

                    LotId =
                        target.LotId,

                    Name =
                        target.Name,
                },
                "Error"
            )
        end

        ZANJI_SHOP_STATE.AuctionNextRetryAt =
            now + 2

        ZanjiAuctionSetStatus(
            blockReason
        )

        return false
    end

    finalRow =
        type(finalRow) == "table"
        and finalRow
        or target

    ZANJI_SHOP_STATE.AuctionLastBlockReason =
        ""

    local watchIndex =
        tonumber(
            finalRow.WatchlistIndex
        )

    if watchIndex ~= nil then

        ZANJI_SHOP_STATE.AuctionRoundRobinIndex =
            watchIndex
    end

    if fireMode == "dry run" then

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Waiting"

        ZANJI_SHOP_STATE.AuctionNextRetryAt =
            now + 1

        ZanjiAuctionSetStatus(
            "Test ready: "
            .. tostring(finalRow.Name)
            .. " at "
            .. tostring(finalRow.PriceText)
        )

        return true
    end

    ZANJI_SHOP_STATE.AuctionSchedulerState =
        "Pending"

    ZANJI_SHOP_STATE.AuctionNextRetryAt =
        0

    ZanjiAuctionSetStatus(
        "Buying "
        .. tostring(finalRow.Name)
        .. " at "
        .. tostring(finalRow.PriceText)
    )

    return true
end

function ZanjiAuctionManualBuyOnce(reason)

    return ZanjiAuctionAttemptPurchase(
        reason or "manual",
        false
    )
end

function ZanjiAuctionRunWorker(reason)

    return ZanjiAuctionAttemptPurchase(
        reason or "automatic",
        true
    )
end

function ZanjiAuctionConnectPacketSignals()

    ZanjiAuctionEnsureState()

    if ZANJI_SHOP_STATE.AuctionSignalsConnected == true then
        return true
    end

    local networking =
        ZanjiShopRequireModule(
            "SharedModules.Networking"
        )

    local auction =
        type(networking) == "table"
        and type(networking.Auctioneer) == "table"
        and networking.Auctioneer
        or nil

    if type(auction) ~= "table" then

        ZanjiAuctionSetStatus(
            "Auction networking missing"
        )

        return false
    end

    local function connectPacket(packetName, callback)

        local packet =
            auction[packetName]

        if type(packet) ~= "table"
        or packet.OnClientEvent == nil then

            return false
        end

        local ok,
            connection =
            pcall(function()

                return packet.OnClientEvent:Connect(
                    callback
                )
            end)

        if ok == true
        and connection ~= nil then

            table.insert(
                ZANJI_SHOP_STATE.AuctionConnections,
                connection
            )

            return true
        end

        return false
    end

    connectPacket(
        "Snapshot",
        function(payload)

            local applied,
                applyReason =
                ZanjiAuctionApplyManifestPayload(
                    payload,
                    "Packet 335"
                )

            if applied == true then

                ZanjiAuctionSetStatus(
                    "Updating auctions..."
                )

            else

                warn(
                    "[ZANJI Auction] Update rejected: "
                    .. tostring(applyReason)
                )

                ZanjiAuctionSetStatus(
                    "Could not update auctions"
                )
            end

            task.defer(function()

                ZanjiAuctionRefreshUI()
            end)
        end
    )

    connectPacket(
        "StockUpdate",
        function(payload)

            ZanjiAuctionEnsureState()

            if type(payload) == "table"
            and type(payload.stock) == "table" then

                local nextStock =
                    {}

                for lotId, stock in pairs(payload.stock) do

                    nextStock[
                        tostring(lotId)
                    ] =
                        math.max(
                            0,
                            math.floor(
                                tonumber(stock)
                                or 0
                            )
                        )
                end

                ZANJI_SHOP_STATE.AuctionStockMap =
                    nextStock

                ZANJI_SHOP_STATE.AuctionLastStockUpdateAt =
                    os.clock()

                if type(ZanjiDevTrace) == "function" then

                    ZanjiDevTrace(
                        "Auction",
                        "StockUpdate",
                        {
                            Stock = nextStock,
                            ServerNow = payload.serverNow,

                            PendingLotId =
                                ZANJI_SHOP_STATE.AuctionPendingLotId,
                        }
                    )
                end

                ZanjiAuctionSetServerClock(
                    payload.serverNow
                )

                ZanjiAuctionCalculateStockCycle()

                local ready =
                    ZanjiAuctionRefreshNetworkReady()

                ZANJI_SHOP_STATE.AuctionNextRetryAt =
                    0

                if ready == true then

                    ZanjiAuctionSetStatus(
                        ZANJI_SHOP_STATE.AuctionDryRun == true
                        and "Test Mode ready"
                        or "Auto Buy ready"
                    )

                else

                    ZanjiAuctionSetStatus(
                        "Updating auctions..."
                    )
                end
            end

            task.defer(function()

                ZanjiAuctionRefreshUI()

                if ZANJI_SHOP_STATE.AutoBuyAuctions == true
                and ZANJI_SHOP_STATE.AuctionNetworkReady == true then

                    ZanjiAuctionQueueWorker(
                        "stock update"
                    )
                end
            end)
        end
    )

    connectPacket(
        "PurchaseResult",
        function(...)

            ZanjiAuctionEnsureState()

            local arguments = {
                ...,
            }

            local lotId =
                ""

            local success =
                false

            local resultReason =
                nil

            if type(arguments[1]) == "table" then

                local payload =
                    arguments[1]

                lotId =
                    ZanjiCleanText(
                        payload.lotId
                        or payload.LotId
                        or payload.id
                    )

                success =
                    payload.success == true
                    or payload.Success == true

                resultReason =
                    payload.reason
                    or payload.Reason
                    or payload.message
                    or payload.Message

            else

                lotId =
                    ZanjiCleanText(
                        arguments[1]
                    )

                success =
                    arguments[2] == true

                resultReason =
                    arguments[3]
            end

            if lotId == "" then

                lotId =
                    tostring(
                        ZANJI_SHOP_STATE.AuctionPendingLotId
                        or ZANJI_SHOP_STATE.AuctionLastSentLotId
                        or ""
                    )
            end

            local pendingName =
                ZanjiCleanText(
                    ZANJI_SHOP_STATE.AuctionPendingName
                )

            if pendingName == "" then

                pendingName =
                    ZanjiCleanText(
                        ZANJI_SHOP_STATE.AuctionLastSentName
                    )
            end

            if pendingName == "" then

                pendingName =
                    "Auction item"
            end

            local pendingSentAt =
                tonumber(
                    ZANJI_SHOP_STATE.AuctionPendingSentAt
                )
                or 0

            if pendingSentAt <= 0 then

                pendingSentAt =
                    tonumber(
                        ZANJI_SHOP_STATE.AuctionLastSentAt
                    )
                    or 0
            end

            local resultAt =
                os.clock()

            if pendingSentAt <= 0 then

                pendingSentAt =
                    resultAt
            end

            local resultLatency =
                math.max(
                    0,
                    resultAt
                        - pendingSentAt
                )

            local reasonText =
                success == true
                and tostring(
                    resultReason
                    or "success"
                )
                or tostring(
                    resultReason
                    or "unknown"
                )

            local lowerReason =
                reasonText:lower()

            local wasSynchronized =
                ZANJI_SHOP_STATE
                    .AuctionCooldownSynchronized
                == true

            ZANJI_SHOP_STATE.AuctionLastResultAt =
                resultAt

            ZANJI_SHOP_STATE.AuctionLastResultSuccess =
                success == true

            ZANJI_SHOP_STATE.AuctionLastResultReason =
                reasonText

            ZANJI_SHOP_STATE.AuctionLastResultLotId =
                lotId

            ZANJI_SHOP_STATE.AuctionLastResultName =
                pendingName

            ZANJI_SHOP_STATE.AuctionLastResultLatency =
                resultLatency

            ZANJI_SHOP_STATE.AuctionUnknownOutcome =
                false

            if type(ZanjiDevTrace) == "function" then

                ZanjiDevTrace(
                    "Auction",
                    "PurchaseResult",
                    {
                        LotId =
                            lotId,

                        Success =
                            success == true,

                        Reason =
                            resultReason,

                        PendingLotId =
                            ZANJI_SHOP_STATE.AuctionPendingLotId,

                        PendingName =
                            pendingName,

                        PendingSentAt =
                            pendingSentAt,

                        ResultReceivedAt =
                            resultAt,

                        ResultLatency =
                            resultLatency,

                        WasSynchronized =
                            wasSynchronized,
                    },
                    success == true
                    and "Info"
                    or "Error"
                )
            end

            if success == true then

                if lotId ~= "" then

                    ZANJI_SHOP_STATE
                        .AuctionAttemptedLots[lotId] =
                        true
                end

                ZanjiAuctionScheduleCooldown(
                    resultAt,
                    "purchase success",
                    true,
                    false
                )

                if ZANJI_SHOP_STATE
                    .AuctionBuyUntilSoldOut == true then

                    ZanjiAuctionSetStatus(
                        "Bought "
                        .. pendingName
                    )

                else

                    ZanjiAuctionSetStatus(
                        "Bought once"
                    )
                end

            else

                if lotId ~= "" then

                    ZANJI_SHOP_STATE
                        .AuctionAttemptedLots[lotId] =
                        nil
                end

                warn(
                    "[ZANJI Auction] Purchase rejected: "
                    .. reasonText
                )

                if lowerReason:find(
                    "cooldown",
                    1,
                    true
                )
                or lowerReason:find(
                    "too fast",
                    1,
                    true
                )
                or lowerReason:find(
                    "debounce",
                    1,
                    true
                ) then

                    if wasSynchronized == true then

                        ZanjiAuctionIncreaseCooldownGuard()
                    end

                    ZanjiAuctionScheduleCooldown(
                        resultAt,
                        "server cooldown rejection",
                        true,
                        false
                    )

                    ZanjiAuctionSetStatus(
                        "Waiting for server cooldown"
                    )

                elseif lowerReason:find(
                    "money",
                    1,
                    true
                )
                or lowerReason:find(
                    "fund",
                    1,
                    true
                )
                or lowerReason:find(
                    "currency",
                    1,
                    true
                )
                or lowerReason:find(
                    "afford",
                    1,
                    true
                ) then

                    ZANJI_SHOP_STATE.AuctionNextBuyAt =
                        0

                    ZANJI_SHOP_STATE.AuctionNextRetryAt =
                        resultAt + 30

                    ZANJI_SHOP_STATE.AuctionSchedulerState =
                        "Waiting"

                    ZanjiAuctionSetStatus(
                        "Not enough money"
                    )

                elseif lowerReason:find(
                    "stock",
                    1,
                    true
                )
                or lowerReason:find(
                    "sold",
                    1,
                    true
                )
                or lowerReason:find(
                    "expired",
                    1,
                    true
                )
                or lowerReason:find(
                    "inactive",
                    1,
                    true
                )
                or lowerReason:find(
                    "unavailable",
                    1,
                    true
                ) then

                    ZANJI_SHOP_STATE.AuctionNextBuyAt =
                        0

                    ZANJI_SHOP_STATE.AuctionNextRetryAt =
                        resultAt + 5

                    ZANJI_SHOP_STATE.AuctionSchedulerState =
                        "Waiting"

                    ZanjiAuctionSetStatus(
                        "Waiting for stock"
                    )

                elseif lowerReason:find(
                    "price",
                    1,
                    true
                )
                or lowerReason:find(
                    "mismatch",
                    1,
                    true
                )
                or lowerReason:find(
                    "changed",
                    1,
                    true
                ) then

                    ZANJI_SHOP_STATE.AuctionNextBuyAt =
                        0

                    ZANJI_SHOP_STATE.AuctionNextRetryAt =
                        resultAt + 1

                    ZANJI_SHOP_STATE.AuctionSchedulerState =
                        "Recheck"

                    ZanjiAuctionSetStatus(
                        "Price changed"
                    )

                else

                    ZANJI_SHOP_STATE.AuctionNextBuyAt =
                        0

                    ZANJI_SHOP_STATE.AuctionNextRetryAt =
                        resultAt + 5

                    ZANJI_SHOP_STATE.AuctionSchedulerState =
                        "Waiting"

                    ZanjiAuctionSetStatus(
                        "Purchase failed"
                    )
                end
            end

            local activePendingLotId =
                tostring(
                    ZANJI_SHOP_STATE.AuctionPendingLotId
                    or ""
                )

            if activePendingLotId == ""
            or lotId == ""
            or activePendingLotId == lotId then

                ZANJI_SHOP_STATE.AuctionPendingLotId =
                    nil

                ZANJI_SHOP_STATE.AuctionPendingPrice =
                    nil

                ZANJI_SHOP_STATE.AuctionPendingName =
                    nil

                ZANJI_SHOP_STATE.AuctionPendingSentAt =
                    0
            end

            task.defer(function()

                ZanjiAuctionRefreshUI()

                if ZANJI_SHOP_STATE.AutoBuyAuctions == true
                and ZANJI_SHOP_STATE.AuctionNetworkReady == true then

                    ZanjiAuctionQueueWorker(
                        "purchase result"
                    )
                end
            end)
        end
    )

    ZANJI_SHOP_STATE.AuctionSignalsConnected =
        true

    return true
end

function ZanjiAuctionStartWatcher()

    ZanjiAuctionEnsureState()

    if ZANJI_SHOP_STATE.AuctionWatcherStarted == true then
        return false
    end

    ZANJI_SHOP_STATE.AuctionWatcherStarted =
        true

    ZanjiAuctionRestoreOffscreen()

    ZanjiAuctionLoadManifestCache()

    ZanjiAuctionPassiveBootstrap(
        true
    )

    ZanjiAuctionConnectPacketSignals()

    ZanjiAuctionRequestSnapshot()

    task.spawn(function()

        while ZANJI_SHOP_STATE.AuctionWatcherStarted == true do

            ZanjiAuctionPassiveBootstrap(
                false
            )

            ZanjiAuctionRefreshUI()

            if ZANJI_SHOP_STATE.AutoBuyAuctions == true
            and ZANJI_SHOP_STATE.AuctionNetworkReady == true then

                ZanjiAuctionQueueWorker(
                    "network watcher"
                )
            end

            task.wait(
                ZANJI_SHOP_STATE.AutoBuyAuctions == true
                and 0.25
                or 0.75
            )
        end
    end)

    task.defer(function()

        ZanjiAuctionRefreshDropdown(
            true
        )

        ZanjiAuctionRefreshUI()

        if ZANJI_SHOP_STATE.AuctionHudEnabled == true then

            ZanjiAuctionHudStart()
        end
    end)

    return true
end


