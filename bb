            "^auction:%d+:(%d+)$"
        )

    return tonumber(raw)
end

function ZanjiAuctionCalculateStockCycle()

    ZanjiAuctionEnsureState()

    local counts =
        {}

    local bestCycle =
        nil

    local bestCount =
        0

    for lotId in pairs(ZANJI_SHOP_STATE.AuctionStockMap or {}) do

        local cycle =
            ZanjiAuctionExtractCycle(
                lotId
            )

        if cycle ~= nil then

            counts[cycle] =
                (
                    counts[cycle]
                    or 0
                )
                + 1

            if counts[cycle] > bestCount
            or (
                counts[cycle] == bestCount
                and (
                    bestCycle == nil
                    or cycle > bestCycle
                )
            ) then

                bestCycle =
                    cycle

                bestCount =
                    counts[cycle]
            end
        end
    end

    ZANJI_SHOP_STATE.AuctionStockCycle =
        bestCycle

    return bestCycle
end

function ZanjiAuctionGetStockCycle()

    ZanjiAuctionEnsureState()

    return ZANJI_SHOP_STATE.AuctionStockCycle
        or ZanjiAuctionCalculateStockCycle()
end

function ZanjiAuctionStockAge()

    ZanjiAuctionEnsureState()

    local at =
        tonumber(
            ZANJI_SHOP_STATE.AuctionLastStockUpdateAt
        )
        or 0

    if at <= 0 then
        return math.huge
    end

    return os.clock() - at
end

function ZanjiAuctionFormatDuration(seconds)

    seconds =
        math.max(
            0,
            math.floor(
                tonumber(seconds)
                or 0
            )
        )

    local hours =
        math.floor(seconds / 3600)

    local minutes =
        math.floor((seconds % 3600) / 60)

    local remaining =
        seconds % 60

    if hours > 0 then

        return tostring(hours)
            .. "h "
            .. tostring(minutes)
            .. "m"
    end

    return tostring(minutes)
        .. "m "
        .. tostring(remaining)
        .. "s"
end

function ZanjiAuctionGetEffectiveRefreshSeconds()

    ZanjiAuctionEnsureState()

    local seconds =
        tonumber(
            ZANJI_SHOP_STATE.AuctionRefreshSeconds
        )
        or 0

    local readAt =
        tonumber(
            ZANJI_SHOP_STATE.AuctionRefreshReadAt
        )
        or 0

    if seconds <= 0
    or readAt <= 0 then

        return seconds
    end

    return math.max(
        0,
        seconds - (os.clock() - readAt)
    )
end

function ZanjiAuctionRefreshHeaderText()

    local seconds =
        ZanjiAuctionGetEffectiveRefreshSeconds()

    if seconds > 0 then

        return "Refresh "
            .. ZanjiAuctionFormatDuration(
                seconds
            )
    end

    local text =
        ZanjiCleanText(
            ZANJI_SHOP_STATE.AuctionRefreshText
            or ""
        )

    if text == ""
    or text == "Refresh in --" then
        return "Refresh --"
    end

    text =
        text:gsub(
            "^Refresh%s+in%s+",
            "Refresh "
        )

    return text
end

function ZanjiAuctionReadHudScale(value)

    local raw =
        tostring(value or "80%")
