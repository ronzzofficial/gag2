function ZanjiAccountStopHeartbeat(reason)

    ZANJI_ACCOUNT_RUNTIME.Active =
        false

    ZANJI_ACCOUNT_RUNTIME.Generation =
        ZANJI_ACCOUNT_RUNTIME.Generation
        + 1

    if reason ~= "unload"
    and reason ~= "replace" then

        ZanjiAccountRefreshUI()
    end
end

function ZanjiAccountSendHeartbeat(notifyUser)

    if ZANJI_ACCOUNT_RUNTIME.HeartbeatBusy == true
    or ZANJI_ACCOUNT_RUNTIME.PairingBusy == true then

        return false
    end

    local token =
        ZANJI_ACCOUNT_RUNTIME.Token

    if ZanjiAccountTokenValid(
        token
    ) ~= true then

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Not connected"

        ZANJI_ACCOUNT_RUNTIME.Message =
            "Generate a pairing code on ZANJI HUB to connect this Roblox account."

        ZanjiAccountRefreshUI()

        return false
    end

    ZANJI_ACCOUNT_RUNTIME.HeartbeatBusy =
        true

    if ZANJI_ACCOUNT_RUNTIME.Status ~= "Online" then

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Checking"

        ZANJI_ACCOUNT_RUNTIME.Message =
            "Authenticating the saved account..."
    end

    ZanjiAccountRefreshUI()

    local statusCode,
        data,
        requestError =
        ZanjiAccountRequest(
            "/api/account/heartbeat",
            "POST",
            {
                roblox_user_id =
                    tostring(
                        LocalPlayer.UserId
                    ),

                roblox_username =
                    LocalPlayer.Name,
            },
            token
        )

    ZANJI_ACCOUNT_RUNTIME.HeartbeatBusy =
        false

    if statusCode == 200
    and type(data) == "table"
    and data.ok == true
    and type(data.account) == "table" then

        ZANJI_ACCOUNT_RUNTIME.Account =
            data.account

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Online"

        local nextIn =
            type(data.heartbeat) == "table"
            and tonumber(
                data.heartbeat.next_in
            )
            or ZANJI_ACCOUNT_HEARTBEAT_INTERVAL

        ZANJI_ACCOUNT_RUNTIME.Interval =
            math.clamp(
                nextIn
                or ZANJI_ACCOUNT_HEARTBEAT_INTERVAL,
                10,
                60
            )

        ZANJI_ACCOUNT_RUNTIME.Message =
            "Automatic heartbeat every "
            .. tostring(
                math.floor(
                    ZANJI_ACCOUNT_RUNTIME.Interval
                    + 0.5
                )
            )
            .. " seconds."

        ZANJI_ACCOUNT_RUNTIME.LastHeartbeat =
            os.time()

        if ZANJI_ACCOUNT_RUNTIME.NeedsMigration == true then

            ZanjiAccountSaveToken(
                token
            )
        end

        ZanjiAccountRefreshUI()

        if ZANJI_ACCOUNT_RUNTIME.MailJobBusy ~= true
        and os.clock()
            >= (
                tonumber(
                    ZANJI_ACCOUNT_RUNTIME
                        .MailJobNextSendClock
                )
                or 0
            )
            + 2 then

            ZanjiAccountQueueMailInventorySync(
                false,
                false
            )
        end

        if notifyUser == true then

            ZanjiNotify(
                "ZANJI Account",
                "Connection verified for "
                .. tostring(
                    data.account.roblox_username
                    or LocalPlayer.Name
                )
                .. ".",
                4
            )
        end

        return true
    end

    local errorCode =
        type(data) == "table"
        and data.error
        or nil

    local message =
        requestError
        or ZanjiAccountFriendlyError(
            errorCode
            or (
                statusCode > 0
                and "request_failed"
                or "service_unreachable"
            )
        )

    if statusCode == 401
    and (
        errorCode == "account_token_required"
        or errorCode == "invalid_account_token"
        or errorCode == "account_token_revoked"
        or errorCode == "account_unlinked"
    ) then

        ZanjiAccountClearInvalidToken()

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Not connected"

        ZANJI_ACCOUNT_RUNTIME.Message =
            message

    elseif statusCode == 403
    and errorCode == "account_identity_mismatch" then

        ZanjiAccountStopHeartbeat(
            "identity mismatch"
        )

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Wrong Roblox account"

        ZANJI_ACCOUNT_RUNTIME.Message =
            "This saved login belongs to another Roblox account. Generate a fresh pairing code for "
            .. LocalPlayer.Name
            .. "."

        message =
            ZANJI_ACCOUNT_RUNTIME.Message

    else

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Connection issue"

        ZANJI_ACCOUNT_RUNTIME.Message =
            message
            .. " Retrying automatically."
    end

    ZanjiAccountRefreshUI()

    if notifyUser == true then

        ZanjiNotify(
            "ZANJI Account",
            message,
            6
        )
    end

    return false
end

function ZanjiAccountStartHeartbeat()

    if ZanjiAccountTokenValid(
        ZANJI_ACCOUNT_RUNTIME.Token
    ) ~= true then

        return false
    end

    if type(
        ZanjiGetRequestFunction()
    ) ~= "function" then

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Unsupported executor"

        ZANJI_ACCOUNT_RUNTIME.Message =
            "This executor does not support HTTP requests."

        ZanjiAccountRefreshUI()

        return false
    end

    ZanjiAccountStopHeartbeat(
        "replace"
    )

    ZANJI_ACCOUNT_RUNTIME.Active =
        true

    local generation =
        ZANJI_ACCOUNT_RUNTIME.Generation

    task.spawn(function()

        while ZANJI_ACCOUNT_RUNTIME.Active == true
        and ZANJI_ACCOUNT_RUNTIME.Generation == generation do

            ZanjiAccountSendHeartbeat(
                false
            )

            local elapsed =
                0

            local interval =
                math.clamp(
                    tonumber(
                        ZANJI_ACCOUNT_RUNTIME.Interval
                    )
                    or ZANJI_ACCOUNT_HEARTBEAT_INTERVAL,
                    10,
                    60
                )

            while elapsed < interval
            and ZANJI_ACCOUNT_RUNTIME.Active == true
            and ZANJI_ACCOUNT_RUNTIME.Generation == generation do

                task.wait(
                    0.5
                )

                elapsed =
                    elapsed
                    + 0.5
            end
        end
    end)

    ZanjiAccountStartMailJobWorker(
        generation
    )

    return true
end

function ZanjiAccountNormalizePairingCode(value)

    local compact =
        tostring(
            value
            or ""
        ):upper():gsub(
            "[^A-Z0-9]",
            ""
        )

    if #compact ~= 8
    or compact:match(
        "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]+$"
    ) == nil then

        return nil
    end

    return compact:sub(1, 4)
        .. "-"
        .. compact:sub(5, 8)
end

function ZanjiAccountRedeemPairingCode(value)

    if ZANJI_ACCOUNT_RUNTIME.PairingBusy == true
    or ZANJI_ACCOUNT_RUNTIME.HeartbeatBusy == true then

        return false
    end

    if value == nil
    and ZANJI_ACCOUNT_RUNTIME.UI.PairingInput then

        value =
            ZANJI_ACCOUNT_RUNTIME.UI
                .PairingInput.Value
    end

    local code =
        ZanjiAccountNormalizePairingCode(
            value
        )

    if not code then

        ZanjiNotify(
            "ZANJI Account",
            "Enter the 8-character code shown on ZANJI HUB.",
            5
        )

        return false
    end

    ZANJI_ACCOUNT_RUNTIME.PairingBusy =
        true

    ZANJI_ACCOUNT_RUNTIME.Status =
        "Connecting"

    ZANJI_ACCOUNT_RUNTIME.Message =
        "Redeeming the one-use pairing code..."

    ZanjiAccountRefreshUI()

    local statusCode,
        data,
        requestError =
        ZanjiAccountRequest(
            "/api/pairing/redeem",
            "POST",
            {
                code =
                    code,

                roblox_user_id =
                    tostring(
                        LocalPlayer.UserId
                    ),

                roblox_username =
                    LocalPlayer.Name,
            }
        )

    ZANJI_ACCOUNT_RUNTIME.PairingBusy =
        false

    if statusCode == 201
    and type(data) == "table"
    and data.ok == true
    and ZanjiAccountTokenValid(
        data.account_token
    ) == true then

        local token =
            ZanjiCleanText(
                data.account_token
            )

        ZANJI_ACCOUNT_RUNTIME.Token =
            token

        ZANJI_ACCOUNT_RUNTIME.Account =
            type(data.account) == "table"
            and data.account
            or nil

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Checking"

        ZANJI_ACCOUNT_ENVIRONMENT.ZANJI_ACCOUNT_TOKEN =
            token

        local saved =
            ZanjiAccountSaveToken(
                token
            )

        ZANJI_ACCOUNT_RUNTIME.Message =
            saved == true
            and "Account linked. Starting automatic heartbeats..."
            or "Account linked for this session, but this executor could not save the login."

        local pairingInput =
            ZANJI_ACCOUNT_RUNTIME.UI.PairingInput

        if pairingInput
        and type(pairingInput.SetValue) == "function" then

            pairingInput:SetValue(
                "",
                true
            )
        end

        ZanjiAccountRefreshUI()

        ZanjiNotify(
            "ZANJI Account",
            saved == true
            and "Roblox account connected and saved."
            or "Roblox account connected for this session.",
            5
        )

        ZanjiAccountStartHeartbeat()

        return true
    end

    local message =
        requestError
        or ZanjiAccountFriendlyError(
            type(data) == "table"
            and data.error
            or "pairing_request_failed"
        )

    ZANJI_ACCOUNT_RUNTIME.Status =
        ZanjiAccountTokenValid(
            ZANJI_ACCOUNT_RUNTIME.Token
        ) == true
        and "Connection paused"
        or "Not connected"

    ZANJI_ACCOUNT_RUNTIME.Message =
        message

    ZanjiAccountRefreshUI()

    ZanjiNotify(
        "ZANJI Account",
        message,
        6
    )

    return false
end

