function ZanjiGuildRunKickAction()

    if ZANJI_GUILD_RUNTIME.Busy.Action == true then
        return
    end

    local selected =
        ZanjiGuildGetSelectedMember()

    local localMember =
        ZanjiGuildGetLocalMember()

    if type(selected) ~= "table"
    or type(localMember) ~= "table"
    or localMember.Role ~= "Owner"
    or selected.UserId
        == LocalPlayer.UserId
    or selected.Role == "Owner" then

        ZanjiGuildCancelKickConfirmation(
            true
        )

        ZanjiNotify(
            "ZANJI Guild",
            "This member cannot be kicked by the current account.",
            4
        )

        return
    end

    local userId =
        tonumber(
            selected.UserId
        )

    local username =
        tostring(
            selected.Username
        )

    local confirmationReady =
        ZANJI_GUILD_RUNTIME.KickConfirmUserId
            == userId
        and ZANJI_GUILD_RUNTIME.KickConfirmUsername
            == username
        and os.clock()
            <= (
                tonumber(
                    ZANJI_GUILD_RUNTIME.KickConfirmExpiresAt
                )
                or 0
            )

    if confirmationReady ~= true then

        local confirmationExpiresAt =
            os.clock()
            + 5

        local confirmationMessage =
            "Press Confirm Kick within 5 seconds to kick @"
            .. username
            .. "."

        ZANJI_GUILD_RUNTIME.KickConfirmUserId =
            userId

        ZANJI_GUILD_RUNTIME.KickConfirmUsername =
            username

        ZANJI_GUILD_RUNTIME.KickConfirmExpiresAt =
            confirmationExpiresAt

        ZanjiGuildSetStatus(
            confirmationMessage
        )

        ZanjiNotify(
            "ZANJI Guild",
            confirmationMessage,
            5
        )

        task.delay(
            5.1,
            function()

                if ZANJI_GUILD_RUNTIME.KickConfirmUserId
                    == userId
                and ZANJI_GUILD_RUNTIME.KickConfirmUsername
                    == username
                and ZANJI_GUILD_RUNTIME.KickConfirmExpiresAt
                    == confirmationExpiresAt
                and os.clock()
                    >= confirmationExpiresAt then

                    ZanjiGuildCancelKickConfirmation(
                        false
                    )

                    if ZANJI_GUILD_STATE.Status
                        == confirmationMessage then

                        ZanjiGuildSetStatus(
                            "Kick confirmation expired."
                        )

                    else

                        ZanjiGuildRefreshRoleAction()
                    end
                end
            end
        )

        return
    end

    ZanjiGuildCancelKickConfirmation(
        false
    )

    ZANJI_GUILD_RUNTIME.Busy.Action =
        true

    ZanjiGuildSetStatus(
        "Kicking @"
        .. username
        .. "..."
    )

    task.spawn(function()

        local ok,
            first,
            second =
            ZanjiGuildCall(
                "Kick",
                userId
            )

        local accepted =
            ok == true
            and ZanjiGuildResultAccepted(
                first,
                second
            )

        local confirmed =
            false

        if accepted == true then

            for _ = 1, 10 do

                task.wait(
                    0.35
                )

                local snapshotRefreshed =
                    ZanjiGuildRefreshSnapshot(
                        true
                    )

                if snapshotRefreshed == true
                and ZanjiGuildGetMember(
                    userId
                ) == nil then

                    confirmed =
                        true

                    break
                end
            end
        end

        if confirmed == true then

            ZANJI_GUILD_STATE.SelectedMemberUserId =
                nil

            ZANJI_GUILD_STATE.OnlineMembers[
                userId
            ] =
                nil

            ZanjiGuildRefreshUI()

            ZanjiGuildRefreshPresence(
                true
            )

            ZanjiGuildRefreshLeaderboard(
                true
            )
        end

        ZANJI_GUILD_RUNTIME.Busy.Action =
            false

        local message =
            confirmed
            and (
                "@"
                .. username
                .. " was kicked from the guild."
            )
            or (
                accepted
                and "Kick request was sent, but removal has not been confirmed yet."
                or ZanjiGuildResultMessage(
                    first,
                    second,
                    "Kick request was rejected"
                )
            )

        ZanjiGuildSetStatus(
            message
        )

        ZanjiNotify(
            "ZANJI Guild",
            message,
            confirmed
            and 3
            or 5
        )
    end)
end

function ZanjiGuildRunRoleAction()

    if ZANJI_GUILD_RUNTIME.Busy.Action == true then
        return
    end

    ZanjiGuildCancelKickConfirmation(
        false
    )

    local selected =
        ZanjiGuildGetSelectedMember()

    local localMember =
        ZanjiGuildGetLocalMember()

    if type(selected) ~= "table"
    or type(localMember) ~= "table"
    or localMember.Role ~= "Owner"
    or selected.UserId == LocalPlayer.UserId
    or (
        selected.Role ~= "Member"
        and selected.Role ~= "Elder"
    ) then

        ZanjiNotify(
            "ZANJI Guild",
            "This member cannot be promoted or demoted by the current account.",
            4
        )

        return
    end

    local packetName =
        selected.Role == "Member"
        and "Promote"
        or "Demote"

    local expectedRole =
        selected.Role == "Member"
        and "Elder"
        or "Member"

    local userId =
        selected.UserId

    local username =
        selected.Username

    ZANJI_GUILD_RUNTIME.Busy.Action =
        true

    ZanjiGuildSetStatus(
        packetName
        .. " request for @"
        .. username
        .. "..."
    )

    task.spawn(function()

        local ok,
            first,
            second =
            ZanjiGuildCall(
                packetName,
                userId
            )

        local accepted =
            ok == true
            and ZanjiGuildResultAccepted(
                first,
                second
            )

        local confirmed =
            false

        if accepted == true then

            for _ = 1, 10 do

                task.wait(
                    0.35
                )

                ZanjiGuildRefreshSnapshot(
                    true
                )

                local refreshed =
                    ZanjiGuildGetMember(
                        userId
                    )

                if refreshed
                and refreshed.Role == expectedRole then

                    confirmed =
                        true

                    break
                end
            end
        end

        ZANJI_GUILD_RUNTIME.Busy.Action =
            false

        local message =
            confirmed
            and (
                "@"
                .. username
                .. " is now "
                .. expectedRole
                .. "."
            )
            or (
                accepted
                and (
                    packetName
                    .. " was sent, but the returned role did not change."
                )
                or ZanjiGuildResultMessage(
                    first,
                    second,
                    packetName
                    .. " was rejected"
                )
            )

        ZanjiGuildSetStatus(
            message
        )

        ZanjiNotify(
            "ZANJI Guild",
            message,
            confirmed
            and 3
            or 5
        )
    end)
end

function ZanjiGuildStart()

    ZANJI_GUILD_RUNTIME.Token =
        ZANJI_GUILD_RUNTIME.Token
        + 1

    local token =
        ZANJI_GUILD_RUNTIME.Token

    ZANJI_GUILD_RUNTIME.Running =
        true

    for _, connection in pairs(
        ZANJI_GUILD_RUNTIME.Connections
        or {}
    ) do

        pcall(function()

            connection:Disconnect()
        end)
    end

    ZANJI_GUILD_RUNTIME.Connections =
        {}

    local networking =
        ZanjiGuildGetNetworking()

