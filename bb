function ZanjiSniperResolvePetKey(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == "any"
    or lower == "all"
    or lower == "any pet"
    or lower == "all pets"
    or lower == "*" then

        return "*"
    end

    if text == "" then
        return "Raccoon"
    end

    ZanjiSniperGetPetValues()

    local displayToKey =
        type(ZANJI_SNIPER_STATE.PetDisplayToKey) == "table"
        and ZANJI_SNIPER_STATE.PetDisplayToKey
        or {}

    local keyToDisplay =
        type(ZANJI_SNIPER_STATE.PetKeyToDisplay) == "table"
        and ZANJI_SNIPER_STATE.PetKeyToDisplay
        or {}

    if displayToKey[text] then
        return displayToKey[text]
    end

    if keyToDisplay[text] then
        return text
    end

    local wantedAlias =
        ZanjiSniperPetAliasKey(
            text
        )

    for internalKey, displayName in pairs(keyToDisplay) do

        if ZanjiSniperPetAliasKey(internalKey) == wantedAlias
        or ZanjiSniperPetAliasKey(displayName) == wantedAlias then

            return internalKey
        end
    end

    return text
end

function ZanjiSniperResolvePetDisplay(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == "any"
    or lower == "all"
    or lower == "any pet"
    or lower == "all pets"
    or lower == "*" then

        return "Any Pet"
    end

    if text == "" then
        return ZanjiSniperGetDefaultPetName()
    end

    ZanjiSniperGetPetValues()

    local displayToKey =
        type(ZANJI_SNIPER_STATE.PetDisplayToKey) == "table"
        and ZANJI_SNIPER_STATE.PetDisplayToKey
        or {}

    local keyToDisplay =
        type(ZANJI_SNIPER_STATE.PetKeyToDisplay) == "table"
        and ZANJI_SNIPER_STATE.PetKeyToDisplay
        or {}

    if displayToKey[text] then
        return text
    end

    if keyToDisplay[text] then
        return keyToDisplay[text]
    end

    local wantedAlias =
        ZanjiSniperPetAliasKey(
            text
        )

    for internalKey, displayName in pairs(keyToDisplay) do

        if ZanjiSniperPetAliasKey(internalKey) == wantedAlias
        or ZanjiSniperPetAliasKey(displayName) == wantedAlias then

            return displayName
        end
    end

    return text
end

function ZanjiSniperNormalizeFilter(row)

    row =
        type(row) == "table"
        and row
        or {}

    local rawPet =
        row.Pet
        or row.PetName
        or row.Name
        or ZanjiSniperGetDefaultPetName()

    local petName =
        ZanjiSniperResolvePetDisplay(
            rawPet
        )

    if petName == "" then

        petName =
            ZanjiSniperGetDefaultPetName()
    end

    local maxPrice =
        ZanjiSniperReadMaxPrice(
            row.MaxPrice
            or row.Max
            or row.PriceLimit
            or row.BuilderMaxPrice
            or 0
        )

    return {
        Pet =
            petName,

        PetKey =
            ZanjiSniperResolvePetKey(
                petName
            ),

        Sizes =
            ZanjiSniperNormalizeSizeSelection(
                row.Sizes
                or row.Size
                or {
                    "Any",
                }
            ),

        Variants =
            ZanjiSniperNormalizeVariantSelection(
                row.Variants
                or row.Variant
                or {
                    "Any",
                }
            ),

        MaxPrice =
            maxPrice,

        Amount =
            999,

        Priority =
            ZanjiSniperNormalizePriority(
                row.Priority
                or "Medium"
            ),

        Enabled =
            row.Enabled ~= false,
    }
end

