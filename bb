function ZanjiSniperSaveFilterFromBuilder()

    local filter =
        ZanjiSniperNormalizeFilter({
            Pet =
                ZANJI_SNIPER_STATE.BuilderPet,

            Sizes =
                ZANJI_SNIPER_STATE.BuilderSizes,

            Variants =
                ZANJI_SNIPER_STATE.BuilderVariants,

            MaxPrice =
                ZANJI_SNIPER_STATE.BuilderMaxPrice,

            Amount =
                999,

            Priority =
                ZANJI_SNIPER_STATE.BuilderPriority,

            Enabled =
                true,
        })

    ZANJI_SNIPER_STATE.Watchlist =
        type(ZANJI_SNIPER_STATE.Watchlist) == "table"
        and ZANJI_SNIPER_STATE.Watchlist
        or {}

    local newKey =
        ZanjiSniperFilterKey(
            filter
        )

    local replaced =
        false

    for index, row in ipairs(ZANJI_SNIPER_STATE.Watchlist) do

        if ZanjiSniperFilterKey(row) == newKey then

            ZANJI_SNIPER_STATE.Watchlist[index] =
                filter

            replaced =
                true

            break
        end
    end

    if replaced ~= true then

        table.insert(
            ZANJI_SNIPER_STATE.Watchlist,
            filter
        )
    end

    ZANJI_SNIPER_STATE.WatchlistPage =
        1

    ZanjiSaveSniperSettings()

    ZanjiSniperRefreshUI()

    if type(ZanjiNotify) == "function" then

        ZanjiNotify(
            "ZANJI Sniper",
            (
                replaced == true
                and "Updated filter: "
                or "Saved filter: "
            )
            .. tostring(filter.Pet),
            3
        )
    end
end

