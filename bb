function ZanjiFarmQueueFruit(plant, fruit, reason)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if typeof(plant) ~= "Instance"
    or typeof(fruit) ~= "Instance"
    or fruit.Parent == nil then

        return false
    end

    if ZanjiFarmFruitReady(fruit) ~= true then
        return false
    end

    local plantName =
        ZanjiFarmReadPlantName(
            plant,
            fruit
        )

    if type(ZanjiEclipseCollectionOwnsPlantName) == "function"
    and ZanjiEclipseCollectionOwnsPlantName(
        plantName
    ) == true then

        return false
    end

    local plantId =
        ZanjiFarmReadPlantId(
            plant
        )

    local fruitId =
        ZanjiFarmReadFruitId(
            plant,
            fruit
        )

    local key =
        ZanjiFarmBuildFruitKey(
            plantId,
            fruitId
        )

    if key == "" then
        return false
    end

    local entry = {
        Key =
            key,

        Kind =
            "FruitHarvest",

        Plant =
            plant,

        Fruit =
            fruit,

        PlantName =
            plantName,

        PlantId =
            plantId,

        FruitId =
            fruitId,

        QueuedAt =
            os.clock(),

        Reason =
            tostring(reason or "ready"),
    }

    if ZanjiFarmCollectionAllowsEntry(
        entry
    ) ~= true then

        return false
    end

    if runtime.Pending[key] ~= nil
    or runtime.ReadyMap[key] == true then

        return false
    end

    runtime.ReadyMap[key] =
        true

    table.insert(
        runtime.ReadyQueue,
        entry
    )

    return true
end

function ZanjiFarmQueuePlantHarvest(plant, reason)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if typeof(plant) ~= "Instance"
    or plant.Parent == nil then

        return false
    end

    if ZanjiFarmPlantLevelHarvestReady(
        plant
    ) ~= true then

        return false
    end

    local plantName =
        ZanjiFarmReadPlantName(
            plant,
            nil
        )

    if type(ZanjiEclipseCollectionOwnsPlantName) == "function"
    and ZanjiEclipseCollectionOwnsPlantName(
        plantName
    ) == true then

        return false
    end

    local plantId =
        ZanjiFarmReadPlantId(
            plant
        )

    local key =
        ZanjiFarmBuildPlantHarvestKey(
            plantId
        )

    if key == "" then
        return false
    end

    local entry = {
        Key =
            key,

        Kind =
            "PlantHarvest",

        Plant =
            plant,

        Fruit =
            plant,

        PlantName =
            plantName,

        PlantId =
            plantId,

        FruitId =
            "",

        QueuedAt =
            os.clock(),

        Reason =
            tostring(reason or "plant ready"),
    }

    if ZanjiFarmCollectionAllowsEntry(
        entry
    ) ~= true then

        return false
    end

    if runtime.Pending[key] ~= nil
    or runtime.ReadyMap[key] == true then

        return false
    end

    runtime.ReadyMap[key] =
        true

    table.insert(
        runtime.ReadyQueue,
        entry
    )

    return true
end

function ZanjiFarmRetryEntry(entry, reason)

    if type(entry) ~= "table" then
        return false
    end

    if entry.Kind == "PlantHarvest" then

        return ZanjiFarmQueuePlantHarvest(
            entry.Plant,
            reason or "retry plant"
        )
    end

    return ZanjiFarmQueueFruit(
        entry.Plant,
        entry.Fruit,
        reason or "retry fruit"
    )
end

function ZanjiFarmUnwatchFruit(fruit)

    local runtime =
        ZanjiFarmEnsureRuntime()

    local connections =
        runtime.FruitConnections[fruit]

    ZanjiFarmDisconnectConnectionList(
        connections
    )

    runtime.FruitConnections[fruit] =
        nil

    runtime.WatchedFruits[fruit] =
        nil

    return true
end

function ZanjiFarmWatchFruit(plant, fruit)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if typeof(plant) ~= "Instance"
    or typeof(fruit) ~= "Instance" then

        return false
    end

    if runtime.WatchedFruits[fruit] == true then

        ZanjiFarmQueueFruit(
            plant,
            fruit,
            "refresh"
        )

        return true
    end

    runtime.WatchedFruits[fruit] =
        true

    runtime.FruitConnections[fruit] =
        {}

    local function refreshFruit()

        task.defer(function()

            if ZANJI_FARM_STATE.AutoCollectFruits == true then

                ZanjiFarmQueueFruit(
                    plant,
                    fruit,
                    "changed"
                )
            end
        end)
    end

    for _, attributeName in ipairs({
        "Age",
        "MaxAge",
        "Mutation",
        "Mutations",
        "SizeMulti",
        "SizeMultiplier",
        "ScaleMultiplier",
        "ScaleMulti",
        "Scale",
        "SizeScale",
    }) do

        local ok,
            signal =
            pcall(function()

                return fruit:GetAttributeChangedSignal(
                    attributeName
                )
            end)

        if ok == true
        and signal then

            table.insert(
                runtime.FruitConnections[fruit],
                signal:Connect(
                    refreshFruit
                )
            )
        end
    end

    table.insert(
        runtime.FruitConnections[fruit],
        fruit.AncestryChanged:Connect(function(_, parent)

            if parent == nil then

                local plantId =
                    ZanjiFarmReadPlantId(
                        plant
                    )

                local fruitId =
                    ZanjiFarmReadFruitId(
                        plant,
                        fruit
                    )

                local key =
                    ZanjiFarmBuildFruitKey(
                        plantId,
                        fruitId
                    )

                if key ~= "" then

                    runtime.ReadyMap[key] =
                        nil

                    runtime.Pending[key] =
                        nil
                end

                ZanjiFarmUnwatchFruit(
                    fruit
                )
            end
        end)
    )

    ZanjiFarmQueueFruit(
        plant,
        fruit,
        "initial"
    )

    return true
end

function ZanjiFarmUnwatchPlant(plant)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if typeof(plant) == "Instance" then

        local plantId =
            ZanjiFarmReadPlantId(
                plant
            )

        local plantKey =
            ZanjiFarmBuildPlantHarvestKey(
                plantId
            )

        if plantKey ~= "" then

            runtime.ReadyMap[plantKey] =
                nil

            runtime.Pending[plantKey] =
                nil
        end
    end

    ZanjiFarmDisconnectConnectionList(
        runtime.PlantConnections[plant]
    )

    runtime.PlantConnections[plant] =
        nil

    runtime.WatchedPlants[plant] =
        nil

    return true
end

function ZanjiFarmWatchPlant(plant)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if typeof(plant) ~= "Instance" then
        return false
    end

    if runtime.WatchedPlants[plant] == true then

        ZanjiFarmQueuePlantHarvest(
            plant,
            "plant refresh"
        )

        return true
    end

    runtime.WatchedPlants[plant] =
        true

    runtime.PlantConnections[plant] =
        {}

    local plantPromptConnected =
        false

    local function refreshPlantHarvest()

        task.defer(function()

            if ZANJI_FARM_STATE.AutoCollectFruits == true then

                ZanjiFarmQueuePlantHarvest(
                    plant,
                    "plant changed"
                )
            end
        end)
    end

    local function connectPlantHarvestPrompt()

        if plantPromptConnected == true then
            return false
        end

        local prompt =
            ZanjiFarmFindPlantHarvestPrompt(
                plant
            )

        if typeof(prompt) ~= "Instance"
        or prompt:IsA("ProximityPrompt") ~= true then

            return false
        end

        plantPromptConnected =
            true

        table.insert(
            runtime.PlantConnections[plant],
            prompt:GetPropertyChangedSignal("Enabled"):Connect(
                refreshPlantHarvest
            )
        )

        return true
    end

    for _, attributeName in ipairs({
        "Age",
        "MaxAge",
        "Mutation",
        "Mutations",
        "PlantGrowthReady",
        "Ready",
        "IsReady",
        "Harvestable",
        "CanHarvest",
        "Grown",
        "FullyGrown",
        "Ripe",
        "SizeMulti",
        "SizeMultiplier",
        "ScaleMultiplier",
        "ScaleMulti",
        "Scale",
        "SizeScale",
    }) do

        local ok,
            signal =
            pcall(function()

                return plant:GetAttributeChangedSignal(
                    attributeName
                )
            end)

        if ok == true
        and signal then

            table.insert(
                runtime.PlantConnections[plant],
                signal:Connect(
                    refreshPlantHarvest
                )
            )
        end
    end

    local function attachFruitsFolder(fruitsFolder)

        if typeof(fruitsFolder) ~= "Instance" then
            return false
        end

        for _, fruit in ipairs(fruitsFolder:GetChildren()) do

            ZanjiFarmWatchFruit(
                plant,
                fruit
            )
        end

        table.insert(
            runtime.PlantConnections[plant],
            fruitsFolder.ChildAdded:Connect(function(fruit)

                task.defer(function()

                    ZanjiFarmWatchFruit(
                        plant,
                        fruit
                    )
                end)
            end)
        )

        table.insert(
            runtime.PlantConnections[plant],
            fruitsFolder.ChildRemoved:Connect(function(fruit)

                local plantId =
                    ZanjiFarmReadPlantId(
                        plant
                    )

                local fruitId =
                    ZanjiFarmReadFruitId(
                        plant,
                        fruit
                    )

                local key =
                    ZanjiFarmBuildFruitKey(
                        plantId,
                        fruitId
                    )

                if key ~= "" then

                    runtime.ReadyMap[key] =
                        nil

                    runtime.Pending[key] =
                        nil
                end

                ZanjiFarmUnwatchFruit(
                    fruit
                )
            end)
        )

        return true
    end

    attachFruitsFolder(
        plant:FindFirstChild(
            "Fruits"
        )
    )

    connectPlantHarvestPrompt()

    ZanjiFarmQueuePlantHarvest(
        plant,
        "initial plant"
    )

    table.insert(
        runtime.PlantConnections[plant],
        plant.ChildAdded:Connect(function(child)

            if child.Name == "Fruits" then

                task.defer(function()

                    attachFruitsFolder(
                        child
                    )
                end)

            elseif child.Name == "HarvestPart" then

                task.defer(function()

                    connectPlantHarvestPrompt()

                    refreshPlantHarvest()
                end)
            end
        end)
    )

    table.insert(
        runtime.PlantConnections[plant],
        plant.AncestryChanged:Connect(function(_, parent)

            if parent == nil then

                ZanjiFarmUnwatchPlant(
                    plant
                )
            end
        end)
    )

    return true
end

function ZanjiFarmInstallIndexer(forceRefresh)

    local runtime =
        ZanjiFarmEnsureRuntime()

    local plot =
        ZanjiFarmResolveOwnPlot(
            forceRefresh == true
        )

    if typeof(plot) ~= "Instance" then
        return false, "own plot missing"
    end

    local plantsFolder =
        plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) ~= "Instance" then
        return false, "plants folder missing"
    end

    if forceRefresh ~= true
    and runtime.PlantsFolder == plantsFolder
    and runtime.IndexerInstalled == true then

        return true, "cached"
    end

    ZanjiFarmDisconnectConnectionMap(
        runtime.Connections
    )

    ZanjiFarmDisconnectConnectionMap(
        runtime.PlantConnections
    )

    ZanjiFarmDisconnectConnectionMap(
        runtime.FruitConnections
    )

    runtime.Connections =
        {}

    runtime.PlantConnections =
        {}

    runtime.FruitConnections =
        {}

    runtime.WatchedPlants =
        {}

    runtime.WatchedFruits =
        {}

    runtime.ReadyQueue =
        {}

    runtime.ReadyMap =
        {}

    runtime.Pending =
        {}

    runtime.OwnPlot =
        plot

    runtime.PlantsFolder =
        plantsFolder

    runtime.IndexerInstalled =
        true

    for _, plant in ipairs(plantsFolder:GetChildren()) do

        ZanjiFarmWatchPlant(
            plant
        )
    end

    table.insert(
        runtime.Connections,
        plantsFolder.ChildAdded:Connect(function(plant)

            task.defer(function()

                ZanjiFarmWatchPlant(
                    plant
                )
            end)
        end)
    )

    table.insert(
        runtime.Connections,
        plantsFolder.ChildRemoved:Connect(function(plant)

            ZanjiFarmUnwatchPlant(
                plant
            )
        end)
    )

    return true, "ok"
end

function ZanjiFarmRebuildReadyQueue(reason)

    local runtime =
        ZanjiFarmEnsureRuntime()

    runtime.ReadyQueue =
        {}

    runtime.ReadyMap =
        {}

    runtime.Pending =
        {}

    if typeof(runtime.PlantsFolder) ~= "Instance"
    or runtime.PlantsFolder.Parent == nil then

        return false
    end

    for _, plant in ipairs(runtime.PlantsFolder:GetChildren()) do

        ZanjiFarmWatchPlant(
            plant
        )

        local fruitsFolder =
            plant:FindFirstChild(
                "Fruits"
            )

        if typeof(fruitsFolder) == "Instance" then

            for _, fruit in ipairs(fruitsFolder:GetChildren()) do

                ZanjiFarmQueueFruit(
                    plant,
                    fruit,
                    reason or "rebuild"
                )
            end

        else

            ZanjiFarmQueuePlantHarvest(
                plant,
                reason or "rebuild plant"
            )
        end
    end

    return true
end

function ZanjiFarmCollectEntry(entry)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if type(entry) ~= "table" then
        return false
    end

    if type(ZanjiEclipseCollectionOwnsPlantName) == "function"
    and ZanjiEclipseCollectionOwnsPlantName(
        entry.PlantName
    ) == true then

        return false
    end

    if typeof(entry.Plant) ~= "Instance"
    or entry.Plant.Parent == nil then

        return false
    end

    local key =
        ""

    if entry.Kind == "PlantHarvest" then

        if ZanjiFarmPlantLevelHarvestReady(
            entry.Plant
        ) ~= true then

            return false
        end

        key =
            ZanjiFarmBuildPlantHarvestKey(
                entry.PlantId
            )

    else

        if typeof(entry.Fruit) ~= "Instance"
        or entry.Fruit.Parent == nil then

            return false
        end

        if ZanjiFarmFruitReady(
            entry.Fruit
        ) ~= true then

            return false
        end

        key =
            ZanjiFarmBuildFruitKey(
                entry.PlantId,
                entry.FruitId
            )
    end

    if ZanjiFarmCollectionAllowsEntry(
        entry
    ) ~= true then

        return false
    end

    if key == "" then
        return false
    end

    entry.Key =
        key

    if runtime.Pending[key] ~= nil then
        return false
    end

    local packet,
        packetReason =
        ZanjiFarmResolveCollectFruitPacket(
            false
        )

    if type(packet) ~= "table" then

        local now =
            os.clock()

        if now - (
            tonumber(runtime.LastPacketWarnAt)
            or 0
        ) > 5 then

            runtime.LastPacketWarnAt =
                now

            if type(ZanjiNotify) == "function" then

                ZanjiNotify(
                    "ZANJI Farm",
                    tostring(packetReason or "CollectFruit packet missing."),
                    4
                )
            end
        end

        return false
    end

    runtime.Pending[key] = {
        At =
            os.clock(),

        Entry =
            entry,
    }

    local ok,
        result =
        pcall(function()

            if entry.Kind == "PlantHarvest" then

                return packet:Fire(
                    entry.PlantId,
                    ""
                )
            end

            return packet:Fire(
                entry.PlantId,
                entry.FruitId
            )
        end)

    if ok ~= true then

        runtime.Pending[key] =
            nil

        task.delay(0.35, function()

            if ZANJI_FARM_STATE.AutoCollectFruits == true then

                ZanjiFarmRetryEntry(
                    entry,
                    "retry"
                )
            end
        end)

        return false,
            tostring(result)
    end

    return true
end

function ZanjiFarmPrunePending()

    local runtime =
        ZanjiFarmEnsureRuntime()

    local now =
        os.clock()

    for key, row in pairs(runtime.Pending) do

        local entry =
            type(row) == "table"
            and row.Entry
            or nil

        local at =
            type(row) == "table"
            and tonumber(row.At)
            or 0

        local missing =
            false

        if type(entry) ~= "table" then

            missing =
                true

        elseif entry.Kind == "PlantHarvest" then

            missing =
                typeof(entry.Plant) ~= "Instance"
                or entry.Plant.Parent == nil

        else

            missing =
                typeof(entry.Fruit) ~= "Instance"
                or entry.Fruit.Parent == nil
        end

        if missing == true then

            runtime.Pending[key] =
                nil

            runtime.ReadyMap[key] =
                nil

        elseif now - at >= 3 then

            runtime.Pending[key] =
                nil

            ZanjiFarmRetryEntry(
                entry,
                "pending retry"
            )
        end
    end
end

function ZanjiFarmAutoCollectBlocked()

    if type(ZANJI_DEFENSE_RUNTIME) == "table"
    and ZANJI_DEFENSE_RUNTIME.Active == true then

        return true
    end

    local sniper =
        type(ZANJI_SNIPER_RUNTIME) == "table"
        and ZANJI_SNIPER_RUNTIME
        or {}

    if sniper.Buying == true
    or sniper.Returning == true
    or sniper.AutoHopInProgress == true
    or sniper.CurrentTarget ~= nil
    or ZanjiCleanText(sniper.CurrentTargetKey) ~= "" then

        return true
    end

    return false
end

function ZanjiFarmRunAutoCollectWorker(token)

    local runtime =
        ZanjiFarmEnsureRuntime()

    runtime.Running =
        true

    runtime.LastIndexerCheckAt =
        0

    while runtime.Token == token
    and ZANJI_FARM_STATE.AutoCollectFruits == true do

        if ZanjiFarmAutoCollectBlocked() == true then

            task.wait(
                0.20
            )

            continue
        end

        local now =
            os.clock()

        if ZanjiFarmIndexerReady() ~= true
        or now - (
            tonumber(runtime.LastIndexerCheckAt)
            or 0
        ) >= 5 then

            runtime.LastIndexerCheckAt =
                now

            local installed =
                ZanjiFarmInstallIndexer(
                    false
                )

            if installed ~= true then

                if now - (
                    tonumber(runtime.LastPlotWarnAt)
                    or 0
                ) > 8 then

                    runtime.LastPlotWarnAt =
                        now

                    print(
                        "[ZANJI FARM]",
                        "Waiting for own plot / Plants folder."
                    )
                end

                task.wait(
                    0.75
                )

                continue
            end
        end

        ZanjiFarmPrunePending()

        local entry =
            table.remove(
                runtime.ReadyQueue,
                1
            )

        if type(entry) == "table" then

            runtime.ReadyMap[entry.Key] =
                nil

            ZanjiFarmCollectEntry(
                entry
            )

            task.wait(
                0.045
            )

        else

            task.wait(
                0.20
            )
        end
    end

    if runtime.Token == token then

        runtime.Running =
            false
    end
end

function ZanjiFarmStartAutoCollect(reason)

    ZanjiFarmEnsureState()

    if ZANJI_FARM_STATE.AutoCollectFruits ~= true then
        return false
    end

    local runtime =
        ZanjiFarmEnsureRuntime()

    if runtime.Running == true then
        return false
    end

    ZanjiFarmPrimeStaticCaches(
        false
    )

    runtime.Token =
        {}

    local token =
        runtime.Token

    local installed =
        ZanjiFarmInstallIndexer(
            false
        )

    if installed == true then

        ZanjiFarmRebuildReadyQueue(
            reason or "start"
        )
    end

    task.spawn(function()

        ZanjiFarmRunAutoCollectWorker(
            token
        )
    end)

    return true
end

function ZanjiFarmStopAutoCollect(reason)

    local runtime =
        ZanjiFarmEnsureRuntime()

    runtime.Token =
        nil

    runtime.Running =
        false

    ZanjiFarmDisconnectIndexer()

    return true
end

function ZanjiProFarmEnsureRuntime()

    ZANJI_PRO_FARM_RUNTIME =
        type(ZANJI_PRO_FARM_RUNTIME) == "table"
        and ZANJI_PRO_FARM_RUNTIME
        or {}

    local runtime =
        ZANJI_PRO_FARM_RUNTIME

    runtime.Connections =
        type(runtime.Connections) == "table"
        and runtime.Connections
        or {}

    runtime.VisualConnections =
        type(runtime.VisualConnections) == "table"
        and runtime.VisualConnections
        or {}

    runtime.Cache =
        type(runtime.Cache) == "table"
        and runtime.Cache
        or {
            Plants = {},
        }

    runtime.Cache.Plants =
        type(runtime.Cache.Plants) == "table"
        and runtime.Cache.Plants
        or {}

    runtime.Cooldowns =
        type(runtime.Cooldowns) == "table"
        and runtime.Cooldowns
        or {}

    runtime.Pending =
        type(runtime.Pending) == "table"
        and runtime.Pending
        or {}

    runtime.NextSendAt =
        tonumber(runtime.NextSendAt)
        or 0

    runtime.MaxPending =
        math.clamp(
            math.floor(
                tonumber(runtime.MaxPending)
                or 10
            ),
            1,
            25
        )

    runtime.ConfirmationTimeout =
        math.clamp(
            tonumber(runtime.ConfirmationTimeout)
            or 2.5,
            0.5,
            10
        )

    runtime.RetryDelay =
        math.clamp(
            tonumber(runtime.RetryDelay)
            or 0.75,
            0,
            5
        )

    runtime.Status =
        tostring(
            runtime.Status
            or "Disabled"
        )

    return runtime
end

function ZanjiProFarmDisconnectList(list)

    if type(list) ~= "table" then
        return
    end

    for _, connection in pairs(list) do

        if connection
        and type(connection.Disconnect) == "function" then

            pcall(function()

                connection:Disconnect()
            end)
        end
    end

    table.clear(
        list
    )
end

function ZanjiProFarmSetStatus(status)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    runtime.Status =
        tostring(
            status
            or "Ready"
        )

    if type(ZanjiProFarmRefreshUI) == "function" then

        ZanjiProFarmRefreshUI()
    end

    return runtime.Status
end

function ZanjiProFarmCurrentAge(data)

    if type(data) ~= "table" then
        return 0
    end

    local age =
        tonumber(
            data.Age
            or data.CurrentAge
        )
        or 0

    local maxAge =
        tonumber(
            data.MaxAge
        )

    local lastClock =
        tonumber(
            data._ZanjiLastClock
        )

    local growthRate =
        tonumber(
            data.GrowRate
            or data.GrowthRate
            or data.StableGrowthAmount
        )
        or 0

    if lastClock ~= nil
    and growthRate > 0 then

        age +=
            math.max(
                0,
                os.clock() - lastClock
            )
            * growthRate
    end

    if maxAge ~= nil
    and maxAge > 0 then

        age =
            math.min(
                age,
                maxAge
            )
    end

    return age
end

function ZanjiProFarmDataReady(data)

    if type(data) ~= "table" then
        return false
    end

    local maxAge =
        tonumber(
            data.MaxAge
        )
        or 0

    if maxAge <= 0 then
        return false
    end

    return ZanjiProFarmCurrentAge(data)
        >= maxAge - 0.01
end

function ZanjiProFarmPrepareFruit(fruitData)

    if type(fruitData) ~= "table" then
        return
    end

    fruitData._ZanjiLastClock =
        os.clock()
end

function ZanjiProFarmPreparePlant(plantData)

    if type(plantData) ~= "table" then
        return
    end

    plantData._ZanjiLastClock =
        os.clock()

    plantData.Fruits =
        type(plantData.Fruits) == "table"
        and plantData.Fruits
        or {}

    for _, fruitData in pairs(plantData.Fruits) do

        ZanjiProFarmPrepareFruit(
            fruitData
        )
    end
end

function ZanjiProFarmPrepareCache()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    for _, plantData in pairs(runtime.Cache.Plants) do

        ZanjiProFarmPreparePlant(
            plantData
        )
    end
end

function ZanjiProFarmCountCache()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local plants =
        0

    local fruits =
        0

    local ready =
        0

    for _, plantData in pairs(runtime.Cache.Plants) do

        if type(plantData) == "table" then

            plants +=
                1

            local fruitCount =
                0

            if type(plantData.Fruits) == "table" then

                for _, fruitData in pairs(plantData.Fruits) do

                    if type(fruitData) == "table" then

                        fruitCount +=
                            1

                        fruits +=
                            1

                        if ZanjiProFarmDataReady(
                            fruitData
                        ) then

                            ready +=
                                1
                        end
                    end
                end
            end

            if fruitCount == 0
            and (
                tonumber(
                    plantData.MaxFruitSpawnLocations
                )
                or 0
            ) <= 0
            and ZanjiProFarmDataReady(
                plantData
            ) then

                ready +=
                    1
            end
        end
    end

    return plants,
        fruits,
        ready
end

function ZanjiProFarmBuildStatusText()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local plants,
        fruits,
        ready =
        ZanjiProFarmCountCache()

    local text =
        "Status: "
        .. tostring(
            runtime.Status
            or "Disabled"
        )

    if runtime.SnapshotReady == true then

        text ..=
            "\n"
            .. tostring(ready)
            .. " ready • "
            .. tostring(fruits)
            .. " fruits • "
            .. tostring(plants)
            .. " plants"
    end

    return text
end

function ZanjiProFarmRefreshUI()

    ZANJI_FARM_UI =
        type(ZANJI_FARM_UI) == "table"
        and ZANJI_FARM_UI
        or {}

    local label =
        ZANJI_FARM_UI.ProStatusLabel

    local text =
        ZanjiProFarmBuildStatusText()

    if type(ZanjiSniperSetLabel) == "function" then

        ZanjiSniperSetLabel(
            label,
            text
        )

        return true
    end

    if type(label) == "table"
    and type(label.SetText) == "function" then

        pcall(function()

            label:SetText(
                text
            )
        end)

        return true
    end

    return false
end

function ZanjiProFarmGetNetworking()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if type(runtime.Networking) == "table"
    and type(runtime.GardenNetworking) == "table" then

        return runtime.Networking,
            runtime.GardenNetworking
    end

    local networking =
        nil

    if type(ZanjiShopRequireModule) == "function" then

        networking =
            ZanjiShopRequireModule(
                "SharedModules.Networking"
            )
    end

    if type(networking) ~= "table" then

        local sharedModules =
            ReplicatedStorage:FindFirstChild(
                "SharedModules"
            )

        local module =
            sharedModules
            and sharedModules:FindFirstChild(
                "Networking"
            )

        if typeof(module) == "Instance"
        and module:IsA("ModuleScript") then

            local ok,
                result =
                pcall(function()

                    return require(
                        module
                    )
                end)

            if ok == true
            and type(result) == "table" then

                networking =
                    result
            end
        end
    end

    local garden =
        type(networking) == "table"
        and type(networking.Garden) == "table"
        and networking.Garden
        or nil

    runtime.Networking =
        networking

    runtime.GardenNetworking =
        garden

    runtime.RequestPacket =
        type(garden) == "table"
        and garden.RequestGardens
        or nil

    runtime.SnapshotPacket =
        type(garden) == "table"
        and garden.SyncAllGardens
        or nil

    runtime.CollectPacket =
        type(garden) == "table"
        and garden.CollectFruit
        or nil

    return networking,
        garden
end

function ZanjiProFarmOwnerMatches(owner)

    return tostring(owner or "")
        == tostring(
            LocalPlayer.UserId
        )
end

function ZanjiProFarmConnectPacket(packet, callback)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if type(packet) ~= "table"
    or packet.OnClientEvent == nil then

        return false
    end

    local ok,
        connection =
        pcall(function()

            return packet.OnClientEvent:Connect(
                callback
            )
        end)

    if ok == true
    and connection ~= nil then

        table.insert(
            runtime.Connections,
            connection
        )

        return true
    end

    return false
end

function ZanjiProFarmApplySnapshot(snapshot)

    if type(snapshot) ~= "table" then
        return false
    end

    local userId =
        LocalPlayer.UserId

    local gardenData =
        snapshot[userId]
        or snapshot[tostring(userId)]

    if type(gardenData) ~= "table"
    or type(gardenData.Plants) ~= "table" then

        return false
    end

    local runtime =
        ZanjiProFarmEnsureRuntime()

    runtime.Cache.Plants =
        gardenData.Plants

    ZanjiProFarmPrepareCache()

    runtime.SnapshotReady =
        true

    runtime.LastSnapshotAt =
        os.clock()

    runtime.ConsecutiveFailures =
        0

    ZanjiProFarmSetStatus(
        "Ready"
    )

    return true
end

function ZanjiProFarmConnectEvents()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    ZanjiProFarmDisconnectList(
        runtime.Connections
    )

    local _,
        garden =
        ZanjiProFarmGetNetworking()

    if type(garden) ~= "table" then
        return false
    end

    ZanjiProFarmConnectPacket(
        garden.SyncAllGardens,
        function(snapshot)

            ZanjiProFarmApplySnapshot(
                snapshot
            )
        end
    )

    ZanjiProFarmConnectPacket(
        garden.PlantAdded,
        function(owner, plantId, plantData)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            if type(plantData) ~= "table" then
                return
            end

            plantId =
                tostring(plantId)

            ZanjiProFarmPreparePlant(
                plantData
            )

            runtime.Cache.Plants[plantId] =
                plantData

            ZanjiProFarmRefreshUI()
        end
    )

    ZanjiProFarmConnectPacket(
        garden.PlantRemoved,
        function(owner, plantId)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            runtime.Cache.Plants[tostring(plantId)] =
                nil

            ZanjiProFarmRefreshUI()
        end
    )

    ZanjiProFarmConnectPacket(
        garden.FruitAdded,
        function(owner, plantId, fruitId, fruitData)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            if type(fruitData) ~= "table" then
                return
            end

            plantId =
                tostring(plantId)

            fruitId =
                tostring(fruitId)

            local plantData =
                runtime.Cache.Plants[plantId]

            if type(plantData) ~= "table" then

                plantData = {
                    Fruits = {},
                }

                runtime.Cache.Plants[plantId] =
                    plantData
            end

            plantData.Fruits =
                type(plantData.Fruits) == "table"
                and plantData.Fruits
                or {}

            ZanjiProFarmPrepareFruit(
                fruitData
            )

            plantData.Fruits[fruitId] =
                fruitData

            ZanjiProFarmRefreshUI()
        end
    )

    ZanjiProFarmConnectPacket(
        garden.FruitRemoved,
        function(owner, plantId, fruitId)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            local plantData =
                runtime.Cache.Plants[tostring(plantId)]

            if type(plantData) == "table"
            and type(plantData.Fruits) == "table" then

                plantData.Fruits[tostring(fruitId)] =
                    nil
            end

            ZanjiProFarmRefreshUI()
        end
    )

    ZanjiProFarmConnectPacket(
        garden.PlantGrowthUpdated,
        function(owner, plantId, currentAge, growthRate)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            local plantData =
                runtime.Cache.Plants[tostring(plantId)]

            if type(plantData) == "table" then

                plantData.Age =
                    tonumber(currentAge)
                    or plantData.Age
                    or 0

                plantData.GrowRate =
                    tonumber(growthRate)
                    or plantData.GrowRate
                    or 0

                plantData._ZanjiLastClock =
                    os.clock()
            end
        end
    )

    ZanjiProFarmConnectPacket(
        garden.FruitGrowthUpdated,
        function(owner, plantId, fruitId, currentAge, growthRate)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            local plantData =
                runtime.Cache.Plants[tostring(plantId)]

            local fruitData =
                type(plantData) == "table"
                and type(plantData.Fruits) == "table"
                and plantData.Fruits[tostring(fruitId)]
                or nil

            if type(fruitData) == "table" then

                fruitData.Age =
                    tonumber(currentAge)
                    or fruitData.Age
                    or 0

                fruitData.GrowRate =
                    tonumber(growthRate)
                    or fruitData.GrowRate
                    or 0

                fruitData._ZanjiLastClock =
                    os.clock()
            end
        end
    )

    ZanjiProFarmConnectPacket(
        garden.FruitMutationUpdated,
        function(owner, plantId, fruitId, mutationData)

            if ZanjiProFarmOwnerMatches(owner) ~= true then
                return
            end

            local plantData =
                runtime.Cache.Plants[tostring(plantId)]

            local fruitData =
                type(plantData) == "table"
                and type(plantData.Fruits) == "table"
                and plantData.Fruits[tostring(fruitId)]
                or nil

            if type(fruitData) == "table" then

                fruitData.Mutation =
                    mutationData
            end
        end
    )

    return true
end

function ZanjiProFarmRequestSnapshot(reason)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local _,
        garden =
        ZanjiProFarmGetNetworking()

    local packet =
        type(garden) == "table"
        and garden.RequestGardens
        or nil

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        ZanjiProFarmSetStatus(
            "Unavailable"
        )

        return false
    end

    runtime.LastRequestAt =
        os.clock()

    ZanjiProFarmSetStatus(
        "Refreshing"
    )

    local ok =
        pcall(function()

            packet:Fire()
        end)

    if ok ~= true then

        ZanjiProFarmSetStatus(
            "Refresh Failed"
        )

        return false
    end

    return true
end

function ZanjiProFarmIsOwnVisualRoot(instance)

    if typeof(instance) ~= "Instance" then
        return false
    end

    local prefix =
        tostring(
            LocalPlayer.UserId
        )
        .. "_"

    return instance.Name:sub(
        1,
        #prefix
    ) == prefix
end

function ZanjiProFarmFindPlantFolders()

    local folders =
        {}

    local gardens =
        workspace:FindFirstChild(
            "Gardens"
        )

    if typeof(gardens) ~= "Instance" then
        return folders
    end

    for _, plot in ipairs(gardens:GetChildren()) do

        local plants =
            plot:FindFirstChild(
                "Plants"
            )

        if typeof(plants) == "Instance" then

            table.insert(
                folders,
                plants
            )
        end
    end

    return folders
end

function ZanjiProFarmRemoveOwnVisuals()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local removed =
        0

    for _, folder in ipairs(
        ZanjiProFarmFindPlantFolders()
    ) do

        for _, child in ipairs(folder:GetChildren()) do

            if ZanjiProFarmIsOwnVisualRoot(child) then

                removed +=
                    1

                pcall(function()

                    child:Destroy()
                end)
            end
        end
    end

    runtime.HiddenVisualRoots +=
        removed

    return removed
end

function ZanjiProFarmStopVisualBlocker()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    runtime.VisualBlockerActive =
        false

    ZanjiProFarmDisconnectList(
        runtime.VisualConnections
    )

    return true
end

function ZanjiProFarmStartVisualBlocker()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    ZanjiProFarmStopVisualBlocker()

    if ZANJI_FARM_STATE.LowGardenDetail ~= true
    or ZANJI_FARM_STATE.ProFruitCollector ~= true then

        return false
    end

    runtime.VisualBlockerActive =
        true

    for _, folder in ipairs(
        ZanjiProFarmFindPlantFolders()
    ) do

        table.insert(
            runtime.VisualConnections,
            folder.ChildAdded:Connect(function(child)

                task.defer(function()

                    if runtime.VisualBlockerActive ~= true
                    or ZANJI_FARM_STATE.LowGardenDetail ~= true
                    or ZANJI_FARM_STATE.ProFruitCollector ~= true then

                        return
                    end

                    if child.Parent == folder
                    and ZanjiProFarmIsOwnVisualRoot(child) then

                        runtime.HiddenVisualRoots +=
                            1

                        pcall(function()

                            child:Destroy()
                        end)
                    end
                end)
            end)
        )
    end

    ZanjiProFarmRemoveOwnVisuals()

    return true
end

function ZanjiProFarmBuildEntry(
    plantId,
    plantData,
    fruitId,
    fruitData
)

    local isPlantHarvest =
        fruitId == nil
        or tostring(fruitId) == ""

    local entry = {
        Kind =
            isPlantHarvest
            and "PlantHarvest"
            or "FruitHarvest",

        Plant =
            nil,

        Fruit =
            nil,

        PlantData =
            plantData,

        FruitData =
            fruitData,

        PlantId =
            tostring(plantId or ""),

        FruitId =
            isPlantHarvest
            and ""
            or tostring(fruitId),

        PlantName =
            ZanjiCleanText(
                type(plantData) == "table"
                and (
                    plantData.PlantName
                    or plantData.FruitName
                    or plantData.SeedName
                    or plantData.Name
                )
                or ""
            ),
    }

    entry.Key =
        isPlantHarvest
        and ZanjiFarmBuildPlantHarvestKey(
            entry.PlantId
        )
        or ZanjiFarmBuildFruitKey(
            entry.PlantId,
            entry.FruitId
        )

    return entry
end

function ZanjiProFarmEntryAllowed(entry)

    if type(entry) ~= "table"
    or entry.Key == "" then

        return false
    end

    if type(ZanjiEclipseCollectionOwnsPlantName) == "function"
    and ZanjiEclipseCollectionOwnsPlantName(
        entry.PlantName
    ) == true then

        return false
    end

    return ZanjiFarmCollectionAllowsEntry(
        entry
    ) == true
end

function ZanjiProFarmFindTarget()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local now =
        os.clock()

    local candidates =
        {}

    local pendingPlants =
        {}

    for _, pending in pairs(runtime.Pending) do

        local pendingEntry =
            type(pending) == "table"
            and pending.Entry
            or nil

        if type(pendingEntry) == "table" then

            pendingPlants[
                tostring(
                    pendingEntry.PlantId
                    or ""
                )
            ] =
                true
        end
    end

    for plantId, plantData in pairs(runtime.Cache.Plants) do

        if type(plantData) == "table"
        and pendingPlants[tostring(plantId)] ~= true then

            local fruitCount =
                0

            if type(plantData.Fruits) == "table" then

                for fruitId, fruitData in pairs(plantData.Fruits) do

                    if type(fruitData) == "table" then

                        fruitCount +=
                            1

                        if ZanjiProFarmDataReady(
                            fruitData
                        ) then

                            local entry =
                                ZanjiProFarmBuildEntry(
                                    plantId,
                                    plantData,
                                    fruitId,
                                    fruitData
                                )

                            local cooldown =
                                tonumber(
                                    runtime.Cooldowns[entry.Key]
                                )
                                or 0

                            if cooldown <= now
                            and runtime.Pending[entry.Key] == nil
                            and ZanjiProFarmEntryAllowed(
                                entry
                            ) then

                                table.insert(
                                    candidates,
                                    entry
                                )
                            end
                        end
                    end
                end
            end

            if fruitCount == 0
            and (
                tonumber(
                    plantData.MaxFruitSpawnLocations
                )
                or 0
            ) <= 0
            and ZanjiProFarmDataReady(
                plantData
            ) then

                local entry =
                    ZanjiProFarmBuildEntry(
                        plantId,
                        plantData,
                        "",
                        plantData
                    )

                local cooldown =
                    tonumber(
                        runtime.Cooldowns[entry.Key]
                    )
                    or 0

                if cooldown <= now
                and runtime.Pending[entry.Key] == nil
                and ZanjiProFarmEntryAllowed(
                    entry
                ) then

                    table.insert(
                        candidates,
                        entry
                    )
                end
            end
        end
    end

    if #candidates == 0 then
        return nil
    end

    return candidates[
        math.random(
            1,
            #candidates
        )
    ]
end

function ZanjiProFarmTargetExists(entry)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if type(entry) ~= "table" then
        return false
    end

    local plantData =
        runtime.Cache.Plants[entry.PlantId]

    if entry.Kind == "PlantHarvest" then

        return type(plantData) == "table"
    end

    return type(plantData) == "table"
        and type(plantData.Fruits) == "table"
        and plantData.Fruits[entry.FruitId] ~= nil
end

function ZanjiProFarmWaitForConfirmation(
    token,
    entry,
    timeout
)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local deadline =
        os.clock()
        + (
            tonumber(timeout)
            or 2.5
        )

    while runtime.Token == token
    and ZANJI_FARM_STATE.ProFruitCollector == true
    and os.clock() < deadline do

        if ZanjiProFarmTargetExists(
            entry
        ) ~= true then

            return true
        end

        task.wait(
            0.08
        )
    end

    return ZanjiProFarmTargetExists(
        entry
    ) ~= true
end

function ZanjiProFarmFireEntry(token, entry)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local packet =
        runtime.CollectPacket

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        local _,
            garden =
            ZanjiProFarmGetNetworking()

        packet =
            type(garden) == "table"
            and garden.CollectFruit
            or nil

        runtime.CollectPacket =
            packet
    end

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false,
            "Collect packet unavailable"
    end

    ZanjiProFarmSetStatus(
        "Collecting"
    )

    local ok,
        result =
        pcall(function()

            return packet:Fire(
                entry.PlantId,
                entry.FruitId
            )
        end)

    if ok ~= true then

        return false,
            tostring(result)
    end

    if ZanjiProFarmWaitForConfirmation(
        token,
        entry,
        2.5
    ) then

        return true,
            "confirmed"
    end

    task.wait(
        0.75
    )

    ok,
        result =
        pcall(function()

            return packet:Fire(
                entry.PlantId,
                entry.FruitId
            )
        end)

    if ok ~= true then

        return false,
            tostring(result)
    end

    if ZanjiProFarmWaitForConfirmation(
        token,
        entry,
        2.5
    ) then

        return true,
            "confirmed after retry"
    end

    return false,
        "not confirmed"
end

function ZanjiProFarmReadCollectionDelay(value)

    local minimumDelay =
        ZanjiLowEndModeEnabled() == true
        and 0.10
        or 0.035

    return math.clamp(
        tonumber(value)
        or 0.05,
        minimumDelay,
        1
    )
end

function ZanjiProFarmGetPendingCount()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local count =
        0

    for _ in pairs(runtime.Pending) do

        count +=
            1
    end

    return count
end

function ZanjiProFarmGetPipelinePacket()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local packet =
        runtime.CollectPacket

    if type(packet) == "table"
    and type(packet.Fire) == "function" then

        return packet
    end

    local _,
        garden =
        ZanjiProFarmGetNetworking()

    packet =
        type(garden) == "table"
        and garden.CollectFruit
        or nil

    runtime.CollectPacket =
        packet

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return nil,
            "Collect packet unavailable"
    end

    return packet
end

function ZanjiProFarmSetPipelineStatus()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local pendingCount =
        ZanjiProFarmGetPendingCount()

    local status =
        pendingCount > 0
        and (
            "Collecting "
            .. tostring(pendingCount)
        )
        or "Ready"

    if runtime.Status ~= status then

        ZanjiProFarmSetStatus(
            status
        )
    end

    return status
end

function ZanjiProFarmRecordPipelineConfirmed(key, pending)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    runtime.Pending[key] =
        nil

    runtime.Cooldowns[key] =
        nil

    runtime.Confirmed +=
        1

    runtime.ConsecutiveFailures =
        0

    return true
end

function ZanjiProFarmRecordPipelineFailure(key, pending, reason)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local entry =
        type(pending) == "table"
        and pending.Entry
        or nil

    runtime.Pending[key] =
        nil

    runtime.Cooldowns[key] =
        os.clock()
        + 8

    runtime.Failed +=
        1

    runtime.ConsecutiveFailures +=
        1

    if runtime.ConsecutiveFailures >= 3 then

        runtime.ConsecutiveFailures =
            0

        ZanjiProFarmRequestSnapshot(
            "pipeline recovery"
        )
    end

    return entry,
        tostring(reason or "failed")
end

function ZanjiProFarmProcessPending(token)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local now =
        os.clock()

    for key, pending in pairs(runtime.Pending) do

        if runtime.Token ~= token then
            break
        end

        local entry =
            type(pending) == "table"
            and pending.Entry
            or nil

        if type(entry) ~= "table" then

            runtime.Pending[key] =
                nil

            continue
        end

        if ZanjiProFarmTargetExists(
            entry
        ) ~= true then

            ZanjiProFarmRecordPipelineConfirmed(
                key,
                pending
            )

            continue
        end

        local lastSentAt =
            tonumber(
                pending.LastSentAt
            )
            or now

        local attempts =
            math.max(
                1,
                math.floor(
                    tonumber(
                        pending.Attempts
                    )
                    or 1
                )
            )

        if pending.RetryReadyAt ~= nil then

            continue
        end

        if now - lastSentAt
            >= runtime.ConfirmationTimeout then

            if attempts < 2 then

                pending.RetryReadyAt =
                    now
                    + runtime.RetryDelay

            else

                ZanjiProFarmRecordPipelineFailure(
                    key,
                    pending,
                    "not confirmed"
                )
            end
        end
    end

    return true
end

function ZanjiProFarmFindRetryReady()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    local now =
        os.clock()

    local bestKey =
        nil

    local bestPending =
        nil

    local bestTime =
        math.huge

    for key, pending in pairs(runtime.Pending) do

        local retryReadyAt =
            type(pending) == "table"
            and tonumber(
                pending.RetryReadyAt
            )
            or nil

        if retryReadyAt
        and retryReadyAt <= now
        and retryReadyAt < bestTime then

            bestKey =
                key

            bestPending =
                pending

            bestTime =
                retryReadyAt
        end
    end

    return bestKey,
        bestPending
end

function ZanjiProFarmSendRetry(token, packet, key, pending)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if runtime.Token ~= token
    or type(pending) ~= "table"
    or type(pending.Entry) ~= "table" then

        return false
    end

    local entry =
        pending.Entry

    if type(ZanjiEclipseCollectionOwnsPlantName) == "function"
    and ZanjiEclipseCollectionOwnsPlantName(
        entry.PlantName
    ) == true then

        runtime.Pending[key] =
            nil

        runtime.Cooldowns[key] =
            nil

        return false
    end

    if ZanjiProFarmTargetExists(
        entry
    ) ~= true then

        ZanjiProFarmRecordPipelineConfirmed(
            key,
            pending
        )

        return true
    end

    local ok =
        pcall(function()

            packet:Fire(
                entry.PlantId,
                entry.FruitId
            )
        end)

    runtime.NextSendAt =
        os.clock()
        + ZanjiProFarmReadCollectionDelay(
            ZANJI_FARM_STATE.ProCollectionDelay
        )

    if ok ~= true then

        ZanjiProFarmRecordPipelineFailure(
            key,
            pending,
            "retry fire failed"
        )

        return false
    end

    pending.Attempts =
        (
            tonumber(
                pending.Attempts
            )
            or 1
        )
        + 1

    pending.LastSentAt =
        os.clock()

    pending.RetryReadyAt =
        nil

    return true
end

function ZanjiProFarmSendNewTarget(token, packet)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if runtime.Token ~= token then
        return false
    end

    local maximumPending =
        runtime.MaxPending

    if ZanjiLowEndModeEnabled() == true then

        maximumPending =
            math.min(
                maximumPending,
                4
            )
    end

    if ZanjiProFarmGetPendingCount()
        >= maximumPending then

        return false
    end

    local entry =
        ZanjiProFarmFindTarget()

    if type(entry) ~= "table" then
        return false
    end

    local ok =
        pcall(function()

            packet:Fire(
                entry.PlantId,
                entry.FruitId
            )
        end)

    runtime.NextSendAt =
        os.clock()
        + ZanjiProFarmReadCollectionDelay(
            ZANJI_FARM_STATE.ProCollectionDelay
        )

    if ok ~= true then

        runtime.Cooldowns[entry.Key] =
            os.clock()
            + 8

        runtime.Failed +=
            1

        runtime.ConsecutiveFailures +=
            1

        if runtime.ConsecutiveFailures >= 3 then

            runtime.ConsecutiveFailures =
                0

            ZanjiProFarmRequestSnapshot(
                "pipeline fire recovery"
            )
        end

        return false
    end

    runtime.Pending[entry.Key] = {
        Entry =
            entry,

        Attempts =
            1,

        LastSentAt =
            os.clock(),

        RetryReadyAt =
            nil,
    }

    return true
end

function ZanjiProFarmPipelineStep(token)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if runtime.Token ~= token
    or ZANJI_FARM_STATE.ProFruitCollector ~= true then

        return false
    end

    if os.clock() < (
        tonumber(runtime.NextSendAt)
        or 0
    ) then

        ZanjiProFarmSetPipelineStatus()

        return false
    end

    local packet =
        ZanjiProFarmGetPipelinePacket()

    if not packet then

        ZanjiProFarmSetStatus(
            "Unavailable"
        )

        runtime.NextSendAt =
            os.clock()
            + 1

        return false
    end

    local retryKey,
        retryPending =
        ZanjiProFarmFindRetryReady()

    local sent =
        false

    if retryKey
    and retryPending then

        sent =
            ZanjiProFarmSendRetry(
                token,
                packet,
                retryKey,
                retryPending
            )

    else

        sent =
            ZanjiProFarmSendNewTarget(
                token,
                packet
            )
    end

    ZanjiProFarmSetPipelineStatus()

    return sent
end

function ZanjiProFarmRunWorker(token)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    while runtime.Token == token
    and ZANJI_FARM_STATE.ProFruitCollector == true do

        ZanjiProFarmProcessPending(
            token
        )

        if ZanjiFarmAutoCollectBlocked() == true then

            if runtime.Status ~= "Paused" then

                ZanjiProFarmSetStatus(
                    "Paused"
                )
            end

            task.wait(
                0.05
            )

            continue
        end

        if runtime.SnapshotReady ~= true then

            if os.clock() - (
                tonumber(runtime.LastRequestAt)
                or 0
            ) >= 5 then

                ZanjiProFarmRequestSnapshot(
                    "waiting"
                )
            end

            task.wait(
                0.05
            )

            continue
        end

        if os.clock() - (
            tonumber(runtime.LastSnapshotAt)
            or 0
        ) >= 60 then

            ZanjiProFarmRequestSnapshot(
                "safety refresh"
            )
        end

        ZanjiProFarmPipelineStep(
            token
        )

        task.wait(
            ZanjiLowEndModeEnabled() == true
            and 0.04
            or 0.01
        )
    end

    if runtime.Token == token then

        runtime.Running =
            false
    end
end

function ZanjiProFarmStart(reason)

    ZanjiFarmEnsureState()

    if ZANJI_FARM_STATE.ProFruitCollector ~= true then
        return false
    end

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if runtime.Running == true then
        return false
    end

    ZanjiFarmStopAutoCollect(
        "pro collector"
    )

    ZanjiProFarmDisconnectList(
        runtime.Connections
    )

    ZanjiProFarmDisconnectList(
        runtime.VisualConnections
    )

    runtime.Cache = {
        Plants = {},
    }

    runtime.Cooldowns =
        {}

    runtime.Pending =
        {}

    runtime.NextSendAt =
        0

    runtime.SnapshotReady =
        false

    runtime.Confirmed =
        0

    runtime.Failed =
        0

    runtime.ConsecutiveFailures =
        0

    runtime.Token =
        {}

    runtime.Running =
        true

    local token =
        runtime.Token

    if ZanjiProFarmConnectEvents() ~= true then

        runtime.Running =
            false

        runtime.Token =
            nil

        ZanjiProFarmSetStatus(
            "Unavailable"
        )

        return false
    end

    if ZANJI_FARM_STATE.LowGardenDetail == true then

        ZanjiProFarmStartVisualBlocker()
    end

    ZanjiProFarmRequestSnapshot(
        reason or "start"
    )

    task.spawn(function()

        ZanjiProFarmRunWorker(
            token
        )
    end)

    return true
end

function ZanjiProFarmStop(reason)

    local runtime =
        ZanjiProFarmEnsureRuntime()

    runtime.Token =
        nil

    runtime.Running =
        false

    runtime.SnapshotReady =
        false

    runtime.Pending =
        {}

    runtime.NextSendAt =
        0

    ZanjiProFarmDisconnectList(
        runtime.Connections
    )

    ZanjiProFarmStopVisualBlocker()

    ZanjiProFarmSetStatus(
        "Disabled"
    )

    return true
end

function ZanjiProFarmSetEnabled(value)

    ZanjiFarmEnsureState()

    value =
        value == true

    ZANJI_FARM_STATE.ProFruitCollector =
        value

    if value == true then

        ZANJI_FARM_STATE.AutoCollectFruits =
            false

        if type(ZANJI_FARM_UI.AutoCollectToggle) == "table"
        and type(ZANJI_FARM_UI.AutoCollectToggle.SetValue) == "function" then

            pcall(function()

                ZANJI_FARM_UI.AutoCollectToggle:SetValue(
                    false,
                    true
                )
            end)
        end

        ZanjiFarmStopAutoCollect(
            "pro enabled"
        )

        ZanjiSaveFarmSettings()

        return ZanjiProFarmStart(
            "toggle on"
        )
    end

    ZanjiSaveFarmSettings()

    return ZanjiProFarmStop(
        "toggle off"
    )
end

function ZanjiProFarmSetCollectionDelay(value)

    ZanjiFarmEnsureState()

    ZANJI_FARM_STATE.ProCollectionDelay =
        ZanjiProFarmReadCollectionDelay(
            value
        )

    local runtime =
        ZanjiProFarmEnsureRuntime()

    runtime.NextSendAt =
        os.clock()
        + ZANJI_FARM_STATE.ProCollectionDelay

    ZanjiSaveFarmSettings()

    return ZANJI_FARM_STATE.ProCollectionDelay
end

function ZanjiProFarmSetLowGardenDetail(value)

    ZanjiFarmEnsureState()

    ZANJI_FARM_STATE.LowGardenDetail =
        value == true

    ZanjiSaveFarmSettings()

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if ZANJI_FARM_STATE.LowGardenDetail == true
    and ZANJI_FARM_STATE.ProFruitCollector == true
    and runtime.Running == true then

        return ZanjiProFarmStartVisualBlocker()
    end

    return ZanjiProFarmStopVisualBlocker()
end

function ZanjiFarmSetAutoCollectFruits(value)

    ZanjiFarmEnsureState()

    value =
        value == true

    if value == true
    and ZANJI_FARM_STATE.ProFruitCollector == true then

        ZANJI_FARM_STATE.ProFruitCollector =
            false

        if type(ZANJI_FARM_UI.ProCollectorToggle) == "table"
        and type(ZANJI_FARM_UI.ProCollectorToggle.SetValue) == "function" then

            pcall(function()

                ZANJI_FARM_UI.ProCollectorToggle:SetValue(
                    false,
                    true
                )
            end)
        end

        ZanjiProFarmStop(
            "normal collector enabled"
        )
    end

    ZANJI_FARM_STATE.AutoCollectFruits =
        value

    ZanjiSaveFarmSettings()

    if ZANJI_FARM_STATE.AutoCollectFruits == true then

        return ZanjiFarmStartAutoCollect(
            "toggle on"
        )
    end

    return ZanjiFarmStopAutoCollect(
        "toggle off"
    )
end

