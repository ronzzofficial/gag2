    end

    local children =
        {}

    pcall(function()

        children =
            middle:GetChildren()
    end)

    local removed =
        0

    for _, child in ipairs(children) do

        if typeof(child) == "Instance"
        and child.Parent == middle then

            if ZanjiPerformanceRemoveChild(child) == true then

                removed =
                    removed + 1
            end
        end
    end

    return removed
end

function ZanjiPerformanceHideMiddleOnce(reason)

    if ZANJI_DEV_UI_STATE.HideMiddle ~= true then
        return 0
    end

    local totalChanged =
        0

    local middle =
        ZanjiPerformanceGetMiddleRoot()

    if typeof(middle) == "Instance" then

        totalChanged =
            totalChanged
            + ZanjiPerformanceRemoveMiddleChildren(
                middle
            )
    end

    local stands =
        ZanjiPerformanceGetStandsRoot()

    if typeof(stands) == "Instance" then

        totalChanged =
            totalChanged
            + ZanjiPerformanceHideVisualTree(
                stands
            )
    end

    local npcs =
        ZanjiPerformanceGetNpcsRoot()

    if typeof(npcs) == "Instance" then

        totalChanged =
            totalChanged
            + ZanjiPerformanceHideVisualTree(
                npcs
            )
    end

    if totalChanged > 0 then

        ZanjiPerformanceSetStatus(
            "Applied."
        )

    else

        ZanjiPerformanceSetStatus(
            "Waiting."
        )
    end

    return totalChanged
end

function ZanjiPerformanceConnectHideTreeWatcher(root)

    if ZANJI_DEV_UI_STATE.HideMiddle ~= true then
        return false
    end

    if typeof(root) ~= "Instance" then
        return false
    end

    ZANJI_PERFORMANCE_STATE.MapConnections =
        type(ZANJI_PERFORMANCE_STATE.MapConnections) == "table"
        and ZANJI_PERFORMANCE_STATE.MapConnections
        or {}

    if ZANJI_PERFORMANCE_STATE.MapConnections[root] then
        return true
    end

    ZANJI_PERFORMANCE_STATE.MapConnections[root] =
        root.ChildAdded:Connect(function(child)

            task.defer(function()

                if ZANJI_DEV_UI_STATE.HideMiddle ~= true
                or ZANJI_PERFORMANCE_STATE.Active ~= true then

                    return
                end

                if typeof(child) == "Instance"
                and child.Parent == root then

                    ZanjiPerformanceHideVisualTree(
                        child
                    )
                end
            end)
        end)

    return true
end

function ZanjiPerformanceConnectMiddleWatcher()

    if ZANJI_DEV_UI_STATE.HideMiddle ~= true then
        return false
    end

    ZANJI_PERFORMANCE_STATE.MapConnections =
        type(ZANJI_PERFORMANCE_STATE.MapConnections) == "table"
        and ZANJI_PERFORMANCE_STATE.MapConnections
        or {}

    local middle,
        map =
        ZanjiPerformanceGetMiddleRoot()

    if typeof(middle) == "Instance"
    and ZANJI_PERFORMANCE_STATE.MapConnections[middle] == nil then

        ZANJI_PERFORMANCE_STATE.MapConnections[middle] =
            middle.ChildAdded:Connect(function(child)

                task.defer(function()

                    if ZANJI_DEV_UI_STATE.HideMiddle ~= true
                    or ZANJI_PERFORMANCE_STATE.Active ~= true then

                        return
                    end

                    if typeof(child) == "Instance"
                    and typeof(middle) == "Instance"
                    and child.Parent == middle then

                        ZanjiPerformanceRemoveChild(
                            child
                        )
                    end
                end)
            end)
    end

    local stands =
        ZanjiPerformanceGetStandsRoot()

    if typeof(stands) == "Instance" then

        ZanjiPerformanceConnectHideTreeWatcher(
            stands
        )
    end

    local npcs =
        ZanjiPerformanceGetNpcsRoot()

    if typeof(npcs) == "Instance" then

        ZanjiPerformanceConnectHideTreeWatcher(
            npcs
        )
    end

    if typeof(map) == "Instance"
    and ZANJI_PERFORMANCE_STATE.MapConnections.__MapChildAdded == nil then

        ZANJI_PERFORMANCE_STATE.MapConnections.__MapChildAdded =
            map.ChildAdded:Connect(function(child)

                task.delay(0.25, function()

                    if ZANJI_DEV_UI_STATE.HideMiddle ~= true
                    or ZANJI_PERFORMANCE_STATE.Active ~= true then

                        return
                    end

                    if typeof(child) ~= "Instance" then
                        return
                    end

                    if child.Name == "Middle" then

                        ZanjiPerformanceHideMiddleOnce(
                            "middle added"
                        )

                        ZanjiPerformanceConnectMiddleWatcher()

                    elseif child.Name == "Stands" then

                        ZanjiPerformanceHideVisualTree(
                            child
                        )

                        ZanjiPerformanceConnectHideTreeWatcher(
                            child
                        )
                    end
                end)
            end)
    end

    if ZANJI_PERFORMANCE_STATE.MapConnections.__WorkspaceChildAdded == nil then

        ZANJI_PERFORMANCE_STATE.MapConnections.__WorkspaceChildAdded =
            workspace.ChildAdded:Connect(function(child)

                task.delay(0.25, function()

                    if ZANJI_DEV_UI_STATE.HideMiddle ~= true
                    or ZANJI_PERFORMANCE_STATE.Active ~= true then

                        return
                    end

                    if typeof(child) == "Instance"
                    and child.Name == "NPCS" then

                        ZanjiPerformanceHideVisualTree(
                            child
                        )

                        ZanjiPerformanceConnectHideTreeWatcher(
                            child
                        )
                    end
                end)
            end)
    end

    return true
end

function ZanjiPerformanceProcessPlotChild(child)

    if typeof(child) ~= "Instance" then

        return "skip",
            0
    end

    if ZanjiPerformanceShouldRemoveChild(child) == true then

        if ZanjiPerformanceRemoveChild(child) == true then

            return "removed",
                1
        end

        return "failed",
            0
    end

    if ZanjiPerformanceShouldHideChild(child) == true then

        return "hidden",
            ZanjiPerformanceHideVisualTree(
                child
            )
    end

    return "kept",
        0
end

function ZanjiPerformanceConnectPlotCleaner(plot)

    if ZanjiPerformanceIsPlot(plot) ~= true then
        return false
    end

    ZANJI_PERFORMANCE_STATE.PlotConnections =
        type(ZANJI_PERFORMANCE_STATE.PlotConnections) == "table"
        and ZANJI_PERFORMANCE_STATE.PlotConnections
        or {}

    if ZANJI_PERFORMANCE_STATE.PlotConnections[plot] then
        return true
    end

    ZANJI_PERFORMANCE_STATE.PlotConnections[plot] =
        plot.ChildAdded:Connect(function(child)

            task.defer(function()

                if ZanjiPerformanceAnyUnloadEnabled() ~= true
                or ZANJI_PERFORMANCE_STATE.Active ~= true then

                    return
                end

                local gardens =
                    ZanjiPerformanceGetGardensRoot()

                if typeof(gardens) ~= "Instance" then
                    return
                end

                local ownPlot =
                    ZANJI_PERFORMANCE_STATE.OwnPlot

                if typeof(ownPlot) ~= "Instance"
                or ownPlot.Parent ~= gardens then

                    ownPlot =
                        select(
                            1,
                            ZanjiPerformanceResolveOwnPlot(
                                gardens
                            )
                        )
                end

                if typeof(ownPlot) ~= "Instance" then
                    return
                end

                if ZanjiPerformanceShouldProcessPlot(
                    plot,
                    ownPlot
                ) ~= true then

                    return
                end

                ZanjiPerformanceProcessPlotChild(
                    child
                )
            end)
        end)

    return true
end

function ZanjiPerformanceProcessPlot(plot, ownPlot)

    if ZanjiPerformanceIsPlot(plot) ~= true then
        return 0,
            0
    end

    if ZanjiPerformanceShouldProcessPlot(
        plot,
        ownPlot
    ) ~= true then

        return 0,
            0
    end

    local children =
        {}

    pcall(function()

        children =
            plot:GetChildren()
    end)

    local removed =
        0

    local hidden =
        0

    for _, child in ipairs(children) do

        if typeof(child) == "Instance"
        and child.Parent == plot then

            local action,
                amount =
                ZanjiPerformanceProcessPlotChild(
                    child
                )

            if action == "removed" then

                removed =
                    removed + amount

            elseif action == "hidden" then

                hidden =
                    hidden + amount
            end
        end
    end

    if removed > 0
    or hidden > 0 then

        ZANJI_PERFORMANCE_STATE.ProcessedPlots =
            type(ZANJI_PERFORMANCE_STATE.ProcessedPlots) == "table"
            and ZANJI_PERFORMANCE_STATE.ProcessedPlots
            or {}

        ZANJI_PERFORMANCE_STATE.ProcessedPlots[plot] =
            true
    end

    ZanjiPerformanceConnectPlotCleaner(
        plot
    )

    return removed,
        hidden
end

function ZanjiPerformanceProcessOtherPlot(plot, ownPlot)

    return ZanjiPerformanceProcessPlot(
        plot,
        ownPlot
    )
end

function ZanjiPerformanceDeleteOtherGardensOnce(reason)

    if ZanjiPerformanceAnyUnloadEnabled() ~= true then
        return 0
    end

    local totalRemoved =
        0

    if ZANJI_DEV_UI_STATE.HideMiddle == true then

        totalRemoved =
            totalRemoved
            + ZanjiPerformanceHideMiddleOnce(
                reason
                or "apply"
            )
    end

    if ZanjiPerformanceAnyGardenUnloadEnabled() ~= true then

        ZanjiPerformanceSetStatus(
            "Applied."
        )

        return totalRemoved
    end

    local gardens =
        ZanjiPerformanceGetGardensRoot()

    if typeof(gardens) ~= "Instance" then

        ZanjiPerformanceSetStatus(
            "Waiting."
        )

        return totalRemoved
    end

    local ownPlot =
        select(
            1,
            ZanjiPerformanceResolveOwnPlot(
                gardens
            )
        )

    if typeof(ownPlot) ~= "Instance" then

        ZanjiPerformanceSetStatus(
            "Waiting."
        )

        return totalRemoved
    end

    local removedThisPass =
        0

    local hiddenThisPass =
        0

    for _, plot in ipairs(gardens:GetChildren()) do

        if ZanjiPerformanceIsPlot(plot) == true then

            local removed,
                hidden =
                ZanjiPerformanceProcessPlot(
                    plot,
                    ownPlot
                )

            removedThisPass =
                removedThisPass + removed

            hiddenThisPass =
                hiddenThisPass + hidden
        end
    end

    ZanjiPerformanceSetStatus(
        "Applied."
    )

    return totalRemoved
        + removedThisPass
end

function ZanjiPerformanceConnectGardenWatcher()

    ZanjiPerformanceDisconnectConnections()

    ZANJI_PERFORMANCE_STATE.Connections =
        {}

    ZANJI_PERFORMANCE_STATE.PlotConnections =
        {}

    ZANJI_PERFORMANCE_STATE.MapConnections =
        {}

    if ZANJI_DEV_UI_STATE.HideMiddle == true then

        ZanjiPerformanceConnectMiddleWatcher()
    end

    if ZanjiPerformanceAnyGardenUnloadEnabled() ~= true then
        return true
    end

    local gardens =
        ZanjiPerformanceGetGardensRoot()

    if typeof(gardens) ~= "Instance" then
        return false
    end

    local ownPlot =
        ZANJI_PERFORMANCE_STATE.OwnPlot

    if typeof(ownPlot) ~= "Instance"
    or ownPlot.Parent ~= gardens then

        ownPlot =
            select(
                1,
                ZanjiPerformanceResolveOwnPlot(
                    gardens
                )
            )
    end

    for _, plot in ipairs(gardens:GetChildren()) do

        if ZanjiPerformanceIsPlot(plot) == true
        and typeof(ownPlot) == "Instance"
        and ZanjiPerformanceShouldProcessPlot(
            plot,
            ownPlot
        ) == true then

            ZanjiPerformanceConnectPlotCleaner(
                plot
            )
        end
    end

    table.insert(
        ZANJI_PERFORMANCE_STATE.Connections,
        gardens.ChildAdded:Connect(function(plot)

            task.delay(0.45, function()

                if ZanjiPerformanceAnyUnloadEnabled() ~= true
                or ZANJI_PERFORMANCE_STATE.Active ~= true then

                    return
                end

                if ZanjiPerformanceIsPlot(plot) ~= true then
                    return
                end

                if typeof(plot) ~= "Instance"
                or plot.Parent ~= gardens then

                    return
                end

                local owned,
                    marker =
                    ZanjiPerformancePlotOwnedByLocal(
                        plot
                    )

                if owned == true then

                    ZANJI_PERFORMANCE_STATE.OwnPlot =
                        plot

                    ZANJI_PERFORMANCE_STATE.OwnMarker =
                        marker
                end

                local resolvedOwnPlot =
                    ZANJI_PERFORMANCE_STATE.OwnPlot

                if typeof(resolvedOwnPlot) ~= "Instance"
                or resolvedOwnPlot.Parent ~= gardens then

                    resolvedOwnPlot =
                        select(
                            1,
                            ZanjiPerformanceResolveOwnPlot(
                                gardens
                            )
                        )
                end

                if typeof(resolvedOwnPlot) ~= "Instance" then
                    return
                end

                if ZanjiPerformanceShouldProcessPlot(
                    plot,
                    resolvedOwnPlot
                ) == true then

                    ZanjiPerformanceProcessPlot(
                        plot,
                        resolvedOwnPlot
                    )
                end
            end)
        end)
    )

    return true
end

function ZanjiPerformanceStartApply(reason)

    if ZanjiPerformanceAnyUnloadEnabled() ~= true then
        return false
    end

    ZANJI_PERFORMANCE_STATE.Active =
        true

    ZanjiSaveUISettings()

    if ZANJI_PERFORMANCE_STATE.Applying == true then
        return true
    end

    ZANJI_PERFORMANCE_STATE.Applying =
        true

    task.spawn(function()

        local deadline =
            os.clock() + 6

        while ZanjiPerformanceAnyUnloadEnabled() == true
        and ZANJI_PERFORMANCE_STATE.Active == true
        and os.clock() <= deadline do

            if ZANJI_DEV_UI_STATE.HideMiddle == true then

                ZanjiPerformanceHideMiddleOnce(
                    reason
                    or "apply"
                )

                ZanjiPerformanceConnectMiddleWatcher()
            end

            if ZanjiPerformanceAnyGardenUnloadEnabled() ~= true then

                ZanjiPerformanceConnectGardenWatcher()

                break
            end

            local gardens =
                ZanjiPerformanceGetGardensRoot()

            if typeof(gardens) == "Instance" then

                local ownPlot =
                    select(
                        1,
                        ZanjiPerformanceResolveOwnPlot(
                            gardens
                        )
                    )

                if typeof(ownPlot) == "Instance" then

                    ZanjiPerformanceDeleteOtherGardensOnce(
                        reason
                        or "apply"
                    )

                    ZanjiPerformanceConnectGardenWatcher()

                    break
                end
            end

            task.wait(
                0.10
            )
        end

        ZANJI_PERFORMANCE_STATE.Applying =
            false
    end)

    return true
end

function ZanjiPerformanceStartUnloadOtherGardens(reason)

    ZANJI_DEV_UI_STATE.UnloadOtherGardens =
        true

    ZANJI_PERFORMANCE_STATE.Active =
        true

    ZanjiSaveUISettings()

    local env =
        (
            type(getgenv) == "function"
            and getgenv()
        )
        or _G

    env.ZANJI_FAST_LOADER_FORCE_ENABLED =
        true

    local queued =
        type(env.ZANJI_FAST_LOADER_QUEUE) == "function"
        and env.ZANJI_FAST_LOADER_QUEUE() == true

    local started =
        type(env.ZANJI_FAST_LOADER_RUN) == "function"
        and env.ZANJI_FAST_LOADER_RUN() == true

    ZanjiPerformanceSetStatus(
        started == true
        and (
            queued == true
            and "Fast loader active and queued for the next server."
            or "Fast loader active. Rejoin for the earliest startup patch."
        )
        or "Fast loader saved. Rejoin to apply it."
    )

    return started == true
        or queued == true
end

function ZanjiPerformanceStopUnloadOtherGardens(reason)

    ZANJI_DEV_UI_STATE.UnloadOtherGardens =
        false

    ZanjiSaveUISettings()

    local env =
        (
            type(getgenv) == "function"
            and getgenv()
        )
        or _G

    env.ZANJI_FAST_LOADER_FORCE_ENABLED =
        false

    if type(env.ZANJI_FAST_LOADER_STOP) == "function" then

        pcall(
            env.ZANJI_FAST_LOADER_STOP
        )
    end

    if ZanjiPerformanceAnyUnloadEnabled() == true then

        ZANJI_PERFORMANCE_STATE.Active =
            true

        ZanjiPerformanceConnectGardenWatcher()

        return true
    end

    ZANJI_PERFORMANCE_STATE.Active =
        false

    ZANJI_PERFORMANCE_STATE.Applying =
        false

    ZanjiPerformanceDisconnectConnections()

    ZanjiPerformanceSetStatus(
        "Fast loader off. Rejoin to restore suppressed visuals."
    )

    return true
end

