            if text == "false"
            or text == "0"
            or text == "no" then

                return false
            end
        end
    end

    return nil
end

function ZanjiFarmPromptUnderFruits(prompt, plant)

    if typeof(prompt) ~= "Instance"
    or typeof(plant) ~= "Instance" then

        return false
    end

    local current =
        prompt.Parent

    while current
    and current ~= plant do

        if current.Name == "Fruits" then
            return true
        end

        current =
            current.Parent
    end

    return false
end

