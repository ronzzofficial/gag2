function ZanjiCleanText(value)

    local text =
        tostring(value or "")

    text =
        text:gsub(
            "^%s+",
            ""
        )

    text =
        text:gsub(
            "%s+$",
            ""
        )

    return text
end

function ZanjiGetRequestFunction()

    if type(syn) == "table"
    and type(syn.request) == "function" then

        return syn.request
    end

    if type(http_request) == "function" then
        return http_request
    end

    if type(request) == "function" then
        return request
    end

    if type(fluxus) == "table"
    and type(fluxus.request) == "function" then

        return fluxus.request
    end

    local env =
        type(getgenv) == "function"
        and getgenv()
        or _G

    if type(env) == "table" then

        if type(env.request) == "function" then
            return env.request
        end

        if type(env.http_request) == "function" then
            return env.http_request
        end
    end

    return nil
end

function ZanjiValidateSource(body)

    if type(body) ~= "string"
    or body == "" then

        return nil,
            "empty response"
    end

    if body:sub(1, 3) == "\239\187\191" then
        body = body:sub(4)
    end

    local preview =
        body:sub(1, 220):lower()

    if preview:find("<!doctype html", 1, true)
    or preview:find("<html", 1, true)
    or preview:find("rate limit", 1, true) then

        return nil,
            "response was HTML/rate-limit page"
    end

    if body:find("\0", 1, true) then

        return nil,
            "response contains binary null bytes"
    end

    return body,
        nil
end

function ZanjiHttpGet(url)

    url =
        ZanjiCleanText(url)

    if url == "" then
        return nil, "empty URL"
    end

    local failures =
        {}

    local ok,
        result =
        pcall(function()

            return game:HttpGet(
                url,
                true
            )
        end)

    if ok == true then

        local source,
            sourceError =
            ZanjiValidateSource(result)

        if source then
            return source, nil
        end

        failures[#failures + 1] =
            "game:HttpGet: "
            .. tostring(sourceError)

    else

        failures[#failures + 1] =
            "game:HttpGet failed: "
            .. tostring(result)
    end

    local requestFunction =
        ZanjiGetRequestFunction()

    if type(requestFunction) == "function" then

        local requestOk,
            response =
            pcall(function()

                return requestFunction({
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["Accept"] = "text/plain",
                        ["Accept-Encoding"] = "identity",
                        ["Cache-Control"] = "no-cache",
                    },
                })
            end)

        if requestOk == true then

            local body =
                nil

            if type(response) == "string" then

                body =
                    response

            elseif type(response) == "table" then

                body =
                    response.Body
                    or response.body
                    or response.ResponseBody
                    or response.responseBody
            end

            local source,
                sourceError =
                ZanjiValidateSource(body)

            if source then
                return source, nil
            end

            failures[#failures + 1] =
                "request: "
                .. tostring(sourceError)

        else

            failures[#failures + 1] =
                "request failed: "
                .. tostring(response)
        end
    end

    return nil,
        table.concat(
            failures,
            " | "
        )
end

function ZanjiGetCompiler()

    if type(loadstring) == "function" then
        return loadstring
    end

    if type(load) == "function" then
        return load
    end

    local env =
        type(getgenv) == "function"
        and getgenv()
        or _G

    if type(env) == "table" then

        if type(env.loadstring) == "function" then
            return env.loadstring
        end

        if type(env.load) == "function" then
            return env.load
        end
    end

    return nil
end

function ZanjiLoadUrl(url, name)

    name =
        tostring(name or "remote script")

    local source,
        downloadError =
        ZanjiHttpGet(url)

    if type(source) ~= "string"
    or source == "" then

        error(
            "[ZANJI] Failed to download "
            .. name
            .. ": "
            .. tostring(downloadError),
            0
        )
    end

    local compiler =
        ZanjiGetCompiler()

    if type(compiler) ~= "function" then

        error(
            "[ZANJI] loadstring/load is missing.",
            0
        )
    end

    local compileOk,
        chunk,
        compileError =
        pcall(
            compiler,
            source
        )

    if compileOk ~= true
    or type(chunk) ~= "function" then

        error(
            "[ZANJI] Failed to compile "
            .. name
            .. ": "
            .. tostring(compileError or chunk),
            0
        )
    end

    local runOk,
        result =
        pcall(chunk)

    if runOk ~= true then

        error(
            "[ZANJI] Failed to run "
            .. name
            .. ": "
            .. tostring(result),
            0
        )
    end

    return result
end

function ZanjiCanUseFiles()

    return type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
end

function ZanjiEnsureFolder()

    if type(makefolder) ~= "function"
    or type(isfolder) ~= "function" then

        return false
    end

    local ok =
        pcall(function()

            if not isfolder(UI_SETTINGS_FOLDER) then

                makefolder(
                    UI_SETTINGS_FOLDER
                )
            end
        end)

    return ok == true
end

function ZanjiAccountTokenValid(value)

    local token =
        ZanjiCleanText(
            value
        )

    if #token < 32
    or #token > 128 then

        return false
    end

    return token:match(
        "^[%w_-]+$"
    ) ~= nil
end

function ZanjiAccountReadFile(path)

    if type(readfile) ~= "function"
    or type(isfile) ~= "function" then

        return nil
    end

    local exists =
        false

    pcall(function()

        exists =
            isfile(
                path
            )
    end)

    if exists ~= true then
        return nil
    end

    local ok,
        contents =
        pcall(function()

            return readfile(
                path
            )
        end)

    if ok ~= true
    or type(contents) ~= "string" then

        return nil
    end

    contents =
        ZanjiCleanText(
            contents
        )

    if contents == "" then
        return nil
    end

    return contents
end

function ZanjiAccountDecodeStoredToken(contents)

    contents =
        ZanjiCleanText(
            contents
        )

    if ZanjiAccountTokenValid(
        contents
    ) == true then

        return contents
    end

    local ok,
        data =
        pcall(function()

            return HttpService:JSONDecode(
                contents
            )
        end)

    if ok ~= true
    or type(data) ~= "table" then

        return nil
    end

    local token =
        ZanjiCleanText(
            data.AccountToken
            or data.account_token
            or data.Token
            or data.token
        )

    if ZanjiAccountTokenValid(
        token
    ) ~= true then

        return nil
    end

    return token
end

function ZanjiAccountLoadSavedToken()

    local token =
        ZanjiAccountDecodeStoredToken(
            ZanjiAccountReadFile(
                ZANJI_ACCOUNT_SETTINGS_FILE
            )
            or ""
        )

    local source =
        token
        and "official"
        or nil

    if not token then

        local environmentToken =
            ZANJI_ACCOUNT_ENVIRONMENT
            and ZANJI_ACCOUNT_ENVIRONMENT
                .ZANJI_ACCOUNT_TOKEN
            or nil

        if ZanjiAccountTokenValid(
            environmentToken
        ) == true then

            token =
                ZanjiCleanText(
                    environmentToken
                )

            source =
                "environment"
        end
    end

    if not token then

        token =
            ZanjiAccountDecodeStoredToken(
                ZanjiAccountReadFile(
                    ZANJI_ACCOUNT_LEGACY_TOKEN_FILE
                )
                or ""
            )

        if token then

            source =
                "legacy"
        end
    end

    ZANJI_ACCOUNT_RUNTIME.Token =
        token

    ZANJI_ACCOUNT_RUNTIME.Source =
        source

    ZANJI_ACCOUNT_RUNTIME.NeedsMigration =
        token ~= nil
        and source ~= "official"

    ZANJI_ACCOUNT_RUNTIME.Account =
        nil

    if token then

        ZANJI_ACCOUNT_ENVIRONMENT.ZANJI_ACCOUNT_TOKEN =
            token

        ZANJI_ACCOUNT_RUNTIME.Status =
            "Checking"

        ZANJI_ACCOUNT_RUNTIME.Message =
            "Authenticating the saved account..."

        return true
    end

    ZANJI_ACCOUNT_RUNTIME.Status =
        type(
            ZanjiGetRequestFunction()
        ) == "function"
        and "Not connected"
        or "Unsupported executor"

    ZANJI_ACCOUNT_RUNTIME.Message =
        type(
            ZanjiGetRequestFunction()
        ) == "function"
        and "Generate a pairing code on ZANJI HUB to connect this Roblox account."
        or "This executor does not support HTTP requests."

    return false
end

function ZanjiAccountSaveToken(token)

    token =
        ZanjiCleanText(
            token
        )

    if ZanjiAccountTokenValid(
        token
    ) ~= true
    or ZanjiCanUseFiles() ~= true then

        return false
    end

    ZanjiEnsureFolder()

    local ok,
        encoded =
        pcall(function()

            return HttpService:JSONEncode({
                Version =
                    1,

                AccountToken =
                    token,

                RobloxUserId =
                    tostring(
                        LocalPlayer.UserId
                    ),

                RobloxUsername =
                    LocalPlayer.Name,
            })
        end)

    if ok ~= true
    or type(encoded) ~= "string" then

        return false
    end

    local writeOk =
        pcall(function()

            writefile(
                ZANJI_ACCOUNT_SETTINGS_FILE,
                encoded
            )
        end)

    if writeOk == true then

        ZANJI_ACCOUNT_RUNTIME.Source =
            "official"

        ZANJI_ACCOUNT_RUNTIME.NeedsMigration =
            false
    end

    return writeOk == true
end

function ZanjiAccountDeleteStoredFile(path)

    if type(isfile) ~= "function" then
        return false
    end

    local exists =
        false

    pcall(function()

        exists =
            isfile(
                path
            )
    end)

    if exists ~= true then
        return true
    end

    if type(delfile) == "function" then

        return pcall(
            delfile,
            path
        )
    end

    if type(writefile) == "function" then

        return pcall(
            writefile,
            path,
            ""
        )
    end

    return false
end

