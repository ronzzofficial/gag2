function ZanjiMergeAutomationReadDelay(value)

    local number =
        tonumber(value)

    if number == nil
    or number ~= number
    or number == math.huge
    or number == -math.huge then

        number =
            3
    end

    return math.max(
        0,
        number
    )
end

