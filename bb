        )
    end

    return false
end

function ZanjiLivePetsDisconnect()

    local connections =
        ZANJI_LIVE_PETS_RUNTIME
        and ZANJI_LIVE_PETS_RUNTIME.Connections
        or nil

    if type(connections) == "table" then

        for _, connection in ipairs(connections) do

            pcall(function()

                connection:Disconnect()
            end)
        end
    end

    ZANJI_LIVE_PETS_RUNTIME.Connections =
        {}
end

function ZanjiLivePetsStart()

    ZANJI_LIVE_PETS_RUNTIME =
        type(ZANJI_LIVE_PETS_RUNTIME) == "table"
        and ZANJI_LIVE_PETS_RUNTIME
        or {}

    if ZANJI_LIVE_PETS_RUNTIME.Running == true then
        return false
    end

    ZanjiLivePetsDisconnect()

    ZANJI_LIVE_PETS_RUNTIME.Running =
        true

    ZANJI_LIVE_PETS_RUNTIME.RefreshQueued =
        true

    ZANJI_LIVE_PETS_RUNTIME.LastRefreshAt =
        0

    local token =
        {}

    ZANJI_LIVE_PETS_RUNTIME.Token =
        token

    local function queueRefresh()

        ZANJI_LIVE_PETS_RUNTIME.RefreshQueued =
            true
    end

    local function connectRoot(root)

        if typeof(root) ~= "Instance" then
            return
        end

        table.insert(
            ZANJI_LIVE_PETS_RUNTIME.Connections,
            root.ChildAdded:Connect(
                queueRefresh
            )
        )

        table.insert(
            ZANJI_LIVE_PETS_RUNTIME.Connections,
            root.ChildRemoved:Connect(
                queueRefresh
            )
        )
    end

    connectRoot(
        ZanjiSniperGetWildPetRefRoot()
    )

    connectRoot(
        ZanjiSniperGetWildPetRoot()
    )

    task.spawn(function()

        while ZANJI_LIVE_PETS_RUNTIME.Token == token do

            local lowEnd =
                ZanjiLowEndModeEnabled()

            local periodicInterval =
                lowEnd == true
                and 1
                or 0.35

            local eventInterval =
                lowEnd == true
                and 0.75
                or 0.25

            local now =
                os.clock()

            local elapsed =
                now
                - (
                    tonumber(
                        ZANJI_LIVE_PETS_RUNTIME.LastRefreshAt
                    )
                    or 0
                )

            local eventReady =
                ZANJI_LIVE_PETS_RUNTIME.RefreshQueued == true
                and elapsed >= eventInterval

            local periodicReady =
                elapsed >= periodicInterval

            if eventReady
            or periodicReady then

                ZANJI_LIVE_PETS_RUNTIME.RefreshQueued =
                    false

                ZANJI_LIVE_PETS_RUNTIME.LastRefreshAt =
                    now

                ZanjiLivePetsRefreshUI()
            end

            task.wait(
                lowEnd == true
                and 0.25
                or 0.10
            )
        end

        if ZANJI_LIVE_PETS_RUNTIME.Token == token then

            ZANJI_LIVE_PETS_RUNTIME.Running =
                false
        end
    end)

    return true
end

function ZanjiLivePetsStop(reason)

    ZANJI_LIVE_PETS_RUNTIME =
        type(ZANJI_LIVE_PETS_RUNTIME) == "table"
        and ZANJI_LIVE_PETS_RUNTIME
        or {}

    ZANJI_LIVE_PETS_RUNTIME.Token =
        nil

    ZANJI_LIVE_PETS_RUNTIME.Running =
        false

    ZanjiLivePetsDisconnect()

    return true
end

