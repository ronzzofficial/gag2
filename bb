function ZanjiGuildCollectOnline(value, output, depth)

    output =
        type(output) == "table"
        and output
        or {}

    depth =
        tonumber(depth)
        or 0

    if depth > 4 then
        return output
    end

    if type(value) == "number"
    or (
        type(value) == "string"
        and tonumber(value) ~= nil
    ) then

        output[
            tonumber(value)
        ] =
            true

        return output
    end

    if type(value) ~= "table" then
        return output
    end

    local directUserId =
        tonumber(
            ZanjiGuildField(
                value,
                {
                    "UserId",
                    "UserID",
                    "PlayerId",
                    "Id",
                }
            )
        )

    local online =
        ZanjiGuildField(
            value,
            {
                "Online",
                "IsOnline",
                "Present",
            }
        )

    if directUserId
    and online ~= false then

        output[directUserId] =
            true
    end

    for key, child in pairs(value) do

        local numericKey =
            tonumber(key)

        if numericKey
        and type(child) == "boolean"
        and child == true then

            output[numericKey] =
                true

        elseif type(child) == "number" then

            local keyText =
                ZanjiGuildKey(key)

            if type(key) == "number"
            or keyText:find("userid", 1, true)
            or keyText:find("playerid", 1, true) then

                output[child] =
                    true
            end

        elseif type(child) == "table" then

            ZanjiGuildCollectOnline(
                child,
                output,
                depth + 1
            )
        end
    end

    return output
end

function ZanjiGuildBuildMembers()

    local root =
        ZanjiGuildSnapshotRoot(
            ZANJI_GUILD_STATE.Snapshot
        )

    local rawMembers =
        ZanjiGuildField(
            root,
            {
                "Members",
                "MemberList",
                "GuildMembers",
            },
            {}
        )

    local rows = {}

    if type(rawMembers) ~= "table" then
        return rows
    end

    for key, rawMember in pairs(rawMembers) do

        local member =
            type(rawMember) == "table"
            and rawMember
            or {}

        local userId =
            tonumber(
                ZanjiGuildField(
                    member,
                    {
                        "UserId",
                        "UserID",
                        "PlayerId",
                        "Id",
                    }
                )
            )

        if userId == nil then

            userId =
                tonumber(
                    type(rawMember) == "number"
                    and rawMember
                    or key
                )
        end

        if userId then

            local username =
                ZanjiCleanText(
                    ZanjiGuildField(
                        member,
                        {
                            "Username",
                            "UserName",
                            "Name",
                            "PlayerName",
                        },
                        ""
                    )
                )

            if username ~= "" then

                ZANJI_GUILD_STATE.NameCache[userId] =
                    username

            else

                username =
                    ZANJI_GUILD_STATE.NameCache[userId]
                    or ""

                ZanjiGuildRequestName(
                    userId
                )
            end

            if userId == LocalPlayer.UserId then

                username =
                    LocalPlayer.Name

                ZANJI_GUILD_STATE.NameCache[userId] =
                    username
            end

            rows[#rows + 1] = {
                UserId = userId,

                Username =
                    username ~= ""
                    and username
                    or (
                        "User "
                        .. tostring(userId)
                    ),

                DisplayName =
                    ZanjiCleanText(
                        ZanjiGuildField(
                            member,
                            {
                                "DisplayName",
                            },
                            ""
                        )
                    ),

                Role =
                    ZanjiGuildRole(
                        ZanjiGuildField(
                            member,
                            {
                                "Role",
                                "GuildRole",
                                "Rank",
                            },
                            "Member"
                        )
                    ),

                Weekly =
                    tonumber(
                        ZanjiGuildField(
                            member,
                            {
                                "WeeklyContribution",
                                "WeeklyContributions",
                                "WeeklyScore",
                                "WeekContribution",
                            },
                            0
                        )
                    )
                    or 0,

                Lifetime =
                    tonumber(
                        ZanjiGuildField(
                            member,
                            {
                                "LifetimeContribution",
                                "LifetimeContributions",
                                "TotalContribution",
                                "Contribution",
                            },
                            0
                        )
                    )
                    or 0,

                JoinedAt =
                    ZanjiGuildField(
                        member,
                        {
                            "JoinedAt",
                            "JoinTime",
                            "Joined",
                            "CreatedAt",
                        }
                    ),

                Online =
                    ZANJI_GUILD_STATE.OnlineMembers[userId]
                    == true,

                Raw =
                    member,
            }
        end
    end

    local sortMode =
        tostring(
            ZANJI_GUILD_STATE.MemberSort
            or "Role"
        )

    table.sort(
        rows,
        function(left, right)

            if sortMode == "Online"
            and left.Online ~= right.Online then

                return left.Online == true
            end

            if sortMode == "Contribution"
            and left.Weekly ~= right.Weekly then

                return left.Weekly > right.Weekly
            end

            local leftRank =
                ZanjiGuildRoleRank(
                    left.Role
                )

            local rightRank =
                ZanjiGuildRoleRank(
                    right.Role
                )

            if leftRank ~= rightRank then
                return leftRank < rightRank
            end

            if left.Online ~= right.Online then
                return left.Online == true
            end

            return tostring(left.Username):lower()
                < tostring(right.Username):lower()
        end
    )

    return rows
end

