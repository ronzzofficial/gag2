function ZanjiFarmDetailsGetFilterValues(
    groups
)

    local plants =
        {}

    local mutations =
        {}

    local mutationSeen =
        {}

    for _,
        group in ipairs(groups or {}) do

        table.insert(
            plants,
            group.Name
        )

        for _,
            fruit in ipairs(
                group.Fruits
                or {}
            ) do

            for _,
                mutation in ipairs(
                    fruit.Mutations
                    or {}
                ) do

                if mutationSeen[mutation] ~= true then

                    mutationSeen[mutation] =
                        true

                    table.insert(
                        mutations,
                        mutation
                    )
                end
            end
        end
    end

    table.sort(plants, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    table.sort(mutations, function(a, b)

        if a == "Normal" then
            return true
        end

        if b == "Normal" then
            return false
        end

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return plants,
        mutations
end

function ZanjiFarmDetailsBuildFilterList()

    local ui =
        ZANJI_FARM_DETAILS_UI

    local list =
        ui.FilterList

    if typeof(list) ~= "Instance" then
        return false
    end

    for _,
        child in ipairs(
            list:GetChildren()
        ) do

        if child:IsA("TextButton") then

            child:Destroy()
        end
    end

    local groups =
        ZanjiFarmDetailsBuildGroups()

    local plants,
        mutations =
        ZanjiFarmDetailsGetFilterValues(
            groups
        )

    local mode =
        ZANJI_FARM_DETAILS_RUNTIME.FilterMode

    local values =
        mode == "Mutations"
        and mutations
        or plants

    ui.PlantsTab.BackgroundColor3 =
        Color3.fromRGB(
            21,
            15,
            24
        )

    ui.PlantsTab.BackgroundTransparency =
        mode == "Plants"
        and 0
        or 1

    ui.PlantsTab.TextColor3 =
        mode == "Plants"
        and Color3.fromRGB(
            255,
            47,
            104
        )
        or Color3.fromRGB(
            145,
            151,
            164
        )

    ui.MutationsTab.BackgroundColor3 =
        Color3.fromRGB(
            21,
            15,
            24
        )

    ui.MutationsTab.BackgroundTransparency =
        mode == "Mutations"
        and 0
        or 1

    ui.MutationsTab.TextColor3 =
        mode == "Mutations"
        and Color3.fromRGB(
            255,
            47,
            104
        )
        or Color3.fromRGB(
            145,
            151,
            164
        )

    ui.FilterEmpty.Visible =
        #values <= 0

    ui.FilterEmpty.Text =
        ZANJI_FARM_DETAILS_RUNTIME.SnapshotReady == true
        and "No filters available."
        or "Waiting for garden data..."

    local selectedSet =
        mode == "Mutations"
        and ZANJI_FARM_DETAILS_STATE.SelectedMutations
        or ZANJI_FARM_DETAILS_STATE.SelectedPlants

    for index,
        value in ipairs(values) do

        local selected =
            selectedSet[value] == true

        local button =
            ZanjiFarmDetailsCreateButton(
                list,
                (
                    selected
                    and "✓  "
                    or ""
                )
                .. value,
                UDim2.new(),
                UDim2.new(
                    1,
                    -6,
                    0,
                    27
                )
            )

        button.LayoutOrder =
            index

        button.ZIndex =
            13

        button.TextXAlignment =
            Enum.TextXAlignment.Left

        button.TextSize =
            10

        button.BackgroundColor3 =
            Color3.fromRGB(
                28,
                15,
                25
            )

        button.BackgroundTransparency =
            selected
            and 0
            or 1

        if mode == "Mutations" then

            local hex =
                ZanjiFarmDetailsMutationHex(
                    value
                )

            local red,
                green,
                blue =
                hex:match(
                    "#(%x%x)(%x%x)(%x%x)"
                )

            if red then

                button.TextColor3 =
                    Color3.fromRGB(
                        tonumber(red, 16),
                        tonumber(green, 16),
                        tonumber(blue, 16)
                    )
            end

        else

            button.TextColor3 =
                selected
                and Color3.fromRGB(
                    255,
                    47,
                    104
                )
                or Color3.fromRGB(
                    242,
                    244,
                    248
                )
        end

        button.MouseButton1Click:Connect(
            function()

                if selectedSet[value] == true then

                    selectedSet[value] =
                        nil

                else

                    selectedSet[value] =
                        true
                end

                ZANJI_FARM_DETAILS_STATE.OverviewPage =
                    1

                ZANJI_FARM_DETAILS_STATE.FruitPage =
                    1

                ZanjiFarmDetailsRender()

                ZanjiFarmDetailsBuildFilterList()
            end
        )
    end

    list.CanvasSize =
        UDim2.fromOffset(
            0,
            math.max(
                0,
                #values * 31
            )
        )

    return true
end

function ZanjiFarmDetailsRender()

    local ui =
        ZANJI_FARM_DETAILS_UI

    if typeof(ui.Surface) ~= "Instance" then
        return false
    end

    ZANJI_FARM_DETAILS_RUNTIME.LastRenderAt =
        os.clock()

    ZANJI_FARM_DETAILS_RUNTIME.RefreshQueued =
        false

    ZanjiFarmDetailsResetRows()

    local allGroups =
        ZanjiFarmDetailsBuildGroups()

    local groups =
        ZanjiFarmDetailsGetVisibleGroups(
            allGroups
        )

    ZanjiFarmDetailsSetFilterDescription(
        groups
    )

    local selectedPlantCount =
        ZanjiFarmDetailsCountSet(
            ZANJI_FARM_DETAILS_STATE.SelectedPlants
        )

    if selectedPlantCount == 1
    and #groups == 1 then

        ZanjiFarmDetailsRenderFruits(
            groups[1]
        )

    else

        ZanjiFarmDetailsRenderOverview(
            groups
        )
    end

    if typeof(ui.FilterPanel) == "Instance"
    and ui.FilterPanel.Visible == true then

        local signatureParts =
            {}

        for _,
            group in ipairs(allGroups) do

            table.insert(
                signatureParts,
                group.Name
                .. ":"
                .. tostring(
                    #group.Fruits
                )
            )
        end

        local signature =
            table.concat(
                signatureParts,
                "|"
            )

        if signature
            ~= ZANJI_FARM_DETAILS_RUNTIME.LastFilterSignature then

            ZANJI_FARM_DETAILS_RUNTIME.LastFilterSignature =
                signature

            ZanjiFarmDetailsBuildFilterList()
        end
    end

    return true
end

