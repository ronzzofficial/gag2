            ),

        AutoClaim =
            ZANJI_MAIL_STATE.AutoClaim == true,

        InboxInterval =
            ZanjiMailNormalizeInboxInterval(
                ZANJI_MAIL_STATE.InboxInterval
                or "2 seconds"
            ),

        ValueStrategy =
            ZanjiMailNormalizeValueStrategy(
                ZANJI_MAIL_STATE.ValueStrategy
            ),

        ExtraLimitMode =
            ZanjiMailNormalizeExtraLimitMode(
                ZANJI_MAIL_STATE.ExtraLimitMode
            ),

        ExtraLimitCustom =
            ZanjiMailNormalizeExtraLimitCustom(
                ZANJI_MAIL_STATE.ExtraLimitCustom
            ),

        FilterFruits =
            ZanjiMailNormalizeFilterSelection(
                ZANJI_MAIL_STATE.FilterFruits
            ),

        FilterMutations =
            ZanjiMailNormalizeFilterSelection(
                ZANJI_MAIL_STATE.FilterMutations
            ),

        SavedRecipients =
            ZanjiMailNormalizeRecipientRecords(
                ZANJI_MAIL_STATE.SavedRecipients,
                25,
                true
            ),

        RecentRecipients =
            ZanjiMailNormalizeRecipientRecords(
                ZANJI_MAIL_STATE.RecentRecipients,
                8,
                false
            ),

        FleetAccounts =
            ZanjiMailNormalizeFleetAccounts(
                ZANJI_MAIL_STATE.FleetAccounts
            ),

        FleetGroups =
            ZanjiMailNormalizeFleetGroups(
                ZANJI_MAIL_STATE.FleetGroups
            ),

        HudPosition =
            position,

        TrackerDay =
            tostring(ZANJI_MAIL_STATE.TrackerDay),

        TrackerUsed =
