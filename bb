function ZanjiFarmMiddleSniperBusy()

    if type(ZANJI_DEFENSE_RUNTIME) == "table"
    and ZANJI_DEFENSE_RUNTIME.Active == true then

        return true,
            "pet defense"
    end

    local runtime =
        type(ZANJI_SNIPER_RUNTIME) == "table"
        and ZANJI_SNIPER_RUNTIME
        or {}

    if runtime.Buying == true then
        return true, "sniper buying"
    end

    if runtime.Returning == true then
        return true, "sniper returning"
    end

    if runtime.AutoHopInProgress == true then
        return true, "auto hop"
    end

    if runtime.CurrentTarget ~= nil then
        return true, "sniper target"
    end

    if ZanjiCleanText(runtime.CurrentTargetKey) ~= "" then
        return true, "sniper target"
    end

    if runtime.BatchActive == true then
        return true, "sniper batch"
    end

    if type(ZanjiSniperTargetLockActive) == "function" then

        local ok,
            active,
            reason =
            pcall(function()

                return ZanjiSniperTargetLockActive()
            end)

        if ok == true
        and active == true then

            return true,
                tostring(reason or "target locked")
        end
    end

    if type(ZanjiSniperPetBuyProtectionActive) == "function" then

        local ok,
            active,
            reason =
            pcall(function()

                return ZanjiSniperPetBuyProtectionActive()
            end)

        if ok == true
        and active == true then

            return true,
                tostring(reason or "pet buy protection")
        end
    end

    local lastMatchAt =
        tonumber(runtime.LastMatchAt)
        or 0

    local matchCount =
        tonumber(runtime.MatchCount)
        or 0

    if matchCount > 0
    and os.clock() - lastMatchAt <= 3 then

        return true,
            "match found"
    end

    local seedBusy,
        seedReason =
        ZanjiFarmMiddleSeedCollectorBusy()

    if seedBusy == true then
        return true, seedReason
    end

    return false,
        "clear"
end

function ZanjiFarmMiddleResolveTarget(forceRefresh)

    local state =
        ZanjiFarmMiddleGetState()

    if forceRefresh ~= true
    and typeof(state.TargetCFrame) == "CFrame"
    and os.clock() - (
        tonumber(state.TargetResolvedAt)
        or 0
    ) < state.TargetRefreshSeconds then

        return state.TargetCFrame
    end

    local cframe =
        nil

    if type(ZanjiSniperGetFarmCenterCFrame) == "function" then

        cframe =
            ZanjiSniperGetFarmCenterCFrame(
                true
            )
    end

    if typeof(cframe) == "CFrame" then

        state.TargetCFrame =
            cframe

        state.TargetResolvedAt =
            os.clock()

        return cframe
    end

    return nil
end

function ZanjiFarmMiddleFlatDistance(root, targetPosition)

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or typeof(targetPosition) ~= "Vector3" then

        return math.huge
    end

    return (
        Vector3.new(
            root.Position.X,
            0,
            root.Position.Z
        )
        -
        Vector3.new(
            targetPosition.X,
            0,
            targetPosition.Z
        )
    ).Magnitude
end

function ZanjiFarmMiddleRunWorker(token, reason)

    local state =
        ZanjiFarmMiddleGetState()

    state.StartedAt =
        os.clock()

    state.Running =
        true

    state.Done =
        false

    state.Moving =
        false

    state.ManualCancelled =
        false

    state.SniperCancelled =
        false

    state.CancelArmed =
        false

    state.AcceptManualInputAfter =
        0

    state.TargetCFrame =
        nil

    state.TargetResolvedAt =
        0

    local loadingReadyAt =
        0

    ZanjiFarmMiddleSetStatus(
        "Waiting loading",
        tostring(reason or "startup")
    )

    while state.Token == token
    and state.Enabled == true
    and ZANJI_DEV_UI_STATE.AutoFarmMiddle == true
    and os.clock() - state.StartedAt <= state.MaxRunSeconds do

        if state.ManualCancelled == true then

            ZanjiFarmMiddleStopMovement()

            state.Running =
                false

            state.Moving =
                false

            return false
        end

        local loadingReady,
            loadingReason =
            ZanjiFarmMiddleLoadingReady()

        if loadingReady ~= true then

            state.CancelArmed =
                false

            state.Moving =
                false

            ZanjiFarmMiddleSetStatus(
                "Waiting loading",
                loadingReason
            )

            task.wait(
                0.15
            )

            continue
        end

        if loadingReadyAt <= 0 then

            loadingReadyAt =
                os.clock()

            state.CancelArmed =
                true

            state.AcceptManualInputAfter =
                os.clock()
                + state.ManualCancelGrace
                + state.StartAfterLoadingDelay

            ZanjiFarmMiddleSetStatus(
                "Settling",
                "loading ready"
            )
        end

        if os.clock() - loadingReadyAt < state.StartAfterLoadingDelay then

            task.wait(
                0.05
            )

            continue
        end

        if ZanjiFarmMiddleManualInputDown() == true then

            ZanjiFarmMiddleCancel(
                "manual movement"
            )

            return false
        end

        local sniperBusy,
            busyReason =
            ZanjiFarmMiddleSniperBusy()

        if sniperBusy == true then

            ZanjiFarmMiddleCancelForSniper(
                busyReason
            )

            return false
        end

        local targetCFrame =
            ZanjiFarmMiddleResolveTarget(
                os.clock() - (
                    tonumber(state.TargetResolvedAt)
                    or 0
                ) >= state.TargetRefreshSeconds
            )

        if typeof(targetCFrame) ~= "CFrame" then

            state.Moving =
                false

            ZanjiFarmMiddleSetStatus(
                "Waiting farm",
                "farm middle not found"
            )

            task.wait(
                state.MissingTargetDelay
            )

            continue
        end

        local humanoid =
            ZanjiSniperGetCharacterHumanoid()

        local root =
            ZanjiSniperGetCharacterRoot()

        if typeof(humanoid) ~= "Instance"
        or humanoid:IsA("Humanoid") ~= true
        or typeof(root) ~= "Instance"
        or root:IsA("BasePart") ~= true then

            state.Moving =
                false

            ZanjiFarmMiddleSetStatus(
                "Waiting character",
                "humanoid/root missing"
            )

            task.wait(
                0.15
            )

            continue
        end

        local targetPosition =
            targetCFrame.Position

        local distance =
            ZanjiFarmMiddleFlatDistance(
                root,
                targetPosition
            )

        state.LastDistance =
            distance

        if distance <= state.StopDistance then

            state.Done =
                true

            state.Running =
                false

            state.Moving =
                false

            state.CancelArmed =
                false

            ZanjiFarmMiddleStopMovement()

            ZanjiFarmMiddleSetStatus(
                "Done",
                tostring(
                    math.floor(distance + 0.5)
                )
                .. " studs"
            )

            return true
        end

        state.Moving =
            true

        state.CancelArmed =
            true

        if (
            tonumber(state.AcceptManualInputAfter)
            or 0
        ) <= 0 then

            state.AcceptManualInputAfter =
                os.clock()
                + state.ManualCancelGrace
        end

        ZanjiFarmMiddleSetStatus(
            "Walking",
            tostring(
                math.floor(distance + 0.5)
            )
            .. " studs"
        )

        local movePosition =
            Vector3.new(
                targetPosition.X,
                root.Position.Y,
                targetPosition.Z
            )

        if type(ZanjiSniperClearHeldToolForMovement) == "function" then

            ZanjiSniperClearHeldToolForMovement(
                "farm middle walk"
            )
        end

        pcall(function()

            humanoid:MoveTo(
                movePosition
            )
        end)

        state.LastMoveAt =
            os.clock()

        task.wait(
            state.MoveRetryDelay
        )
    end

    if state.Token == token then

        state.Running =
            false

        state.Moving =
            false

        state.CancelArmed =
            false

        ZanjiFarmMiddleStopMovement()

        ZanjiFarmMiddleSetStatus(
            "Stopped",
            "timeout"
        )
    end

    return false
end

function ZanjiFarmMiddleStop(reason)

    local state =
        ZanjiFarmMiddleGetState()

    state.Token =
        nil

    state.Running =
        false

    state.Moving =
        false

    state.CancelArmed =
        false

    ZanjiFarmMiddleStopMovement()

    ZanjiFarmMiddleSetStatus(
        "Stopped",
        reason or "manual"
    )

    return true
end

function ZanjiFarmMiddleStart(reason)

    local state =
        ZanjiFarmMiddleGetState()

    if ZANJI_DEV_UI_STATE.AutoFarmMiddle ~= true then

        return false
    end

    state.Enabled =
        true

    if type(ZanjiFruitAutomationPickupOwnsMovement)
        == "function"
    and ZanjiFruitAutomationPickupOwnsMovement() == true then

        state.Token =
            nil

        state.Running =
            false

        state.Moving =
            false

        state.CancelArmed =
            false

        ZanjiFarmMiddleStopMovement()

        ZanjiFarmMiddleSetStatus(
            "Paused",
            "dropped fruit walking"
        )

        return false
    end

    if ZanjiFarmMiddleWateringRejoinActive() == true then

        ZanjiFarmMiddlePauseForWatering(
            "watering rejoin active"
        )

        return false
    end

    if state.Running == true then

        return false
    end

    ZanjiFarmMiddleConnectInputWatcher()

    local token =
        {}

    state.Token =
        token

    state.Running =
        true

    state.Done =
        false

    state.ManualCancelled =
        false

    state.SniperCancelled =
        false

    state.Moving =
        false

    state.CancelArmed =
        false

    task.spawn(function()

        ZanjiFarmMiddleRunWorker(
            token,
            reason or "startup"
        )
    end)

    return true
end

function ZanjiFarmMiddleConnectCharacterWatcher()

    local state =
        ZanjiFarmMiddleGetState()

    if state.CharacterConnection then
        return true
    end

    if not LocalPlayer then
        return false
    end

    state.CharacterConnection =
        LocalPlayer.CharacterAdded:Connect(function()

            local liveState =
                ZanjiFarmMiddleGetState()

            liveState.Token =
                nil

            liveState.Running =
                false

            liveState.Moving =
                false

            liveState.Done =
                false

            liveState.ManualCancelled =
                false

            liveState.SniperCancelled =
                false

            liveState.CancelArmed =
                false

            liveState.TargetCFrame =
                nil

            liveState.TargetResolvedAt =
                0

            if ZANJI_DEV_UI_STATE.AutoFarmMiddle == true then

                task.delay(0.65, function()

                    if ZANJI_DEV_UI_STATE.AutoFarmMiddle == true then

                        ZanjiFarmMiddleStart(
                            "respawn"
                        )
                    end
                end)
            end
        end)

    return true
end

function ZanjiFarmMiddleDisconnectCharacterWatcher()

    local state =
        ZanjiFarmMiddleGetState()

    if state.CharacterConnection then

        pcall(function()

            state.CharacterConnection:Disconnect()
        end)
    end

    state.CharacterConnection =
        nil
end

function ZanjiFarmMiddleSetEnabled(value, reason)

    local enabled =
        value == true

    ZANJI_DEV_UI_STATE.AutoFarmMiddle =
        enabled

    local state =
        ZanjiFarmMiddleGetState()

    state.Enabled =
        enabled

    ZanjiSaveUISettings()

    if enabled == true then

        ZanjiFarmMiddleConnectCharacterWatcher()

        state.ManualCancelled =
            false

        state.SniperCancelled =
            false

        state.Done =
            false

        return ZanjiFarmMiddleStart(
            reason or "enabled"
        )
    end

    ZanjiFarmMiddleStop(
        reason or "disabled"
    )

    ZanjiFarmMiddleDisconnectCharacterWatcher()
    ZanjiFarmMiddleDisconnectInputWatcher()

    return true
end

function ZanjiFarmMiddleRestoreState()

    local state =
        ZanjiFarmMiddleGetState()

    state.Enabled =
        ZANJI_DEV_UI_STATE.AutoFarmMiddle == true

    if state.Enabled == true then

        ZanjiFarmMiddleConnectCharacterWatcher()

        task.defer(function()

            ZanjiFarmMiddleStart(
                "startup"
            )
        end)

    else

        ZanjiFarmMiddleStop(
            "disabled"
        )
    end

    return true
end

function ZanjiSniperResolveReturnCFrame()

    local destination =
        ZanjiSniperNormalizeReturnDestination(
            ZANJI_SNIPER_STATE.ReturnDestination
        )

    local savedCFrame =
        ZanjiSniperGetSavedReturnCFrame()

    local activationCFrame =
        typeof(ZANJI_SNIPER_RUNTIME.ReturnActivationCFrame) == "CFrame"
        and ZANJI_SNIPER_RUNTIME.ReturnActivationCFrame
        or nil

    local root =
        ZanjiSniperGetCharacterRoot()

    local currentCFrame =
        root
        and root:IsA("BasePart")
        and root.CFrame
        or nil

    if destination == "Saved Position" then

        if savedCFrame then
            return savedCFrame, "Saved Position"
        end

        if activationCFrame then
            return activationCFrame, "Sniper Start"
        end

        local farmCFrame =
            ZanjiSniperGetFarmCenterCFrame()

        if farmCFrame then
            return farmCFrame, "Farm Center"
        end

        return currentCFrame,
            "Current Position"
    end

    local farmCFrame =
        ZanjiSniperGetFarmCenterCFrame()

    if farmCFrame then
        return farmCFrame, "Farm Center"
    end

    if savedCFrame then
        return savedCFrame, "Saved Position"
    end

    if activationCFrame then
        return activationCFrame, "Sniper Start"
    end

    return currentCFrame,
        "Current Position"
end

function ZanjiSniperReturnTeleport(cframe, token)

    ZanjiSniperClearHeldToolForMovement(
        "return teleport"
    )

    if typeof(cframe) ~= "CFrame" then
        return false, "missing return cframe"
    end

    if ZanjiSniperStillActive(token) ~= true then
        return false, "stopped"
    end

    local root =
        ZanjiSniperGetCharacterRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return false,
            "missing root"
    end

    ZanjiSniperZeroRootVelocity(
        root
    )

    local ok,
        err =
        pcall(function()

            root.CFrame =
                cframe
        end)

    if ok ~= true then

        return false,
            "teleport return failed "
            .. tostring(err)
    end

    task.wait(
        0.08
    )

    ZanjiSniperZeroRootVelocity(
        root
    )

    return true,
        "teleported"
end

function ZanjiSniperReturnWalk(cframe, token)

    ZanjiSniperClearHeldToolForMovement(
        "return walk start"
    )

    if typeof(cframe) ~= "CFrame" then
        return false, "missing return cframe"
    end

    local targetPosition =
        cframe.Position

    local timeout =
        tonumber(
            ZANJI_SNIPER_RUNTIME.ReturnWalkTimeout
        )
        or 22

    local arriveDistance =
        tonumber(
            ZANJI_SNIPER_RUNTIME.ReturnArriveDistance
        )
        or 12

    local startedAt =
        os.clock()

    local lastStatusAt =
        0

    while ZanjiSniperStillActive(token) == true
    and os.clock() - startedAt <= timeout do

        ZanjiSniperClearHeldToolForMovement(
            "return walk loop"
        )

        local humanoid =
            ZanjiSniperGetCharacterHumanoid()

        local root =
            ZanjiSniperGetCharacterRoot()

        if typeof(humanoid) ~= "Instance"
        or typeof(root) ~= "Instance"
        or root:IsA("BasePart") ~= true then

            return false,
                "missing humanoid/root"
        end

        if ZanjiSniperManualReturnCancelled(
            startedAt
        ) == true then

            ZanjiSniperStopHumanoidMovement(
                humanoid,
                root
            )

            return false,
                "manual movement"
        end

        local flatDelta =
            Vector3.new(
                root.Position.X - targetPosition.X,
                0,
                root.Position.Z - targetPosition.Z
            )

        local flatDistance =
            flatDelta.Magnitude

        if os.clock() - lastStatusAt >= 0.55 then

            lastStatusAt =
                os.clock()

            ZanjiSniperSetStatus(
                "Returning / "
                .. tostring(
                    math.floor(flatDistance + 0.5)
                )
                .. " studs"
            )
        end

        if flatDistance <= arriveDistance then

            ZanjiSniperStopHumanoidMovement(
                humanoid,
                root
            )

            ZanjiSniperZeroRootVelocity(
                root
            )

            return true,
                "walked"
        end

        local movePosition =
            Vector3.new(
                targetPosition.X,
                root.Position.Y,
                targetPosition.Z
            )

        pcall(function()

            humanoid:MoveTo(
                movePosition
            )
        end)

        task.wait(
            0.14
        )
    end

    local humanoid =
        ZanjiSniperGetCharacterHumanoid()

    local root =
        ZanjiSniperGetCharacterRoot()

    ZanjiSniperStopHumanoidMovement(
        humanoid,
        root
    )

    return false,
        "return walk timeout"
end

function ZanjiSniperReturnToDestination(reason, token)

    if ZANJI_SNIPER_STATE.ReturnEnabled ~= true then
        return false
    end

    if type(ZANJI_DEFENSE_RUNTIME) == "table"
    and ZANJI_DEFENSE_RUNTIME.Active == true then

        return false
    end

    if ZANJI_SNIPER_RUNTIME.Returning == true then
        return false
    end

    local cframe,
        destinationName =
        ZanjiSniperResolveReturnCFrame()

    if typeof(cframe) ~= "CFrame" then

        ZanjiSniperSetStatus(
            "Return skipped: no destination"
        )

        return false
    end

    ZANJI_SNIPER_RUNTIME.Returning =
        true

    ZanjiSniperSetStatus(
        "Returning to "
        .. tostring(destinationName)
    )

    local mode =
        ZanjiSniperNormalizeReturnMode(
            ZANJI_SNIPER_STATE.ReturnMode
        )

    local ok,
        returnReason =
        false,
        ""

    if mode == "Teleport" then

        ok,
            returnReason =
            ZanjiSniperReturnTeleport(
                cframe,
                token
            )

    else

        ok,
            returnReason =
            ZanjiSniperReturnWalk(
                cframe,
                token
            )
    end

    ZANJI_SNIPER_RUNTIME.Returning =
        false

    if ok == true then

        ZanjiSniperSetStatus(
            "Returned to "
            .. tostring(destinationName)
        )

    elseif tostring(returnReason) == "manual movement" then

        ZanjiSniperSetStatus(
            "Return cancelled by movement"
        )

    else

        ZanjiSniperSetStatus(
            "Return failed: "
            .. tostring(returnReason)
        )
    end

    return ok
end

function ZanjiSniperRegisterConfirmedBuy(match, entry)

    if ZANJI_SNIPER_STATE.ReturnEnabled ~= true then
        return
    end

    if ZanjiSniperNormalizeReturnTiming(
        ZANJI_SNIPER_STATE.ReturnTiming
    ) ~= "After Batch" then

        return
    end

    ZANJI_SNIPER_RUNTIME.BatchActive =
        true

    ZANJI_SNIPER_RUNTIME.BatchBoughtCount =
        (
            tonumber(
                ZANJI_SNIPER_RUNTIME.BatchBoughtCount
            )
            or 0
        )
        + 1

    ZANJI_SNIPER_RUNTIME.BatchEmptySince =
        0
end

function ZanjiSniperMaybeReturnAfterBuy(token)

    if ZANJI_SNIPER_STATE.ReturnEnabled ~= true then
        return false
    end

    if ZanjiSniperNormalizeReturnTiming(
        ZANJI_SNIPER_STATE.ReturnTiming
    ) ~= "After Buy" then

        return false
    end

    return ZanjiSniperReturnToDestination(
        "after buy",
        token
    )
end

function ZanjiSniperMaybeReturnAfterBatchNoMatches(token)

    if ZANJI_SNIPER_STATE.ReturnEnabled ~= true then
        return false
    end

    if ZanjiSniperNormalizeReturnTiming(
        ZANJI_SNIPER_STATE.ReturnTiming
    ) ~= "After Batch" then

        ZANJI_SNIPER_RUNTIME.BatchActive =
            false

        ZANJI_SNIPER_RUNTIME.BatchBoughtCount =
            0

        ZANJI_SNIPER_RUNTIME.BatchEmptySince =
            0

        return false
    end

    if ZANJI_SNIPER_RUNTIME.BatchActive ~= true then
        return false
    end

    if (
        tonumber(
            ZANJI_SNIPER_RUNTIME.BatchBoughtCount
        )
        or 0
    ) <= 0 then

        return false
    end

    if ZANJI_SNIPER_RUNTIME.Buying == true
    or ZANJI_SNIPER_RUNTIME.Returning == true then

        return false
    end

    local now =
        os.clock()

    if (
        tonumber(
            ZANJI_SNIPER_RUNTIME.BatchEmptySince
        )
        or 0
    ) <= 0 then

        ZANJI_SNIPER_RUNTIME.BatchEmptySince =
            now

        ZanjiSniperSetStatus(
            "Batch clear, waiting..."
        )

        return false
    end

    local stableSeconds =
        tonumber(
            ZANJI_SNIPER_RUNTIME.BatchStableSeconds
        )
        or 1.5

    if now - ZANJI_SNIPER_RUNTIME.BatchEmptySince < stableSeconds then
        return false
    end

    local returned =
        ZanjiSniperReturnToDestination(
            "after batch",
            token
        )

    ZANJI_SNIPER_RUNTIME.BatchActive =
        false

    ZANJI_SNIPER_RUNTIME.BatchBoughtCount =
        0

    ZANJI_SNIPER_RUNTIME.BatchEmptySince =
        0

    return returned
end

function ZanjiSniperMoveWalkToEntry(entry, filter, token)

    ZanjiSniperClearHeldToolForMovement(
        "walk to pet start"
    )

    local startedAt =
        os.clock()

    local timeout =
        tonumber(
            ZANJI_SNIPER_RUNTIME.WalkTimeout
        )
        or 26

    local lastStatusAt =
        0

    while ZanjiSniperStillActive(token) == true
    and os.clock() - startedAt <= timeout do

        ZanjiSniperClearHeldToolForMovement(
            "walk to pet loop"
        )

        local valid,
            refreshed,
            reason =
            ZanjiSniperValidateTargetForBuy(
                entry,
                filter
            )

        if valid ~= true then

            return false,
                refreshed,
                reason
        end

        entry =
            refreshed

        local humanoid =
            ZanjiSniperGetCharacterHumanoid()

        local root =
            ZanjiSniperGetCharacterRoot()

        if typeof(humanoid) ~= "Instance"
        or typeof(root) ~= "Instance"
        or root:IsA("BasePart") ~= true then

            return false,
                entry,
                "missing humanoid/root"
        end

        local position =
            ZanjiSniperGetPromptPosition(
                entry.Prompt,
                entry.Model
            )

        if typeof(position) ~= "Vector3" then

            return false,
                entry,
                "missing prompt position"
        end

        local distance =
            (
                root.Position
                - position
            ).Magnitude

        local safeRange =
            ZanjiSniperGetSafeRange(
                entry.Prompt
            )

        if os.clock() - lastStatusAt >= 0.55 then

            lastStatusAt =
                os.clock()

            ZanjiSniperSetStatus(
                "Walking: "
                .. ZanjiSniperDescribeEntry(entry)
                .. " / "
                .. tostring(
                    math.floor(distance + 0.5)
                )
                .. " studs"
            )
        end

        if distance <= safeRange then

            pcall(function()

                humanoid:MoveTo(
                    root.Position
                )
            end)

            return true,
                entry,
                "in range"
        end

        pcall(function()

            humanoid:MoveTo(
                position
            )
        end)

        task.wait(
            0.12
        )
    end

    return false,
        entry,
        "walk timeout"
end

function ZanjiSniperMoveTeleportToEntry(entry, filter, token)

    ZanjiSniperClearHeldToolForMovement(
        "teleport to pet start"
    )

    local valid,
        refreshed,
        reason =
        ZanjiSniperValidateTargetForBuy(
            entry,
            filter
        )

    if valid ~= true then

        return false,
            refreshed,
            reason
    end

    entry =
        refreshed

    local root =
        ZanjiSniperGetCharacterRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return false,
            entry,
            "missing root"
    end

    local position =
        ZanjiSniperGetPromptPosition(
            entry.Prompt,
            entry.Model
        )

    if typeof(position) ~= "Vector3" then

        return false,
            entry,
            "missing prompt position"
    end

    ZanjiSniperSetStatus(
        "Teleporting: "
        .. ZanjiSniperDescribeEntry(entry)
    )

    local away =
        root.Position
        - position

    away =
        Vector3.new(
            away.X,
            0,
            away.Z
        )

    if away.Magnitude < 1 then

        away =
            Vector3.new(
                0,
                0,
                1
            )

    else

        away =
            away.Unit
    end

    local destination =
        position
        + away * 6
        + Vector3.new(
            0,
            2.4,
            0
        )

    local cframe =
        CFrame.new(
            destination,
            position
        )

    ZanjiSniperZeroRootVelocity(
        root
    )

    local ok,
        err =
        pcall(function()

            root.CFrame =
                cframe
        end)

    if ok ~= true then

        return false,
            entry,
            "teleport failed "
            .. tostring(err)
    end

    task.wait(
        0.055
    )

    ZanjiSniperZeroRootVelocity(
        root
    )

    task.wait(
        0.035
    )

    ZanjiSniperClearHeldToolForMovement(
        "teleport to pet verify"
    )

    valid,
        refreshed,
        reason =
        ZanjiSniperValidateTargetForBuy(
            entry,
            filter
        )

    if valid ~= true then

        return false,
            refreshed,
            reason
    end

    entry =
        refreshed

    local distance =
        ZanjiSniperDistanceToEntry(
            entry
        )

    local safeRange =
        ZanjiSniperGetSafeRange(
            entry.Prompt
        )

    if distance > safeRange then

        return false,
            entry,
            "teleport out of range "
            .. tostring(
                math.floor(distance + 0.5)
            )
    end

    return true,
        entry,
        "teleported"
end

function ZanjiSniperTriggerPrompt(prompt)

    if typeof(prompt) ~= "Instance"
    or prompt:IsA("ProximityPrompt") ~= true
    or prompt.Parent == nil then

        return false,
            "bad prompt"
    end

    local hold =
        math.max(
            tonumber(prompt.HoldDuration)
            or 1,
            0.05
        )

    local buyMode =
        ZanjiSniperNormalizeBuyMode(
            ZANJI_SNIPER_STATE.BuyMode
        )

    if buyMode == "Instant"
    and type(fireproximityprompt) == "function" then

        local ok,
            err =
            pcall(function()

                fireproximityprompt(
                    prompt,
                    hold + 0.25
                )
            end)

        if ok == true then

            task.wait(
                0.08
            )

            return true,
                "fireproximityprompt"
        end
    end

    local beginOk =
        pcall(function()

            prompt:InputHoldBegin()
        end)

    task.wait(
        hold + 0.20
    )

    local endOk =
        pcall(function()

            prompt:InputHoldEnd()
        end)

    if beginOk == true
    and endOk == true then

        return true,
            "hold prompt"
    end

    return false,
        "prompt trigger failed"
end

function ZanjiSniperAddUniqueReason(reasons, reason)

    reason =
        ZanjiCleanText(
            reason
        )

    if reason == "" then
        return
    end

    for _, existing in ipairs(reasons) do

        if existing == reason then
            return
        end
    end

    table.insert(
        reasons,
        reason
    )
end

function ZanjiSniperConfirmBuy(entry, beforeSheckles, token)

    local deadline =
        os.clock()
        + (
            tonumber(
                ZANJI_SNIPER_RUNTIME.ConfirmTimeout
            )
            or 9
        )

    local reasons =
        {}

    while os.clock() <= deadline do

        if token ~= nil
        and ZanjiSniperStillActive(token) ~= true then

            return false,
                "cancelled"
        end

        local ref =
            type(entry) == "table"
            and entry.Ref
            or nil

        if typeof(ref) == "Instance"
        and ref.Parent ~= nil then

            local ownerUserId =
                tonumber(
                    ZanjiSniperReadModelAttribute(
                        ref,
                        {
                            "OwnerUserId",
                            "OwnerUserID",
                            "Owner",
                            "UserId",
                            "UserID",
                        }
                    )
                )
                or 0

            local ownerName =
                ZanjiCleanText(
                    ZanjiSniperReadModelAttribute(
                        ref,
                        {
                            "OwnerName",
                            "OwnerDisplayName",
                        }
                    )
                )

            local state =
                ZanjiCleanText(
                    ZanjiSniperReadModelAttribute(
                        ref,
                        {
                            "State",
                            "PetState",
                        }
                    )
                )

            if ownerUserId == tonumber(LocalPlayer.UserId) then

                ZanjiSniperAddUniqueReason(
                    reasons,
                    "owner user id"
                )

                ZanjiSniperTouchPetBuyProtection(
                    entry,
                    "owner user id"
                )
            end

            if ownerName == ZanjiCleanText(LocalPlayer.Name) then

                ZanjiSniperAddUniqueReason(
                    reasons,
                    "owner name"
                )

                ZanjiSniperTouchPetBuyProtection(
                    entry,
                    "owner name"
                )
            end

            if ZanjiSniperPetBuyStateLooksPending(state) == true then

                ZanjiSniperAddUniqueReason(
                    reasons,
                    state ~= ""
                    and state
                    or "walking to garden"
                )

                ZanjiSniperTouchPetBuyProtection(
                    entry,
                    state ~= ""
                    and state
                    or "walking to garden"
                )
            end
        end

        local currentSheckles =
            ZanjiSniperReadSheckles()

        if beforeSheckles
        and currentSheckles
        and currentSheckles < beforeSheckles then

            ZanjiSniperAddUniqueReason(
                reasons,
                "sheckles decreased"
            )

            ZanjiSniperTouchPetBuyProtection(
                entry,
                "sheckles decreased"
            )
        end

        if #reasons > 0 then

            return true,
                table.concat(
                    reasons,
                    ", "
                )
        end

        task.wait(
            0.10
        )
    end

    return false,
        "confirm timeout"
end

function ZanjiSniperMarkBought(match, entry)

    ZANJI_SNIPER_RUNTIME.Handled =
        type(ZANJI_SNIPER_RUNTIME.Handled) == "table"
