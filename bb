        )

        return false
    end

    ZanjiDevRecorderPush(
        "Recorder",
        ZANJI_DEV_SUITE_STATE.RecorderArea,
        "Finished",
        {
            Reason =
                reason
                or "manual finish",
        },
        "Info"
    )

    runtime.RecorderAfter =
        ZanjiDevRecorderSnapshot(
            ZANJI_DEV_SUITE_STATE.RecorderArea
        )

    local report =
        ZanjiDevRecorderBuildReport(
            reason
            or "manual finish"
        )

    runtime.RecorderActive =
        false

    runtime.RecorderTriggerGeneration =
        (
            runtime.RecorderTriggerGeneration
            or 0
        )
        + 1

    ZanjiDevRecorderCleanupSources()

    runtime.LastRecorderReport =
        report

    local saved =
        ZanjiDevWriteJson(
            DEV_TEST_RECORDER_FILE,
            report
        )

    local copied =
        copyResult == true
        and ZanjiDevCopyReport(report)
        or false

    ZanjiDevRecorderDeleteCheckpoint()

    local status =
        tostring(
            report.StoredEvents
        )
        .. " events"

    if report.Analysis
    and report.Analysis.HasFailure then

        status =
            status
            .. " · issue found"
    end

    if copied == true then

        status =
            status
            .. " · copied"
    end

    if saved == true then

        status =
            status
            .. " · saved"
    end

    ZanjiDevRecorderRefreshStatus(
        status
    )

    ZanjiNotify(
        "ZANJI Dev",
        status,
        5
    )

    return true
end

