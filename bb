function ZanjiPerformanceDeleteBackpackOnce(reason)

    if ZANJI_DEV_UI_STATE.DeleteBackpack ~= true
    or not LocalPlayer then

        return false
    end

    local backpack =
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )

    if typeof(backpack) ~= "Instance" then
        return false
    end

    local toolCount =
        0

    for _, child in ipairs(
        backpack:GetChildren()
    ) do

        if child:IsA("Tool") then

            toolCount +=
                1
        end
    end

    local ok =
        pcall(function()

            backpack:Destroy()
        end)

    if ok == true then

        ZANJI_PERFORMANCE_STATE.DeletedCount =
            (
                tonumber(
                    ZANJI_PERFORMANCE_STATE.DeletedCount
                )
                or 0
            )
            + toolCount
            + 1

        ZanjiPerformanceSetStatus(
            "Backpack deleted."
        )
    end

    return ok == true
end

function ZanjiPerformanceConnectBackpackWatcher()

