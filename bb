function ZanjiDailyDealLiveReadNumber(value)

    if type(value) == "number" then

        if value == value
        and value ~= math.huge
        and value ~= -math.huge then

            return value
        end

        return 0
    end

    local text =
        tostring(value or "")

    text =
        text:gsub(",", "")

    local raw =
        text:match(
            "%-?%d+%.?%d*"
        )

    local number =
        tonumber(raw)

