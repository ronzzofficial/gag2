function ZanjiFarmRequestRebuild(reason, delaySeconds)

    local runtime =
        ZanjiFarmEnsureRuntime()

    runtime.RebuildToken =
        (
            tonumber(runtime.RebuildToken)
            or 0
        )
        + 1

    local token =
        runtime.RebuildToken

    runtime.RebuildPending =
        true

    delaySeconds =
        math.clamp(
            tonumber(delaySeconds)
            or 0.25,
            0.05,
            2
        )

    task.delay(delaySeconds, function()

        local liveRuntime =
            ZanjiFarmEnsureRuntime()

        if liveRuntime.RebuildToken ~= token then
            return
        end

        liveRuntime.RebuildPending =
            false

        if ZANJI_FARM_STATE.AutoCollectFruits ~= true then
            return
        end

        ZanjiFarmRebuildReadyQueue(
            reason or "settings changed"
        )
    end)

    return true
end

