local ZanjiAuctionWatchlistRefreshToken =
    ZANJI_AUCTION_WATCHLIST_REFRESH_TOKEN

ZANJI_SHOP_STATE.AuctionWatchlistUIDirty =
    true

ZANJI_SHOP_STATE.AuctionWatchlistUIForceRebuild =
    true

pcall(function()

    ZanjiAuctionRefreshWatchlistUI(
        true
    )
end)

task.spawn(function()

    while ZANJI_AUCTION_WATCHLIST_REFRESH_TOKEN
        == ZanjiAuctionWatchlistRefreshToken do

        local surfaceAlive =
            false

        pcall(function()

            surfaceAlive =
                AuctionWatchlistSurface.Parent
                ~= nil
        end)

        if surfaceAlive ~= true then
            break
        end

        if ZANJI_SHOP_STATE.AuctionWatchlistUIDirty == true then

            local forceRebuild =
                ZANJI_SHOP_STATE
                    .AuctionWatchlistUIForceRebuild
                    == true

            ZANJI_SHOP_STATE.AuctionWatchlistUIDirty =
                false

            ZANJI_SHOP_STATE.AuctionWatchlistUIForceRebuild =
                false

            local refreshed =
                pcall(function()

                    ZanjiAuctionRefreshWatchlistUI(
                        forceRebuild
                    )
                end)

            if refreshed ~= true then

                ZANJI_SHOP_STATE.AuctionWatchlistUIDirty =
                    true
            end
        end

        task.wait(
            0.25
        )
    end
end)

