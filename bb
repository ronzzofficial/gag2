            1,
            true
        ) then
            return {
                Group =
                    "Gear",

                Category =
                    "Sprinklers",

                ItemKey =
                    name,

                Name =
                    name,

                Details =
                    "Sprinkler",

                Unique =
                    false,

                Supported =
                    true,

                Favorite =
                    readOwnedFavorite(
                        item
                    ),

                Count =
                    readOwnedCount(
                        item,
                        false
                    ),

                Instance =
                    item,
            }
        end

        if gearData ~= nil
            or mainKey:find(
                "gear",
                1,
                true
            )
        then
            return {
