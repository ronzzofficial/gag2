function ZanjiFarmCountOwnPrefixedPlants(plantsFolder)

    if typeof(plantsFolder) ~= "Instance" then
        return 0
    end

    local prefix =
        tostring(
            LocalPlayer
            and LocalPlayer.UserId
            or ""
        )
        .. "_"

    if prefix == "_" then
        return 0
    end

    local count =
        0

    for _, plant in ipairs(plantsFolder:GetChildren()) do

        if tostring(plant.Name):sub(1, #prefix) == prefix then

            count =
                count + 1
        end
    end

    return count
end

function ZanjiFarmScorePlot(plot)

    if typeof(plot) ~= "Instance" then
        return 0
    end

    local score =
        0

    local localUserId =
        tostring(
            LocalPlayer
            and LocalPlayer.UserId
            or ""
        )

    local localName =
        ZanjiCleanText(
            LocalPlayer
            and LocalPlayer.Name
            or ""
        )

    local ownerUserId =
        nil

    pcall(function()

        ownerUserId =
            plot:GetAttribute(
                "OwnerUserId"
            )
    end)

    if ownerUserId ~= nil
    and tostring(ownerUserId) == localUserId then

        score =
            score + 1000
    end

    local owner =
        nil

    pcall(function()

        owner =
            plot:GetAttribute(
                "Owner"
            )
    end)

    owner =
        ZanjiCleanText(
            owner
        )

    if owner ~= ""
    and localName ~= ""
    and owner == localName then

        score =
            score + 900
    end

    local plantsFolder =
        plot:FindFirstChild(
            "Plants"
        )

    local ownPrefixCount =
        ZanjiFarmCountOwnPrefixedPlants(
            plantsFolder
        )

    if ownPrefixCount > 0 then

        score =
            score + 100 + math.min(
                ownPrefixCount,
                100
            )
    end

    return score
end

function ZanjiFarmResolveOwnPlot(forceRefresh)

    local runtime =
        ZanjiFarmEnsureRuntime()

    local gardens =
        ZanjiFarmGetGardensRoot()

    if typeof(gardens) ~= "Instance" then
        return nil
    end

    if forceRefresh ~= true
    and typeof(runtime.OwnPlot) == "Instance"
    and runtime.OwnPlot.Parent == gardens
    and ZanjiFarmScorePlot(runtime.OwnPlot) > 0 then

        runtime.PlantsFolder =
            runtime.OwnPlot:FindFirstChild(
                "Plants"
            )

        return runtime.OwnPlot
    end

    local bestPlot =
        nil

    local bestScore =
        0

    for _, plot in ipairs(gardens:GetChildren()) do

        local score =
            ZanjiFarmScorePlot(
                plot
            )

        if score > bestScore then

            bestScore =
                score

            bestPlot =
                plot
        end
    end

    if typeof(bestPlot) == "Instance"
    and bestScore > 0 then

        runtime.OwnPlot =
            bestPlot

        runtime.PlantsFolder =
            bestPlot:FindFirstChild(
                "Plants"
            )

        return bestPlot
    end

    runtime.OwnPlot =
        nil

    runtime.PlantsFolder =
        nil

    return nil
end

