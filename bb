function ZanjiPerformanceModeApplyWorld(token)

    ZanjiPerformanceModeApplyEnvironment()

    local workspaceObjects =
        {}

    pcall(function()

        workspaceObjects =
            workspace:GetDescendants()
    end)

    for index, instance in ipairs(workspaceObjects) do

        if ZANJI_DEV_UI_STATE.PerformanceMode ~= true
        or ZANJI_PERFORMANCE_STATE.PerformanceModeToken ~= token then

            return false
        end

        ZanjiPerformanceModeSimplifyInstance(
            instance
        )

        if index % 400 == 0 then

            task.wait()
        end
    end

    local lightingObjects =
        {}

    pcall(function()

        lightingObjects =
            Lighting:GetDescendants()
    end)

    for index, instance in ipairs(lightingObjects) do

        if ZANJI_DEV_UI_STATE.PerformanceMode ~= true
        or ZANJI_PERFORMANCE_STATE.PerformanceModeToken ~= token then

            return false
        end

        ZanjiPerformanceModeSimplifyInstance(
            instance
        )

        if index % 200 == 0 then

            task.wait()
        end
    end

    return true
end

function ZanjiPerformanceModeClearPlants(plants)

    if ZANJI_DEV_UI_STATE.PerformanceMode ~= true
    or typeof(plants) ~= "Instance" then

        return 0
    end

    local children =
        {}

    pcall(function()

        children =
            plants:GetChildren()
    end)

    local removed =
        0

    for _, child in ipairs(children) do

        if ZANJI_DEV_UI_STATE.PerformanceMode ~= true then
            break
        end

        if typeof(child) == "Instance"
        and child.Parent == plants then

            removed =
                removed
                + ZanjiPerformanceModeDestroy(
                    child
                )
        end
    end

    if removed > 0 then

        ZanjiPerformanceSetStatus(
            "Performance mode removed "
            .. tostring(removed)
            .. " plant instances."
        )
    end

    return removed
end

function ZanjiPerformanceModeBindOwnPlants()

    if ZANJI_DEV_UI_STATE.PerformanceMode ~= true then
        return false
    end

    local gardens =
        ZanjiPerformanceGetGardensRoot()

    if typeof(gardens) ~= "Instance" then
        return false
    end

    local ownPlot =
        select(
            1,
            ZanjiPerformanceResolveOwnPlot(
                gardens
            )
        )

    if typeof(ownPlot) ~= "Instance" then
        return false
    end

    ZanjiPerformanceModeDisconnectSingle(
        ZANJI_PERFORMANCE_STATE.PerformanceModePlotConnection
    )

    ZanjiPerformanceModeDisconnectSingle(
        ZANJI_PERFORMANCE_STATE.PerformanceModePlantsConnection
    )

    ZANJI_PERFORMANCE_STATE.PerformanceModePlotConnection =
        ownPlot.ChildAdded:Connect(function(child)

            if child.Name == "Plants" then

                task.defer(function()

                    if ZANJI_DEV_UI_STATE.PerformanceMode == true
                    and child.Parent == ownPlot then

                        ZanjiPerformanceModeBindOwnPlants()
                    end
                end)
            end
        end)

    local plants =
        ownPlot:FindFirstChild(
            "Plants"
        )

    if typeof(plants) ~= "Instance" then

        ZanjiPerformanceSetStatus(
            "Performance mode waiting for Plants."
        )

        return true
    end

    ZANJI_PERFORMANCE_STATE.PerformanceModePlantsConnection =
        plants.ChildAdded:Connect(function(child)

            task.defer(function()

                if ZANJI_DEV_UI_STATE.PerformanceMode == true
                and child.Parent == plants then

                    ZanjiPerformanceModeDestroy(
                        child
                    )
                end
            end)
        end)

    ZanjiPerformanceModeClearPlants(
        plants
    )

    return true
end

function ZanjiPerformanceModeStart(reason)

    ZANJI_DEV_UI_STATE.PerformanceMode =
        true

    ZanjiSaveUISettings()

    ZanjiPerformanceModeDisconnect()

    ZANJI_PERFORMANCE_STATE.PerformanceModeToken =
        (
            tonumber(
                ZANJI_PERFORMANCE_STATE.PerformanceModeToken
            )
            or 0
        )
        + 1

    local token =
        ZANJI_PERFORMANCE_STATE.PerformanceModeToken

    ZANJI_PERFORMANCE_STATE.PerformanceModeConnections =
        {}

    table.insert(
        ZANJI_PERFORMANCE_STATE.PerformanceModeConnections,
        workspace.DescendantAdded:Connect(function(instance)

            task.defer(function()

                if ZANJI_DEV_UI_STATE.PerformanceMode ~= true
                or ZANJI_PERFORMANCE_STATE.PerformanceModeToken
                    ~= token then

                    return
                end

                ZanjiPerformanceModeSimplifyInstance(
                    instance
                )

                if instance.Name == "Plants" then

                    ZanjiPerformanceModeBindOwnPlants()
                end
            end)
        end)
    )

    table.insert(
        ZANJI_PERFORMANCE_STATE.PerformanceModeConnections,
        Lighting.DescendantAdded:Connect(function(instance)

            task.defer(function()

                if ZANJI_DEV_UI_STATE.PerformanceMode == true
                and ZANJI_PERFORMANCE_STATE.PerformanceModeToken
                    == token then

                    ZanjiPerformanceModeSimplifyInstance(
                        instance
                    )
                end
            end)
        end)
    )

    task.spawn(function()

        local deadline =
            os.clock() + 6

        while ZANJI_DEV_UI_STATE.PerformanceMode == true
        and ZANJI_PERFORMANCE_STATE.PerformanceModeToken == token
        and os.clock() <= deadline do

            if ZanjiPerformanceModeBindOwnPlants() == true then
                break
            end

            task.wait(
                0.25
            )
        end

        if ZANJI_DEV_UI_STATE.PerformanceMode ~= true
        or ZANJI_PERFORMANCE_STATE.PerformanceModeToken ~= token then

            return
        end

        ZanjiPerformanceModeApplyWorld(
            token
        )

        if ZANJI_DEV_UI_STATE.PerformanceMode == true
        and ZANJI_PERFORMANCE_STATE.PerformanceModeToken == token then

            ZanjiPerformanceSetStatus(
                "Performance mode applied."
            )
        end
    end)

    return true
end

function ZanjiPerformanceModeStop(reason)

    ZANJI_DEV_UI_STATE.PerformanceMode =
