        )

    if type(data) ~= "table"
    or type(Library.Themes[themeName]) ~= "table" then

        return false
    end

    local applied =
        Library:SetTheme(
            themeName
        )

    if applied ~= themeName then
        return false
    end

    ZANJI_THEME_STATE.ActiveName =
        themeName

    ZANJI_THEME_STATE.Draft =
        ZanjiThemeCloneData(
            data
