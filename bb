function ZanjiAuthGet()

    return (
        type(getgenv) == "function"
        and getgenv().ZANJI_AUTH
    )
    or _G.ZANJI_AUTH
    or ZANJI_AUTH
end

function ZanjiAuthHasFeature(featureName)

    local auth =
        ZanjiAuthGet()

    local features =
        type(auth) == "table"
        and type(auth.Features) == "table"
        and auth.Features
        or {}

    return features[featureName] == true
end

function ZanjiAuthIsAdmin()

    return ZanjiAuthHasFeature(
        "admin"
    )
    or ZanjiAuthHasFeature(
        "dev_tools"
    )
end

function ZanjiAuthHasPetFinder()

    return ZanjiAuthHasFeature(
        "server_finder"
    )
    or ZanjiAuthHasFeature(
        "pet_sniper"
    )
    or ZanjiAuthHasFeature(
        "pet_sniper_autobuy"
    )
end

function ZanjiAuthRequireFeature(featureName, featureLabel)

    if ZanjiAuthHasFeature(
        featureName
    ) == true then

        return true
    end

    warn(
        "[ZANJI AUTH]",
        tostring(featureLabel or featureName),
        "locked"
    )

    return false
end

function ZanjiAuthRequirePetFinder(actionName)

    if ZanjiAuthHasPetFinder() == true then

        return true
    end

    warn(
        "[ZANJI AUTH]",
        tostring(actionName or "Pet Finder"),
        "locked"
    )

    return false
end

function ZanjiAuthHasServerSniperSlot()

    if ZanjiAuthIsAdmin() == true then

        return true
    end

    return ZanjiAuthHasFeature(
        "server_finder"
    )
    or ZanjiAuthHasFeature(
        "pet_sniper"
    )
    or ZanjiAuthHasFeature(
        "pet_sniper_autobuy"
    )
end

function ZanjiServerSniperLockedMessage(actionName)

    return tostring(actionName or "Server Sniper")
        .. " requires an active Server Sniper slot."
end

function ZanjiServerSniperNotifyLocked(actionName)

    local message =
        ZanjiServerSniperLockedMessage(
            actionName
        )

    warn(
        "[ZANJI AUTH]",
        message
    )

    if type(ZanjiNotify) == "function" then

        ZanjiNotify(
            "ZANJI Locked",
            message,
            5
        )
    end

    if type(ZanjiServerSetStatus) == "function" then

        ZanjiServerSetStatus(
            "Locked: Server Sniper slot required"
        )
    end

    return false
end

function ZanjiServerSniperForceLockedOff(reason, notifyUser)

    if ZanjiAuthHasServerSniperSlot() == true then

        return false
    end

    if type(ZANJI_SERVER_FINDER_STATE) == "table" then

        ZANJI_SERVER_FINDER_STATE.Enabled =
            false

        ZANJI_SERVER_FINDER_STATE.AutoJoinMode =
            "Off"

        ZANJI_SERVER_FINDER_STATE.AutoRefresh =
            false
    end

    if type(ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME) == "table" then

        ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.Teleporting =
            false
    end

    if type(ZANJI_SERVER_FINDER_HUD) == "table" then

        if type(ZANJI_SERVER_FINDER_HUD.SetAutoJoinMode) == "function" then

            pcall(function()

                ZANJI_SERVER_FINDER_HUD:SetAutoJoinMode(
                    "Off"
                )
            end)
        end

        if type(ZANJI_SERVER_FINDER_HUD.Hide) == "function" then

            pcall(function()

                ZANJI_SERVER_FINDER_HUD:Hide()
            end)
        end
    end

    if type(ZanjiServerFinderSyncToggle) == "function" then

        ZanjiServerFinderSyncToggle(
            false
        )
    end

    if type(ZanjiQueueSaveServerFinderSettings) == "function" then

        ZanjiQueueSaveServerFinderSettings()
    end

    if notifyUser == true then

        ZanjiServerSniperNotifyLocked(
            reason or "Server Sniper"
        )
    end

    return true
end

function ZanjiAuthRequireServerSniper(actionName, notifyUser)

    if ZanjiAuthHasServerSniperSlot() == true then

        return true
    end

    ZanjiServerSniperForceLockedOff(
        actionName or "Server Sniper",
        false
    )

    if notifyUser ~= false then

        ZanjiServerSniperNotifyLocked(
            actionName or "Server Sniper"
        )
    end

    return false
end

