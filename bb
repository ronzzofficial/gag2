            table.insert(
                validSelection,
                recipeKey
            )
        end
    end

    ZANJI_MERGE_AUTOMATION_STATE.SelectedRecipes =
        validSelection

    local dropdown =
        ZANJI_MERGE_AUTOMATION_UI.RecipesDropdown

    if type(dropdown) == "table" then

        runtime.UpdatingRecipes =
            true

        pcall(function()

            if type(dropdown.SetValues) == "function" then

                dropdown:SetValues(
                    values
                )

            elseif type(dropdown.SetItems) == "function" then

                dropdown:SetItems(
                    values
                )
            end
        end)

        pcall(function()

            if type(dropdown.SetValue) == "function" then

                dropdown:SetValue(
                    ZanjiMergeAutomationGetSelectedRecipeDisplays()
                )
            end
        end)

        runtime.UpdatingRecipes =
            false
    end

    if notifyPlayer == true then

        ZanjiNotify(
            "Plant Merging",
            tostring(#values)
                .. " merge recipe(s) found. New recipes are left unselected.",
            4
        )
    end

    ZanjiSaveFarmSettings()
    ZanjiMergeAutomationWake()

    return values
end

function ZanjiMergeAutomationEscapeRichText(value)

    return tostring(value or "")
        :gsub("&", "&amp;")
        :gsub("<", "&lt;")
        :gsub(">", "&gt;")
        :gsub('"', "&quot;")
        :gsub("'", "&apos;")
end

function ZanjiMergeAutomationStatusColor(status)

    local lower =
        tostring(status or "")
            :lower()

    if lower:find("disabled", 1, true) then
        return "154, 147, 168"
    end

    if lower:find("complete", 1, true)
    or lower:find("ready", 1, true)
    or lower == "plant potted"
    or lower == "potted plant picked up"
    or lower:find("growth complete", 1, true) then

        return "73, 230, 133"
    end

    if lower:find("waiting", 1, true)
    or lower:find("paused", 1, true) then

        return "255, 190, 85"
    end

    if lower:find("failed", 1, true)
    or lower:find("error", 1, true)
    or lower:find("missing", 1, true)
    or lower:find("rejected", 1, true) then

        return "255, 98, 109"
    end

    return "85, 215, 255"
end

function ZanjiMergeAutomationBuildStatusText()

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local status =
        ZanjiMergeAutomationEscapeRichText(
            runtime.Status
            or "Disabled"
        )

    local color =
        ZanjiMergeAutomationStatusColor(
            runtime.Status
        )

    local text =
        'Status: <font color="rgb('
        .. color
        .. ')"><b>'
        .. status
        .. "</b></font>"

    if tostring(runtime.Detail or "") ~= "" then

        text =
            text
            .. '\n<font color="rgb(190, 185, 205)">'
            .. ZanjiMergeAutomationEscapeRichText(
                runtime.Detail
            )
            .. "</font>"
    end

    return text
end

