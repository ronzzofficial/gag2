function ZanjiGuildInviteStillPending(inviteId)

    inviteId =
        tostring(
            inviteId
            or ""
        )

    for _, invite in ipairs(
        ZANJI_GUILD_STATE.PendingInvites
        or {}
    ) do

        if tostring(invite.Id)
            == inviteId then

            return true
        end
    end

    return false
end

function ZanjiGuildRespondInvite(
    invite,
    accept,
    automatic
)
    if type(invite) ~= "table"
    or ZANJI_GUILD_RUNTIME.Busy.Action == true then

        return false
    end

    local inviteId =
        ZanjiCleanText(
            invite.Id
        )

    if inviteId == "" then
        return false
    end

    if accept == true
    and ZanjiGuildGetGuildId() ~= "" then

        if automatic ~= true then

            ZanjiNotify(
                "ZANJI Guild",
                "Leave your current guild before accepting another invitation.",
                5
            )
        end

        return false
    end

    ZANJI_GUILD_RUNTIME.Busy.Action =
        true

    ZANJI_GUILD_RUNTIME.InviteAutomationRunning =
        automatic == true

    ZANJI_GUILD_RUNTIME.InviteAttempts[
        inviteId
    ] =
        os.clock()

    ZanjiGuildRefreshInviteActions()

    local info =
        ZanjiGuildBuildInviteInfo(
            invite
        )

    ZanjiGuildSetStatus(
        accept == true
        and (
            "Accepting "
            .. tostring(info.Name)
            .. "..."
        )
        or (
            "Declining "
            .. tostring(info.Name)
            .. "..."
        )
    )

    task.spawn(function()

        local ok,
            first,
            second =
            ZanjiGuildCall(
                "RespondInvite",
                inviteId,
                accept == true
            )

        local accepted =
            ok == true
            and ZanjiGuildResultAccepted(
                first,
                second
            )

        local confirmed =
            false

        if accepted == true then

            for _ = 1, 10 do

                if ZanjiGuildInviteStillPending(
                    inviteId
                ) ~= true then

                    confirmed =
                        true

                    break
                end

                ZanjiGuildRefreshInvites(
                    true
                )

                task.wait(
                    0.35
                )
            end
        end

        ZANJI_GUILD_RUNTIME.Busy.Action =
            false

        ZANJI_GUILD_RUNTIME.InviteAutomationRunning =
            false

        local actionText =
            accept == true
            and "accepted"
            or "declined"

        local message =
            confirmed
            and (
                "Guild invitation from "
                .. tostring(info.Name)
                .. " was "
                .. actionText
                .. "."
            )
            or (
                accepted
                and (
                    "The "
                    .. actionText
                    .. " request was sent, but the mailbox has not confirmed it yet."
                )
                or ZanjiGuildResultMessage(
                    first,
                    second,
                    "Guild invitation response was rejected"
                )
            )

        ZanjiGuildSetStatus(
            message
        )

        if automatic ~= true
        or ZANJI_GUILD_STATE.NotifyAutoAccepted
            == true then

            ZanjiNotify(
                "ZANJI Guild",
                automatic == true
                and (
                    "Automatic rule: "
                    .. message
                )
                or message,
                confirmed
                and 3
                or 5
            )
        end

        if confirmed == true
        and accept == true then

            ZanjiGuildRefreshSnapshot(
                true
            )

            ZanjiGuildRefreshLeaderboard(
                true
            )
        end

        ZanjiGuildInvalidateInvitePanels()
        ZanjiGuildRefreshInfoPanels()
        ZanjiGuildRunInviteAutomation()
    end)

    return true
end

function ZanjiGuildRespondSelectedInvite(accept)

    local invite =
        ZanjiGuildGetSelectedInvite()

    if type(invite) ~= "table" then

        ZanjiNotify(
            "ZANJI Guild",
            "Select a pending guild invitation first.",
            4
        )

        return
    end

    ZanjiGuildRespondInvite(
        invite,
        accept == true,
        false
    )
end

function ZanjiGuildRunInviteAutomation()

    if ZANJI_GUILD_RUNTIME.Running ~= true
    or ZANJI_GUILD_RUNTIME.Busy.Action == true
    or ZANJI_GUILD_RUNTIME.InviteAutomationRunning
        == true then

        return
    end

    if ZANJI_GUILD_STATE.AutoAcceptInvites ~= true
    and ZANJI_GUILD_STATE.AutoDeclineUntrusted
        ~= true then

        return
    end

    local hasGuild =
        ZanjiGuildGetGuildId() ~= ""

    for _, invite in ipairs(
        ZANJI_GUILD_STATE.PendingInvites
        or {}
    ) do

        local inviterUserId =
            tonumber(
                invite.InviterUserId
            )

        local trusted =
            inviterUserId ~= nil
            and ZANJI_GUILD_STATE.TrustedSenders[
                inviterUserId
            ] ~= nil

        local shouldAccept =
            trusted
            and ZANJI_GUILD_STATE.AutoAcceptInvites
                == true
            and hasGuild ~= true

        local shouldDecline =
            trusted ~= true
            and ZANJI_GUILD_STATE.AutoDeclineUntrusted
                == true

        local lastAttempt =
            tonumber(
                ZANJI_GUILD_RUNTIME.InviteAttempts[
                    invite.Id
                ]
            )
            or 0

        if (
            shouldAccept
            or shouldDecline
        )
        and os.clock() - lastAttempt >= 20 then

            ZanjiGuildRespondInvite(
                invite,
                shouldAccept,
                true
            )

            return
        end
    end
end

