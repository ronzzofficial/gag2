local function ZanjiThemeCleanName(
    value
)

    local name =
        tostring(
            value
            or ""
        )
        :match(
            "^%s*(.-)%s*$"
        )

    if #name < 2 then

        return nil,
            "Theme names need at least 2 characters."
    end

    if #name > 24 then

        return nil,
            "Theme names can contain at most 24 characters."
    end

    if name:match(
        "^[%w%s_%-]+$"
    ) == nil then

        return nil,
            "Use letters, numbers, spaces, underscores or dashes."
    end

    local lowerName =
        string.lower(
            name
        )

    if ZANJI_THEME_STATE.BuiltInSet[
        lowerName
    ] == true then

        return nil,
            "Built-in theme names are reserved."
    end

    for existingName in pairs(
        ZANJI_THEME_STATE.CustomThemes
    ) do

        if string.lower(
            existingName
        ) == lowerName then

            return nil,
                "A theme with this name already exists."
        end
    end

    return name
end

function ZanjiThemeSaveAs(
    requestedName
)

    if type(ZANJI_THEME_STATE.Draft) ~= "table" then

        return false,
            "There is no theme to save."
    end

    local name,
        nameError =
        ZanjiThemeCleanName(
            requestedName
        )

    if name == nil then

        return false,
            nameError
    end

    ZANJI_THEME_STATE.CustomThemes[
        name
    ] =
        ZanjiThemeCloneData(
            ZANJI_THEME_STATE.Draft
        )

    local saved,
        saveError =
        ZanjiThemeSaveCustomThemes()

    if saved ~= true then

        ZANJI_THEME_STATE.CustomThemes[
            name
        ] =
            nil

        return false,
            saveError
    end

    ZanjiThemeRebuildLibraryThemes()

    ZanjiThemeApplyByName(
        name
    )

    ZanjiThemeNotify(
        "Theme saved",
        name .. " is now available."
    )

    return true
end

function ZanjiThemeOverwriteActive()

    local name =
        ZANJI_THEME_STATE.ActiveName

    if ZanjiThemeIsCustom(name) ~= true then

        ZanjiThemeNotify(
            "Built-in theme",
            "Save this theme as a new custom theme first.",
            true
        )

        return false
    end

    if type(ZANJI_THEME_STATE.Draft) ~= "table" then
        return false
    end

    local previous =
        ZanjiThemeCloneData(
            ZANJI_THEME_STATE.CustomThemes[
                name
            ]
        )

    ZANJI_THEME_STATE.CustomThemes[
        name
    ] =
        ZanjiThemeCloneData(
            ZANJI_THEME_STATE.Draft
        )

    local saved,
        saveError =
        ZanjiThemeSaveCustomThemes()

    if saved ~= true then

        ZANJI_THEME_STATE.CustomThemes[
            name
        ] =
            previous

        ZanjiThemeNotify(
            "Theme not saved",
            saveError,
            true
        )

        return false
    end

    ZanjiThemeRebuildLibraryThemes()

    ZanjiThemeApplyByName(
        name
    )

    ZanjiThemeNotify(
        "Theme updated",
        name .. " was overwritten."
    )

    return true
end

function ZanjiThemeDeleteActive()

    local name =
        ZANJI_THEME_STATE.ActiveName

    if ZanjiThemeIsCustom(name) ~= true then

        ZanjiThemeNotify(
            "Built-in theme",
            "Built-in themes cannot be deleted.",
            true
        )

        return false
    end

    local previous =
        ZANJI_THEME_STATE.CustomThemes[
            name
        ]

    ZANJI_THEME_STATE.CustomThemes[
        name
    ] =
        nil

    local saved,
        saveError =
        ZanjiThemeSaveCustomThemes()

    if saved ~= true then

        ZANJI_THEME_STATE.CustomThemes[
            name
        ] =
            previous

        ZanjiThemeNotify(
            "Theme not deleted",
            saveError,
            true
        )

        return false
    end

    if ZANJI_DEV_UI_STATE.ThemeName == name then

        ZANJI_DEV_UI_STATE.ThemeName =
            "Zanji Midnight"

        ZanjiSaveUISettings()
    end

    ZanjiThemeRebuildLibraryThemes()

    ZanjiThemeApplyByName(
        "Zanji Midnight"
    )

    ZanjiThemeNotify(
        "Theme deleted",
        name .. " was removed."
    )

    return true
end

