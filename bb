function ZanjiGuildGetContestView()

    local root =
        ZanjiGuildContestRoot()

    if type(root) ~= "table" then
        return nil
    end

    local rawPhase =
        ZanjiCleanText(
            ZanjiGuildField(
                root,
                {
                    "Phase",
                    "Status",
                    "State",
                },
                "Unknown"
            )
        )

    local phaseLower =
        rawPhase:lower()

    local state =
        (
            phaseLower == "active"
            or phaseLower == "live"
        )
        and "Active"
        or (
            (
                phaseLower == "pending"
                or phaseLower == "upcoming"
                or phaseLower == "scheduled"
            )
            and "Upcoming"
            or (
                (
                    phaseLower == "completed"
                    or phaseLower == "complete"
                    or phaseLower == "ended"
                    or phaseLower == "finished"
                )
                and "Completed"
                or rawPhase
            )
        )

    local active =
        ZanjiGuildField(
            root,
            {
                "CurrentCompetition",
                "Current",
                "ActiveCompetition",
                "Competition",
            }
        )

    local previous =
        ZanjiGuildField(
            root,
            {
                "PreviousCompetition",
                "Previous",
                "LastCompetition",
            }
        )

    local shown =
        state == "Active"
        and type(active) == "table"
        and active
        or (
            state == "Completed"
            and type(previous) == "table"
            and previous
            or (
                type(active) == "table"
                and active
                or (
                    type(previous) == "table"
                    and previous
                    or root
                )
            )
        )

    local startsAt =
        ZanjiGuildEpoch(
            ZanjiGuildField(
                root,
                {
                    "NextCompetitionStart",
                    "NextStartAt",
                    "StartsAt",
                    "StartTime",
                }
            )
            or ZanjiGuildField(
                shown,
                {
                    "StartsAt",
                    "StartTime",
                }
            )
        )

    local endsAt =
        ZanjiGuildEpoch(
            ZanjiGuildField(
                shown,
                {
                    "EndsAt",
                    "EndTime",
                }
            )
        )

    local timing =
        "Timing unavailable"

    if state == "Upcoming"
    and startsAt then

        timing =
            "Starts in "
            .. ZanjiGuildFormatDuration(
                startsAt
                - os.time()
            )

    elseif state == "Active"
    and endsAt then

        timing =
            "Ends in "
            .. ZanjiGuildFormatDuration(
                endsAt
                - os.time()
            )

    elseif state == "Completed" then

        timing =
            "Competition ended"
    end

    return {
        Root = root,
        Shown = shown,
        State = state,
        RawPhase = rawPhase,
        StartsAt = startsAt,
        EndsAt = endsAt,
        Timing = timing,

        Name =
            ZanjiCleanText(
                ZanjiGuildField(
                    shown,
                    {
                        "Name",
                        "Title",
                        "DisplayName",
                    },
                    state == "Upcoming"
                    and "Next Guild Competition"
                    or "Guild Competition"
                )
            ),

        Objective =
            ZanjiCleanText(
                ZanjiGuildField(
                    shown,
                    {
                        "Objective",
                        "Description",
                        "ObjectiveDescription",
                        "ObjectiveTag",
                        "Tag",
                    },
                    "Objective unavailable"
                )
            ),

        Mode =
            ZanjiCleanText(
                ZanjiGuildField(
                    shown,
                    {
                        "Mode",
                        "WinMode",
                        "ScoringMode",
                    },
                    ""
                )
            ),

        ScoreFormat =
            ZanjiCleanText(
                ZanjiGuildField(
                    shown,
                    {
                        "ScoreFormat",
                        "Format",
                        "Unit",
                    },
                    "Number"
                )
            ),

        Score =
            tonumber(
                ZanjiGuildField(
                    root,
                    {
                        "GuildScore",
                        "Score",
                        "CurrentScore",
                    },
                    0
                )
            )
            or 0,

        Placement =
            tonumber(
                ZanjiGuildField(
                    root,
                    {
                        "GuildPlacement",
                        "Placement",
                        "Rank",
                    }
                )
            ),

        Bracket =
            ZanjiGuildField(
                root,
                {
                    "Bracket",
                    "League",
                    "Tier",
                }
            ),
    }
end

