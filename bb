function ZanjiGuildGetSelectedLeaderboardGuild()

    local selectedId =
        tostring(
            ZANJI_GUILD_STATE.SelectedGuildId
            or ""
        )

    local rows =
        ZanjiGuildLeaderboardArray()

    for _, row in ipairs(rows) do

        if ZanjiGuildLeaderboardRowId(
            row
        ) == selectedId then

            return row
        end
    end

    local ownRow =
        ZanjiGuildGetOwnLeaderboardRow()

    if type(ownRow) == "table"
    and ZanjiGuildLeaderboardRowId(
        ownRow
    ) == selectedId then

        return ownRow
    end

    local first =
        rows[1]
        or ownRow

    if first then

        ZANJI_GUILD_STATE.SelectedGuildId =
            ZanjiGuildLeaderboardRowId(
                first
            )
    end

    return first
end

