function ZanjiMergeAutomationWorker(token)

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local startedForOneShot =
        runtime.RunOnceRequested == true
        or runtime.ManualPotRequested == true
        or runtime.ManualPickupRequested == true

    ZanjiMergeAutomationSetStatus(
        "Starting",
        "Checking your garden and selected automation."
    )

    while runtime.Token == token
    and ZanjiMergeAutomationShouldRun() == true do

        local didWork =
            false

        local eclipseNextAt =
            nil

        local selectedRecipes =
            ZanjiMergeAutomationGetSelectedRecipes()

        if ZANJI_MERGE_AUTOMATION_STATE.AutoMergePlants == true then

            if #selectedRecipes <= 0 then

                ZanjiMergeAutomationSetStatus(
                    "Waiting",
                    "Select at least one merge recipe."
                )
            else

                for _, recipe in ipairs(selectedRecipes) do

                    if ZanjiMergeAutomationOutputExists(
                        recipe.Result
                    ) ~= true then

                        local merged,
                            mergeReason =
                            ZanjiMergeAutomationMergeRecipe(
                                recipe
                            )

                        didWork =
                            merged == true

                        if merged ~= true then

                            ZanjiMergeAutomationSetStatus(
                                "Waiting to merge",
                                mergeReason
                            )
                        end

                        break
                    end
                end
            end
        end

        if runtime.Token ~= token then
            break
        end

        if ZANJI_MERGE_AUTOMATION_STATE.AutoWatering == true then

            for _, recipe in ipairs(selectedRecipes) do

                local plant =
                    ZanjiMergeAutomationFindPlantByName(
                        recipe.Result,
                        true
                    )

                if plant
                and ZanjiFarmInstanceReady(
                    plant
                ) ~= true then

                    local grown,
                        growReason =
                        ZanjiMergeAutomationGrowPlant(
                            plant,
                            token
                        )

                    didWork =
                        didWork
                        or grown == true

                    if grown ~= true
                    and tostring(growReason or "") ~= "Stopped." then

                        ZanjiMergeAutomationSetStatus(
                            "Watering paused",
                            growReason
                        )
                    end

                    break
                end
            end
        end

        if runtime.Token ~= token then
            break
        end

        local runOnce =
            runtime.RunOnceRequested == true

        if ZANJI_MERGE_AUTOMATION_STATE.AutoEclipseLoop == true
        or runOnce == true then

            local completed,
                cycleReason =
                ZanjiMergeAutomationRunEclipseCycle(
                    token
                )

            didWork =
                didWork
                or completed == true

            if runOnce == true then

                runtime.RunOnceRequested =
                    false
            end

            if completed ~= true then

                ZanjiMergeAutomationSetStatus(
                    "Eclipse loop waiting",
                    cycleReason
                )
            elseif ZANJI_MERGE_AUTOMATION_STATE.AutoEclipseLoop == true then

                eclipseNextAt =
                    os.clock()
                    + ZanjiMergeAutomationReadDelay(
                        ZANJI_MERGE_AUTOMATION_STATE.LoopDelay
                    )
            end
        end

        if runtime.Token ~= token then
            break
        end

        local pottedActionAttempted =
            false

        local wantsPickup =
            ZANJI_MERGE_AUTOMATION_STATE.AutoPickupPottedPlants == true
            or runtime.ManualPickupRequested == true

        if wantsPickup == true then

            local attempted,
                completed =
                ZanjiMergeAutomationProcessPickupAction(
                    token,
                    runtime.ManualPickupRequested == true
                )

            pottedActionAttempted =
                attempted == true

            didWork =
                didWork
                or completed == true
        end

        if runtime.Token ~= token then
            break
        end

        local wantsPot =
            ZANJI_MERGE_AUTOMATION_STATE.AutoPotPlants == true
            or runtime.ManualPotRequested == true

        if pottedActionAttempted ~= true
        and wantsPot == true then

            local attempted,
                completed =
                ZanjiMergeAutomationProcessPotAction(
                    token,
                    runtime.ManualPotRequested == true
                )

            pottedActionAttempted =
                attempted == true

            didWork =
                didWork
                or completed == true
        end

        if runtime.Token ~= token then
            break
        end

        if eclipseNextAt ~= nil then

            local remaining =
                math.max(
                    0,
                    eclipseNextAt - os.clock()
                )

            if ZanjiMergeAutomationWaitDelay(
                token,
                remaining
            ) ~= true then

                break
            end
        elseif didWork ~= true
        and pottedActionAttempted ~= true then

            if ZanjiMergeAutomationWaitDelay(
                token,
                0.50
            ) ~= true then

                break
            end
        end
    end

    if runtime.Token == token then

        runtime.Token =
            nil

        runtime.Running =
            false

        if startedForOneShot ~= true then

            ZanjiMergeAutomationSetStatus(
                "Disabled"
            )
        end
    end
end

function ZanjiMergeAutomationWake()

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    if ZanjiMergeAutomationShouldRun() ~= true then

        ZanjiMergeAutomationStop(
            "Disabled"
        )

        return false
    end

    if runtime.Running == true
    and runtime.Token ~= nil then

        return true
    end

    runtime.Running =
        true

    runtime.Token =
        {}

    local token =
        runtime.Token

    task.spawn(function()

        ZanjiMergeAutomationWorker(
            token
        )
    end)

    return true
end

