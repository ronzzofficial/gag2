function ZanjiSniperSortWatchlist(watchlist)

    table.sort(watchlist, function(a, b)

        local priceA =
            tonumber(a.ValueNumber)
            or ZanjiSniperGetBasePrice(a)

        local priceB =
            tonumber(b.ValueNumber)
            or ZanjiSniperGetBasePrice(b)

        if priceA ~= priceB then
            return priceA > priceB
        end

        local rankA =
            ZanjiSniperPriorityRank(
                a.Priority
            )

        local rankB =
            ZanjiSniperPriorityRank(
                b.Priority
            )

        if rankA ~= rankB then
            return rankA < rankB
        end

        return tostring(a.Pet) < tostring(b.Pet)
    end)

    return watchlist
end

function ZanjiSniperMatchesSearch(row, searchText)

    searchText =
        ZanjiCleanText(
            searchText
        )
        :lower()

    if searchText == "" then
        return true
    end

    local haystack =
        table.concat({
            tostring(row.Pet or ""),
            tostring(row.PetKey or ""),
            tostring(row.Value or ""),
            tostring(row.Size or ""),
            tostring(row.Variant or ""),
            tostring(row.MaxPrice or ""),
            tostring(row.Amount or ""),
            tostring(row.Priority or ""),
            tostring(row.PriorityFull or ""),
        }, " "):lower()

    return haystack:find(
        searchText,
        1,
        true
    ) ~= nil
end

function ZanjiSniperBuildAllWatchlistRows()

    local rows =
        {}

    local searchText =
        ZanjiCleanText(
            ZANJI_SNIPER_STATE.WatchlistSearch
            or ""
        )

    for sourceIndex, row in ipairs(ZANJI_SNIPER_STATE.Watchlist or {}) do

        local filter =
            ZanjiSniperNormalizeFilter(
                row
            )

        local price =
            ZanjiSniperGetBasePrice(
                filter
            )

        local maxPriceText =
            ZanjiSniperFormatMaxPrice(
                filter.MaxPrice
            )

        local tableRow = {
            SourceIndex =
                sourceIndex,

            Pet =
                tostring(filter.Pet),

            PetKey =
                tostring(filter.PetKey),

            Value =
                ZanjiSniperFormatMoney(
                    price
                ),

            ValueNumber =
                price,

            MaxPrice =
                maxPriceText,

            MaxPriceNumber =
                tonumber(filter.MaxPrice)
                or 0,

            Size =
                ZanjiSniperShortArrayText(
                    filter.Sizes,
                    "Any"
                ),

            Variant =
                ZanjiSniperShortArrayText(
                    filter.Variants,
                    "Any"
                ),

            Amount =
                maxPriceText,

            AmountNumber =
                tonumber(filter.MaxPrice)
                or 0,

            Priority =
                ZanjiSniperPriorityShort(
                    filter.Priority
                ),

            PriorityFull =
                ZanjiSniperNormalizePriority(
                    filter.Priority
                ),
        }

        if ZanjiSniperMatchesSearch(
            tableRow,
            searchText
        ) == true then

            table.insert(
                rows,
                tableRow
            )
        end
    end

    ZanjiSniperSortWatchlist(
        rows
    )

    return rows
end

function ZanjiSniperGetWatchlistPageSize()

    local pageSize =
        math.floor(
            tonumber(
                ZANJI_SNIPER_STATE.WatchlistPageSize
