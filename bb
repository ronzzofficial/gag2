function ZanjiDevEndActionCapture()

    local runtime =
        ZANJI_DEV_SUITE_RUNTIME

    if type(runtime.ActionBefore) ~= "table" then

        ZanjiNotify(
            "ZANJI Dev",
            "Press Begin Capture first.",
            4
        )

        return false
    end

    local after =
        ZanjiDevCaptureActionScope(
            runtime.ActionBefore.Scope
        )

    local beforeFlat =
        ZanjiDevFlatten(
            runtime.ActionBefore.Values,
            "Action",
            {}
        )

    local afterFlat =
        ZanjiDevFlatten(
            after.Values,
            "Action",
            {}
        )

    local diff =
        ZanjiDevDiffMaps(
            beforeFlat,
            afterFlat
        )

    local report = {
        Version =
            "ZANJI_DEV_ACTION_CAPTURE_V1",

        Scope =
            runtime.ActionBefore.Scope,

        StartedAt =
            runtime.ActionBefore.Time,

        FinishedAt =
            os.time(),

        JobId =
            game.JobId,

        Diff =
            diff,

        Before =
            runtime.ActionBefore,

        After =
            after,
    }

    runtime.LastActionReport =
        report

    runtime.ActionBefore =
        nil

    ZanjiDevCopyReport(
        report
    )

    ZanjiDevSetStatus(
        "ActionStatusLabel",
        "+"
            .. tostring(diff.AddedCount)
            .. "  -"
            .. tostring(diff.RemovedCount)
            .. "  ~"
            .. tostring(diff.ChangedCount)
            .. " — copied"
    )

    return true
end

