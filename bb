function ZanjiFruitAutomationAddMutation(output, seen, value)

    output =
        type(output) == "table"
        and output
        or {}

    seen =
        type(seen) == "table"
        and seen
        or {}

    if type(value) == "table" then

        for key, childValue in pairs(value) do

            if type(key) == "number" then

                ZanjiFruitAutomationAddMutation(
                    output,
                    seen,
                    childValue
                )

            elseif childValue == true then

                ZanjiFruitAutomationAddMutation(
                    output,
                    seen,
                    key
                )
            end
        end

        return output
    end

    for _, part in ipairs(
        ZanjiFarmSplitMutationText(
            value
        )
    ) do

        local mutation =
            ZanjiFarmNormalizeMutationName(
                part
            )

        if mutation ~= ""
        and seen[mutation] ~= true then

            seen[mutation] =
                true

            table.insert(
                output,
                mutation
            )
        end
    end

    return output
end

function ZanjiFruitAutomationReadBracketMutations(displayName, output, seen)

    displayName =
        tostring(displayName or "")

    for bracket in displayName:gmatch("%[([^%]]+)%]") do

        local lower =
            bracket:lower()

        if lower:find("kg", 1, true) == nil then

            ZanjiFruitAutomationAddMutation(
                output,
                seen,
                bracket
            )
        end
    end

    return output
end

function ZanjiFruitAutomationReadCommonFruitInfo(instance, fallbackName)

    if typeof(instance) ~= "Instance" then
        return nil
    end

    local fruitData =
        ZanjiFruitAutomationDecodeData(
            ZanjiFruitAutomationReadAttribute(
                instance,
                {
                    "FruitData",
                    "ItemData",
                    "Data",
                }
            )
        )

    local displayName =
        ZanjiCleanText(
            ZanjiFruitAutomationReadAttribute(
                instance,
                {
                    "DisplayName",
                    "ItemName",
                    "Name",
                }
            )
            or fallbackName
            or instance.Name
        )

    local fruitName =
        ZanjiCleanText(
            fruitData.FruitName
            or fruitData.Fruit
            or fruitData.Name
            or ZanjiFruitAutomationReadAttribute(
                instance,
                {
                    "FruitName",
                    "SeedName",
                    "PlantName",
                    "CropName",
                    "ItemName",
                }
            )
            or ""
        )

    if fruitName == "" then

        fruitName =
            ZanjiFruitAutomationCleanDisplayName(
                displayName
            )
    end

    fruitName =
        ZanjiFruitAutomationNormalizeFruitName(
            fruitName
        )

    if fruitName == "" then
        return nil
    end

    local weight =
        tonumber(
            fruitData.Weight
            or fruitData.WeightKg
            or fruitData.Kg
            or fruitData.Mass
            or ZanjiFruitAutomationReadAttribute(
                instance,
                {
                    "Weight",
                    "WeightKg",
                    "Kg",
                    "Mass",
                }
            )
        )

    if weight == nil then

        weight =
            tonumber(
                tostring(displayName):match("([%d%.]+)%s*[Kk][Gg]")
            )
            or tonumber(
                tostring(instance.Name):match("([%d%.]+)%s*[Kk][Gg]")
            )
    end

    local mutations =
        {}

    local seen =
        {}

    ZanjiFruitAutomationAddMutation(
        mutations,
        seen,
        fruitData.Mutation
        or fruitData.Mutations
        or fruitData.Variant
        or fruitData.Type
        or ZanjiFruitAutomationReadAttribute(
            instance,
            {
                "Mutation",
                "Mutations",
                "Variant",
                "Type",
            }
        )
        or ""
    )

    ZanjiFruitAutomationReadBracketMutations(
        displayName,
        mutations,
        seen
    )

    table.sort(mutations, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return {
        Instance =
            instance,

        FruitName =
            fruitName,

        DisplayName =
            displayName ~= ""
            and displayName
            or fruitName,

        WeightKg =
            tonumber(weight)
            or 0,

        Mutations =
            mutations,

        HadFruitData =
            next(fruitData) ~= nil,
    }
end

function ZanjiFruitAutomationLooksLikeFruit(info)

    if type(info) ~= "table" then
        return false
    end

    local fruitName =
        ZanjiFruitAutomationNormalizeFruitName(
            info.FruitName
        )

    if fruitName == "" then
        return false
    end

    local validMap =
        {}

    if type(ZanjiFarmGetPlantValueMap) == "function" then

        validMap =
            ZanjiFarmGetPlantValueMap()
    end

    if next(validMap) == nil then
        return true
    end

    if validMap[fruitName] == true then
        return true
    end

    return info.HadFruitData == true
end

function ZanjiFruitAutomationMutationListHasSelected(mutations, selectedMap)

    if type(mutations) ~= "table"
    or type(selectedMap) ~= "table" then

