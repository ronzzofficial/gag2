local function ZanjiThemeFindFont(enumName)

    for _, fontItem in ipairs(
        Enum.Font:GetEnumItems()
    ) do

        if fontItem.Name == enumName then

            return fontItem
        end
    end

    return nil
end

local function ZanjiThemeRegisterFont(
    label,
    enumName
)

    local fontItem =
        ZanjiThemeFindFont(
            enumName
        )

    if typeof(fontItem) ~= "EnumItem" then
        return
    end

    local success,
        fontFace =
        pcall(function()

            return Font.fromEnum(
                fontItem
            )
        end)

    if success ~= true
    or typeof(fontFace) ~= "Font" then

        return
    end

    ZANJI_THEME_STATE.FontByName[
        enumName
    ] =
        fontFace

    ZANJI_THEME_STATE.FontLabelByName[
        enumName
    ] =
        label

    ZANJI_THEME_STATE.FontNameByLabel[
        label
    ] =
        enumName

    table.insert(
        ZANJI_THEME_STATE.FontLabels,
        label
    )
end

