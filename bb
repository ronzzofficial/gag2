function ZanjiFruitAutomationRefreshDropdowns(forceRefresh)

    ZANJI_FRUIT_AUTOMATION_UI =
        type(ZANJI_FRUIT_AUTOMATION_UI) == "table"
        and ZANJI_FRUIT_AUTOMATION_UI
        or {}

    if forceRefresh == true then

        if type(ZanjiFarmInvalidatePlantNameCache) == "function" then

            ZanjiFarmInvalidatePlantNameCache()
        end

        if type(ZanjiFarmInvalidateMutationNameCache) == "function" then

            ZanjiFarmInvalidateMutationNameCache()
        end
    end

    ZanjiFruitAutomationEnsureState()

    local fruitsDropdown =
        ZANJI_FRUIT_AUTOMATION_UI.FruitsDropdown

    if type(fruitsDropdown) == "table" then

        local values =
            ZanjiFruitAutomationGetFruitDropdownValues()

        pcall(function()

            if type(fruitsDropdown.SetValues) == "function" then

                fruitsDropdown:SetValues(
                    values
                )

            elseif type(fruitsDropdown.SetItems) == "function" then

                fruitsDropdown:SetItems(
                    values
                )
            end
        end)

        pcall(function()

            if type(fruitsDropdown.SetValue) == "function" then

                fruitsDropdown:SetValue(
                    ZANJI_FRUIT_AUTOMATION_STATE.SelectedFruits
                )
            end
        end)
    end

    local mutationsDropdown =
        ZANJI_FRUIT_AUTOMATION_UI.MutationsDropdown

    if type(mutationsDropdown) == "table" then

        local values =
            ZanjiFruitAutomationGetMutationDropdownValues()

        pcall(function()

            if type(mutationsDropdown.SetValues) == "function" then

                mutationsDropdown:SetValues(
                    values
                )

            elseif type(mutationsDropdown.SetItems) == "function" then

                mutationsDropdown:SetItems(
                    values
                )
            end
        end)

        pcall(function()

            if type(mutationsDropdown.SetValue) == "function" then

                mutationsDropdown:SetValue(
                    ZANJI_FRUIT_AUTOMATION_STATE.SelectedMutations
                )
            end
        end)
    end

    return true
end

