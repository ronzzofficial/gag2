function ZanjiPerformancePlotOwnedByLocal(plot)

    if ZanjiPerformanceIsPlot(plot) ~= true then
        return false,
            ""
    end

    local localUserId =
        tostring(
            LocalPlayer
            and LocalPlayer.UserId
            or ""
        )

    local localName =
        ZanjiCleanText(
            LocalPlayer
            and LocalPlayer.Name
            or ""
        )

    local ownerUserId =
        ZanjiPerformanceReadPlotAttribute(
            plot,
            "OwnerUserId"
        )

    if ownerUserId ~= nil
    and tostring(ownerUserId) == localUserId then

        return true,
            "OwnerUserId="
                .. tostring(ownerUserId)
    end

    local ownerName =
        ZanjiCleanText(
            ZanjiPerformanceReadPlotAttribute(
                plot,
                "Owner"
            )
        )

    if ownerName ~= ""
    and localName ~= ""
    and ownerName == localName then

        return true,
            "Owner="
                .. tostring(ownerName)
    end

    return false,
        ""
end

function ZanjiPerformanceFindOwnPlotOnce(gardens)

    if typeof(gardens) ~= "Instance" then
        return nil,
            "gardens missing"
    end

    for _, plot in ipairs(gardens:GetChildren()) do

        if ZanjiPerformanceIsPlot(plot) == true then

            local owned,
                marker =
                ZanjiPerformancePlotOwnedByLocal(
                    plot
                )

            if owned == true then

                return plot,
                    marker
            end
        end
    end

    return nil,
        "no owner attribute match"
end

function ZanjiPerformanceResolveOwnPlot(gardens)

    ZANJI_PERFORMANCE_STATE =
        type(ZANJI_PERFORMANCE_STATE) == "table"
        and ZANJI_PERFORMANCE_STATE
        or {}

    if typeof(gardens) ~= "Instance" then
        return nil,
            "gardens missing"
    end

    local cached =
        ZANJI_PERFORMANCE_STATE.OwnPlot

    if typeof(cached) == "Instance"
    and cached.Parent == gardens then

        local owned,
            marker =
            ZanjiPerformancePlotOwnedByLocal(
                cached
            )

        if owned == true then

            ZANJI_PERFORMANCE_STATE.OwnMarker =
                marker

            return cached,
                marker
        end
    end

    local startedAt =
        os.clock()

    local lastReason =
        ""

    while os.clock() - startedAt <= 4 do

        local plot,
            reason =
            ZanjiPerformanceFindOwnPlotOnce(
                gardens
            )

        lastReason =
            tostring(reason or "")

        if typeof(plot) == "Instance" then

            ZANJI_PERFORMANCE_STATE.OwnPlot =
                plot

            ZANJI_PERFORMANCE_STATE.OwnMarker =
                lastReason

            return plot,
                lastReason
        end

        task.wait(
            0.10
        )
    end

    return nil,
        lastReason
end

