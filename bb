function ZanjiDailyDealStartWorker(reason)

    ZanjiDailyDealEnsureState()

    if ZANJI_SHOP_STATE.AutoDailyDealAll ~= true then
        return false
    end

    if ZANJI_SHOP_STATE.DailyDealWorkerRunning == true then
        return false
    end

    local token =
        {}

    ZANJI_SHOP_STATE.DailyDealToken =
        token

    ZANJI_SHOP_STATE.DailyDealWorkerRunning =
        true

    ZanjiDailyDealSetStatus(
        "Starting..."
    )

    task.spawn(function()

        while ZANJI_SHOP_STATE.AutoDailyDealAll == true
