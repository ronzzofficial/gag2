function ZanjiDefenseFindThreat(targetPos)

    if typeof(targetPos) ~= "Vector3" then
        return nil
    end

    local best =
        nil

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            local root =
                ZanjiDefenseGetPlayerRoot(
                    player
                )

            if typeof(root) == "Instance"
            and root:IsA("BasePart") then

                local distance =
                    (
                        root.Position
                        - targetPos
                    ).Magnitude

                if distance <= 45
                and (
                    best == nil
                    or distance < best.Distance
                ) then

                    best = {
                        Player =
                            player,

                        Root =
                            root,

                        Distance =
                            distance,
                    }
                end
            end
        end
    end

    return best
end

function ZanjiDefenseGetPlayerControls()

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if runtime.PlayerControls ~= nil then
        return runtime.PlayerControls
    end

    local playerScripts =
        LocalPlayer
        and LocalPlayer:FindFirstChild("PlayerScripts")
        or nil

    local playerModule =
        playerScripts
        and playerScripts:FindFirstChild("PlayerModule")
        or nil

    if typeof(playerModule) ~= "Instance"
    or playerModule:IsA("ModuleScript") ~= true then

        return nil
    end

    local okModule,
        module =
        pcall(require, playerModule)

    if okModule ~= true
    or type(module) ~= "table"
    or type(module.GetControls) ~= "function" then

        return nil
    end

    local okControls,
        controls =
        pcall(function()

            return module:GetControls()
        end)

    if okControls == true then

        runtime.PlayerControls =
            controls

        return controls
    end

    return nil
end

