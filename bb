function ZanjiPerformanceModeDestroy(instance)

    if typeof(instance) ~= "Instance"
    or instance.Parent == nil then

        return 0
    end

    local removedCount =
        1

    pcall(function()

        removedCount =
            removedCount
            + #instance:GetDescendants()
    end)

    local destroyed =
        pcall(function()

            instance:Destroy()
        end)

    if destroyed ~= true then
        return 0
    end

    ZANJI_PERFORMANCE_STATE.DeletedCount =
        (
            tonumber(
                ZANJI_PERFORMANCE_STATE.DeletedCount
            )
            or 0
        )
        + removedCount

    ZANJI_PERFORMANCE_STATE.RemovedCount =
        (
            tonumber(
                ZANJI_PERFORMANCE_STATE.RemovedCount
            )
            or 0
        )
        + removedCount

    return removedCount
end

