function ZanjiWebhookReadMultiplier(value)

    local number = nil

    if type(value) == "number" then

        number = value

    else

        local text =
            ZanjiCleanText(value)
                :lower()
                :gsub("%s+", "")
                :gsub(",", ".")
                :gsub("^x", "")

        number = tonumber(text)
    end

    if number == nil
    or number <= 0
    or number ~= number
    or number == math.huge
    or number == -math.huge then

        return nil
    end

    return math.floor(
        math.clamp(number, 0.01, 100) * 100
        + 0.5
    ) / 100
end

function ZanjiWebhookFormatMultiplier(value)

    return string.format(
        "%.2f",
        ZanjiWebhookReadMultiplier(value) or 0
    )
end

function ZanjiWebhookFilterKey(value)

    return ZanjiDailyDealNameKey(value)
