function ZanjiGuildCancelKickConfirmation(
    refreshActions
)
    local hadConfirmation =
        ZANJI_GUILD_RUNTIME.KickConfirmUserId
        ~= nil

    ZANJI_GUILD_RUNTIME.KickConfirmUserId =
        nil

    ZANJI_GUILD_RUNTIME.KickConfirmUsername =
        nil

    ZANJI_GUILD_RUNTIME.KickConfirmExpiresAt =
        0

    if refreshActions ~= false
    and type(ZanjiGuildRefreshRoleAction)
        == "function" then

        ZanjiGuildRefreshRoleAction()
    end

    return hadConfirmation
end

function ZanjiGuildRefreshRoleAction()

    local actions =
        ZANJI_GUILD_UI.MemberActions

    if type(actions) ~= "table" then
        return
    end

    if ZANJI_GUILD_RUNTIME.KickConfirmUserId
        ~= nil
    and os.clock()
        > (
            tonumber(
                ZANJI_GUILD_RUNTIME.KickConfirmExpiresAt
            )
            or 0
        ) then

        ZanjiGuildCancelKickConfirmation(
            false
        )
    end

    local selected =
        ZanjiGuildGetSelectedMember()

    local localMember =
        ZanjiGuildGetLocalMember()

    local busy =
        ZANJI_GUILD_RUNTIME.Busy.Action
        == true

    local text =
        "Select a Member"

    local allowed =
        false

    if selected
    and selected.Role == "Owner" then

        text =
            "Owner Cannot Be Changed"

    elseif selected
    and selected.UserId
        == LocalPlayer.UserId then

        text =
            "Your Role Cannot Be Changed"

    elseif localMember == nil
    or localMember.Role ~= "Owner" then

        text =
            "Owner Permission Required"

    elseif selected
    and selected.Role == "Member" then

        text =
            "Promote to Elder"

        allowed =
            true

    elseif selected
    and selected.Role == "Elder" then

        text =
            "Demote to Member"

        allowed =
            true
    end

    allowed =
        allowed == true
        and busy ~= true

    local kickAllowed =
        type(selected) == "table"
        and type(localMember) == "table"
        and localMember.Role == "Owner"
        and selected.UserId
            ~= LocalPlayer.UserId
        and selected.Role ~= "Owner"
        and busy ~= true

    local kickText =
        "Kick Member"

    local kickConfirming =
        kickAllowed == true
        and ZANJI_GUILD_RUNTIME.KickConfirmUserId
            == selected.UserId
        and ZANJI_GUILD_RUNTIME.KickConfirmUsername
            == selected.Username
        and os.clock()
            <= (
                tonumber(
                    ZANJI_GUILD_RUNTIME.KickConfirmExpiresAt
                )
                or 0
            )

    if kickConfirming == true then

        kickText =
            "Confirm Kick"
    end

    pcall(function()

        actions:SetText(
            "RoleAction",
            text
        )

        actions:SetDisabled(
            "RoleAction",
            allowed ~= true
        )

        actions:SetText(
            "KickAction",
            kickText
        )

        actions:SetDisabled(
            "KickAction",
            kickAllowed ~= true
        )

        actions:SetDisabled(
            "Refresh",
            ZANJI_GUILD_RUNTIME.Busy.Snapshot
                == true
            or busy == true
        )
    end)
end

