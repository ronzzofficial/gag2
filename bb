function ZanjiServerFinderRefreshMainUI()

    ZanjiServerFinderEnsureAutoJoinState()

    local ui =
        ZANJI_SERVER_FINDER_MAIN_UI

    if type(ui) ~= "table" then
        return false
    end

    ui.Lock =
        true

    local function setValue(control, value)

        if type(control) == "table"
        and type(control.SetValue) == "function" then

            pcall(function()

                control:SetValue(
                    value
                )
            end)
        end
    end

    setValue(
        ui.HudToggle,
        ZANJI_SERVER_FINDER_STATE.Enabled == true
    )

    setValue(
        ui.AutoRefreshToggle,
        ZANJI_SERVER_FINDER_STATE.AutoRefresh == true
    )

    setValue(
        ui.RefreshDelayInput,
        tostring(
            ZANJI_SERVER_FINDER_STATE.RefreshDelay
            or 5
        )
    )

    setValue(
        ui.ModeDropdown,
        ZanjiServerFinderModeDisplay(
            ZANJI_SERVER_FINDER_STATE.AutoJoinMode
        )
    )

    setValue(
        ui.MinLifeInput,
        tostring(
            ZANJI_SERVER_FINDER_STATE.AutoJoinMinLife
            or 30
        )
    )

    setValue(
        ui.CooldownInput,
        tostring(
            ZANJI_SERVER_FINDER_STATE.AutoJoinCooldown
            or 10
        )
    )

    setValue(
        ui.BuilderPetDropdown,
        ui.BuilderPet
    )

    setValue(
        ui.BuilderSizeDropdown,
        ui.BuilderSizes
    )

    setValue(
        ui.BuilderVariantDropdown,
        ui.BuilderVariants
    )

    setValue(
        ui.BuilderRarityDropdown,
        ui.BuilderRarities
    )

    setValue(
        ui.BuilderPriorityDropdown,
        ui.BuilderPriority
    )

    local pageRows,
        page,
        pageCount =
        ZanjiServerFinderBuildWatchlistPage()

    if type(ui.WatchlistTable) == "table" then

        ui.WatchlistTable:SetRows(
            pageRows
        )

        local selectedRow =
            nil

        for rowIndex, rowData in ipairs(pageRows) do

            if tonumber(
                rowData.SourceIndex
            ) == tonumber(
                ui.SelectedIndex
            ) then

                selectedRow =
                    rowIndex

                break
            end
        end

        ui.WatchlistTable:SetSelected(
            selectedRow
        )
    end

    if type(ui.WatchlistPager) == "table" then

        ui.WatchlistPager:SetVisible(
            pageCount > 1
        )

        ui.WatchlistPager:SetText(
            "Page",
            "Page "
                .. tostring(page)
                .. "/"
                .. tostring(pageCount)
        )

        ui.WatchlistPager:SetDisabled(
            "Prev",
            page <= 1
        )

        ui.WatchlistPager:SetDisabled(
            "Next",
            page >= pageCount
        )
    end

    local selectedExists =
        tonumber(ui.SelectedIndex) ~= nil
        and ZANJI_SERVER_FINDER_STATE.AutoJoinRules[
            tonumber(ui.SelectedIndex)
        ] ~= nil

    if type(ui.WatchlistActions) == "table" then

        ui.WatchlistActions:SetDisabled(
            "Edit",
            selectedExists ~= true
        )

        ui.WatchlistActions:SetDisabled(
            "Remove",
            selectedExists ~= true
        )
    end

    if type(ui.BuilderActions) == "table" then

        local editing =
            tonumber(ui.EditingIndex) ~= nil
            and ZANJI_SERVER_FINDER_STATE.AutoJoinRules[
                tonumber(ui.EditingIndex)
            ] ~= nil

        ui.BuilderActions:SetText(
            "Reset",
            editing
            and "Cancel Edit"
            or "Reset"
        )

        ui.BuilderActions:SetText(
            "Save",
            editing
            and "Save Changes"
            or "Save Filter"
        )
    end

    ui.Lock =
        false

    ZanjiSniperSetLabel(
        ui.FinderStatus,
        "HUD: "
            .. (
                ZANJI_SERVER_FINDER_STATE.Enabled
                and "ON"
                or "OFF"
            )
            .. " · Auto refresh: "
            .. (
                ZANJI_SERVER_FINDER_STATE.AutoRefresh
                and "ON"
                or "OFF"
            )
            .. " · "
            .. tostring(
                ZANJI_SERVER_FINDER_STATE.RefreshDelay
                or 5
            )
            .. "s"
    )

    ZanjiSniperSetLabel(
        ui.AutoJoinStatus,
        "Mode: "
            .. ZanjiServerFinderModeDisplay(
                ZANJI_SERVER_FINDER_STATE.AutoJoinMode
            )
            .. " · "
            .. tostring(
                #(
                    ZANJI_SERVER_FINDER_STATE.AutoJoinRules
                    or {}
                )
            )
            .. " filters"
    )

    return true
end

ZANJI_SERVER_FINDER_TOGGLE:OnChanged(function(value)

    if ZANJI_SERVER_FINDER_TOGGLE_LOCK == true
    or ZANJI_SERVER_FINDER_MAIN_UI.Lock == true then

        return
    end

    if value == true
    and ZanjiAuthRequireServerSniper(
        "Server Finder HUD",
        true
    ) ~= true then

        ZanjiServerFinderSyncToggle(
            false
        )

        return
    end

    ZanjiServerFinderSetHudVisible(
        value == true
    )

    ZanjiServerFinderRefreshMainUI()
end)

ZANJI_SERVER_FINDER_MAIN_UI.AutoRefreshToggle:OnChanged(function(value)

    if ZANJI_SERVER_FINDER_MAIN_UI.Lock == true then
        return
    end

    if value == true
    and ZanjiAuthRequireServerSniper(
        "Auto Refresh",
        true
    ) ~= true then

        ZanjiServerFinderRefreshMainUI()

        return
    end

    ZANJI_SERVER_FINDER_STATE.AutoRefresh =
        value == true

    ZanjiServerFinderApplyStateToHud(
        ZANJI_SERVER_FINDER_HUD
    )

    ZanjiQueueSaveServerFinderSettings()

    ZanjiServerFinderRefreshMainUI()
end)

