function ZanjiAuctionUpsertWatchItem(itemName, maxPrice)

    ZanjiAuctionEnsureState()

    itemName =
        ZanjiCleanText(
            itemName
        )

    maxPrice =
        ZanjiAuctionReadMoney(
            maxPrice
        )

    if itemName == ""
    or ZanjiAuctionItemKey(itemName) == "all" then

        return false,
            "Select an auction item."
    end

    if maxPrice <= 0 then

        return false,
            "Enter a valid maximum price."
    end

    local entry =
        ZanjiAuctionGetWatchEntry(
            itemName
        )

    if type(entry) == "table" then

        entry.Name =
            itemName

        entry.MaxPrice =
            maxPrice

    else

        table.insert(
            ZANJI_SHOP_STATE.AuctionWatchlist,
            {
                Name = itemName,
                MaxPrice = maxPrice,
            }
        )
    end

    ZANJI_SHOP_STATE.AuctionWatchlistSelectedKey =
        ZanjiAuctionItemKey(
            itemName
        )

    ZANJI_SHOP_STATE.AuctionNextRetryAt =
        0

    ZanjiAuctionRememberKnownItem(
        itemName
    )

    ZanjiSaveShopSettings()

    if type(ZanjiAuctionRefreshWatchlistUI) == "function" then

        ZanjiAuctionRefreshWatchlistUI(
            true
        )
    end

    ZanjiAuctionRefreshUI()

    if ZANJI_SHOP_STATE.AutoBuyAuctions == true then

        ZanjiAuctionQueueWorker(
            "watchlist changed"
        )
    end

    return true
end

function ZanjiAuctionRemoveWatchItem(itemName)

    ZanjiAuctionEnsureState()

    local entry,
        index =
        ZanjiAuctionGetWatchEntry(
            itemName
        )

    if type(entry) ~= "table"
    or index == nil then

        return false
    end

    local removedKey =
        ZanjiAuctionItemKey(
            entry.Name
        )

    table.remove(
        ZANJI_SHOP_STATE.AuctionWatchlist,
        index
    )

    if ZANJI_SHOP_STATE.AuctionWatchlistSelectedKey == removedKey then

        ZANJI_SHOP_STATE.AuctionWatchlistSelectedKey =
            ""
    end

    ZANJI_SHOP_STATE.AuctionRoundRobinIndex =
        math.min(
            ZANJI_SHOP_STATE.AuctionRoundRobinIndex,
            #ZANJI_SHOP_STATE.AuctionWatchlist
        )

    ZANJI_SHOP_STATE.AuctionNextRetryAt =
        0

    ZanjiSaveShopSettings()

    if type(ZanjiAuctionRefreshWatchlistUI) == "function" then

        ZanjiAuctionRefreshWatchlistUI(
            true
        )
    end

    ZanjiAuctionRefreshUI()

    return true
end

function ZanjiAuctionReadStock(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == ""
    or lower:find("sold", 1, true)
    or lower:find("out", 1, true)
    or lower:find("expired", 1, true) then

        return 0
    end

    -- Strict UI stock safety:
    -- only trust text like "x19,631 in Stock".
    if lower:find("stock", 1, true) == nil then
        return 0
    end

    local raw =
        text:match("x%s*([%d,]+)")
        or text:match("([%d,]+)")

    if raw == nil then
        return 0
    end

    local digits =
        tostring(raw or "")

    digits =
        digits:gsub(
            ",",
            ""
        )

    local number =
        ZanjiAuctionSafeTonumber(
            digits
        )

    return math.max(
        0,
        math.floor(
            number
            or 0
        )
    )
end

