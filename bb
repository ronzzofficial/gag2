function ZanjiHarvestPromptIsHarvest(prompt)

    if typeof(prompt) ~= "Instance"
    or prompt:IsA("ProximityPrompt") ~= true
    or ZanjiHarvestPromptIsInGarden(
        prompt
    ) ~= true then

        return false
    end

    local actionText =
        ""

    local objectText =
        ""

    local promptName =
        ""

    pcall(function()

        actionText =
            ZanjiCleanText(
                prompt.ActionText
            ):lower()

        objectText =
            ZanjiCleanText(
                prompt.ObjectText
            ):lower()

        promptName =
            ZanjiCleanText(
                prompt.Name
            ):lower()
    end)

    local combinedText =
        actionText
        .. " "
        .. objectText
        .. " "
        .. promptName

    if combinedText:find(
        "harvest",
        1,
        true
    )
    or combinedText:find(
        "pluck",
        1,
        true
    )
    or combinedText:find(
        "pick fruit",
        1,
        true
    ) then

        return true
    end

    local current =
        prompt.Parent

    for _ = 1, 14 do

        if typeof(current) ~= "Instance" then
            break
        end

        local nameKey =
            tostring(
                current.Name
                or ""
            )
            :lower()
            :gsub(
                "[^%w]",
                ""
            )

        if nameKey == "harvestpart"
        or nameKey == "fruitprompt"
        or nameKey == "harvestprompt" then

            return true
        end

        if current:GetAttribute("FruitId") ~= nil
        or current:GetAttribute("FruitID") ~= nil
        or current:GetAttribute("FruitUUID") ~= nil then

            return true
        end

        local parent =
            current.Parent

        if typeof(parent) == "Instance"
        and parent.Name == "Fruits" then

            return true
        end

        current =
            parent
    end

    return false
end

function ZanjiHarvestPromptSaveOriginal(prompt)

    local runtime =
        ZANJI_HARVEST_PROMPT_RUNTIME

    if typeof(prompt) ~= "Instance"
    or prompt:IsA("ProximityPrompt") ~= true then

        return false
    end

    if runtime.OriginalStates[prompt] ~= nil then
        return true
    end

    local originalState =
        {}

    local success =
        pcall(function()

            originalState.Enabled =
                prompt.Enabled

            originalState.MaxActivationDistance =
                prompt.MaxActivationDistance

            originalState.Style =
                prompt.Style

            originalState.ClickablePrompt =
                prompt.ClickablePrompt
        end)

    if success ~= true then
        return false
    end

    runtime.OriginalStates[prompt] =
        originalState

    return true
end

function ZanjiHarvestPromptApply(prompt)

    local runtime =
        ZANJI_HARVEST_PROMPT_RUNTIME

    if runtime.Running ~= true
    or ZanjiHarvestPromptIsHarvest(
        prompt
    ) ~= true then

        return false
    end

    if ZanjiHarvestPromptSaveOriginal(
        prompt
    ) ~= true then

        return false
    end

    if runtime.Applying[prompt] == true then
        return true
    end

    runtime.Applying[prompt] =
        true

    local hidden =
        pcall(function()

            prompt.Style =
                Enum.ProximityPromptStyle.Custom

            prompt.ClickablePrompt =
                false

            prompt.MaxActivationDistance =
                0

            prompt.Enabled =
                false
        end)

    runtime.Applying[prompt] =
        nil

    if hidden ~= true then
        return false
    end

    if runtime.PromptConnections[prompt] == nil then

        local connections =
            {}

        local function reapply()

            if runtime.Running ~= true
            or runtime.Applying[prompt] == true then

                return
            end

            task.defer(function()

                if runtime.Running == true
                and prompt.Parent ~= nil then

                    ZanjiHarvestPromptApply(
                        prompt
                    )
                end
            end)
        end

        table.insert(
            connections,
            prompt:GetPropertyChangedSignal(
                "Enabled"
            ):Connect(
                reapply
            )
        )

        table.insert(
            connections,
            prompt:GetPropertyChangedSignal(
                "MaxActivationDistance"
            ):Connect(
                reapply
            )
        )

        table.insert(
            connections,
            prompt:GetPropertyChangedSignal(
                "Style"
            ):Connect(
                reapply
            )
        )

        pcall(function()

            table.insert(
                connections,
                prompt:GetPropertyChangedSignal(
                    "ClickablePrompt"
                ):Connect(
                    reapply
                )
            )
        end)

        runtime.PromptConnections[prompt] =
            connections
    end

    return prompt.Enabled == false
end

function ZanjiHarvestPromptRestoreAll()

    local runtime =
        ZANJI_HARVEST_PROMPT_RUNTIME

    for prompt,
        connections in pairs(
        runtime.PromptConnections
        or {}
    ) do

        ZanjiHarvestPromptDisconnectList(
            connections
        )

        runtime.PromptConnections[prompt] =
            nil
    end

    for prompt,
        originalState in pairs(
        runtime.OriginalStates
        or {}
    ) do

        if typeof(prompt) == "Instance"
        and prompt.Parent ~= nil
        and type(originalState) == "table" then

            runtime.Applying[prompt] =
                true

            pcall(function()

                if originalState.Style ~= nil then

                    prompt.Style =
                        originalState.Style
                end

                if originalState.ClickablePrompt ~= nil then

                    prompt.ClickablePrompt =
                        originalState.ClickablePrompt
                end

                if originalState.MaxActivationDistance ~= nil then

                    prompt.MaxActivationDistance =
                        originalState.MaxActivationDistance
                end

                if originalState.Enabled ~= nil then

                    prompt.Enabled =
                        originalState.Enabled
                end
            end)

            runtime.Applying[prompt] =
                nil
        end

        runtime.OriginalStates[prompt] =
            nil
    end

    return true
end

function ZanjiHarvestPromptScanGarden(gardenRoot)

    if typeof(gardenRoot) ~= "Instance" then
        return 0
    end

    local hiddenCount =
        0

    for _, descendant in ipairs(
        gardenRoot:GetDescendants()
    ) do

        if descendant:IsA("ProximityPrompt")
        and ZanjiHarvestPromptApply(
            descendant
        ) == true then

            hiddenCount +=
                1
        end
    end

    return hiddenCount
end

function ZanjiHarvestPromptBindGarden(gardenRoot)

    local runtime =
        ZANJI_HARVEST_PROMPT_RUNTIME

    if runtime.Running ~= true
    or typeof(gardenRoot) ~= "Instance" then

        return false
    end

    local existingConnection =
        runtime.RootConnections[
            gardenRoot
        ]

    if typeof(existingConnection) == "RBXScriptConnection" then

        ZanjiHarvestPromptScanGarden(
            gardenRoot
        )

        return true
    end

    runtime.RootConnections[gardenRoot] =
        gardenRoot.DescendantAdded:Connect(
            function(descendant)

                if descendant:IsA("ProximityPrompt") then

                    task.defer(function()

                        if runtime.Running == true
                        and descendant.Parent ~= nil then

                            ZanjiHarvestPromptApply(
                                descendant
                            )
                        end
                    end)
                end
            end
        )

    task.defer(function()

        if runtime.Running == true
        and gardenRoot.Parent ~= nil then

            ZanjiHarvestPromptScanGarden(
                gardenRoot
            )
        end
    end)

    return true
end

function ZanjiHarvestPromptFindGardens()

    local roots =
        {}

    for _, rootName in ipairs({
        "Gardens",
        "_Gardens",
    }) do

        local gardenRoot =
            workspace:FindFirstChild(
                rootName
            )

        if typeof(gardenRoot) == "Instance" then

            table.insert(
                roots,
                gardenRoot
            )
        end
    end

    return roots
end

function ZanjiHarvestPromptBindCurrentGardens()

    local hiddenCount =
        0

    for _, gardenRoot in ipairs(
        ZanjiHarvestPromptFindGardens()
    ) do

        ZanjiHarvestPromptBindGarden(
            gardenRoot
        )

        hiddenCount +=
            ZanjiHarvestPromptScanGarden(
                gardenRoot
            )
    end

    return hiddenCount
end

function ZanjiHarvestPromptStop(reason)

    local runtime =
        ZANJI_HARVEST_PROMPT_RUNTIME

    if type(runtime) ~= "table" then
        return false
    end

    runtime.Running =
        false

    runtime.WatchdogToken =
        nil

    ZanjiHarvestPromptDisconnect(
        runtime.WorkspaceConnection
    )

    ZanjiHarvestPromptDisconnect(
        runtime.PromptShownConnection
    )

    runtime.WorkspaceConnection =
        nil

    runtime.PromptShownConnection =
        nil

    for gardenRoot,
        connection in pairs(
        runtime.RootConnections
        or {}
    ) do

        ZanjiHarvestPromptDisconnect(
            connection
        )

        runtime.RootConnections[gardenRoot] =
            nil
    end

    ZanjiHarvestPromptRestoreAll()

    return true
end

function ZanjiHarvestPromptStart(reason)

    local runtime =
        ZANJI_HARVEST_PROMPT_RUNTIME

    if runtime.Running == true then

        ZanjiHarvestPromptBindCurrentGardens()

        return true
    end

    runtime.Running =
        true

    runtime.WorkspaceConnection =
        workspace.ChildAdded:Connect(
            function(child)

                if child.Name == "Gardens"
                or child.Name == "_Gardens" then

                    ZanjiHarvestPromptBindGarden(
                        child
                    )
                end
            end
        )

    local proximityPromptService =
        game:GetService(
            "ProximityPromptService"
        )

    runtime.PromptShownConnection =
        proximityPromptService.PromptShown:Connect(
            function(prompt)

                if runtime.Running == true
                and ZanjiHarvestPromptIsHarvest(
                    prompt
                ) then

                    ZanjiHarvestPromptApply(
                        prompt
                    )
                end
            end
        )

    ZanjiHarvestPromptBindCurrentGardens()

    runtime.WatchdogToken =
        {}

    local watchdogToken =
        runtime.WatchdogToken

    task.spawn(function()

        while runtime.Running == true
        and runtime.WatchdogToken == watchdogToken do

            for prompt in pairs(
                runtime.OriginalStates
            ) do

                if typeof(prompt) ~= "Instance"
                or prompt.Parent == nil then

                    ZanjiHarvestPromptDisconnectList(
                        runtime.PromptConnections[
                            prompt
                        ]
                    )

                    runtime.PromptConnections[prompt] =
                        nil

                    runtime.OriginalStates[prompt] =
                        nil

                    runtime.Applying[prompt] =
                        nil

                else

                    ZanjiHarvestPromptApply(
                        prompt
                    )
                end
            end

            task.wait(
                0.25
            )
        end
    end)

    return true
end

function ZanjiHarvestPromptSetEnabled(value)

    value =
        value == true

    ZANJI_DEV_UI_STATE.HideHarvestPrompts =
        value

    ZanjiSaveUISettings()

    if value == true then

        return ZanjiHarvestPromptStart(
            "toggle on"
        )
    end

    return ZanjiHarvestPromptStop(
        "toggle off"
    )
end

ZANJI_HARVEST_PROMPT_RUNTIME.Stop =
    ZanjiHarvestPromptStop

function ZanjiFarmPlantHasFruitsFolder(plant)

    if typeof(plant) ~= "Instance" then
        return false
    end

    local fruitsFolder =
        plant:FindFirstChild(
            "Fruits"
        )

    return typeof(fruitsFolder) == "Instance"
end

function ZanjiFarmInstanceReady(instance)

    if typeof(instance) ~= "Instance"
    or instance.Parent == nil then

        return false
    end

    local age =
        ZanjiFarmReadNumberAttribute(
            instance,
            {
                "Age",
                "Growth",
                "GrowAge",
                "CurrentAge",
            }
        )

    local maxAge =
        ZanjiFarmReadNumberAttribute(
            instance,
            {
                "MaxAge",
                "MaxGrowth",
                "GrowTime",
                "GrowthTime",
                "RequiredAge",
            }
        )

    if age ~= nil
    and maxAge ~= nil then

        return age >= maxAge
    end

    local ready =
        ZanjiFarmReadBooleanAttribute(
            instance,
            {
                "PlantGrowthReady",
                "Ready",
                "IsReady",
                "Harvestable",
                "CanHarvest",
                "Grown",
                "FullyGrown",
                "Ripe",
            }
        )

    if ready == true then
        return true
    end

    return false
end

function ZanjiFarmFruitReady(fruit)

    if ZanjiFarmInstanceReady(
        fruit
    ) == true then

        return true
    end

    local prompt =
        ZanjiFarmFindHarvestPrompt(
            fruit
        )

    if typeof(prompt) == "Instance"
    and prompt:IsA("ProximityPrompt") then

        return prompt.Enabled == true
    end

    return false
end

function ZanjiFarmPlantLevelHarvestReady(plant)

    if typeof(plant) ~= "Instance"
    or plant.Parent == nil then

        return false
    end

    if ZanjiFarmPlantHasFruitsFolder(
        plant
    ) == true then

        return false
    end

    if ZanjiFarmInstanceReady(
        plant
    ) == true then

        return true
    end

    local prompt =
        ZanjiFarmFindPlantHarvestPrompt(
            plant
        )

    if typeof(prompt) == "Instance"
    and prompt:IsA("ProximityPrompt") then

        return prompt.Enabled == true
    end

    return false
end

function ZanjiFarmBuildFruitKey(plantId, fruitId)

    plantId =
        ZanjiCleanText(
            plantId
        )

    fruitId =
        ZanjiCleanText(
            fruitId
        )

    if plantId == ""
    or fruitId == "" then

        return ""
    end

    return plantId
        .. ":"
        .. fruitId
end

function ZanjiFarmBuildPlantHarvestKey(plantId)

    plantId =
        ZanjiCleanText(
            plantId
        )

    if plantId == "" then
        return ""
    end

    return plantId
        .. ":__PLANT_HARVEST__"
end

function ZanjiFarmResolveCollectFruitPacket(forceRefresh)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if forceRefresh ~= true
    and type(runtime.CollectFruitPacket) == "table"
    and type(runtime.CollectFruitPacket.Fire) == "function" then

        return runtime.CollectFruitPacket,
            "cached"
    end

    runtime.CollectFruitPacket =
        nil

    local networking =
        nil

    if type(ZanjiShopRequireModule) == "function" then

        networking =
            ZanjiShopRequireModule(
                "SharedModules.Networking"
            )
    end

    if type(networking) ~= "table" then

        local module =
            ReplicatedStorage:FindFirstChild("SharedModules")
            and ReplicatedStorage.SharedModules:FindFirstChild("Networking")

        if typeof(module) == "Instance"
        and module:IsA("ModuleScript") == true then

            local ok,
                result =
                pcall(function()

                    return require(
                        module
                    )
                end)

            if ok == true
            and type(result) == "table" then

                networking =
                    result
            end
        end
    end

    local packet =
        type(networking) == "table"
        and type(networking.Garden) == "table"
        and networking.Garden.CollectFruit
        or nil

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return nil,
            "Networking.Garden.CollectFruit missing"
    end

    runtime.CollectFruitPacket =
        packet

    return packet,
        "ok"
end

function ZanjiFarmPrimeStaticCaches(forceRefresh)

    local runtime =
        ZanjiFarmEnsureRuntime()

    if forceRefresh ~= true
    and runtime.StaticCachesPrimed == true then

        return true
    end

    pcall(function()

        ZanjiFarmBuildPlantNameCache(
            forceRefresh == true
        )
    end)

    pcall(function()

        ZanjiFarmBuildMutationNameCache(
            forceRefresh == true
        )
    end)

    pcall(function()

        ZanjiFarmLoadBaseKgCache(
            forceRefresh == true
        )
    end)

    pcall(function()

