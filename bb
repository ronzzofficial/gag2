    local function cleanItemKey(value)
        return tostring(
            value or ""
        )
            :lower()
            :gsub(
                "[%s%p_]",
                ""
            )
    end

    local function cleanItemName(value)
        local result =
            tostring(
                value or ""
            )

        result =
            result:gsub(
                "%s*%[%s*[xX]%d+%s*%]%s*$",
                ""
            )

        result =
            result:gsub(
                "%s+[xX]%d+%s*$",
                ""
            )

        result =
            result:gsub(
                "^%s+",
                ""
            )

        result =
            result:gsub(
                "%s+$",
                ""
            )

        return result
    end

    local function firstText(...)
        for index = 1, select("#", ...) do
            local value =
                select(
                    index,
                    ...
                )

            if type(value) == "string" then
                local cleaned =
                    cleanItemName(
                        value
                    )

                if cleaned ~= "" then
                    return cleaned
                end
            end
        end

        return ""
    end

    local function walkCatalog(
        value,
        callback,
        depth,
        seen
    )
        if type(value) ~= "table" then
            return
        end

        depth =
            depth or 0

        if depth > 6 then
            return
        end

        seen =
            seen or {}

        if seen[value] then
            return
        end

        seen[value] =
            true

        callback(value)

        for _, child in pairs(value) do
            if type(child) == "table" then
                walkCatalog(
                    child,
                    callback,
                    depth + 1,
                    seen
                )
            end
        end
    end

