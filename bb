    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    ZANJI_MERGE_AUTOMATION_STATE.SelectedPickupPlants =
        ZanjiMergeAutomationNormalizePlantSelection(
            value,
            runtime.PickupDisplayToPlant,
            "All Potted Plants"
        )

    runtime.PlantListSignature =
        nil

    ZanjiSaveFarmSettings()
    ZanjiMergeAutomationRefreshPlantDropdowns(true)
    ZanjiMergeAutomationWake()

    return ZANJI_MERGE_AUTOMATION_STATE.SelectedPickupPlants
