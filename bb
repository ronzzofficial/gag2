function ZanjiEclipseCollectionEnsureRuntime()

    ZANJI_ECLIPSE_COLLECTION_RUNTIME =
        type(ZANJI_ECLIPSE_COLLECTION_RUNTIME) == "table"
        and ZANJI_ECLIPSE_COLLECTION_RUNTIME
        or {}

    local runtime =
        ZANJI_ECLIPSE_COLLECTION_RUNTIME

    runtime.Running =
        runtime.Running == true

    runtime.WaitingForStart =
        runtime.WaitingForStart == true

    runtime.WaitingForEnd =
        runtime.WaitingForEnd == true

    runtime.Confirming =
        runtime.Confirming == true

    runtime.PendingEntry =
        type(runtime.PendingEntry) == "table"
        and runtime.PendingEntry
        or nil

    runtime.ConfirmationStartedAt =
        tonumber(
            runtime.ConfirmationStartedAt
        )
        or 0

    runtime.ConfirmationTimeout =
        math.clamp(
            tonumber(
                runtime.ConfirmationTimeout
            )
            or 2.5,
            0.5,
            10
        )

    runtime.RetryCount =
        math.max(
            0,
            math.floor(
                tonumber(
                    runtime.RetryCount
                )
                or 0
            )
        )

    runtime.RetryDelay =
        math.clamp(
            tonumber(
                runtime.RetryDelay
            )
            or 0.75,
            0.25,
            5
        )

    runtime.RejoinPending =
        runtime.RejoinPending == true

    runtime.RejoinAt =
        tonumber(
            runtime.RejoinAt
        )
        or 0

    runtime.Teleporting =
        runtime.Teleporting == true

    runtime.NextCollectAt =
        tonumber(
            runtime.NextCollectAt
        )
        or 0

    runtime.LastFireAt =
        tonumber(
            runtime.LastFireAt
        )
        or 0

    runtime.LastPlantId =
        tostring(
            runtime.LastPlantId
            or ""
        )

    runtime.LastFruitId =
        tostring(
            runtime.LastFruitId
            or ""
        )

    return runtime
end

function ZanjiEclipseCollectionOwnsPlantName(
    plantName
)

    return type(ZANJI_FARM_STATE) == "table"
        and ZANJI_FARM_STATE.AutoEclipseCollection == true
        and ZanjiFarmPlantKey(
            plantName
        ) == ZanjiFarmPlantKey(
            "Eclipse Bloom"
        )
end

function ZanjiEclipseCollectionServerNow()

    local ok,
        serverNow =
        pcall(function()

            return workspace:GetServerTimeNow()
        end)

    if ok == true
    and tonumber(serverNow) then

        return tonumber(serverNow)
    end

    return os.time()
end

function ZanjiEclipseCollectionWeatherActive()

    local weatherText =
        ZanjiFarmPlantKey(
            workspace:GetAttribute(
                "ActiveWeather"
            )
        )
        .. " "
        .. ZanjiFarmPlantKey(
            workspace:GetAttribute(
                "ActivePhase"
            )
        )
        .. " "
        .. ZanjiFarmPlantKey(
            workspace:GetAttribute(
                "Phase"
            )
        )

    if weatherText:find(
        "eclipse",
        1,
        true
    ) == nil then

        return false
    end

    local phaseEnd =
        tonumber(
            workspace:GetAttribute(
                "PhaseDuration"
            )
        )

    if phaseEnd
    and phaseEnd > 0
    and ZanjiEclipseCollectionServerNow()
        >= phaseEnd then

        return false
    end

    return true
end

function ZanjiEclipseCollectionFindProEntry()

    if ZANJI_FARM_STATE.ProFruitCollector ~= true then
        return nil
    end

    local runtime =
        ZanjiProFarmEnsureRuntime()

    if runtime.SnapshotReady ~= true
    or type(runtime.Cache) ~= "table"
    or type(runtime.Cache.Plants) ~= "table" then

        return nil
    end

    for plantId, plantData in pairs(
        runtime.Cache.Plants
    ) do

        if type(plantData) == "table" then

            local plantName =
                ZanjiCleanText(
                    plantData.PlantName
                    or plantData.FruitName
                    or plantData.SeedName
                    or plantData.Name
                    or ""
                )

            if ZanjiEclipseCollectionOwnsPlantName(
                plantName
            ) == true then

                local fruitCount =
                    0

                if type(plantData.Fruits) == "table" then

                    for fruitId, fruitData in pairs(
                        plantData.Fruits
                    ) do

                        if type(fruitData) == "table" then

                            fruitCount +=
                                1

                            if ZanjiProFarmDataReady(
                                fruitData
                            ) == true then

                                return ZanjiProFarmBuildEntry(
                                    plantId,
                                    plantData,
                                    fruitId,
                                    fruitData
                                )
                            end
                        end
                    end
                end

                if fruitCount == 0
                and (
                    tonumber(
                        plantData.MaxFruitSpawnLocations
                    )
                    or 0
                ) <= 0
                and ZanjiProFarmDataReady(
                    plantData
                ) == true then

                    return ZanjiProFarmBuildEntry(
                        plantId,
                        plantData,
                        "",
                        plantData
                    )
                end
            end
        end
    end

    return nil
end

function ZanjiEclipseCollectionFindWorkspaceEntry()

    local plot =
        ZanjiFarmResolveOwnPlot(
            false
        )

    if typeof(plot) ~= "Instance" then

        plot =
            ZanjiFarmResolveOwnPlot(
                true
            )
    end

    if typeof(plot) ~= "Instance" then
        return nil
    end

    local plantsFolder =
        plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) ~= "Instance" then
        return nil
    end

    for _, plant in ipairs(
        plantsFolder:GetChildren()
    ) do

        local plantName =
            ZanjiFarmReadPlantName(
                plant,
                nil
            )

        if ZanjiEclipseCollectionOwnsPlantName(
            plantName
        ) == true then

            local plantId =
                ZanjiFarmReadPlantId(
                    plant
                )

            local fruitsFolder =
                plant:FindFirstChild(
                    "Fruits"
                )

            if typeof(fruitsFolder) == "Instance" then

                for _, fruit in ipairs(
                    fruitsFolder:GetChildren()
                ) do

                    if ZanjiFarmFruitReady(
                        fruit
                    ) == true then

                        local fruitId =
                            ZanjiFarmReadFruitId(
                                plant,
                                fruit
                            )

                        if ZanjiCleanText(plantId) ~= ""
                        and ZanjiCleanText(fruitId) ~= "" then

                            return {
                                Kind =
                                    "FruitHarvest",

                                Plant =
                                    plant,

                                Fruit =
                                    fruit,

                                PlantName =
                                    plantName,

                                PlantId =
                                    plantId,

                                FruitId =
                                    fruitId,

                                Key =
                                    ZanjiFarmBuildFruitKey(
                                        plantId,
                                        fruitId
                                    ),
                            }
                        end
                    end
                end

            elseif ZanjiFarmPlantLevelHarvestReady(
                plant
            ) == true
            and ZanjiCleanText(plantId) ~= "" then

                return {
                    Kind =
                        "PlantHarvest",

                    Plant =
                        plant,

                    Fruit =
                        plant,

                    PlantName =
                        plantName,

                    PlantId =
                        plantId,

                    FruitId =
                        "",

                    Key =
                        ZanjiFarmBuildPlantHarvestKey(
                            plantId
                        ),
                }
            end
        end
    end

    return nil
end

function ZanjiEclipseCollectionFindEntry()

    local proEntry =
        ZanjiEclipseCollectionFindProEntry()

    if type(proEntry) == "table" then
        return proEntry
    end

    return ZanjiEclipseCollectionFindWorkspaceEntry()
end

function ZanjiEclipseCollectionTargetExists(
    entry
)

    if type(entry) ~= "table" then
        return false
    end

    local plantId =
        ZanjiCleanText(
            entry.PlantId
            or ""
        )

    local fruitId =
        ZanjiCleanText(
            entry.FruitId
            or ""
        )

    if plantId == "" then
        return false
    end

    if type(ZANJI_FARM_STATE) == "table"
    and ZANJI_FARM_STATE.ProFruitCollector == true
    and type(ZanjiProFarmTargetExists) == "function" then

        local proRuntime =
            type(ZANJI_PRO_FARM_RUNTIME) == "table"
            and ZANJI_PRO_FARM_RUNTIME
            or {}

        if proRuntime.SnapshotReady == true then

            local ok,
                exists =
                pcall(function()

                    return ZanjiProFarmTargetExists(
                        entry
                    )
                end)

            if ok == true then
                return exists == true
            end
        end
    end

    local plot =
        ZanjiFarmResolveOwnPlot(
            false
        )

    if typeof(plot) ~= "Instance" then

        plot =
            ZanjiFarmResolveOwnPlot(
                true
            )
    end

    if typeof(plot) ~= "Instance" then

        if entry.Kind == "PlantHarvest"
        and typeof(entry.Plant) == "Instance" then

            return entry.Plant.Parent ~= nil
        end

        if typeof(entry.Fruit) == "Instance" then

            return entry.Fruit.Parent ~= nil
        end

        return true
    end

    local plantsFolder =
        plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) ~= "Instance" then
        return true
    end

    for _, plant in ipairs(
        plantsFolder:GetChildren()
    ) do

        if ZanjiCleanText(
            ZanjiFarmReadPlantId(
                plant
            )
        ) == plantId then

            if entry.Kind == "PlantHarvest"
            or fruitId == "" then

                return true
            end

            local fruitsFolder =
                plant:FindFirstChild(
                    "Fruits"
                )

            if typeof(fruitsFolder) ~= "Instance" then
                return false
            end

            for _, fruit in ipairs(
                fruitsFolder:GetChildren()
            ) do

                if ZanjiCleanText(
                    ZanjiFarmReadFruitId(
                        plant,
                        fruit
                    )
                ) == fruitId then

                    return true
                end
            end

            return false
        end
    end

    return false
end

function ZanjiEclipseCollectionClearPending()

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    runtime.Confirming =
        false

    runtime.PendingEntry =
        nil

    runtime.ConfirmationStartedAt =
        0

    runtime.RetryCount =
        0

    return true
end

function ZanjiEclipseCollectionCancelRejoin(
    resumeCollection
)

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    runtime.RejoinPending =
        false

    runtime.RejoinAt =
        0

    if resumeCollection == true
    and runtime.Running == true
    and ZANJI_FARM_STATE.AutoEclipseCollection == true then

        local eclipseActive =
            ZanjiEclipseCollectionWeatherActive()

        runtime.WaitingForStart =
            eclipseActive ~= true

        runtime.WaitingForEnd =
            eclipseActive == true

        runtime.NextCollectAt =
            math.huge
    end

    return true
end

function ZanjiEclipseCollectionCompleteConfirmation()

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    ZanjiEclipseCollectionClearPending()

    runtime.NextCollectAt =
        math.huge

    if ZANJI_FARM_STATE.AutoEclipseCollection == true
    and ZANJI_FARM_STATE.RejoinAfterEclipseHarvest == true then

        runtime.WaitingForStart =
            false

        runtime.WaitingForEnd =
            false

        runtime.RejoinPending =
            true

        runtime.RejoinAt =
            os.clock()
            + 1

        return true
    end

    runtime.RejoinPending =
        false

    runtime.RejoinAt =
        0

    runtime.WaitingForStart =
        true

    runtime.WaitingForEnd =
        false

    return true
end

function ZanjiEclipseCollectionSendEntry(
    entry,
    retryCount
)

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    if ZANJI_FARM_STATE.AutoEclipseCollection ~= true
    or type(entry) ~= "table"
    or ZanjiEclipseCollectionWeatherActive() == true then

        return false
    end

    if type(ZanjiFarmAutoCollectBlocked) == "function"
    and ZanjiFarmAutoCollectBlocked() == true then

        return false
    end

    if ZanjiEclipseCollectionTargetExists(
        entry
    ) ~= true then

        return false
    end

    local packet =
        ZanjiFarmResolveCollectFruitPacket(
            false
        )

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false
    end

    local ok =
        pcall(function()

            packet:Fire(
                entry.PlantId,
                entry.FruitId
                or ""
            )
        end)

    if ok ~= true then
        return false
    end

    runtime.Confirming =
        true

    runtime.PendingEntry =
        entry

    runtime.ConfirmationStartedAt =
        os.clock()

    runtime.RetryCount =
        math.max(
            0,
            math.floor(
                tonumber(
                    retryCount
                )
                or 0
            )
        )

    runtime.WaitingForStart =
        false

    runtime.WaitingForEnd =
        false

    runtime.NextCollectAt =
        math.huge

    runtime.LastFireAt =
        os.clock()

    runtime.LastPlantId =
        tostring(
            entry.PlantId
            or ""
        )

    runtime.LastFruitId =
        tostring(
            entry.FruitId
            or ""
        )

    return true
end

function ZanjiEclipseCollectionProcessConfirmation()

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    if runtime.Confirming ~= true then
        return false
    end

    local entry =
        runtime.PendingEntry

    if type(entry) ~= "table" then

        ZanjiEclipseCollectionClearPending()

        runtime.NextCollectAt =
            os.clock()
            + 1

        return false
    end

    if ZanjiEclipseCollectionTargetExists(
        entry
    ) ~= true then

        return ZanjiEclipseCollectionCompleteConfirmation()
    end

    local elapsed =
        os.clock()
        - (
            tonumber(
                runtime.ConfirmationStartedAt
            )
            or os.clock()
        )

    if elapsed < runtime.ConfirmationTimeout then
        return false
    end

    if runtime.RetryCount < 1 then

        if ZanjiEclipseCollectionWeatherActive() == true then
            return false
        end

        if type(ZanjiFarmAutoCollectBlocked) == "function"
        and ZanjiFarmAutoCollectBlocked() == true then

            return false
        end

        task.wait(
            runtime.RetryDelay
        )

        if ZanjiEclipseCollectionTargetExists(
            entry
        ) ~= true then

            return ZanjiEclipseCollectionCompleteConfirmation()
        end

        if ZanjiEclipseCollectionSendEntry(
            entry,
            1
        ) == true then

            return true
        end

        if ZanjiEclipseCollectionTargetExists(
            entry
        ) ~= true then

            return ZanjiEclipseCollectionCompleteConfirmation()
        end

        ZanjiEclipseCollectionClearPending()

        runtime.NextCollectAt =
            os.clock()
            + 1

        return false
    end

    if ZANJI_FARM_STATE.ProFruitCollector == true
    and type(ZanjiProFarmRequestSnapshot) == "function" then

        ZanjiProFarmRequestSnapshot(
            "eclipse confirmation failed"
        )
    end

    ZanjiEclipseCollectionClearPending()

    runtime.NextCollectAt =
        os.clock()
        + 1

    return false
end

function ZanjiEclipseCollectionRejoinBlocked()

    if type(ZanjiFarmAutoCollectBlocked) == "function"
    and ZanjiFarmAutoCollectBlocked() == true then

        return true
    end

    local sniper =
        type(ZANJI_SNIPER_RUNTIME) == "table"
        and ZANJI_SNIPER_RUNTIME
        or {}

    if sniper.ManualBuying == true
    or sniper.BatchActive == true then

        return true
    end

    if type(ZanjiSniperServerSwitchBlocked) == "function"
    and ZanjiSniperServerSwitchBlocked(
        "Eclipse harvest rejoin",
        false
    ) == true then

        return true
    end

    if type(ZANJI_SERVER_STATE) == "table"
    and ZANJI_SERVER_STATE.Hopping == true then

        return true
    end

    if type(ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME) == "table"
    and ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.Teleporting == true then

        return true
    end

    if type(ZANJI_WATERING_REJOIN_RUNTIME) == "table"
    and (
        ZANJI_WATERING_REJOIN_RUNTIME.Running == true
        or ZANJI_WATERING_REJOIN_RUNTIME.Teleporting == true
    ) then

        return true
    end

    return false
end

function ZanjiEclipseCollectionProcessRejoin()

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    if runtime.RejoinPending ~= true then
        return false
    end

    if ZANJI_FARM_STATE.AutoEclipseCollection ~= true
    or ZANJI_FARM_STATE.RejoinAfterEclipseHarvest ~= true then

        ZanjiEclipseCollectionCancelRejoin(
            true
        )

        return false
    end

    if runtime.Teleporting == true then
        return true
    end

    if os.clock() < runtime.RejoinAt then
        return false
    end

    if ZanjiEclipseCollectionRejoinBlocked() == true then

        runtime.RejoinAt =
            os.clock()
            + 0.5

        return false
    end

    if type(ZanjiRejoin) ~= "function" then

        runtime.RejoinAt =
            os.clock()
            + 1

        return false
    end

    local token =
        runtime.Token

    local startedJobId =
        tostring(
            game.JobId
        )

    runtime.Teleporting =
        true

    local callOk,
        rejoinStarted =
        pcall(function()

            return ZanjiRejoin()
        end)

    if callOk == true
    and rejoinStarted == true then

        runtime.RejoinPending =
            false

        task.delay(15, function()

            if runtime.Token == token
            and tostring(game.JobId) == startedJobId
            and ZANJI_FARM_STATE.AutoEclipseCollection == true
            and ZANJI_FARM_STATE.RejoinAfterEclipseHarvest == true then

                runtime.Teleporting =
                    false

                runtime.RejoinPending =
                    true

                runtime.RejoinAt =
                    os.clock()
                    + 1
            end
        end)

        return true
    end

    runtime.Teleporting =
        false

    runtime.RejoinPending =
        true

    runtime.RejoinAt =
        os.clock()
        + 3

    return false
end

function ZanjiEclipseCollectionFireOne()

    if ZANJI_FARM_STATE.AutoEclipseCollection ~= true
    or ZanjiEclipseCollectionWeatherActive() == true then

        return false
    end

    if type(ZanjiFarmAutoCollectBlocked) == "function"
    and ZanjiFarmAutoCollectBlocked() == true then

        return false
    end

    local entry =
        ZanjiEclipseCollectionFindEntry()

    if type(entry) ~= "table" then
        return false
    end

    if ZanjiEclipseCollectionWeatherActive() == true then
        return false
    end

    return ZanjiEclipseCollectionSendEntry(
        entry,
        0
    )
end

function ZanjiEclipseCollectionRunWorker(
    token
)

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    while runtime.Token == token
    and ZANJI_FARM_STATE.AutoEclipseCollection == true do

        local eclipseActive =
            ZanjiEclipseCollectionWeatherActive()

        if runtime.Teleporting == true then

            task.wait(
                0.25
            )

            continue
        end

        if runtime.RejoinPending == true then

            ZanjiEclipseCollectionProcessRejoin()

        elseif runtime.Confirming == true then

            ZanjiEclipseCollectionProcessConfirmation()

        elseif runtime.WaitingForStart == true then

            if eclipseActive == true then

                runtime.WaitingForStart =
                    false

                runtime.WaitingForEnd =
                    true
            end

        elseif runtime.WaitingForEnd == true then

            if eclipseActive ~= true then

                runtime.WaitingForEnd =
                    false

                runtime.NextCollectAt =
                    os.clock()
                    + 2
            end

        elseif eclipseActive == true then

            runtime.WaitingForEnd =
                true

            runtime.NextCollectAt =
                math.huge

        elseif os.clock()
            >= runtime.NextCollectAt then

            if ZanjiEclipseCollectionFireOne() ~= true then

                runtime.NextCollectAt =
                    os.clock()
                    + 1
            end
        end

        task.wait(
            0.25
        )
    end

    if runtime.Token == token then

        runtime.Running =
            false
    end
end

function ZanjiEclipseCollectionStart(
    reason
)

    ZanjiFarmEnsureState()

    if ZANJI_FARM_STATE.AutoEclipseCollection ~= true then
        return false
    end

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    if runtime.Running == true then
        return false
    end

    runtime.Token =
        {}

    runtime.Running =
        true

    runtime.Confirming =
        false

    runtime.PendingEntry =
        nil

    runtime.ConfirmationStartedAt =
        0

    runtime.RetryCount =
        0

    runtime.RejoinPending =
        false

    runtime.RejoinAt =
        0

    runtime.Teleporting =
        false

    runtime.WaitingForStart =
        false

    runtime.WaitingForEnd =
        ZanjiEclipseCollectionWeatherActive()

    runtime.NextCollectAt =
        runtime.WaitingForEnd == true
        and math.huge
        or os.clock()

    local token =
        runtime.Token

    task.spawn(function()

        ZanjiEclipseCollectionRunWorker(
            token
        )
    end)

    return true
end

function ZanjiEclipseCollectionStop(
    reason
)

    local runtime =
        ZanjiEclipseCollectionEnsureRuntime()

    runtime.Token =
        nil

    runtime.Running =
        false

    runtime.WaitingForStart =
        false

    runtime.WaitingForEnd =
        false

    runtime.Confirming =
        false

    runtime.PendingEntry =
        nil

    runtime.ConfirmationStartedAt =
        0

    runtime.RetryCount =
        0

    runtime.RejoinPending =
        false

    runtime.RejoinAt =
        0

    runtime.Teleporting =
        false

    runtime.NextCollectAt =
        0

    return true
end

function ZanjiEclipseCollectionSetEnabled(
    value
)

    ZanjiFarmEnsureState()

    ZANJI_FARM_STATE.AutoEclipseCollection =
        value == true

    ZanjiSaveFarmSettings()

    if ZANJI_FARM_STATE.AutoEclipseCollection == true then

        return ZanjiEclipseCollectionStart(
            "toggle on"
        )
    end

    ZanjiEclipseCollectionStop(
        "toggle off"
    )

    if ZANJI_FARM_STATE.AutoCollectFruits == true then

        ZanjiFarmRequestRebuild(
            "eclipse collection disabled",
            0.05
        )
    end

    return true
end

function ZanjiEclipseCollectionSetRejoinAfterHarvest(
    value
)

    ZanjiFarmEnsureState()

    ZANJI_FARM_STATE.RejoinAfterEclipseHarvest =
        value == true

    ZanjiSaveFarmSettings()

    if ZANJI_FARM_STATE.RejoinAfterEclipseHarvest ~= true then

        ZanjiEclipseCollectionCancelRejoin(
            true
        )
    end

    return true
end

ZANJI_ECLIPSE_COLLECTION_RUNTIME.Stop =
    ZanjiEclipseCollectionStop

