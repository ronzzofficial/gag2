function ZanjiSniperStart(reason)

    ZANJI_SNIPER_RUNTIME =
        type(ZANJI_SNIPER_RUNTIME) == "table"
        and ZANJI_SNIPER_RUNTIME
        or {}

    if ZANJI_SNIPER_RUNTIME.Running == true then
        return false
    end

    ZANJI_SNIPER_RUNTIME.Running =
        true

    ZANJI_SNIPER_RUNTIME.LoadingReady =
        false

    ZANJI_SNIPER_RUNTIME.StartClock =
        os.clock()

    ZANJI_SNIPER_RUNTIME.AutoHopInProgress =
        false

    ZANJI_SNIPER_RUNTIME.HopFailureBackoffUntil =
        0

    ZANJI_SNIPER_RUNTIME.NoMatchSince =
        0

    ZANJI_SNIPER_RUNTIME.NoMatchScans =
        0

    ZANJI_SNIPER_RUNTIME.Buying =
        false

    ZANJI_SNIPER_RUNTIME.Returning =
        false

    ZANJI_SNIPER_RUNTIME.BatchActive =
        false

    ZANJI_SNIPER_RUNTIME.BatchBoughtCount =
        0

    ZANJI_SNIPER_RUNTIME.BatchEmptySince =
        0

    ZanjiSniperClearTargetLock(
        "sniper start"
    )

    local startRoot =
        ZanjiSniperGetCharacterRoot()

    ZANJI_SNIPER_RUNTIME.ReturnActivationCFrame =
        startRoot
        and startRoot:IsA("BasePart")
        and startRoot.CFrame
        or nil

    ZANJI_SNIPER_RUNTIME.FarmCenterCFrame =
        nil

    ZANJI_SNIPER_RUNTIME.FarmCenterLastScanAt =
        0

    ZanjiSniperGetFarmCenterCFrame(
        true
    )

    ZANJI_SNIPER_RUNTIME.Handled =
        type(ZANJI_SNIPER_RUNTIME.Handled) == "table"
        and ZANJI_SNIPER_RUNTIME.Handled
        or {}

    ZANJI_SNIPER_RUNTIME.FailedUntil =
        type(ZANJI_SNIPER_RUNTIME.FailedUntil) == "table"
        and ZANJI_SNIPER_RUNTIME.FailedUntil
        or {}

    ZANJI_SNIPER_RUNTIME.BoughtCounts =
        type(ZANJI_SNIPER_RUNTIME.BoughtCounts) == "table"
        and ZANJI_SNIPER_RUNTIME.BoughtCounts
        or {}

    local token =
        {}

    ZANJI_SNIPER_RUNTIME.Token =
        token

    ZanjiSniperSetStatus(
        "Waiting for loading"
    )

    task.spawn(function()

        while ZANJI_SNIPER_RUNTIME.Token == token
        and ZANJI_SNIPER_STATE.ActivateSniper == true do

            if ZanjiSniperLoadingGateReady() ~= true then

                if ZANJI_SNIPER_STATE.AutoHop == true
                and ZanjiSniperNormalizeAutoHopTiming(
                    ZANJI_SNIPER_STATE.AutoHopTiming
                ) == "Fast - During Loading" then

                    local hopOk,
                        hopErr =
                        pcall(function()

                            ZanjiSniperEarlyAutoHopTick(
                                token
                            )
                        end)

                    if hopOk ~= true then

                        ZanjiSniperSetStatus(
                            "Fast Hop error: "
                            .. tostring(hopErr)
                        )

                        task.wait(
                            1
                        )

                    else

                        task.wait(
                            0.22
                        )
                    end

                else

                    ZanjiSniperAutoHopReset(
                        "waiting loading"
                    )

                    ZanjiSniperSetStatus(
                        "Waiting for loading"
                    )

                    task.wait(
                        0.25
                    )
                end

            else

                ZANJI_SNIPER_RUNTIME.LoadingReady =
                    true

                local ok,
                    err =
                    pcall(function()

                        ZanjiSniperTick(
                            token
                        )
                    end)

                if ok ~= true then

                    ZanjiSniperSetStatus(
                        "Sniper error: "
                        .. tostring(err)
                    )

                    task.wait(
                        1
                    )
                end

                task.wait(
                    0.18
                )
            end
        end

        if ZANJI_SNIPER_RUNTIME.Token == token then

            ZANJI_SNIPER_RUNTIME.Running =
                false
        end
    end)

