end

function ZanjiDoubleRollWithFavoriteRace(token, rollIndex, targetWins, requireActive)

    if requireActive == true
    and ZanjiDoubleStillActive(token) ~= true then

        return nil,
            false,
            "stopped",
            {}
    end

    local snapshotRows =
        ZanjiDoubleGetFruitRows()

    local favoriteDelay =
        ZanjiDoubleReadDelay(
            ZANJI_SHOP_STATE.DoubleBustFavDelay,
            0.10,
            5
        )

    local rollDone =
        false

    local favoriteBusy =
        false

    local favoriteRows =
        nil

    local result =
        nil

    local rollOk =
        false

    local rollReason =
        "not started"

    task.spawn(function()

        result,
            rollOk,
            rollReason =
            ZanjiDoubleFirePacket(
                "DoubleOrNothing"
            )

        rollDone =
            true
    end)

    if #snapshotRows > 0 then

        task.delay(favoriteDelay, function()

            if rollDone == true then
                return
            end

            favoriteRows =
                snapshotRows

            favoriteBusy =
                true

            ZanjiDoubleSetRowsFavorite(
                snapshotRows,
                true,
                "roll race"
            )

            favoriteBusy =
                false
        end)
    end

    local deadline =
        os.clock() + 12

    while rollDone ~= true
    and os.clock() <= deadline do

        if requireActive == true
        and ZanjiDoubleStillActive(token) ~= true then

            rollDone =
                true

            return nil,
                false,
                "stopped",
                favoriteRows or {}
        end

        task.wait(
            0.02
        )
    end

    if rollDone ~= true then

        rollDone =
            true

        return nil,
            false,
            "roll timeout",
            favoriteRows or {}
    end

    local favoriteDeadline =
        os.clock() + 1.5

    while favoriteBusy == true
    and os.clock() <= favoriteDeadline do

        task.wait(
            0.02
        )
    end

    return result,
        rollOk,
        rollReason,
        favoriteRows or {}
end

function ZanjiDoubleDoOneRoll(token, rollIndex, targetWins, requireActive)

    ZanjiDoubleSetStatus(
        "🎲 Roll "
        .. tostring(rollIndex)
        .. "/"
        .. tostring(targetWins)
    )

    local result,
        rollOk,
        rollReason,
        favoriteRows =
        ZanjiDoubleRollWithFavoriteRace(
            token,
            rollIndex,
            targetWins,
            requireActive == true
        )

    if rollOk ~= true
    or type(result) ~= "table" then

        if #favoriteRows > 0 then

            ZanjiDoubleReleaseRows(
                favoriteRows,
                "roll failed restore"
            )
        end

        ZanjiDoubleSetStatus(
            "⚠️ Roll failed: "
            .. tostring(rollReason)
        )

        return false,
            result,
            "failed"
    end

    if result.Success == false then

        if #favoriteRows > 0 then

            ZanjiDoubleReleaseRows(
                favoriteRows,
                "blocked restore"
            )
        end

        ZanjiDoubleSetStatus(
            "⛔ Blocked: "
            .. tostring(result.Reason or "server")
        )

        return false,
            result,
            "blocked"
    end

    if result.Busted == true then

        ZanjiDoubleUpdateFromRollResult(
            result
        )

        ZanjiDoubleSetStatus(
            "💥 Busted: lost "
            .. tostring(result.LostCount or "?")
            .. " fruit(s)"
        )

        if #favoriteRows > 0 then

            ZanjiDoubleReleaseRows(
                favoriteRows,
                "busted restore"
            )
        end

        return true,
            result,
            "busted"
    end

    if result.Won == true then

        ZanjiDoubleUpdateFromRollResult(
            result
        )

        ZanjiDoubleSetStatus(
            "✅ Won "
            .. tostring(result.Wins or rollIndex)
            .. " | 💰 Pot "
            .. ZanjiDoubleFormatNumber(
                result.Pot or 0
            )
        )

        if #favoriteRows > 0 then

            ZanjiDoubleReleaseRows(
                favoriteRows,
                "won restore"
            )
        end

        return true,
            result,
            "won"
    end

    if #favoriteRows > 0 then

        ZanjiDoubleReleaseRows(
            favoriteRows,
            "unknown restore"
        )
    end

    ZanjiDoubleSetStatus(
        "⚠️ Unknown roll result"
    )

    return false,
        result,
        "unknown"
end

function ZanjiDoubleCashoutCurrent(requireActive, token)

    if requireActive == true
    and ZanjiDoubleStillActive(token) ~= true then

        return false
    end

    ZanjiDoubleSetStatus(
        "🔓 Restoring favorites..."
    )

    ZanjiDoubleUnfavoriteTouchedRows(
        "cashout restore"
    )

    task.wait(
        0.25
    )

    if requireActive == true
    and ZanjiDoubleStillActive(token) ~= true then

        return false
    end

    ZanjiDoubleSetStatus(
        "💰 Cashing out..."
    )

    local cashout,
        cashoutOk,
        cashoutReason =
        ZanjiDoubleFirePacket(
            "CashOutDoubleOrNothing"
        )

    if cashoutOk ~= true
    or type(cashout) ~= "table" then

        ZanjiDoubleSetStatus(
            "⚠️ Cashout failed: "
            .. tostring(cashoutReason)
        )

        return false
    end

    if cashout.Success == false then

        ZanjiDoubleSetStatus(
            "⛔ Cashout blocked: "
            .. tostring(cashout.Reason or "server")
        )

        return false
    end

    ZanjiDoubleUpdateFromCashout(
        cashout
    )

    ZanjiDoubleSetStatus(
        "💰 Cashed: +"
        .. ZanjiDoubleFormatNumber(
            cashout.SellPrice or 0
        )
        .. " | "
        .. tostring(cashout.SoldCount or "?")
        .. " fruit(s)"
    )

    return true
end

function ZanjiDoubleRunOnce(token)

    if ZanjiDoubleStillActive(token) ~= true then
        return false
    end

    local preview,
        previewOk,
        previewReason =
        ZanjiDoubleFirePacket(
            "PreviewSellAll"
        )

    if previewOk ~= true
    or type(preview) ~= "table" then

        ZanjiDoubleSetStatus(
            "⚠️ Preview failed: "
            .. tostring(previewReason)
        )

        return false
    end

    local fruitCount,
        totalValue =
        ZanjiDoublePreviewNumbers(
            preview
        )

    if fruitCount <= 0 then

        ZanjiDoubleSetStatus(
            "⏳ Waiting for fruits"
        )

        return false
    end

    local targetWins =
        ZanjiDoubleReadTargetWins()

    ZanjiDoubleSetStatus(
        "🎲 Rolling "
        .. tostring(fruitCount)
        .. " fruit(s) | 🎯 "
        .. tostring(targetWins)
        .. " win(s)"
    )

    local currentWins =
        0

    for rollIndex = 1, targetWins do

        if ZanjiDoubleStillActive(token) ~= true then
            return false
        end

        task.wait(
            rollIndex == 1
            and 0.15
            or 0.65
        )

        local rollSuccess,
            result,
            mode =
            ZanjiDoubleDoOneRoll(
                token,
                rollIndex,
                targetWins,
                true
            )

        if rollSuccess ~= true then
            return false
        end

        if mode == "busted" then
            return true
        end

        if mode == "won" then

            currentWins =
                tonumber(
                    result
                    and result.Wins
                )
                or rollIndex

            if currentWins >= targetWins then
                break
            end
        end
    end

    if currentWins < targetWins then

        ZanjiDoubleSetStatus(
            "⚠️ Stopped at "
            .. tostring(currentWins)
            .. " win(s)"
        )

        return false
    end

    if ZanjiDoubleStillActive(token) ~= true then
        return false
    end

    task.wait(
        0.35
    )

    return ZanjiDoubleCashoutCurrent(
        true,
        token
    )
end

function ZanjiDoubleManualDouble()

    ZanjiDoubleEnsureState()

    if ZANJI_SHOP_STATE.DoubleWorkerRunning == true then

        ZanjiDoubleSetStatus(
            "⚠️ Manual blocked: auto running"
        )

        return false
    end

    if ZANJI_SHOP_STATE.DoubleManualBusy == true then

        ZanjiDoubleSetStatus(
            "⏳ Manual busy"
        )

        return false
    end

    ZANJI_SHOP_STATE.DoubleManualBusy =
        true

    task.spawn(function()

        local ok,
            err =
            pcall(function()

                ZanjiDoubleDisableAutoSell()

                local targetWins =
                    ZanjiDoubleReadTargetWins()

                local preview =
                    select(
                        1,
                        ZanjiDoubleFirePacket(
                            "PreviewSellAll"
                        )
                    )

                local fruitCount =
                    0

                if type(preview) == "table" then

                    fruitCount =
                        tonumber(preview.FruitCount)
                        or 0
                end

                if fruitCount <= 0 then

                    ZanjiDoubleSetStatus(
                        "⏳ No fruits to double"
                    )

                    return
                end

                ZanjiDoubleDoOneRoll(
                    nil,
                    1,
                    targetWins,
                    false
                )
            end)

        if ok ~= true then

            ZanjiDoubleSetStatus(
                "⚠️ Manual error: "
                .. tostring(err)
            )
        end

        ZANJI_SHOP_STATE.DoubleManualBusy =
            false
    end)

    return true
