        )

    local variant =
        ZanjiSniperNormalizeVariantName(
            pet.Variant
            or pet.variant
            or pet.Mutation
            or pet.mutation
            or "Normal"
        )

    copy.Pet =
        baseName

    copy.PetName =
        baseName

    copy.Size =
        size

    copy.Variant =
        variant

    copy.Mutation =
        variant

    copy.DisplayName =
        ZanjiServerFinderPetDisplayName(
            copy
        )

    copy.Rarity =
