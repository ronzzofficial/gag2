                text =
                    ZanjiCleanText(
                        key
                    )
            end

            if text ~= "" then

                table.insert(
                    output,
                    text
                )
            end
        end

    else

        value =
            ZanjiCleanText(
                value
            )

        value =
            value:gsub("/", ",")
                :gsub("%+", ",")
                :gsub(";", ",")

        for part in value:gmatch("[^,]+") do

            local text =
                ZanjiCleanText(
                    part
                )

            if text ~= "" then

                table.insert(
                    output,
                    text
                )
            end
        end
    end

    return output
end

function ZanjiServerFinderAutoJoinListHasAny(list)

    if type(list) ~= "table"
    or #list <= 0 then

        return true
    end

    for _, value in ipairs(list) do

        local text =
            ZanjiCleanText(
                value
            )
            :lower()

        if text == ""
        or text == "any"
        or text == "any pet"
        or text == "all" then

            return true
        end
    end

    return false
end

function ZanjiServerFinderAutoJoinUniqueList(list, normalizer, fallback)

    local output =
        {}

    local seen =
        {}

    fallback =
        fallback
        or "Any"

    for _, value in ipairs(ZanjiServerFinderSplitCommaList(list)) do

        local text =
            ZanjiCleanText(
                value
            )

        local lower =
            text:lower()

        if lower == ""
        or lower == "any"
        or lower == "all"
        or lower == "any pet" then

            return {
                "Any",
            }
        end

        if type(normalizer) == "function" then

            text =
                normalizer(
                    text
                )
        end

        text =
            ZanjiCleanText(
                text
            )

        if text ~= "" then

            local key =
                text:lower()

            if seen[key] ~= true then

                seen[key] =
                    true

                table.insert(
                    output,
                    text
                )
            end
        end
    end

    if #output <= 0 then
        return {
            fallback,
        }
    end

    return output
end

function ZanjiServerFinderNormalizeAutoJoinPetName(value)

