function ZanjiSniperNormalizeSizeName(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == ""
    or lower == "none"
    or lower == "nil"
    or lower == "normal"
    or lower == "regular" then

        return "Normal"
    end

    if lower == "mega"
    or lower == "huge" then

        return "Huge"
    end

    local petSizes =
        ZanjiSniperGetPetSizesModule()

    if type(petSizes.Normalize) == "function" then

        local ok,
            result =
            pcall(function()

                return petSizes.Normalize(
                    text
                )
            end)

        result =
            ZanjiCleanText(
                ok == true
                and result
                or ""
            )

        if result ~= "" then

            if result == "Mega" then
                return "Huge"
            end

            return result
        end
    end

    return text
end

function ZanjiSniperAddSortedValue(values, seen, value)

    value =
        ZanjiCleanText(
            value
        )

    if value == "" then
        return false
    end

    if value == "Mega" then
        value =
            "Huge"
    end

    if seen[value] == true then
        return false
    end

    seen[value] =
        true

    table.insert(
        values,
        value
    )

    return true
end

function ZanjiSniperSortSizeValues(values)

    table.sort(values, function(a, b)

        local order = {
            Any = 0,
            Normal = 1,
            Big = 2,
            Huge = 3,
        }

        local rankA =
            order[a]
            or 50

        local rankB =
            order[b]
            or 50

        if rankA ~= rankB then
            return rankA < rankB
        end

        return tostring(a) < tostring(b)
    end)
end

function ZanjiSniperSortVariantValues(values)

    table.sort(values, function(a, b)

        local order = {
            Any = 0,
            Normal = 1,
            Rainbow = 2,
        }

        local rankA =
            order[a]
            or 50

        local rankB =
            order[b]
            or 50

        if rankA ~= rankB then
            return rankA < rankB
        end

        return tostring(a) < tostring(b)
    end)
end

function ZanjiSniperGetSizeValues()

    local values =
        {}

    local seen =
        {}

    ZanjiSniperAddSortedValue(
        values,
        seen,
        "Any"
    )

    ZanjiSniperAddSortedValue(
        values,
        seen,
        "Normal"
    )

    local petSizes =
        ZanjiSniperGetPetSizesModule()

    local function addSizeFromKey(key)

        key =
            ZanjiCleanText(
                key
            )

        if key == "" then
            return
        end

        local normalized =
            ZanjiSniperNormalizeSizeName(
                key
            )

        if normalized ~= ""
        and normalized ~= "Normal" then

            ZanjiSniperAddSortedValue(
                values,
                seen,
                normalized
            )
        end
    end

    if type(petSizes.Scales) == "table" then

        for key in pairs(petSizes.Scales) do

            addSizeFromKey(
                key
            )
        end
    end

    if type(petSizes.BoostMultipliers) == "table" then

        for key in pairs(petSizes.BoostMultipliers) do

            addSizeFromKey(
                key
            )
        end
    end

    ZanjiSniperSortSizeValues(
        values
    )

    return values
end

function ZanjiSniperSizeValueMap()

    local map =
        {}

    for _, value in ipairs(ZanjiSniperGetSizeValues()) do

        if value ~= "Any" then

            map[value] =
                true
        end
    end

    return map
end

function ZanjiSniperNormalizeSizeSelection(value)

    local selection =
        ZanjiShopSelectionArray(
            value
        )

    if #selection <= 0 then

        return {
            "Any",
        }
    end

    for _, itemName in ipairs(selection) do

        if itemName == "Any" then

            return {
                "Any",
            }
        end
    end

    local validMap =
        ZanjiSniperSizeValueMap()

    local output =
        {}

    local seen =
        {}

    for _, itemName in ipairs(selection) do

        local normalized =
            ZanjiSniperNormalizeSizeName(
                itemName
            )

        if validMap[normalized] == true
        and seen[normalized] ~= true then

            seen[normalized] =
                true

            table.insert(
                output,
                normalized
            )
        end
    end

    if #output <= 0 then

        return {
            "Normal",
        }
    end

    ZanjiSniperSortSizeValues(
        output
    )

    return output
end

function ZanjiSniperPetTypeIsValid(typeName)

    typeName =
        ZanjiCleanText(
            typeName
        )

    if typeName == "" then
        return false
    end

    if typeName == "Normal" then
        return true
    end

    local petTypes =
        ZanjiSniperGetPetTypesModule()

    if type(petTypes.IsValid) == "function" then

        local ok,
            result =
            pcall(function()

                return petTypes.IsValid(
                    typeName
                )
            end)

        if ok == true then
            return result == true
        end
    end

    return false
end

function ZanjiSniperNormalizeVariantName(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == ""
    or lower == "none"
    or lower == "nil"
    or lower == "normal"
    or lower == "regular" then

