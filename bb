function ZanjiDevCheckPersistenceRejoin()

    local payload =
        ZanjiDevReadJson(
            DEV_PERSISTENCE_FILE
        )

    if type(payload) ~= "table"
    or payload.Phase ~= "AwaitingRejoin" then

        return false
    end

    if tostring(payload.JobId)
    == tostring(game.JobId) then

        ZanjiDevSetStatus(
            "PersistenceStatusLabel",
            "Saved • rejoin to complete."
        )

        return false
    end

    task.wait(
        3
    )

    local afterRejoin,
        found =
        ZanjiDevGetToolCount(
            payload.Target
        )

    local verdict =
        "INCONCLUSIVE"

    if found == true then

        if tonumber(afterRejoin)
        == tonumber(payload.AfterUseCount) then

            verdict =
                "PERSISTED"

        elseif tonumber(afterRejoin)
        == tonumber(payload.BeforeCount) then

            verdict =
                "ROLLED BACK"

        else

            verdict =
                "CHANGED"
        end
    end

    local finalReport = {
        Version =
            "ZANJI_DEV_PERSISTENCE_V1",

        Phase =
            "Complete",

        PlaceId =
            game.PlaceId,

        PreviousJobId =
            payload.JobId,

        CurrentJobId =
            game.JobId,

        Target =
            payload.Target,

        BeforeCount =
            payload.BeforeCount,

        AfterUseCount =
            payload.AfterUseCount,

        AfterRejoinCount =
            found == true
            and afterRejoin
            or nil,

        Verdict =
            verdict,

        FinishedAt =
            os.time(),
    }

    ZanjiDevWriteJson(
        DEV_PERSISTENCE_FILE,
        finalReport
    )

    ZanjiDevCopyReport(
        finalReport
    )

    ZANJI_DEV_SUITE_RUNTIME.LastPersistenceReport =
        finalReport

    ZanjiDevSetStatus(
        "PersistenceStatusLabel",
        tostring(payload.BeforeCount)
            .. " → "
            .. tostring(payload.AfterUseCount)
            .. " → "
            .. tostring(
                found == true
                and afterRejoin
                or "?"
            )
            .. " • "
            .. verdict
            .. " • copied"
    )

    ZanjiNotify(
        "ZANJI Dev",
        payload.Target
            .. ": "
            .. verdict
            .. ". Report copied.",
        8
    )

    return true
end

