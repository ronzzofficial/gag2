        + 1

    ZANJI_SERVER_STATE.Hopping =
        false

    ZANJI_SERVER_STATE.HopAttempt =
        0

    if type(ZANJI_SNIPER_RUNTIME) == "table" then

        ZANJI_SNIPER_RUNTIME.AutoHopInProgress =
            false

        ZANJI_SNIPER_RUNTIME.HopFailureBackoffUntil =
            os.clock() + 2
    end

    ZanjiServerSetStatus(
        tostring(reason or "Hop cancelled.")
    )
end

