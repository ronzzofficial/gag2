function ZanjiFarmSetPage(mode)

    ZANJI_FARM_PAGE_STATE =
        type(ZANJI_FARM_PAGE_STATE) == "table"
        and ZANJI_FARM_PAGE_STATE
        or {}

    mode =
        ZanjiFarmNormalizePageMode(
