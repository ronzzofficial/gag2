function ZanjiServerReadInteger(value, fallback)

    local number =
        tonumber(
            tostring(value or "")
                :match("%-?%d+")
        )

    if not number then
        number =
            tonumber(fallback)
            or 0
    end

    return math.floor(number)
end

function ZanjiServerReadNumber(value, fallback)

