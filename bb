local function ZanjiMailSplitStackCount(
    totalCount
)
    totalCount =
        math.max(
            0,
            math.floor(
                tonumber(totalCount)
                    or 0
            )
        )

    local chunks = {}

    if totalCount <= 0 then
        return chunks
    end

    local remaining =
        totalCount

    while remaining > 0 do
        local chunk =
            math.min(
                remaining,
                ZANJI_MAIL_MAX_COUNT_PER_PAYLOAD
            )

        table.insert(
            chunks,
            chunk
        )

        remaining -=
            chunk
    end

    return chunks
end

