        end

        return ok
    end

    local function runBootstrap()

        if readEnabled() ~= true then
            return false
        end

        local existing =
            env.ZANJI_FAST_LOADER_RUNTIME

        if type(existing) == "table"
        and existing.JobId == game.JobId then

            existing.Active =
                true

            return true
        end

        local compiler =
            loadstring
            or load

        if type(compiler) ~= "function" then
            return false
        end

        local compileOk,
            chunk =
            pcall(
                compiler,
                bootstrapSource
            )

        if compileOk ~= true
        or type(chunk) ~= "function" then
            return false
        end

        local runOk =
            pcall(
                chunk
            )

        return runOk == true
    end

    local function stopBootstrap()

        env.ZANJI_FAST_LOADER_FORCE_ENABLED =
            false

        local runtime =
            env.ZANJI_FAST_LOADER_RUNTIME

        if type(runtime) == "table"
        and runtime.JobId == game.JobId
        and type(runtime.Stop) == "function" then

            pcall(
                runtime.Stop
            )
        end

        return true
    end

    env.ZANJI_FAST_LOADER_SOURCE =
        bootstrapSource

    env.ZANJI_FAST_LOADER_QUEUE =
        queueBootstrap

    env.ZANJI_FAST_LOADER_RUN =
        runBootstrap

    env.ZANJI_FAST_LOADER_STOP =
        stopBootstrap

    if readEnabled() == true then

        queueBootstrap()
        runBootstrap()
    end
end

