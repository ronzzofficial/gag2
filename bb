function ZanjiGuildAddTrustedSender()

    local username =
        ZanjiCleanText(
            ZANJI_GUILD_STATE.TrustedSenderDraft
        ):gsub(
            "^@",
            ""
        )

    if username == "" then

        ZanjiNotify(
            "ZANJI Guild",
            "Enter a Roblox username first.",
            4
        )

        return
    end

    ZanjiGuildSetStatus(
        "Resolving @"
        .. username
        .. "..."
    )

    task.spawn(function()

        local resolveOk,
            userId =
            pcall(
                Players.GetUserIdFromNameAsync,
                Players,
                username
            )

        userId =
            tonumber(userId)

        if resolveOk ~= true
        or userId == nil
        or userId <= 0 then

            ZanjiGuildSetStatus(
                "Could not resolve @"
                .. username
            )

            ZanjiNotify(
                "ZANJI Guild",
                "That Roblox username could not be found.",
                5
            )

            return
        end

        if userId == LocalPlayer.UserId then

            ZanjiNotify(
                "ZANJI Guild",
                "You cannot add your own account as a trusted inviter.",
                4
            )

            return
        end

        local canonicalName =
            username

        pcall(function()

            canonicalName =
                Players:GetNameFromUserIdAsync(
                    userId
                )
        end)

        ZANJI_GUILD_STATE.TrustedSenders[
            userId
        ] =
            tostring(
                canonicalName
            )

        ZANJI_GUILD_STATE.NameCache[
            userId
        ] =
            tostring(
                canonicalName
            )

        ZANJI_GUILD_STATE.SelectedTrustedUserId =
            userId

        ZANJI_GUILD_STATE.TrustedSenderDraft =
            ""

        if type(
            ZANJI_GUILD_UI.TrustedSenderInput
        ) == "table"
        and type(
            ZANJI_GUILD_UI.TrustedSenderInput.SetValue
        ) == "function" then

            ZANJI_GUILD_RUNTIME.UpdatingUI =
                true

            pcall(function()

                ZANJI_GUILD_UI.TrustedSenderInput:SetValue(
                    "",
                    true
                )
            end)

            ZANJI_GUILD_RUNTIME.UpdatingUI =
                false
        end

        ZanjiGuildSaveSettings()
        ZanjiGuildInvalidateInvitePanels()
        ZanjiGuildRefreshInfoPanels()
        ZanjiGuildRunInviteAutomation()

        ZanjiGuildSetStatus(
            "@"
            .. tostring(canonicalName)
            .. " is now trusted"
        )

        ZanjiNotify(
            "ZANJI Guild",
            "@"
            .. tostring(canonicalName)
            .. " added to trusted senders.",
            3
        )
    end)
end

