        (
            tonumber(
                ZANJI_MAIL_RUNTIME.InboxWorkerToken
            )
            or 0
        )
        + 1

    ZANJI_MAIL_RUNTIME.InboxWorkerRunning =
        false

    return true
end

ZANJI_MAIL_RUNTIME.StopInboxWorker =
    ZanjiMailStopInboxWorker

function ZanjiMailRefreshInboxCount()
    if ZANJI_MAIL_RUNTIME.InboxClaiming == true then
        return false,
            "Mail is currently being claimed"
    end

    ZANJI_MAIL_RUNTIME.InboxStatus =
        "Checking inbox..."

    ZanjiMailRefreshControlUI()

    local listPacket, _, packetError =
        ZanjiMailGetInboxPackets()

    if not listPacket then
        ZANJI_MAIL_RUNTIME.InboxKnown =
            false

        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Could not check inbox"

        ZANJI_MAIL_RUNTIME.InboxLastError =
            tostring(
                packetError
            )

        ZanjiMailRefreshControlUI()

        return false,
            packetError
    end

    local inbox, listError =
        ZanjiMailListInbox(
            listPacket
        )

    if not inbox then
        ZANJI_MAIL_RUNTIME.InboxKnown =
            false

        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Could not check inbox"

        ZANJI_MAIL_RUNTIME.InboxLastError =
            tostring(
                listError
            )

        ZanjiMailRefreshControlUI()

        return false,
            listError
    end

    ZanjiMailApplyInbox(
        inbox
    )

    if ZANJI_MAIL_STATE.AutoClaim == true then
        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Watching for new mail..."
    elseif ZANJI_MAIL_RUNTIME.InboxCount == 0 then
        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Inbox is empty"
    else
        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Auto Claim is off"
    end

    ZanjiMailRefreshControlUI()

    return true,
        inbox
end

function ZanjiMailClaimInbox(manual)
    if ZANJI_MAIL_RUNTIME.InboxClaiming == true then
        if manual == true then
            ZanjiNotify(
                "ZANJI Mail",
                "Mail is already being claimed.",
                3
            )
        end

        return false,
            "Mail is already being claimed",
            0
    end

    ZANJI_MAIL_RUNTIME.InboxClaiming =
        true

    ZANJI_MAIL_RUNTIME.InboxStatus =
        "Checking inbox..."

    ZANJI_MAIL_RUNTIME.InboxLastError =
        ""

    ZanjiMailRefreshControlUI()

    local executionOk,
        successful,
        resultMessage,
        claimedCount =
        xpcall(
            function()
                local listPacket,
                    claimPacket,
                    packetError =
                    ZanjiMailGetInboxPackets()

                if not listPacket
                    or not claimPacket
                then
                    return false,
                        packetError,
                        0
                end

                local inbox, listError =
                    ZanjiMailListInbox(
                        listPacket
                    )

                if not inbox then
                    return false,
                        listError,
                        0
                end

                ZanjiMailApplyInbox(
                    inbox
                )

                local claimable =
                    ZanjiMailCollectClaimableMails(
                        inbox
                    )

                if #claimable == 0 then
                    if ZANJI_MAIL_RUNTIME.InboxCount == 0 then
                        return true,
                            ZANJI_MAIL_STATE.AutoClaim == true
                                and "Watching for new mail..."
                                or "Inbox is empty",
                            0
                    end

                    return true,
                        "No item gifts to claim",
                        0
                end

                local claimed =
                    0

                for index, mail in ipairs(
                    claimable
                ) do
                    if manual ~= true
                    and ZANJI_MAIL_STATE.AutoClaim ~= true
                    then
                        break
                    end

                    ZANJI_MAIL_RUNTIME.InboxStatus =
                        "Claiming "
                        .. tostring(index)
                        .. " of "
                        .. tostring(
                            #claimable
                        )
                        .. "..."

                    ZanjiMailRefreshControlUI()

                    local callOk,
                        accepted,
                        claimMessage =
                        pcall(function()
                            return claimPacket:Fire(
                                mail.Id
                            )
                        end)

                    if callOk ~= true then
                        return false,
                            tostring(accepted),
                            claimed
                    end

                    if accepted ~= true then
                        return false,
                            tostring(
                                claimMessage
                                or accepted
                            ),
                            claimed
                    end

                    claimed +=
                        1

                    ZANJI_MAIL_RUNTIME.InboxClaimed +=
                        1

                    ZanjiMailHistoryRecordClaim(
                        mail
                    )

                    ZANJI_MAIL_RUNTIME.InboxCount =
                        math.max(
                            0,
                            ZANJI_MAIL_RUNTIME.InboxCount
                                - 1
                        )

                    ZanjiMailRefreshControlUI()
                end

                local finalInbox,
                    finalListError =
                    ZanjiMailListInbox(
                        listPacket
                    )

                if not finalInbox then
                    return false,
                        "Inbox refresh failed: "
                            .. tostring(
                                finalListError
                            ),
                        claimed
                end

                ZanjiMailApplyInbox(
                    finalInbox
                )

                if ZANJI_MAIL_STATE.AutoClaim == true then
                    return true,
                        "Watching for new mail...",
                        claimed
                end

                if manual == true
                and claimed > 0
                then
                    return true,
                        "All item mail claimed",
                        claimed
                end

                return true,
                    "Auto Claim is off",
                    claimed
            end,
            function(message)
                return tostring(message)
                    .. "\n"
                    .. debug.traceback()
            end
        )

    ZANJI_MAIL_RUNTIME.InboxClaiming =
        false

    if executionOk ~= true then
        resultMessage =
            tostring(
                successful
            )

        successful =
            false

        claimedCount =
            0
    end

    claimedCount =
        math.max(
            0,
            math.floor(
                tonumber(
                    claimedCount
                )
                or 0
            )
        )

    if successful == true then
        ZANJI_MAIL_RUNTIME.InboxStatus =
            tostring(
                resultMessage
                or "Inbox checked"
            )

        if manual == true then
            ZanjiNotify(
                "ZANJI Mail",
                claimedCount > 0
                    and (
                        "Claimed "
                        .. tostring(claimedCount)
                        .. (
                            claimedCount == 1
                                and " mail."
                                or " mails."
                        )
                    )
                    or tostring(
                        resultMessage
                        or "No item mail to claim."
                    ),
                4
            )
        end
    else
        local cleanMessage =
            ZanjiMailCleanInboxMessage(
                resultMessage
            )

        ZANJI_MAIL_RUNTIME.InboxLastError =
            cleanMessage

        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Stopped: "
            .. cleanMessage

        if ZANJI_MAIL_STATE.AutoClaim == true then
            ZANJI_MAIL_STATE.AutoClaim =
                false

            ZanjiMailStopInboxWorker()

            ZanjiMailSyncInboxToggle(
                false
            )

            ZanjiMailSaveSettings()
        end

        ZanjiNotify(
            "ZANJI Mail",
            "Auto Claim stopped: "
                .. cleanMessage,
            5
        )
    end

    ZanjiMailRefreshControlUI()

    return successful == true,
        resultMessage,
        claimedCount
end

function ZanjiMailStartInboxWorker()
    if ZANJI_MAIL_STATE.AutoClaim ~= true then
        return false
    end

    if ZANJI_MAIL_RUNTIME.InboxWorkerRunning == true then
        return true
    end

    ZANJI_MAIL_RUNTIME.InboxWorkerToken =
        (
            tonumber(
                ZANJI_MAIL_RUNTIME.InboxWorkerToken
            )
            or 0
        )
        + 1

    local token =
        ZANJI_MAIL_RUNTIME.InboxWorkerToken

    ZANJI_MAIL_RUNTIME.InboxWorkerRunning =
        true

    ZANJI_MAIL_RUNTIME.InboxStatus =
        "Watching for new mail..."

    ZanjiMailRefreshControlUI()

    task.spawn(function()
        while ZANJI_MAIL_STATE.AutoClaim == true
        and ZANJI_MAIL_RUNTIME.InboxWorkerToken == token
        do
            ZanjiMailClaimInbox(
                false
            )

            if ZANJI_MAIL_STATE.AutoClaim ~= true
            or ZANJI_MAIL_RUNTIME.InboxWorkerToken ~= token
            then
                break
            end

            local _, interval =
                ZanjiMailNormalizeInboxInterval(
                    ZANJI_MAIL_STATE.InboxInterval
                )

            local deadline =
                os.clock()
                + interval

            while ZANJI_MAIL_STATE.AutoClaim == true
            and ZANJI_MAIL_RUNTIME.InboxWorkerToken == token
            and os.clock() < deadline
            do
                task.wait(
                    math.min(
                        0.1,
                        math.max(
                            0,
                            deadline - os.clock()
                        )
                    )
                )
            end
        end

        if ZANJI_MAIL_RUNTIME.InboxWorkerToken == token then
            ZANJI_MAIL_RUNTIME.InboxWorkerRunning =
                false
        end
    end)

    return true
end

function ZanjiMailSetAutoClaim(value)
    local enabled =
        value == true

    ZANJI_MAIL_STATE.AutoClaim =
        enabled

    ZANJI_MAIL_RUNTIME.InboxLastError =
        ""

    if enabled == true then
        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Watching for new mail..."

        ZanjiMailStartInboxWorker()
    else
        ZanjiMailStopInboxWorker()

        ZANJI_MAIL_RUNTIME.InboxStatus =
            "Auto Claim is off"
    end

    ZanjiMailSaveSettings()
    ZanjiMailRefreshControlUI()

    return enabled
end

