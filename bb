function ZanjiVisualGardenBuildRichText(row)

    local lineOneParts =
        {}

    table.insert(
        lineOneParts,
        '<font color="#FFFFFF">'
            .. ZanjiVisualGardenRichEscape(row.Name)
            .. '</font>'
    )

    table.insert(
        lineOneParts,
        '<font color="'
            .. ZanjiVisualGardenKgColor(row.Weight)
            .. '">'
            .. ZanjiVisualGardenRichEscape(
                ZanjiVisualGardenFormatKg(
                    row.Weight
                )
            )
            .. '</font>'
    )

    if ZANJI_VISUAL_STATE.GardenFruitShowValue == true then

        table.insert(
            lineOneParts,
            '<font color="#39FF14">['
                .. ZanjiVisualGardenRichEscape(
                    ZanjiVisualGardenFormatMoney(
                        row.Value
                    )
                )
                .. ']</font>'
        )
    end

    local lineOne =
        table.concat(
            lineOneParts,
            " "
        )

    local badges =
        {}

    for _, mutationName in ipairs(row.Mutations or {}) do

        local emoji =
            ZanjiVisualGardenMutationEmoji(
                mutationName
            )

        local prefix =
            emoji ~= ""
            and (
                emoji
                .. " "
            )
            or ""

        table.insert(
            badges,
            '<font color="'
                .. ZanjiVisualGardenMutationColor(mutationName)
                .. '">'
                .. ZanjiVisualGardenRichEscape(prefix .. mutationName)
                .. '</font>'
        )
    end

    if #badges > 0 then

        return lineOne
            .. "\n"
            .. table.concat(
                badges,
                "  "
            )
    end

    return lineOne
end

function ZanjiVisualGardenReadRow(plant, fruit, kind)

    if typeof(plant) ~= "Instance"
    or typeof(fruit) ~= "Instance"
    or fruit.Parent == nil then

        return nil
    end

    local adornee,
        worldOffset =
        ZanjiVisualGardenFindAdornee(
            fruit
        )

    if typeof(adornee) ~= "Instance"
    or adornee:IsA("BasePart") ~= true then

        return nil
    end

    worldOffset =
        typeof(worldOffset) == "Vector3"
        and worldOffset
        or Vector3.zero

    local maxDistance =
        tonumber(
            ZANJI_VISUAL_STATE.GardenFruitMaxDistance
        )
        or 150

    local distance =
        ZanjiVisualGardenGetDistance(
            adornee,
            worldOffset
        )

    if maxDistance > 0
    and distance > maxDistance then

        return nil
    end

    local fruitName =
        ZanjiVisualGardenReadFruitName(
            plant,
            fruit
        )

    if fruitName == ""
    or fruitName == "Unknown" then

        return nil
    end

    if ZanjiVisualGardenFruitAllows(
        fruitName
    ) ~= true then

        return nil
    end

    local sizeMultiplier =
        ZanjiVisualGardenReadSizeMultiplier(
            plant,
            fruit,
            kind
        )

    local weight =
        ZanjiVisualGardenReadWeightKg(
            plant,
            fruit,
            fruitName,
            sizeMultiplier,
            kind
        )

    if ZanjiVisualGardenWeightAllows(weight) ~= true then
        return nil
    end

    local mutations =
        ZanjiVisualGardenReadMutations(
            plant,
            fruit,
            kind
        )

    if ZanjiVisualGardenMutationAllows(mutations) ~= true then
        return nil
    end

    local row = {
        Key =
            fruit,

        Plant =
            plant,

        Fruit =
            fruit,

        Kind =
            kind,

        Adornee =
            adornee,

        WorldOffset =
            worldOffset,

        Name =
            fruitName,

        RawMutation =
            table.concat(
                mutations,
                ","
            ),

        Mutations =
            mutations,

        Weight =
            tonumber(weight)
            or 0,

        SizeMultiplier =
            tonumber(sizeMultiplier)
            or 1,

        Distance =
            tonumber(distance)
            or 0,
    }

    row.Value =
        ZanjiVisualGardenCalculateValue(
            row
        )

    if ZanjiVisualGardenValueAllows(row.Value) ~= true then
        return nil
    end

    row.Score =
        (
            tonumber(row.Value)
            or 0
        )
        + (
            #mutations
            * 100000000
        )
        + (
            tonumber(row.Weight)
            or 0
        )
        * 250
        - (
            tonumber(row.Distance)
            or 0
        )

    return row
end

function ZanjiVisualGardenBuildRows()

    ZanjiVisualEnsureState()

    local rows =
        {}

    local plot =
        nil

    if type(ZanjiFarmResolveOwnPlot) == "function" then

        plot =
            ZanjiFarmResolveOwnPlot(
                false
            )
    end

    if typeof(plot) ~= "Instance" then
        return rows
    end

    local plantsFolder =
        plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) ~= "Instance" then
        return rows
    end

    for _, plant in ipairs(plantsFolder:GetChildren()) do

        if typeof(plant) == "Instance" then

            local fruitsFolder =
                plant:FindFirstChild(
                    "Fruits"
                )

            if typeof(fruitsFolder) == "Instance" then

                for _, fruit in ipairs(fruitsFolder:GetChildren()) do

                    local row =
                        ZanjiVisualGardenReadRow(
                            plant,
                            fruit,
                            "FruitHarvest"
                        )

                    if row then

                        table.insert(
                            rows,
                            row
                        )
                    end
                end

            elseif plant:FindFirstChild("HarvestPart", true) then

                local row =
                    ZanjiVisualGardenReadRow(
                        plant,
                        plant,
                        "PlantHarvest"
                    )

                if row then

                    table.insert(
                        rows,
                        row
                    )
                end
            end
        end
    end

    table.sort(rows, function(a, b)

        return tonumber(a.Score or 0)
            > tonumber(b.Score or 0)
    end)

    return rows
end

