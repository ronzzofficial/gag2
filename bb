function ZanjiFarmDetailsSetFilterDescription(
    groups
)

    local ui =
        ZANJI_FARM_DETAILS_UI

    if typeof(ui.FilterDescription) ~= "Instance" then
        return
    end

    if ZANJI_FARM_DETAILS_RUNTIME.SnapshotReady ~= true
    and #groups <= 0 then

        ui.FilterDescription.Text =
            "Waiting for garden data..."

        return
    end

    local plantCount =
        ZanjiFarmDetailsCountSet(
            ZANJI_FARM_DETAILS_STATE.SelectedPlants
        )

    local mutationCount =
        ZanjiFarmDetailsCountSet(
            ZANJI_FARM_DETAILS_STATE.SelectedMutations
        )

    local plantText =
        "All plants"

    if plantCount == 1 then

        for plantName in pairs(
            ZANJI_FARM_DETAILS_STATE.SelectedPlants
        ) do

            plantText =
                plantName
        end

    elseif plantCount > 1 then

        plantText =
            tostring(plantCount)
            .. " plants"
    end

    local mutationText =
        "All mutations"

    if mutationCount == 1 then

        for mutation in pairs(
            ZANJI_FARM_DETAILS_STATE.SelectedMutations
        ) do

            mutationText =
                mutation
        end

    elseif mutationCount > 1 then

        mutationText =
            tostring(mutationCount)
            .. " mutations"
    end

    ui.FilterDescription.Text =
        plantText
        .. " · "
        .. mutationText
end

