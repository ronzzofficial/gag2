function ZanjiDefenseMonitorScan()

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true then
        return false
    end

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if runtime.Active == true then
        return true
    end

    local root =
        ZanjiSniperGetWildPetRefRoot()

    if typeof(root) ~= "Instance" then
        return false
    end

    local now =
        os.clock()

    for key, expiresAt in pairs(
        runtime.CompletedTargets
        or {}
    ) do

        if tonumber(expiresAt) == nil
        or tonumber(expiresAt) <= now then

            runtime.CompletedTargets[key] =
                nil
        end
    end

    for _, ref in ipairs(root:GetChildren()) do

        local refKey =
            ZanjiDefenseRefKey(
                ref
            )

        local recentlyCompleted =
            refKey ~= ""
            and (
                tonumber(
                    runtime.CompletedTargets[
                        refKey
                    ]
                )
                or 0
            ) > now

        if recentlyCompleted ~= true
        and ZanjiDefenseRefReady(
            ref
        ) == true then

            local entry =
                ZanjiDefenseBuildEntryFromRef(
                    ref
                )

            if type(entry) == "table"
            and type(ZanjiDefenseStartTarget) == "function" then

                return ZanjiDefenseStartTarget(
                    ref,
                    entry,
                    ZanjiDefenseFindFilterForEntry(
                        entry
                    ),
                    "defense monitor"
                )
            end
        end
    end

    return false
end

function ZanjiDefenseStartMonitor(reason)

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true then
        return false
    end

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if runtime.MonitorRunning == true then
        return true
    end

    runtime.MonitorToken =
        {}

    local token =
        runtime.MonitorToken

    runtime.MonitorRunning =
        true

    task.spawn(function()

        while runtime.MonitorToken == token
        and ZANJI_SNIPER_STATE.DefendBoughtPets == true do

            ZanjiDefenseMonitorScan()

            task.wait(
                runtime.MonitorScanDelay
            )
        end

        if runtime.MonitorToken == token then

            runtime.MonitorRunning =
                false
        end
    end)

    return true
end

function ZanjiDefenseStopMonitor(reason)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    runtime.MonitorToken =
        nil

    runtime.MonitorRunning =
        false

    return true
end

