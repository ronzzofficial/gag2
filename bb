function ZanjiServerFinderSaveFilterBuilder()

    if ZanjiAuthRequireServerSniper(
        "Auto Join Filters",
        true
    ) ~= true then

        return false
    end

    local petName =
        ZanjiCleanText(
            ZANJI_SERVER_FINDER_MAIN_UI.BuilderPet
            or "Any Pet"
        )

    local anyPet =
        petName == ""
        or petName:lower() == "any pet"
        or petName:lower() == "any"

    local filter =
        ZanjiServerFinderNormalizeAutoJoinRule({
            PetScope =
                anyPet
                and "Any Pet"
                or "Selected Pets",

            Pets =
                anyPet
                and {
                    "Any",
                }
                or {
                    petName,
                },

            Sizes =
                ZanjiServerFinderTargetSelectionList(
                    ZANJI_SERVER_FINDER_MAIN_UI.BuilderSizes,
                    "Any"
                ),

            Variants =
                ZanjiServerFinderTargetSelectionList(
                    ZANJI_SERVER_FINDER_MAIN_UI.BuilderVariants,
                    "Any"
                ),

            Rarities =
                ZanjiServerFinderTargetSelectionList(
                    ZANJI_SERVER_FINDER_MAIN_UI.BuilderRarities,
                    "Any"
                ),

            Priority =
                ZanjiServerFinderNormalizeAutoJoinPriority(
                    ZANJI_SERVER_FINDER_MAIN_UI.BuilderPriority
                ),

            MatchMode =
                "All Selected",
        })

    local filters =
        ZANJI_SERVER_FINDER_STATE.AutoJoinRules

    local editingIndex =
        tonumber(
            ZANJI_SERVER_FINDER_MAIN_UI.EditingIndex
        )

    local savedIndex =
        nil

    local updated =
        false

    if editingIndex
    and filters[editingIndex] ~= nil then

        filters[editingIndex] =
            filter

        savedIndex =
            editingIndex

        updated =
            true

    else

        local newKey =
            ZanjiServerFinderFilterKey(
                filter
            )

        for index, existing in ipairs(filters) do

            if ZanjiServerFinderFilterKey(
                existing
            ) == newKey then

                filters[index] =
                    filter

                savedIndex =
                    index

                updated =
                    true

                break
            end
        end

        if savedIndex == nil then

            table.insert(
                filters,
                filter
            )

            savedIndex =
                #filters
        end
    end

    ZANJI_SERVER_FINDER_MAIN_UI.SelectedIndex =
        savedIndex

    ZANJI_SERVER_FINDER_STATE.AutoJoinSelectedRuleIndex =
        savedIndex
        or 1

    ZanjiQueueSaveServerFinderSettings()

    ZanjiNotify(
        "Auto Join Filters",
        updated
        and "Filter updated."
        or "Filter added.",
        3
    )

    ZanjiServerFinderResetFilterBuilder(
        false
    )

    ZanjiServerFinderRefreshMainUI()

    return true
end

