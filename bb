                math.floor(
                    tonumber(ZANJI_MAIL_STATE.TrackerUsed)
                        or 0
                ),
                0,
                ZANJI_MAIL_DAILY_LIMIT
            ),
    }

    local encodeOk, encoded =
        pcall(function()
            return HttpService:JSONEncode(payload)
        end)

    if encodeOk ~= true
        or type(encoded) ~= "string"
    then
        return false
    end

    return pcall(function()
        writefile(
            ZANJI_MAIL_SETTINGS_FILE,
            encoded
        )
    end)
end

function ZanjiMailLoadSettings()
    if ZanjiCanUseFiles() ~= true then
        ZanjiMailCheckDay()

        return false
    end

    local exists =
        false

    pcall(function()
        exists =
            isfile(ZANJI_MAIL_SETTINGS_FILE)
    end)

    if exists ~= true then
        ZanjiMailCheckDay()

        return false
    end

    local readOk, raw =
        pcall(function()
            return readfile(
                ZANJI_MAIL_SETTINGS_FILE
            )
        end)

    if readOk ~= true
        or type(raw) ~= "string"
        or raw == ""
    then
        ZanjiMailCheckDay()

        return false
    end

    local decodeOk, data =
        pcall(function()
            return HttpService:JSONDecode(raw)
        end)

    if decodeOk ~= true
        or type(data) ~= "table"
    then
        ZanjiMailCheckDay()

        return false
    end

    local storedUserId =
        math.floor(
            tonumber(
                data.UserId
            )
            or 0
        )

    if storedUserId > 0
        and storedUserId
            ~= ZANJI_MAIL_ACCOUNT_USER_ID
    then
        ZanjiMailCheckDay()

        return false
    end

    ZANJI_MAIL_STATE.HudEnabled =
        data.HudEnabled == true

    ZANJI_MAIL_STATE.StartMinimized =
        data.StartMinimized == true

    ZANJI_MAIL_STATE.HudScale =
        ZanjiMailNormalizeScale(
            data.HudScale
            or ZANJI_MAIL_STATE.HudScale
            or "100%"
        )

    ZANJI_MAIL_STATE.AutoClaim =
        data.AutoClaim == true

    ZANJI_MAIL_STATE.InboxInterval =
        ZanjiMailNormalizeInboxInterval(
            data.InboxInterval
            or ZANJI_MAIL_STATE.InboxInterval
            or "2 seconds"
        )

    ZANJI_MAIL_STATE.ValueStrategy =
        ZanjiMailNormalizeValueStrategy(
            data.ValueStrategy
            or ZANJI_MAIL_STATE.ValueStrategy
        )

    ZANJI_MAIL_STATE.ExtraLimitMode =
        ZanjiMailNormalizeExtraLimitMode(
            data.ExtraLimitMode
            or ZANJI_MAIL_STATE.ExtraLimitMode
        )

    ZANJI_MAIL_STATE.ExtraLimitCustom =
        ZanjiMailNormalizeExtraLimitCustom(
            data.ExtraLimitCustom
            or ZANJI_MAIL_STATE.ExtraLimitCustom
        )

    ZANJI_MAIL_STATE.FilterFruits =
        ZanjiMailNormalizeFilterSelection(
            data.FilterFruits
            or ZANJI_MAIL_STATE.FilterFruits
            or {}
        )

    ZANJI_MAIL_STATE.FilterMutations =
        ZanjiMailNormalizeFilterSelection(
            data.FilterMutations
            or ZANJI_MAIL_STATE.FilterMutations
            or {}
        )

    ZANJI_MAIL_STATE.SavedRecipients =
        ZanjiMailNormalizeRecipientRecords(
            data.SavedRecipients
                or ZANJI_MAIL_STATE.SavedRecipients
                or {},
            25,
            true
        )

    ZANJI_MAIL_STATE.RecentRecipients =
        ZanjiMailNormalizeRecipientRecords(
            data.RecentRecipients
                or ZANJI_MAIL_STATE.RecentRecipients
                or {},
            8,
            false
        )

    ZANJI_MAIL_STATE.FleetAccounts =
        ZanjiMailNormalizeFleetAccounts(
            data.FleetAccounts
                or ZANJI_MAIL_STATE.FleetAccounts
                or {}
        )

    ZANJI_MAIL_STATE.FleetGroups =
        ZanjiMailNormalizeFleetGroups(
            data.FleetGroups
                or ZANJI_MAIL_STATE.FleetGroups
                or {
                    "Ungrouped",
                }
        )

    ZANJI_MAIL_STATE.TrackerDay =
        tostring(
            data.TrackerDay
                or ZanjiMailToday()
        )

    ZANJI_MAIL_STATE.TrackerUsed =
        math.clamp(
            math.floor(
                tonumber(data.TrackerUsed)
                    or 0
            ),
            0,
            ZANJI_MAIL_DAILY_LIMIT
        )

    if type(data.HudPosition) == "table" then
        ZANJI_MAIL_STATE.HudPosition = {
            XScale =
                tonumber(data.HudPosition.XScale)
                    or 0.5,

            XOffset =
                tonumber(data.HudPosition.XOffset)
                    or 0,

            YScale =
                tonumber(data.HudPosition.YScale)
                    or 0.5,

            YOffset =
                tonumber(data.HudPosition.YOffset)
                    or 0,
        }
    end

    if ZanjiMailCheckDay() == true then
        ZanjiMailSaveSettings()
    end

    return true
end

