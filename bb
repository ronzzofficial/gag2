function ZanjiGuildNormalizePage(value)

    local text =
        ZanjiCleanText(
            value
        )
        :lower()

    if text:find(
        "member",
        1,
        true
    ) then

        return "Members"
    end

    if text:find(
        "invite",
        1,
        true
    ) then

        return "Invites"
    end

    if text:find(
        "contest",
        1,
        true
    ) then

        return "Contest"
    end

    if text:find(
        "leader",
        1,
        true
    ) then

        return "Leaderboard"
    end

    return "Overview"
end

function ZanjiGuildSetPage(value)

    local previousPage =
        ZANJI_GUILD_STATE.Page

    local page =
        ZanjiGuildNormalizePage(
            value
        )

    ZANJI_GUILD_STATE.Page =
        page

    if type(
        ZANJI_GUILD_RUNTIME.LastPageRefresh
    ) ~= "table" then

        ZANJI_GUILD_RUNTIME.LastPageRefresh =
            {}
    end

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.OverviewBox,
        page == "Overview"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.ActionsBox,
        page == "Overview"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.MembersBox,
        page == "Members"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.SelectedMemberBox,
        page == "Members"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.InvitesBox,
        page == "Invites"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.SelectedInviteBox,
        page == "Invites"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.ContestBox,
        page == "Contest"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.ProgressBox,
        page == "Contest"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.LeaderboardBox,
        page == "Leaderboard"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.SelectedGuildBox,
        page == "Leaderboard"
    )

    if ZANJI_GUILD_UI.Tab
    and type(
        ZANJI_GUILD_UI.Tab.RefreshSides
    ) == "function" then

        task.defer(function()

            ZANJI_GUILD_UI.Tab:RefreshSides()
        end)
    end

    ZanjiGuildRefreshUI()

    local lastRefresh =
        ZANJI_GUILD_RUNTIME.LastPageRefresh[
            page
        ]
        or 0

    if ZANJI_GUILD_RUNTIME.Running == true
    and previousPage ~= page
    and os.clock() - lastRefresh >= 8 then

        ZANJI_GUILD_RUNTIME.LastPageRefresh[
            page
        ] =
            os.clock()

        task.spawn(function()

            if page == "Overview"
            or page == "Members" then

                ZanjiGuildRefreshSnapshot(
                    true
                )

                ZanjiGuildRefreshPresence(
                    true
                )

            elseif page == "Invites" then

                ZanjiGuildRefreshInvites(
                    false
                )

            elseif page == "Contest" then

                ZanjiGuildRefreshCompetition(
                    true
                )

                ZanjiGuildRefreshSnapshot(
                    true
                )

                ZanjiGuildRefreshPresence(
                    true
                )

            elseif page == "Leaderboard" then

                ZanjiGuildRefreshLeaderboard(
                    true
                )
            end
        end)
    end
end

function ZanjiGuildStart()

    ZANJI_GUILD_RUNTIME.Token =
        ZANJI_GUILD_RUNTIME.Token
        + 1

    local token =
        ZANJI_GUILD_RUNTIME.Token

    ZANJI_GUILD_RUNTIME.Running =
        true

    for _, connection in pairs(
        ZANJI_GUILD_RUNTIME.Connections
        or {}
    ) do

        pcall(function()

            connection:Disconnect()
        end)
    end

    ZANJI_GUILD_RUNTIME.Connections =
        {}

    local networking =
        ZanjiGuildGetNetworking()

    local tickPacket =
        type(networking) == "table"
        and type(networking.Guild) == "table"
        and networking.Guild.TickUpdate
        or nil

    local tickSignal =
        nil

    pcall(function()

        tickSignal =
            tickPacket.OnClientEvent
    end)

    if tickSignal ~= nil then

        local connected,
            connection =
            pcall(function()

                return tickSignal:Connect(
                    ZanjiGuildHandleTickUpdate
                )
            end)

        if connected == true
        and connection then

            ZANJI_GUILD_RUNTIME.Connections[
                #ZANJI_GUILD_RUNTIME.Connections
                + 1
            ] =
                connection
        end
    end

    local mailboxUpdated =
        type(networking) == "table"
        and type(networking.Mailbox) == "table"
        and networking.Mailbox.Updated
        or nil

    local mailboxSignal =
        nil

    pcall(function()

        mailboxSignal =
            mailboxUpdated.OnClientEvent
    end)

    if mailboxSignal ~= nil then

        local connected,
            connection =
            pcall(function()

                return mailboxSignal:Connect(function(...)

                    ZanjiGuildApplyMailboxUpdate(
                        ...
                    )
                end)
            end)

        if connected == true
        and connection then

            ZANJI_GUILD_RUNTIME.Connections[
                #ZANJI_GUILD_RUNTIME.Connections
                + 1
            ] =
                connection
        end
    end

    ZANJI_GUILD_RUNTIME.Connections[
        #ZANJI_GUILD_RUNTIME.Connections
        + 1
    ] =
        Players.PlayerAdded:Connect(function()

            ZanjiGuildRefreshPlayerDropdown()
        end)

    ZANJI_GUILD_RUNTIME.Connections[
        #ZANJI_GUILD_RUNTIME.Connections
        + 1
    ] =
        Players.PlayerRemoving:Connect(function(player)

            if player.UserId
                == ZANJI_GUILD_STATE.InviteUserId then

                ZANJI_GUILD_STATE.InviteUserId =
                    nil
            end

            ZanjiGuildRefreshPlayerDropdown()
        end)

    task.spawn(function()

        ZanjiGuildRefreshAll(
            false
        )

        ZanjiGuildRefreshInvites(
            true
        )
    end)

    task.spawn(function()

        while ZANJI_GUILD_RUNTIME.Running == true
        and ZANJI_GUILD_RUNTIME.Token == token do

            if ZANJI_GUILD_STATE.Page == "Contest" then

                ZanjiGuildRefreshContestPanel()

            elseif ZANJI_GUILD_STATE.Page == "Invites"
            and os.clock()
                - (
                    ZANJI_GUILD_RUNTIME.LastInviteRefreshAt
                    or 0
                )
                >= 8 then

                task.spawn(function()

                    ZanjiGuildRefreshInvites(
                        true
                    )
                end)
            end

            ZanjiGuildRunInviteAutomation()

            task.wait(
                1
            )
        end
    end)
end

