function ZanjiMergeAutomationResolvePackets()

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    if type(runtime.Packets) == "table"
    and type(runtime.Packets.RequestMerge) == "table" then

        return runtime.Packets
    end

    local networking =
        ZanjiShopRequireModule(
            "SharedModules.Networking"
        )

    local garden =
        type(networking) == "table"
        and type(networking.Garden) == "table"
        and networking.Garden
        or {}

    local potPlacement =
        type(networking) == "table"
        and type(networking.PotPlacement) == "table"
        and networking.PotPlacement
        or {}

    local wateringCan =
        type(networking) == "table"
        and type(networking.WateringCan) == "table"
        and networking.WateringCan
        or {}

    runtime.Packets = {
        RequestMerge =
            garden.RequestMerge,

        PotPlant =
            garden.PotPlant,

        PickUpPottedPlant =
            potPlacement.PickUpPottedPlant,

        PlacePottedPlant =
            potPlacement.PlacePottedPlant,

        UseWateringCan =
            wateringCan.UseWateringCan,
    }

    return runtime.Packets
end

function ZanjiMergeAutomationGetPlantsFolder()

    local plot =
        ZanjiFarmResolveOwnPlot(
            false
        )

    local plantsFolder =
        plot
        and plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) == "Instance" then
        return plantsFolder
    end

    plot =
        ZanjiFarmResolveOwnPlot(
            true
        )

    plantsFolder =
        plot
        and plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) == "Instance" then
        return plantsFolder
    end

    return nil
end

function ZanjiMergeAutomationPlantName(plant)

    return ZanjiFarmCleanPlantName(
        ZanjiFarmReadPlantName(
            plant
        )
    )
end

function ZanjiMergeAutomationIsPotted(plant)

    if typeof(plant) ~= "Instance" then
        return false
    end

    local value =
        ZanjiFarmReadBooleanAttribute(
            plant,
            {
                "IsPotted",
                "Potted",
            }
        )

    if value ~= nil then
        return value == true
    end

    return plant:FindFirstChild(
        "PotVisual"
    ) ~= nil
end

function ZanjiMergeAutomationPlantPosition(plant)

    if typeof(plant) ~= "Instance" then
        return nil
    end

    local ok,
        pivot =
        pcall(function()

            return plant:GetPivot()
        end)

    if ok == true
    and typeof(pivot) == "CFrame" then

        return pivot.Position,
            pivot
    end

    local part =
        plant:IsA("BasePart")
        and plant
        or plant:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if typeof(part) == "Instance" then

        return part.Position,
            part.CFrame
    end

    return nil
end

function ZanjiMergeAutomationFindPlantById(plantId)

    plantId =
        ZanjiCleanText(
            plantId
        )

    if plantId == "" then
        return nil
    end

    local plantsFolder =
        ZanjiMergeAutomationGetPlantsFolder()

    if typeof(plantsFolder) ~= "Instance" then
        return nil
    end

    for _, plant in ipairs(
        plantsFolder:GetChildren()
    ) do

        if ZanjiAutoTrowelOwnsPlant(
            plant,
            plantsFolder
        ) == true
        and ZanjiFarmReadPlantId(plant) == plantId then

            return plant
        end
    end

    return nil
end

function ZanjiMergeAutomationFindPlantsByName(plantName)

    local wanted =
        ZanjiFarmPlantKey(
            plantName
        )

    local plantsFolder =
        ZanjiMergeAutomationGetPlantsFolder()

    local output =
        {}

    if typeof(plantsFolder) ~= "Instance" then
        return output
    end

    for _, plant in ipairs(
        plantsFolder:GetChildren()
    ) do

        if ZanjiAutoTrowelOwnsPlant(
            plant,
            plantsFolder
        ) == true
        and ZanjiFarmPlantKey(
            ZanjiMergeAutomationPlantName(
                plant
            )
        ) == wanted then

            table.insert(
                output,
                plant
            )
        end
    end

    table.sort(output, function(a, b)

        return tostring(
            ZanjiFarmReadPlantId(a)
        ) < tostring(
            ZanjiFarmReadPlantId(b)
        )
    end)

    return output
end

function ZanjiMergeAutomationFindPlantByName(plantName, preferGrowing)

    local plants =
        ZanjiMergeAutomationFindPlantsByName(
            plantName
        )

    if preferGrowing == true then

        for _, plant in ipairs(plants) do

            if ZanjiFarmInstanceReady(plant) ~= true then
                return plant
            end
        end
    end

    return plants[1]
end

function ZanjiMergeAutomationToolPlantId(tool)

    if typeof(tool) ~= "Instance" then
        return ""
    end

    return ZanjiFarmReadAttribute(
        tool,
        {
            "PlantId",
            "PlantID",
            "PlantUUID",
            "UUID",
            "Id",
            "ID",
        }
    )
end

function ZanjiMergeAutomationFindPottedTool(plantName, plantId)

    local wantedName =
        ZanjiFarmPlantKey(
            plantName
        )

    plantId =
        ZanjiCleanText(
            plantId
        )

    for _, container in ipairs({
        LocalPlayer.Character,
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        ),
    }) do

        if typeof(container) == "Instance" then

            for _, tool in ipairs(
                container:GetChildren()
            ) do

                if tool:IsA("Tool") then

                    local toolName =
                        tostring(tool.Name or "")

                    local nameMatches =
                        wantedName ~= ""
                        and ZanjiFarmPlantKey(toolName):find(
                            wantedName,
                            1,
                            true
                        ) ~= nil

                    local idMatches =
                        plantId ~= ""
                        and ZanjiMergeAutomationToolPlantId(tool)
                            == plantId

                    local looksPotted =
                        toolName:lower():find(
                            "potted",
                            1,
                            true
                        ) ~= nil
                        or tool:GetAttribute("IsPotted") == true

                    if looksPotted == true
                    and (
                        idMatches == true
                        or nameMatches == true
                    ) then

                        return tool
                    end
                end
            end
        end
    end

    return nil
end

function ZanjiMergeAutomationOutputExists(plantName)

    if ZanjiMergeAutomationFindPlantByName(
        plantName,
        false
    ) then

        return true
    end

    return ZanjiMergeAutomationFindPottedTool(
        plantName
    ) ~= nil
end

function ZanjiMergeAutomationFindMergePair(recipe)

    local leftPlants =
        ZanjiMergeAutomationFindPlantsByName(
            recipe.Left
        )

    local rightPlants =
        ZanjiMergeAutomationFindPlantsByName(
            recipe.Right
        )

    local samePlant =
        ZanjiFarmPlantKey(recipe.Left)
        == ZanjiFarmPlantKey(recipe.Right)

    local bestLeft =
        nil

    local bestRight =
        nil

    local bestDistance =
        math.huge

    local range =
        tonumber(
            ZANJI_MERGE_AUTOMATION_RUNTIME.RangeStuds
        )
        or 30

    for _, left in ipairs(leftPlants) do

        if ZanjiFarmInstanceReady(left) == true
        and ZanjiMergeAutomationIsPotted(left) ~= true then

            local leftPosition =
                ZanjiMergeAutomationPlantPosition(
                    left
                )

            if leftPosition then

                for _, right in ipairs(rightPlants) do

                    if right ~= left
                    and (
                        samePlant ~= true
                        or ZanjiFarmReadPlantId(right)
                            ~= ZanjiFarmReadPlantId(left)
                    )
                    and ZanjiFarmInstanceReady(right) == true
                    and ZanjiMergeAutomationIsPotted(right) ~= true then

                        local rightPosition =
                            ZanjiMergeAutomationPlantPosition(
                                right
                            )

                        if rightPosition then

                            local distance =
                                (
                                    leftPosition
                                    - rightPosition
                                ).Magnitude

                            if distance <= range
                            and distance < bestDistance then

                                bestLeft =
                                    left

                                bestRight =
                                    right

                                bestDistance =
                                    distance
                            end
                        end
                    end
                end
            end
        end
    end

    return bestLeft,
        bestRight,
        bestDistance
end

function ZanjiMergeAutomationWaitFor(callback, timeout)

    local deadline =
        os.clock()
        + math.max(
            0,
            tonumber(timeout)
            or 0
        )

    repeat

        local ok,
            result =
            pcall(
                callback
            )

        if ok == true
        and result then

            return result
        end

        task.wait(
            0.10
        )

    until os.clock() >= deadline

    return nil
end

function ZanjiMergeAutomationWaitDelay(token, seconds)

    seconds =
        ZanjiMergeAutomationReadDelay(
            seconds
        )

    if seconds <= 0 then

        task.wait()

        return ZANJI_MERGE_AUTOMATION_RUNTIME.Token
            == token
    end

    local deadline =
        os.clock()
        + seconds

    while os.clock() < deadline do

        if ZANJI_MERGE_AUTOMATION_RUNTIME.Token
            ~= token then

            return false
        end

        task.wait(
            math.min(
                0.10,
                math.max(
                    0,
                    deadline - os.clock()
                )
            )
        )
    end

    return ZANJI_MERGE_AUTOMATION_RUNTIME.Token
        == token
end

function ZanjiMergeAutomationMergeRecipe(recipe)

    if ZanjiMergeAutomationOutputExists(
        recipe.Result
    ) == true then

        return true,
            "already exists"
    end

    local left,
        right =
        ZanjiMergeAutomationFindMergePair(
            recipe
        )

    if not left
    or not right then

        return false,
            "Needs fully grown "
                .. recipe.Left
                .. " and "
                .. recipe.Right
                .. " within "
                .. tostring(
                    ZANJI_MERGE_AUTOMATION_RUNTIME.RangeStuds
                    or 30
                )
                .. " studs."
    end

    local packet =
        ZanjiMergeAutomationResolvePackets()
            .RequestMerge

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false,
            "Garden.RequestMerge is missing."
    end

    local leftId =
        ZanjiFarmReadPlantId(
            left
        )

    local rightId =
        ZanjiFarmReadPlantId(
            right
        )

    ZanjiMergeAutomationSetStatus(
        "Merging plants",
        recipe.Display
    )

    local callOk,
        accepted,
        message =
        pcall(function()

            return packet:Fire(
                leftId,
                rightId
            )
        end)

    if callOk ~= true then

        return false,
            tostring(accepted)
    end

    if accepted == false then

        return false,
            tostring(
                message
                or "The server rejected the merge."
            )
    end

    local result =
        ZanjiMergeAutomationWaitFor(function()

            return ZanjiMergeAutomationFindPlantByName(
                recipe.Result,
                false
            )
        end, 12)

    if not result then

        return false,
            "Merge was sent, but "
                .. recipe.Result
                .. " did not appear."
    end

    ZANJI_MERGE_AUTOMATION_RUNTIME.Merges =
        (
            ZANJI_MERGE_AUTOMATION_RUNTIME.Merges
            or 0
        )
        + 1

    ZanjiMergeAutomationSetStatus(
        "Merge complete",
        recipe.Result
            .. " is now in your garden."
    )

    return true,
        "merged"
end

function ZanjiMergeAutomationFindUsableWateringCan()

    local wanted =
        ZanjiMergeAutomationNormalizeCan(
            ZANJI_MERGE_AUTOMATION_STATE.WateringCan
        )

    for _, container in ipairs({
        LocalPlayer.Character,
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        ),
    }) do

        if typeof(container) == "Instance" then

            for _, tool in ipairs(
                container:GetChildren()
            ) do

                if tool:IsA("Tool")
                and tool.Name == wanted
                and (
                    tonumber(
                        tool:GetAttribute("Count")
                    )
                    or 0
                ) > 0 then

                    return tool
                end
            end
        end
    end

    return nil
end

function ZanjiMergeAutomationCountWateringUses()

    local wanted =
        ZanjiMergeAutomationNormalizeCan(
            ZANJI_MERGE_AUTOMATION_STATE.WateringCan
        )

    local total =
        0

    for _, container in ipairs({
        LocalPlayer.Character,
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        ),
    }) do

        if typeof(container) == "Instance" then

            for _, tool in ipairs(
                container:GetChildren()
            ) do

                if tool:IsA("Tool")
                and tool.Name == wanted then

                    total =
                        total
                        + math.max(
                            0,
                            tonumber(
                                tool:GetAttribute("Count")
                            )
                            or 0
                        )
                end
            end
        end
    end

    return total
end

function ZanjiMergeAutomationEquipTool(tool)

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    if typeof(tool) ~= "Instance"
    or typeof(character) ~= "Instance"
    or typeof(humanoid) ~= "Instance" then

        return false
    end

    if tool.Parent ~= character then

        pcall(function()

            humanoid:EquipTool(
                tool
            )
        end)

        task.wait(
            0.20
        )
    end

    return tool.Parent == character
end

function ZanjiMergeAutomationWaterOnce(plant)

    if typeof(plant) ~= "Instance"
    or plant.Parent == nil then

        return false,
            "The target plant disappeared."
    end

    local tool =
        ZanjiMergeAutomationFindUsableWateringCan()

    local canName =
        ZanjiMergeAutomationNormalizeCan(
            ZANJI_MERGE_AUTOMATION_STATE.WateringCan
        )

    if not tool then

        return false,
            "No usable "
                .. canName
                .. " was found."
    end

    if ZanjiMergeAutomationEquipTool(tool) ~= true then

        return false,
            canName
                .. " could not be equipped."
    end

    local packet =
        ZanjiMergeAutomationResolvePackets()
            .UseWateringCan

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false,
            "WateringCan.UseWateringCan is missing."
    end

    local position =
        ZanjiMergeAutomationPlantPosition(
            plant
        )

    if not position then

        return false,
            "The target plant has no usable position."
    end

    local beforeCount =
        ZanjiMergeAutomationCountWateringUses()

    local beforeAge =
        ZanjiFarmReadNumberAttribute(
            plant,
            {
                "Age",
                "Growth",
                "GrowAge",
                "CurrentAge",
            }
        )

    local callOk,
        callError =
        pcall(function()

            packet:Fire(
                position,
                canName,
                tool
            )
        end)

    if callOk ~= true then

        return false,
            tostring(callError)
    end

    local confirmed =
        ZanjiMergeAutomationWaitFor(function()

            local afterCount =
                ZanjiMergeAutomationCountWateringUses()

            if afterCount < beforeCount then
                return true
            end

            if typeof(plant) == "Instance"
            and plant.Parent ~= nil
            and beforeAge ~= nil then

                local afterAge =
                    ZanjiFarmReadNumberAttribute(
                        plant,
                        {
                            "Age",
                            "Growth",
                            "GrowAge",
                            "CurrentAge",
                        }
                    )

                if afterAge ~= nil
                and afterAge > beforeAge then

                    return true
                end
            end

            return false
        end, 3)

    if confirmed ~= true then

        return false,
            "Watering was not confirmed; no extra use was sent."
    end

    ZANJI_MERGE_AUTOMATION_RUNTIME.WaterUses =
        (
            ZANJI_MERGE_AUTOMATION_RUNTIME.WaterUses
            or 0
        )
        + 1

    ZanjiMergeAutomationRefreshUI()

    return true
end

function ZanjiMergeAutomationGrowPlant(plant, token)

    local plantId =
        ZanjiFarmReadPlantId(
            plant
        )

    while ZANJI_MERGE_AUTOMATION_RUNTIME.Token == token
    and ZANJI_MERGE_AUTOMATION_STATE.AutoWatering == true do

        plant =
            ZanjiMergeAutomationFindPlantById(
                plantId
            )

        if not plant then

            return false,
                "The merged plant disappeared."
        end

        if ZanjiFarmInstanceReady(plant) == true then

            ZanjiMergeAutomationSetStatus(
                "Growth complete",
                ZanjiMergeAutomationPlantName(plant)
                    .. " reached MaxAge."
            )

            return true
        end

        local age =
            ZanjiFarmReadNumberAttribute(
                plant,
                {
                    "Age",
                    "Growth",
                    "CurrentAge",
                }
            )
            or 0

        local maxAge =
            ZanjiFarmReadNumberAttribute(
                plant,
                {
                    "MaxAge",
                    "MaxGrowth",
                    "RequiredAge",
                }
            )
            or "?"

        ZanjiMergeAutomationSetStatus(
            "Growing "
                .. ZanjiMergeAutomationPlantName(plant),
            tostring(age)
                .. " / "
                .. tostring(maxAge)
                .. " using "
                .. ZanjiMergeAutomationNormalizeCan(
                    ZANJI_MERGE_AUTOMATION_STATE.WateringCan
                )
        )

        local watered,
            reason =
            ZanjiMergeAutomationWaterOnce(
                plant
            )

        if watered ~= true then

            return false,
                reason
        end

        if ZanjiFarmInstanceReady(plant) ~= true then

            if ZanjiMergeAutomationWaitDelay(
                token,
                ZANJI_MERGE_AUTOMATION_STATE.WateringDelay
            ) ~= true then

                return false,
                    "Stopped."
            end
        end
    end

    return ZanjiFarmInstanceReady(plant) == true,
        "Auto Watering is disabled."
end

function ZanjiMergeAutomationPotPlant(plant)

    if ZanjiMergeAutomationIsPotted(plant) == true then

        return true,
            plant
    end

    local packet =
        ZanjiMergeAutomationResolvePackets()
            .PotPlant

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false,
            "Garden.PotPlant is missing."
    end

    local plantId =
        ZanjiFarmReadPlantId(
            plant
        )

    local callOk,
        callError =
        pcall(function()

            packet:Fire(
                plantId
            )
        end)

    if callOk ~= true then

        return false,
            tostring(callError)
    end

    local potted =
        ZanjiMergeAutomationWaitFor(function()

            local current =
                ZanjiMergeAutomationFindPlantById(
                    plantId
                )

            if current
            and ZanjiMergeAutomationIsPotted(current) == true then

                return current
            end

            return nil
        end, 6)

    if not potted then

        return false,
            "Potting was not confirmed. Make sure you own an empty pot."
    end

    return true,
        potted
end

function ZanjiMergeAutomationPickUpPlant(plant)

    local packet =
        ZanjiMergeAutomationResolvePackets()
            .PickUpPottedPlant

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false,
            "PotPlacement.PickUpPottedPlant is missing."
    end

    local plantId =
        ZanjiFarmReadPlantId(
            plant
        )

    local plantName =
        ZanjiMergeAutomationPlantName(
            plant
        )

    local callOk,
        callError =
        pcall(function()

            packet:Fire(
                plantId
            )
        end)

    if callOk ~= true then

        return false,
            tostring(callError)
    end

    local removedAt =
        nil

    local pickedUp =
        ZanjiMergeAutomationWaitFor(function()

            if ZanjiMergeAutomationFindPlantById(
                plantId
            ) == nil then

                local pottedTool =
                    ZanjiMergeAutomationFindPottedTool(
                        plantName,
                        plantId
                    )

                if pottedTool then
                    return pottedTool
                end

                removedAt =
                    removedAt
                    or os.clock()

                if os.clock() - removedAt >= 0.50 then
                    return true
                end

                return nil
            end

            removedAt =
                nil

            return nil
        end, 6)

    if not pickedUp then

        return false,
            "Potted plant pickup was not confirmed."
    end

    return true
end

function ZanjiMergeAutomationPlacePlant(
