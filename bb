function ZanjiDevSaveUpdateBaseline()

    local runtime =
        ZANJI_DEV_SUITE_RUNTIME

    if runtime.UpdateScanning == true then

        ZanjiNotify(
            "ZANJI Dev",
            "An update capture is already running.",
            4
        )

        return false
    end

    runtime.UpdateScanning =
        true

    local scope =
        ZanjiDevUpdateScope(
            ZANJI_DEV_SUITE_STATE.UpdateScope
        )

    task.spawn(function()

        local success,
            result =
            xpcall(function()

                local snapshot =
                    ZanjiDevCaptureStableUpdateSnapshot(
                        scope
                    )

                local valid,
                    reason =
                    ZanjiDevValidateUpdateSnapshot(
                        snapshot
                    )

                if valid ~= true then
                    error(reason, 0)
                end

                if ZanjiDevUpdateWriteExact(
                    DEV_UPDATE_BASELINE_FILE,
                    snapshot
                ) ~= true then

                    error(
                        "could not write baseline",
                        0
                    )
                end

                ZanjiDevUpdateWriteExact(
                    ZanjiDevUpdateHistoryFile(
                        snapshot.PlaceVersion
                    ),
                    snapshot
                )

                runtime.PendingUpdateSnapshot =
                    nil

                runtime.LastUpdateDiff =
                    nil

                runtime.LastUpdateSummary =
                    nil

                if type(delfile) == "function" then

                    pcall(function()

                        if isfile(
                            DEV_UPDATE_PENDING_FILE
                        ) then

                            delfile(
                                DEV_UPDATE_PENDING_FILE
                            )
                        end
                    end)
                end

                ZanjiDevSetStatus(
                    "UpdateStatusLabel",
                    "Baseline ready · v"
                        .. tostring(snapshot.PlaceVersion or "?")
                        .. " · "
                        .. tostring(snapshot.ValueCount or 0)
                        .. " stable values"
                )

                ZanjiNotify(
                    "ZANJI Dev",
                    "Stable V2 baseline saved.",
                    4
                )

                return true
            end, debug.traceback)

        runtime.UpdateScanning =
            false

        if success ~= true then

            ZanjiDevSetStatus(
                "UpdateStatusLabel",
                "Baseline failed · "
                    .. ZanjiCleanText(result)
            )

            ZanjiNotify(
                "ZANJI Dev",
                "Baseline failed: "
                    .. ZanjiCleanText(result),
                6
            )
        end
    end)

    return true
end

function ZanjiDevScanUpdateChanges(copyResult)

    local runtime =
        ZANJI_DEV_SUITE_RUNTIME

    if runtime.UpdateScanning == true then

        ZanjiNotify(
            "ZANJI Dev",
            "An update capture is already running.",
            4
        )

        return false
    end

    local baseline =
        ZanjiDevReadJson(
            DEV_UPDATE_BASELINE_FILE
        )

    local baselineValid,
        baselineReason =
        ZanjiDevValidateUpdateSnapshot(
            baseline
        )

    if baselineValid ~= true then

        ZanjiDevSetStatus(
            "UpdateStatusLabel",
            "Capture a new V2 baseline · "
                .. tostring(baselineReason)
        )

        return false
    end

    runtime.UpdateScanning =
        true

    task.spawn(function()

        local success,
            result =
            xpcall(function()

                local current =
                    ZanjiDevCaptureStableUpdateSnapshot(
                        baseline.Scope
                    )

                local currentValid,
                    currentReason =
                    ZanjiDevValidateUpdateSnapshot(
                        current
                    )

                if currentValid ~= true then
                    error(currentReason, 0)
                end

                local diff =
                    ZanjiDevDiffMaps(
                        baseline.Values,
                        current.Values
                    )

                local categoryCounts =
                    ZanjiDevUpdateDiffCategoryCounts(
                        diff
                    )

                local warnings =
                    {}

                for _, warning in ipairs(
                    current.Warnings
                    or {}
                ) do

                    warnings[#warnings + 1] =
                        warning
                end

                if type(baseline.Capabilities) == "table"
                and type(current.Capabilities) == "table"
                and baseline.Capabilities.BytecodeHashing
                ~= current.Capabilities.BytecodeHashing then

                    warnings[#warnings + 1] =
                        "Bytecode capability changed since the baseline; script hash removals may be capability-related."
                end

                local confidence =
                    #warnings <= 0
                    and "High"
                    or "High with warnings"

                local report = {
                    Version =
                        "ZANJI_DEV_UPDATE_DIFF_V2",

                    PlaceId =
                        game.PlaceId,

                    BaselinePlaceVersion =
                        baseline.PlaceVersion,

                    CurrentPlaceVersion =
                        current.PlaceVersion,

                    Scope =
                        current.Scope,

                    ScannedAt =
                        os.time(),

                    CaptureStatus =
                        "Complete",

                    Confidence =
                        confidence,

                    StableValueCount =
                        current.ValueCount,

                    VolatileIgnored =
                        current.VolatileIgnored,

                    VolatileExamples =
                        current.VolatileExamples,

                    CategoryCounts =
                        categoryCounts,

                    Warnings =
                        warnings,

                    Capabilities =
                        current.Capabilities,

                    Diff =
                        diff,
                }

                report.Summary =
                    ZanjiDevBuildUpdateSummary(
                        report
                    )

                runtime.PendingUpdateSnapshot =
                    current

                runtime.LastUpdateDiff =
                    report

                runtime.LastUpdateSummary =
                    report.Summary

                ZanjiDevUpdateWriteExact(
                    DEV_UPDATE_PENDING_FILE,
                    current
                )

                ZanjiDevSetStatus(
                    "UpdateStatusLabel",
                    "v"
                        .. tostring(baseline.PlaceVersion or "?")
                        .. " → v"
                        .. tostring(current.PlaceVersion or "?")
                        .. "  +"
                        .. tostring(diff.AddedCount)
                        .. " -"
                        .. tostring(diff.RemovedCount)
                        .. " ~"
                        .. tostring(diff.ChangedCount)
                        .. " · noise "
                        .. tostring(current.VolatileIgnored or 0)
                )

                if copyResult == true then

                    ZanjiCopyText(
                        report.Summary
                    )
                end

                ZanjiNotify(
                    "ZANJI Dev",
                    "Stable update scan finished.",
                    4
                )

                return true
            end, debug.traceback)

        runtime.UpdateScanning =
            false

        if success ~= true then

            ZanjiDevSetStatus(
                "UpdateStatusLabel",
                "Scan failed · "
                    .. ZanjiCleanText(result)
            )

            ZanjiNotify(
                "ZANJI Dev",
                "Update scan failed: "
                    .. ZanjiCleanText(result),
                6
            )
        end
    end)

    return true
end

function ZanjiDevAcceptCurrentUpdateBaseline()

    local runtime =
        ZANJI_DEV_SUITE_RUNTIME

    if runtime.UpdateScanning == true then
        return false
    end

    local current =
        runtime.PendingUpdateSnapshot
        or ZanjiDevReadJson(
            DEV_UPDATE_PENDING_FILE
        )

    local valid,
        reason =
        ZanjiDevValidateUpdateSnapshot(
            current
        )

    if valid ~= true then

        ZanjiNotify(
            "ZANJI Dev",
            "No valid pending scan: "
                .. tostring(reason),
            5
        )

        return false
    end

    local oldBaseline =
        ZanjiDevReadJson(
            DEV_UPDATE_BASELINE_FILE
        )

    if type(oldBaseline) == "table"
    and oldBaseline.PlaceVersion ~= nil then

        ZanjiDevUpdateWriteExact(
            ZanjiDevUpdateHistoryFile(
                oldBaseline.PlaceVersion
            ),
            oldBaseline
        )
    end

    if ZanjiDevUpdateWriteExact(
        DEV_UPDATE_BASELINE_FILE,
        current
    ) ~= true then

        ZanjiNotify(
            "ZANJI Dev",
            "Could not promote the pending baseline.",
            5
        )

        return false
    end

    ZanjiDevUpdateWriteExact(
        ZanjiDevUpdateHistoryFile(
            current.PlaceVersion
        ),
        current
    )

    runtime.PendingUpdateSnapshot =
        nil

    ZANJI_DEV_SUITE_STATE.UpdateScope =
        current.Scope

    if type(delfile) == "function" then

        pcall(function()

            if isfile(
                DEV_UPDATE_PENDING_FILE
            ) then

                delfile(
                    DEV_UPDATE_PENDING_FILE
                )
            end
        end)
    end

    ZanjiDevSetStatus(
        "UpdateStatusLabel",
        "Baseline accepted · v"
            .. tostring(current.PlaceVersion or "?")
    )

    ZanjiNotify(
        "ZANJI Dev",
        "Current scan accepted as the new baseline.",
        4
    )

    return true
end

