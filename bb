function ZanjiSellReadValueThreshold(value)

    local text =
        ZanjiCleanText(
            value
        )

    text =
        text:gsub("¢", "")
            :gsub("%$", "")
            :gsub(",", "")
            :gsub("%s+", "")

    local lower =
        text:lower()

    if lower == ""
    or lower == "0"
    or lower == "none"
    or lower == "off"
    or lower == "no" then

        return 0
    end

    if type(ZanjiDailyDealStrictMoney) == "function" then

        local ok,
            result =
            pcall(function()

                return ZanjiDailyDealStrictMoney(
                    lower,
                    0,
                    nil
                )
            end)

        result =
            tonumber(result)

        if ok == true
        and result ~= nil
        and result >= 0 then

            return math.floor(
                result + 0.5
            )
        end
    end

    local numberText,
        suffix =
        lower:match("^(%d+%.?%d*)([a-z]*)$")

    local number =
        tonumber(numberText)

    if number == nil then
        return 0
    end

    local multipliers = {
        [""] = 1,

        k = 1000,
        thousand = 1000,

        m = 1000000,
        mil = 1000000,
        million = 1000000,

        b = 1000000000,
        bil = 1000000000,
        billion = 1000000000,

        t = 1000000000000,
        tril = 1000000000000,
        trillion = 1000000000000,

        q = 1000000000000000,
        qa = 1000000000000000,
        quad = 1000000000000000,
        quadrillion = 1000000000000000,
    }

    local multiplier =
        multipliers[suffix or ""]

    if multiplier == nil then
        multiplier = 1
    end

    return math.max(
        0,
        math.floor(number * multiplier + 0.5)
    )
end

function ZanjiSellFormatValue(value)

    value =
        tonumber(value)

    if value == nil then
        return "$0"
    end

    if type(ZanjiVisualFormatFruitValue) == "function" then

        return ZanjiVisualFormatFruitValue(
            value
        )
    end

    return tostring(
        math.floor(value + 0.5)
    )
end

function ZanjiSellGetToolValue(tool)

    if ZanjiSellLooksLikeFruitTool(tool) ~= true then
        return nil
    end

    if type(ZanjiVisualReadFruitTool) == "function" then

        local ok,
            row =
            pcall(function()

                return ZanjiVisualReadFruitTool(
                    tool,
                    0
                )
            end)

        if ok == true
        and type(row) == "table" then

            local value =
                tonumber(
                    row.Value
                )

            if value ~= nil
            and value > 0 then

                return math.floor(value + 0.5),
                    row.ValueText
                    or ZanjiSellFormatValue(value)
            end
        end
    end

    if type(ZanjiVisualCalculateFruitValue) == "function" then

        local attrs =
            ZanjiSellGetToolAttributes(
                tool
            )

        local weight =
            ZanjiSellGetToolWeight(
                tool
            )

        local sizeMultiplier =
            tonumber(
                attrs.SizeMultiplier
                or attrs.SizeMulti
                or attrs.ScaleMultiplier
                or attrs.ScaleMulti
                or attrs.Scale
                or attrs.SizeScale
            )

        if sizeMultiplier == nil
        or sizeMultiplier <= 0 then

            sizeMultiplier =
                math.max(
                    0.01,
                    tonumber(weight)
                    or 0
                )
        end

        local row = {
            Tool =
                tool,

            Name =
                ZanjiSellGetToolFruitName(
                    tool
                ),

            RawName =
                tostring(
                    tool
                    and tool.Name
                    or ""
                ),

            RawMutation =
                ZanjiSellGetRawToolMutation(
                    tool
                ),

            Weight =
                tonumber(weight)
                or 0,

            SizeMultiplier =
                sizeMultiplier,

            Index =
                0,
        }

        local ok,
            result =
            pcall(function()

                return ZanjiVisualCalculateFruitValue(
                    tool,
                    row
                )
            end)

        result =
            tonumber(result)

        if ok == true
        and result ~= nil
        and result > 0 then

            return math.floor(result + 0.5),
                ZanjiSellFormatValue(result)
        end
    end

    return nil
end

function ZanjiSellValueFilterActive()

    if ZANJI_SHOP_STATE.UseSellFilters ~= true then
        return false
    end

    return ZanjiSellReadValueThreshold(
        ZANJI_SHOP_STATE.SellValueThreshold
        or "0"
    ) > 0
end

function ZanjiSellPassesValueFilter(tool)

    local threshold =
        ZanjiSellReadValueThreshold(
            ZANJI_SHOP_STATE.SellValueThreshold
            or "0"
        )

    if threshold <= 0 then
        return true
    end

    local value =
        ZanjiSellGetToolValue(
            tool
        )

    value =
        tonumber(value)

    if value == nil
    or value <= 0 then

        return false
    end

    local mode =
        ZanjiSellNormalizeValueMode(
            ZANJI_SHOP_STATE.SellValueMode
            or "Below"
        )

    if mode == "Above" then

        return value >= threshold
    end

    return value <= threshold
end

function ZanjiSellSortQueue()

    ZANJI_SHOP_STATE.SellQueue =
        type(ZANJI_SHOP_STATE.SellQueue) == "table"
        and ZANJI_SHOP_STATE.SellQueue
        or {}

    if ZanjiSellValueFilterActive() ~= true then
        return false
    end

    local mode =
        ZanjiSellNormalizeValueMode(
            ZANJI_SHOP_STATE.SellValueMode
            or "Below"
        )

    table.sort(ZANJI_SHOP_STATE.SellQueue, function(a, b)

        a =
            type(a) == "table"
            and a
            or {}

        b =
            type(b) == "table"
            and b
            or {}

        local valueA =
            tonumber(a.Value)
            or 0

        local valueB =
            tonumber(b.Value)
            or 0

        if valueA ~= valueB then

            if mode == "Above" then

                return valueA > valueB
            end

            return valueA < valueB
        end

        local weightA =
            tonumber(a.Weight)
            or 0

        local weightB =
            tonumber(b.Weight)
            or 0

        if weightA ~= weightB then
            return weightA > weightB
        end

        return tostring(a.Name or "")
            < tostring(b.Name or "")
    end)

    return true
end

function ZanjiSellClearQueue()

