function ZanjiAuctionFindBuyTarget()

    ZanjiAuctionEnsureState()

    local watchlist =
        ZANJI_SHOP_STATE.AuctionWatchlist
        or {}

    if #watchlist <= 0 then

        return nil,
            "Add an item to the Auction Watchlist"
    end

    local rows =
        ZanjiAuctionScanLiveLots()

    if #rows <= 0 then

        return nil,
            "Loading auctions"
    end

    local eligibleByIndex = {}
    local selectedTooExpensive = nil
    local selectedStale = nil
    local selectedBoughtOnce = false
    local selectedFound = false

    for _, row in ipairs(rows) do

        local entry,
            watchIndex =
            ZanjiAuctionGetWatchEntry(
                row.Name
            )

        if type(entry) == "table" then

            selectedFound = true

            row.WatchlistIndex =
                watchIndex

            row.WatchlistMaxPrice =
                ZanjiAuctionReadMoney(
                    entry.MaxPrice
                )

            local alreadyAttempted =
                ZANJI_SHOP_STATE.AuctionAttemptedLots[
                    tostring(
                        row.LotId
                    )
                ] == true

            if ZANJI_SHOP_STATE.AuctionBuyUntilSoldOut ~= true
            and alreadyAttempted == true then

                selectedBoughtOnce =
                    true

            elseif row.Active == true then

                local stale,
                    staleReason =
                    ZanjiAuctionRowStale(
                        row,
                        true
                    )

                if stale == true then

                    selectedStale =
                        selectedStale
                        or staleReason

                elseif ZanjiAuctionPriceAllows(row) == true then

                    eligibleByIndex[watchIndex] =
                        row

                else

                    local currentRatio =
                        (
                            tonumber(row.Price)
                            or math.huge
                        )
                        / math.max(
                            1,
                            row.WatchlistMaxPrice
                        )

                    local previousRatio =
                        selectedTooExpensive
                        and selectedTooExpensive.Ratio
                        or math.huge

                    if currentRatio < previousRatio then

                        selectedTooExpensive = {
                            Row = row,
                            Ratio = currentRatio,
                            MaxPrice = row.WatchlistMaxPrice,
                        }
                    end
                end
            end
        end
    end

    local lastIndex =
        math.clamp(
            math.floor(
                tonumber(
                    ZANJI_SHOP_STATE.AuctionRoundRobinIndex
                )
                or 0
            ),
            0,
            #watchlist
        )

    for offset = 1, #watchlist do

        local watchIndex =
            (
                (
                    lastIndex + offset - 1
                )
                % #watchlist
            )
            + 1

        local row =
            eligibleByIndex[
                watchIndex
            ]

        if type(row) == "table" then

            return row,
                "Ready"
        end
    end

    if type(selectedTooExpensive) == "table" then

        local row =
            selectedTooExpensive.Row

        return nil,
            "Waiting: "
            .. tostring(row.Name)
            .. " "
            .. ZanjiAuctionFormatMoney(row.Price)
            .. " > "
            .. ZanjiAuctionFormatMoney(
                selectedTooExpensive.MaxPrice
            )
    end

    if selectedStale ~= nil then

        return nil,
            "Waiting for stock"
    end

    if selectedBoughtOnce == true
    and ZANJI_SHOP_STATE.AuctionBuyUntilSoldOut ~= true then

        return nil,
            "Bought once"
    end

    if selectedFound == true then

        return nil,
            "Watchlist items unavailable"
    end

    return nil,
        "Waiting for watchlist items"
end

function ZanjiAuctionQueueWorker(reason)

    ZanjiAuctionEnsureState()

    local now =
        os.clock()

    local pendingLotId =
        ZanjiCleanText(
            ZANJI_SHOP_STATE.AuctionPendingLotId
        )

    local pendingSentAt =
        tonumber(
            ZANJI_SHOP_STATE.AuctionPendingSentAt
        )
        or 0

    local pendingTimeout =
        math.max(
            2,
            ZanjiAuctionReadDebounce()
                + 0.5
        )

    local pendingExpired =
        pendingLotId ~= ""
        and pendingSentAt > 0
        and now - pendingSentAt >= pendingTimeout

    if pendingLotId ~= ""
    and pendingSentAt > 0
    and pendingExpired ~= true then

        ZANJI_SHOP_STATE.AuctionSchedulerState =
            "Pending"

        ZanjiAuctionSetStatus(
            "Processing purchase..."
        )

        return false
    end

    if pendingExpired ~= true then

        local nextBuyAt =
            tonumber(
                ZANJI_SHOP_STATE.AuctionNextBuyAt
            )
            or 0

        if now < nextBuyAt then

            ZANJI_SHOP_STATE.AuctionSchedulerState =
                "Cooldown"

            ZanjiAuctionSetStatus(
                "Cooldown "
                .. tostring(
                    math.max(
                        1,
                        math.ceil(
                            nextBuyAt - now
                        )
                    )
                )
                .. "s"
            )

            return false
        end

        local nextRetryAt =
            tonumber(
                ZANJI_SHOP_STATE.AuctionNextRetryAt
            )
            or 0

        if now < nextRetryAt then

            ZANJI_SHOP_STATE.AuctionSchedulerState =
                "Waiting"

            return false
        end
    end

    if ZANJI_SHOP_STATE.AuctionWorkerRunning == true then

        return false
    end

    ZANJI_SHOP_STATE.AuctionWorkerRunning =
        true

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "WorkerQueued",
            {
                Reason =
                    tostring(
                        reason
                        or "queue"
                    ),

                SchedulerState =
                    ZANJI_SHOP_STATE.AuctionSchedulerState,

                PendingLotId =
                    ZANJI_SHOP_STATE.AuctionPendingLotId,

                NextBuyIn =
                    math.max(
                        0,
                        (
                            tonumber(
                                ZANJI_SHOP_STATE.AuctionNextBuyAt
                            )
                            or 0
                        ) - now
                    ),
            }
        )
    end

    task.spawn(function()

        local ok,
            err =
            pcall(function()

                ZanjiAuctionRunWorker(
                    reason
                    or "queue"
                )
            end)

        if ok ~= true then

            ZANJI_SHOP_STATE.AuctionSchedulerState =
                "Waiting"

            ZanjiAuctionSetStatus(
                "Error: "
                    .. tostring(err)
            )
        end

        ZANJI_SHOP_STATE.AuctionWorkerRunning =
            false
    end)

    return true
end

