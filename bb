    for _, record in ipairs(
        decoded.Records
    ) do
        if type(record) == "table" then
            table.insert(
                ZANJI_MAIL_HISTORY.Records,
                record
            )

            if #ZANJI_MAIL_HISTORY.Records
                >= ZANJI_MAIL_HISTORY_LIMIT
            then
                break
            end
        end
    end

    return true
end

function ZanjiMailHistoryAdd(record)
    if type(record) ~= "table" then
        return false
    end

    record.Id =
        tostring(
            record.Id
                or (
                    tostring(os.time())
                    .. "-"
                    .. tostring(
                        math.floor(
                            os.clock() * 1000
                        )
                    )
                    .. "-"
                    .. tostring(
                        math.random(
                            1000,
                            9999
                        )
                    )
                )
        )

    record.Timestamp =
        math.floor(
            tonumber(record.Timestamp)
                or os.time()
        )

    record.Items =
        type(record.Items) == "table"
            and record.Items
            or {}

    record.AccountUserId =
        ZANJI_MAIL_ACCOUNT_USER_ID

    record.AccountUsername =
        tostring(
            LocalPlayer.Name
        )

    ZANJI_MAIL_HISTORY.Version =
        2

    ZANJI_MAIL_HISTORY.UserId =
        ZANJI_MAIL_ACCOUNT_USER_ID

    ZANJI_MAIL_HISTORY.Username =
        tostring(
            LocalPlayer.Name
        )

    table.insert(
        ZANJI_MAIL_HISTORY.Records,
        1,
        record
    )

    while #ZANJI_MAIL_HISTORY.Records
        > ZANJI_MAIL_HISTORY_LIMIT
    do
        table.remove(
            ZANJI_MAIL_HISTORY.Records
        )
    end

