function ZanjiSettingsSetDashboard(value)

    value =
        tostring(
            value
            or "Interface"
        )

    if value ~= "Themes"
    and value ~= "Session"
    and value ~= "Performance"
    and value ~= "Account" then

        value =
            "Interface"
    end

    ZANJI_DEV_UI_STATE.SettingsDashboard =
        value

    ZanjiSaveUISettings()

    if SettingsModeControl
    and type(SettingsModeControl.SetValue) == "function" then

        SettingsModeControl:SetValue(
            value,
            true
        )
    end

    ZanjiSettingsRefreshDashboard()
end

