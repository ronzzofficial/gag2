function ZanjiAuctionExtractCycle(lotId)

    local raw =
        tostring(lotId or ""):match(
            "^auction:(%d+):%d+$"
        )

    return tonumber(raw)
end

function ZanjiAuctionExtractSlot(lotId)

    local raw =
