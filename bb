function ZanjiDevCollectOwnedTools()

    local byName =
        {}

    local roots = {
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        ),

        LocalPlayer.Character,
    }

    for _, root in ipairs(roots) do

        if root then

            for _, child in ipairs(
                root:GetChildren()
            ) do

                if ZanjiDevIsUsableGear(child) == true then

                    local name =
                        tostring(child.Name)

                    local count =
                        tonumber(
                            child:GetAttribute(
                                "Count"
                            )
                        )

                    if count == nil then
                        count = 1
                    end

                    local current =
                        byName[name]

                    if current == nil
                    or count > current.Count then

                        byName[name] = {
                            Name = name,
                            Count = count,
                            Tool = child,

                            Location =
                                root == LocalPlayer.Character
                                and "Character"
                                or "Backpack",
                        }
                    end
                end
            end
        end
    end

    local rows =
        {}

    for _, row in pairs(byName) do

        if row.Count > 0 then

            rows[#rows + 1] =
                row
        end
    end

    table.sort(rows, function(a, b)

        return a.Name:lower()
            < b.Name:lower()
    end)

    return rows
end

function ZanjiDevGetToolCount(toolName)

