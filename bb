function ZanjiServerFinderSelectionValues(value)

    local output =
        {}

    if type(value) ~= "table" then
        return output
    end

    for key, enabled in pairs(value) do

        local text =
            ""

        if type(key) == "number" then

            text =
                ZanjiCleanText(
                    enabled
                )

        elseif enabled == true then

            text =
                ZanjiCleanText(
                    key
                )
        end

        if text ~= "" then

            table.insert(
                output,
                text
            )
        end
    end

    return output
end

function ZanjiServerFinderAddMapValue(map, value)

    value =
        ZanjiCleanText(
            value
        )

    if value == "" then
        return false
    end

    map[value] =
        true

    return true
end

function ZanjiServerFinderNormalizeSizeChoice(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == "big" then
        return "Big"
    end

    if lower == "huge"
    or lower == "mega" then
        return "Huge"
    end

    if lower == "normal"
    or lower == "regular" then
        return "Normal"
    end

    if lower == "big rainbow" then
        return "Big"
    end

    if lower == "mega rainbow"
    or lower == "huge rainbow" then
        return "Huge"
    end

    return ""
end

function ZanjiServerFinderNormalizeVariantChoice(value)

    local text =
        ZanjiCleanText(
            value
        )

    local lower =
        text:lower()

    if lower == "rainbow"
    or lower == "big rainbow"
    or lower == "huge rainbow"
    or lower == "mega rainbow" then
        return "Rainbow"
    end

    if lower == "regular"
    or lower == "normal" then
        return "Regular"
    end

    return ""
end

function ZanjiServerFinderMapFromArray(value)

    local output =
