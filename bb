function ZanjiShopSelectionArray(value)

    local output =
        {}

    local seen =
        {}

    local function add(itemName)

        itemName =
            ZanjiCleanText(itemName)

        if itemName == ""
        or seen[itemName] == true then
            return
        end

        seen[itemName] =
            true

        table.insert(
            output,
            itemName
        )
    end

    if type(value) == "table" then

        for key, enabled in pairs(value) do

            if type(key) == "number" then

                add(
                    enabled
                )

            elseif enabled == true then

                add(
                    key
                )
            end
        end

    elseif type(value) == "string" then

        add(
            value
        )
    end

    table.sort(output, function(a, b)

        if a == "All" then
            return true
        end

        if b == "All" then
            return false
        end

        return tostring(a) < tostring(b)
    end)

    return output
end

function ZanjiSellNormalizeMethod(value)

