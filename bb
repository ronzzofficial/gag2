        {
            "Rainbow",
            "IsRainbow",
            "PetRainbow",
            "RainbowPet",
        }
    ) == true then

        return "Rainbow"
    end

    if ZanjiSniperReadModelBooleanAttribute(
        model,
        {
            "Rainbow",
            "IsRainbow",
            "PetRainbow",
            "RainbowPet",
        }
    ) == true then

        return "Rainbow"
    end

    local rawVariant =
        ZanjiSniperReadModelAttribute(
            ref,
            {
                "PetType",
                "Type",
                "Variant",
                "PetVariant",
                "DisplayType",
                "DisplayVariant",
                "Mutation",
                "WildPetType",
                "PetTypeName",
            }
        )

    if rawVariant == "" then

        rawVariant =
            ZanjiSniperReadModelAttribute(
                model,
                {
                    "PetType",
                    "Type",
                    "Variant",
                    "PetVariant",
                    "DisplayType",
                    "DisplayVariant",
                    "Mutation",
                    "WildPetType",
                    "PetTypeName",
                }
            )
    end

    if rawVariant ~= "" then

        rawVariant =
            ZanjiSniperNormalizeVariantName(
