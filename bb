            or 7
        )

    return math.clamp(
        pageSize,
        1,
        20
    )
end

function ZanjiSniperGetWatchlistPageCount(totalRows)

    totalRows =
        math.max(
            0,
            math.floor(
                tonumber(totalRows)
                or 0
            )
        )

    local pageSize =
        ZanjiSniperGetWatchlistPageSize()

    return math.max(
        1,
        math.ceil(
            totalRows / pageSize
        )
    )
end

function ZanjiSniperClampWatchlistPage(totalRows)

    local pageCount =
        ZanjiSniperGetWatchlistPageCount(
            totalRows
        )

    local page =
        math.floor(
            tonumber(
                ZANJI_SNIPER_STATE.WatchlistPage
            )
            or 1
        )

    page =
        math.clamp(
            page,
            1,
            pageCount
        )

    ZANJI_SNIPER_STATE.WatchlistPage =
        page

    return page,
        pageCount
end

function ZanjiSniperBuildWatchlistRows()

    local allRows =
        ZanjiSniperBuildAllWatchlistRows()

    local page,
        pageCount =
        ZanjiSniperClampWatchlistPage(
            #allRows
        )

    local pageSize =
        ZanjiSniperGetWatchlistPageSize()

    local firstIndex =
        ((page - 1) * pageSize) + 1

    local lastIndex =
        math.min(
            #allRows,
            firstIndex + pageSize - 1
        )

    local pageRows =
        {}

    for index = firstIndex, lastIndex do

        if type(allRows[index]) == "table" then

            table.insert(
                pageRows,
                allRows[index]
            )
        end
    end

    return pageRows,
        {
            Page =
                page,

            PageCount =
                pageCount,

            TotalRows =
                #allRows,

            FirstIndex =
                firstIndex,

            LastIndex =
                lastIndex,
        }
end

function ZanjiSniperBuildWatchlistPageText()

    local allRows =
