function ZanjiSniperPetBuyProtectionActive()

    local lock =
        ZanjiSniperPetBuyProtectionEnsure()

    if lock.Active ~= true then

        ZANJI_SNIPER_RUNTIME.BuyProtectionActive =
            false

        return false,
            "clear"
    end

    local now =
        os.clock()

    local hardUntil =
        tonumber(lock.HardUntil)
        or 0

    if hardUntil > 0
    and now >= hardUntil then

        ZanjiSniperClearPetBuyProtection(
            "hard timeout"
        )

        return false,
            "hard timeout"
    end

    if ZANJI_SNIPER_RUNTIME.Buying == true then

        ZANJI_SNIPER_RUNTIME.BuyProtectionActive =
            true

        return true,
            "buying"
    end

    local ref =
        lock.Ref

    if typeof(ref) ~= "Instance"
    or ref.Parent == nil then

        ref =
            ZanjiSniperFindPetBuyProtectionRef(
                lock
            )

        lock.Ref =
            ref
    end

    local state =
        ""

    local ownerUserId =
        0

    local ownerName =
        ""

    if typeof(ref) == "Instance"
    and ref.Parent ~= nil then

        state =
            ZanjiSniperReadModelAttribute(
                ref,
                {
                    "State",
                    "PetState",
                }
            )

        ownerUserId =
            tonumber(
                ZanjiSniperReadModelAttribute(
                    ref,
                    {
                        "OwnerUserId",
                        "OwnerUserID",
                        "Owner",
                        "UserId",
                        "UserID",
                    }
                )
            )
            or 0

        ownerName =
            ZanjiCleanText(
                ZanjiSniperReadModelAttribute(
                    ref,
                    {
                        "OwnerName",
                        "OwnerDisplayName",
                    }
                )
            )
    end

    local ownedByLocal =
        ownerUserId == tonumber(LocalPlayer.UserId)
        or (
            ownerName ~= ""
            and ownerName == ZanjiCleanText(LocalPlayer.Name)
        )

    if ZanjiSniperPetBuyStateLooksPending(state) == true then

        ZANJI_SNIPER_RUNTIME.BuyProtectionActive =
            true

        lock.Reason =
            state ~= ""
            and state
            or "going to garden"

        return true,
            lock.Reason
    end

    if ownedByLocal == true then

        ZANJI_SNIPER_RUNTIME.BuyProtectionActive =
            true

        lock.Reason =
            "owned by you, settling"

        return true,
            lock.Reason
    end

    local minUntil =
        tonumber(lock.MinUntil)
        or 0

    if now < minUntil then

        ZANJI_SNIPER_RUNTIME.BuyProtectionActive =
            true

        return true,
            tostring(lock.Reason or "settling")
    end

    ZanjiSniperClearPetBuyProtection(
        "settled"
    )

    return false,
        "settled"
end

