function ZanjiSniperExecuteMatch(match, token)

    if type(match) ~= "table"
    or type(match.Entry) ~= "table"
    or type(match.Filter) ~= "table" then

        return false,
            "bad match"
    end

        if type(ZANJI_DEFENSE_RUNTIME) == "table"
    and ZANJI_DEFENSE_RUNTIME.Active == true then

        ZanjiSniperSetStatus(
            "Paused: pet defense active"
        )

        return false,
            "defense active"
    end

    if type(ZanjiFarmMiddleCancelForSniper) == "function" then

        ZanjiFarmMiddleCancelForSniper(
            "sniper buy"
        )
    end

    if ZANJI_SNIPER_RUNTIME.Buying == true
    or ZANJI_SNIPER_RUNTIME.Returning == true then

        return false,
            "busy"
    end

    if ZanjiSniperPetBuyProtectionBlocks(
        "Buy",
        false
    ) == true then

        return false,
            "pet buy pending"
    end

    ZANJI_SNIPER_RUNTIME.Buying =
        true

    ZanjiSniperClearHeldToolForMovement(
        "buy flow"
    )

    local entry =
        match.Entry

    local filter =
        match.Filter

    ZanjiSniperArmTargetLock(
        entry,
        "buy flow"
    )

    local protectionArmed =
        false

    local promptTriggered =
        false

    ZANJI_SNIPER_RUNTIME.CurrentTarget =
        entry

    ZANJI_SNIPER_RUNTIME.CurrentTargetKey =
        ZanjiSniperEntryKey(
            entry
        )

    local root =
        ZanjiSniperGetCharacterRoot()

    if typeof(root) == "Instance"
    and root:IsA("BasePart")
    and typeof(ZANJI_SNIPER_RUNTIME.ReturnActivationCFrame) ~= "CFrame" then

        ZANJI_SNIPER_RUNTIME.ReturnActivationCFrame =
            root.CFrame
    end

    local success =
        false

    local finalReason =
        "unknown"

    local ok,
        err =
        pcall(function()

            local valid,
                refreshed,
                reason =
                ZanjiSniperValidateTargetForBuy(
                    entry,
                    filter
                )

            if valid ~= true then

                entry =
                    refreshed
                    or entry

                finalReason =
                    reason
                    or "target invalid"

                return
            end

            entry =
                refreshed

            local beforeSheckles =
                ZanjiSniperReadSheckles()

            ZanjiSniperSetStatus(
                "Target locked: "
                .. ZanjiSniperDescribeEntry(entry)
            )

            local moveOk,
                movedEntry,
                moveReason =
                false,
                nil,
                ""

            if ZanjiSniperNormalizeMovementMode(
                ZANJI_SNIPER_STATE.MovementMode
            ) == "Teleport" then

                moveOk,
                    movedEntry,
                    moveReason =
                    ZanjiSniperMoveTeleportToEntry(
                        entry,
                        filter,
                        token
                    )

            else

                moveOk,
                    movedEntry,
                    moveReason =
                    ZanjiSniperMoveWalkToEntry(
                        entry,
                        filter,
                        token
                    )
            end

            entry =
                movedEntry
                or entry

            if moveOk ~= true then

                finalReason =
                    moveReason
                    or "move failed"

                return
            end

            valid,
                refreshed,
                reason =
                ZanjiSniperValidateTargetForBuy(
                    entry,
                    filter
                )

            if valid ~= true then

                entry =
                    refreshed
                    or entry

                finalReason =
                    reason
                    or "target invalid after move"

                return
            end

            entry =
                refreshed

            local distance =
                ZanjiSniperDistanceToEntry(
                    entry
                )

            local safeRange =
                ZanjiSniperGetSafeRange(
                    entry.Prompt
                )

            if distance > safeRange then

                finalReason =
                    "not in range"

                return
            end

            ZanjiSniperArmPetBuyProtection(
                entry,
                "buy prompt"
            )

            protectionArmed =
                true

            ZanjiSniperSetStatus(
                "Buying: "
                .. ZanjiSniperDescribeEntry(entry)
            )

            local triggerOk,
                triggerReason =
                ZanjiSniperTriggerPrompt(
                    entry.Prompt
                )

            if triggerOk ~= true then

                finalReason =
                    triggerReason
                    or "prompt trigger failed"

                ZanjiSniperClearPetBuyProtection(
                    "prompt trigger failed"
                )

                protectionArmed =
                    false

                return
            end

            promptTriggered =
                true

            ZanjiSniperTouchPetBuyProtection(
                entry,
                "prompt fired"
            )

            local confirmed,
                confirmReason =
                ZanjiSniperConfirmBuy(
                    entry,
                    beforeSheckles,
                    token
                )

            if confirmed == true then

                ZanjiSniperTouchPetBuyProtection(
                    entry,
                    confirmReason
                    or "confirmed"
                )

                ZanjiSniperMarkBought(
                    match,
                    entry
                )

                ZanjiSniperRegisterConfirmedBuy(
                    match,
                    entry
                )

                if type(ZanjiDefenseArm) == "function" then

                    ZanjiDefenseArm(
                        entry,
                        filter,
                        "confirmed buy"
                    )
                end

                success =
                    true

                finalReason =
                    confirmReason
                    or "confirmed"

                ZanjiSniperSetStatus(
                    "Bought: "
                    .. ZanjiSniperDescribeEntry(entry)
                    .. " / protected"
                )

                ZanjiSniperMaybeReturnAfterBuy(
                    token
                )

            else

                finalReason =
                    confirmReason
                    or "confirm failed"
            end
        end)

    if ok ~= true then

        finalReason =
            tostring(err)
    end

    if protectionArmed == true
    and promptTriggered ~= true
    and success ~= true then

        ZanjiSniperClearPetBuyProtection(
            "buy failed before prompt"
        )
    end

    if success == true then

        ZanjiSniperClearTargetLock(
            "buy protection active"
        )

    else

        ZanjiSniperMarkFailed(
            entry
        )

        ZanjiSniperClearTargetLock(
            "buy failed: "
            .. tostring(finalReason or "unknown")
        )

        ZanjiSniperSetStatus(
            "Buy failed: "
            .. tostring(finalReason or "unknown")
        )
    end

    ZANJI_SNIPER_RUNTIME.Buying =
        false

    ZANJI_SNIPER_RUNTIME.CurrentTarget =
        nil

    ZANJI_SNIPER_RUNTIME.CurrentTargetKey =
        ""

    task.wait(
        success == true
        and 0.30
        or 0.55
    )

    return success,
        finalReason
end

function ZanjiSniperRunScan()

    local entries =
        ZanjiSniperScanLivePets()

    local matches =
        ZanjiSniperFindMatches(
            entries
        )

    ZANJI_SNIPER_RUNTIME.ScanCount =
        (
            tonumber(
                ZANJI_SNIPER_RUNTIME.ScanCount
            )
            or 0
        )
        + 1

    ZANJI_SNIPER_RUNTIME.PetCount =
        #entries

    ZANJI_SNIPER_RUNTIME.MatchCount =
        #matches

    ZANJI_SNIPER_RUNTIME.LastScanAt =
        os.clock()

    if #matches > 0 then

        if type(ZanjiFarmMiddleCancelForSniper) == "function" then

            ZanjiFarmMiddleCancelForSniper(
                "match found"
            )
        end

        local best =
            matches[1].Entry

        ZANJI_SNIPER_RUNTIME.CurrentTarget =
            best

        ZANJI_SNIPER_RUNTIME.CurrentTargetKey =
            ZanjiSniperEntryKey(
                best
            )

        ZANJI_SNIPER_RUNTIME.LastMatchAt =
            os.clock()

        ZanjiSniperArmTargetLock(
            best,
            "match found"
        )

        ZanjiSniperSetStatus(
            tostring(#entries)
            .. " pets / "
            .. tostring(#matches)
            .. " matches / Best: "
            .. ZanjiSniperDescribeEntry(best)
        )

        return matches
    end

    ZANJI_SNIPER_RUNTIME.CurrentTarget =
        nil

    ZANJI_SNIPER_RUNTIME.CurrentTargetKey =
        ""

    ZanjiSniperClearTargetLock(
        "no matches"
    )

    if type(ZANJI_SNIPER_STATE.Watchlist) ~= "table"
    or #ZANJI_SNIPER_STATE.Watchlist <= 0 then

        ZanjiSniperSetStatus(
            tostring(#entries)
            .. " pets / No watchlist"
        )

    else

        ZanjiSniperSetStatus(
            tostring(#entries)
            .. " pets / 0 matches"
        )
    end

    return matches
end

