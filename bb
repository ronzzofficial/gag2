function ZanjiServerFinderOpenHud(showHud)

    if ZanjiAuthRequireServerSniper(
        "Server Finder HUD",
        showHud ~= false
    ) ~= true then

        return false
    end

    if ZANJI_SERVER_FINDER_HUD == nil then

        ZANJI_SERVER_FINDER_HUD =
            Library:CreateServerFinderHUD({
                Title =
                    "ZANJI Server Finder",

                CurrentServer =
                    tostring(game.JobId),

                SimpleMode =
                    true,

                HideFull =
                    false,

                AutoRefresh =
                    ZANJI_SERVER_FINDER_STATE.AutoRefresh == true,

                RefreshDelay =
                    ZANJI_SERVER_FINDER_STATE.RefreshDelay,

                HudScale =
                    ZanjiServerFinderGetHudScale(),

                Scale =
                    ZanjiServerFinderGetHudScaleFactor(),

                AutoJoinMode =
                    ZanjiServerFinderNormalizeAutoJoinMode(
                        ZANJI_SERVER_FINDER_STATE.AutoJoinMode
                    ),

                Minimized =
                    ZANJI_SERVER_FINDER_STATE.Minimized == true,

                Position =
                    ZANJI_SERVER_FINDER_STATE.Position,

                OnVisibleChanged =
                    function(visible, hud)

                        ZANJI_SERVER_FINDER_STATE.Enabled =
                            visible == true

                        if visible == true then

                            ZanjiServerFinderPullStateFromHud(
                                hud
                            )
                        end

                        ZanjiServerFinderSyncToggle(
                            visible == true
                        )

                        ZanjiQueueSaveServerFinderSettings()
                    end,

                OnSettingsChanged =
                    function(hud)

                        ZanjiServerFinderPullStateFromHud(
                            hud
                        )

                        ZanjiQueueSaveServerFinderSettings()
                    end,

                OnRefresh =
                    function(hud)

                        ZanjiServerFinderRefreshRows(
                            hud,
                            "refresh button"
                        )
                    end,

                OnJoin =
                    function(row)

                        ZanjiServerFinderJoinRow(
                            row,
                            "Manual Join"
                        )
                    end,
            })
    end

    ZanjiServerFinderApplyStateToHud(
        ZANJI_SERVER_FINDER_HUD
    )

    ZanjiServerFinderRefreshRows(
        ZANJI_SERVER_FINDER_HUD,
        showHud == false
        and "background refresh"
        or "hud open"
    )

    ZANJI_SERVER_FINDER_HUD:SetCurrentServer(
        tostring(game.JobId)
    )

    if showHud ~= false then

        ZANJI_SERVER_FINDER_HUD:Show()
    end

    return true
end

ZANJI_SERVER_FINDER_BACKGROUND_TOKEN = {
    Active = true,
}

do

    local token =
        ZANJI_SERVER_FINDER_BACKGROUND_TOKEN

    task.spawn(function()

        local nextRefreshAt =
            0

        while token.Active == true
        and ZANJI_SERVER_FINDER_BACKGROUND_TOKEN == token do

            ZanjiServerFinderEnsureAutoJoinState()

            local mode =
                ZanjiServerFinderNormalizeAutoJoinMode(
                    ZANJI_SERVER_FINDER_STATE.AutoJoinMode
                )

            local shouldRun =
                ZANJI_SERVER_FINDER_STATE.AutoRefresh == true
                or mode ~= "Off"

            if shouldRun == true
            and ZanjiAuthHasServerSniperSlot() == true
            and os.clock() >= nextRefreshAt then

                local delay =
                    math.clamp(
                        tonumber(
                            ZANJI_SERVER_FINDER_STATE.RefreshDelay
                        )
                        or 5,
                        1,
                        60
                    )

                nextRefreshAt =
                    os.clock()
                    + delay

                if ZANJI_SERVER_FINDER_HUD == nil then

                    ZanjiServerFinderOpenHud(
                        false
                    )

                else

                    local hudVisible =
                        ZANJI_SERVER_FINDER_HUD.Visible == true

                    local visibleAutoRefresh =
                        hudVisible
                        and ZANJI_SERVER_FINDER_STATE.AutoRefresh == true

                    if visibleAutoRefresh ~= true then

                        ZanjiServerFinderRefreshRows(
                            ZANJI_SERVER_FINDER_HUD,
                            "background automation"
                        )
                    end
                end
            end

            task.wait(
                0.5
            )
        end
    end)
end

