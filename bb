function ZanjiFruitAutomationReadToolInfo(tool)

    if typeof(tool) ~= "Instance" then

        return nil
    end

    local isTool =
        tool:IsA("Tool")

    local isFruitProxy =
        tool:IsA("Configuration")
        and tool:GetAttribute("FruitProxy") == true

    if isTool ~= true
    and isFruitProxy ~= true then

        return nil
    end

    if tool:GetAttribute("HarvestedFruit") ~= true then

        return nil
    end

    local fruitId =
        tostring(
            tool:GetAttribute("Id")
            or ""
        )

    if fruitId == "" then

        return nil
    end

    local info =
        ZanjiFruitAutomationReadCommonFruitInfo(
            tool,
            tool.Name
        )

    if ZanjiFruitAutomationLooksLikeFruit(
        info
    ) ~= true then

        return nil
    end

    info.Tool =
        tool

    info.FruitId =
        fruitId

    info.IsFruitProxy =
        isFruitProxy

    return info
end

function ZanjiFruitAutomationGetFruitTools()

    local tools =
        {}

    local containers =
        {}

    local character =
        ZanjiFruitAutomationGetCharacter()

    if typeof(character) == "Instance" then

        table.insert(
            containers,
            character
        )
    end

    local backpack =
        LocalPlayer
        and LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )
        or nil

    if typeof(backpack) == "Instance" then

        table.insert(
            containers,
            backpack
        )
    end

    for _, container in ipairs(containers) do

        for _, child in ipairs(container:GetChildren()) do

            local info =
                ZanjiFruitAutomationReadToolInfo(
                    child
                )

            if ZanjiFruitAutomationPassesDropFilters(
                info
            ) == true then

                ZanjiFruitAutomationCalculateInfoValue(
                    info
                )

                table.insert(
                    tools,
                    info
                )
            end
        end
    end

    local valueThreshold =
        ZanjiFruitAutomationReadValueThreshold(
            ZANJI_FRUIT_AUTOMATION_STATE.ValueThreshold
            or "0"
        )

    local valueMode =
        ZanjiFruitAutomationNormalizeValueMode(
            ZANJI_FRUIT_AUTOMATION_STATE.ValueMode
            or "Below"
        )

    table.sort(tools, function(a, b)

        if valueThreshold > 0 then

            local valueA =
                tonumber(
                    a.ValueNumber
                    or ZanjiFruitAutomationCalculateInfoValue(a)
                )
                or 0

            local valueB =
                tonumber(
                    b.ValueNumber
                    or ZanjiFruitAutomationCalculateInfoValue(b)
                )
                or 0

            if valueA ~= valueB then

                if valueMode == "Below" then

                    return valueA < valueB
                end

                return valueA > valueB
            end
        end

        local weightA =
            tonumber(a.WeightKg)
            or 0

        local weightB =
            tonumber(b.WeightKg)
            or 0

        if weightA ~= weightB then
            return weightA > weightB
        end

        return tostring(a.FruitName)
            < tostring(b.FruitName)
    end)

    return tools
end

