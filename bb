function ZanjiHookGroupboxAutosave(groupbox, key, collapsed)

    key =
        ZanjiNormalizeGroupboxKey(
            key
        )

    if type(groupbox) ~= "table" then
        return groupbox
    end

    groupbox.__ZanjiGroupboxKey =
        key

    if groupbox.__ZanjiGroupboxAutosave ~= true
    and type(groupbox.SetCollapsed) == "function" then

        local originalSetCollapsed =
            groupbox.SetCollapsed

        groupbox.__ZanjiGroupboxAutosave =
            true

        groupbox.__ZanjiOriginalSetCollapsed =
            originalSetCollapsed

        groupbox.SetCollapsed =
            function(self, state, skipSave)

                local result =
                    originalSetCollapsed(
                        self,
                        state
                    )

                ZANJI_GROUPBOX_STATE =
                    type(ZANJI_GROUPBOX_STATE) == "table"
                    and ZANJI_GROUPBOX_STATE
                    or {}

                ZANJI_GROUPBOX_STATE.Collapsed =
                    type(ZANJI_GROUPBOX_STATE.Collapsed) == "table"
                    and ZANJI_GROUPBOX_STATE.Collapsed
                    or {}

                if key ~= "" then

                    ZANJI_GROUPBOX_STATE.Collapsed[key] =
                        self.Collapsed == true
                end

                if skipSave ~= true then

                    ZanjiSaveGroupboxSettings()
                end

                return result
            end
    end

    if type(groupbox.SetCollapsed) == "function"
    and groupbox.Collapsible == true then

        pcall(function()

            groupbox:SetCollapsed(
                collapsed == true,
                true
            )
        end)
    end

    return groupbox
end

function ZanjiAddGroupbox(tab, side, key, title, icon, defaultCollapsed)

    key =
        ZanjiNormalizeGroupboxKey(
            key
            or title
        )

    local collapsed =
        ZanjiGetGroupboxCollapsed(
            key,
            defaultCollapsed == true
        )

    local defaultOpen =
        collapsed ~= true

    local groupbox =
        nil

    local sideName =
        tostring(side or "Left")

    local collapsibleMethod =
        sideName == "Right"
        and "AddRightCollapsibleGroupbox"
        or "AddLeftCollapsibleGroupbox"

    local fallbackMethod =
        sideName == "Right"
        and "AddRightGroupbox"
        or "AddLeftGroupbox"

    if tab
    and type(tab[collapsibleMethod]) == "function" then

        local ok,
            result =
            pcall(function()

                return tab[collapsibleMethod](
                    tab,
                    title,
                    icon,
                    defaultOpen
                )
            end)

        if ok == true
        and result ~= nil then

            groupbox =
                result
        end
    end

    if groupbox == nil
    and tab
    and type(tab[fallbackMethod]) == "function" then

        groupbox =
            tab[fallbackMethod](
                tab,
                title,
                icon
            )
    end

    return ZanjiHookGroupboxAutosave(
        groupbox,
        key,
        collapsed
    )
end

