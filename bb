function ZanjiDoubleStartWorker(reason)

    ZanjiDoubleEnsureState()

    ZANJI_SHOP_STATE.AutoDoubleOrNothing =
        true

    ZanjiSaveShopSettings()

    ZanjiDoubleDisableAutoSell()

    if ZANJI_SHOP_STATE.DoubleWorkerRunning == true then
        return false
    end

    local token =
        {}

    ZANJI_SHOP_STATE.DoubleToken =
        token

    ZANJI_SHOP_STATE.DoubleWorkerRunning =
        true

    ZanjiDoubleSetStatus(
        "🚀 Starting..."
    )

    task.spawn(function()

        while ZanjiDoubleStillActive(token) == true do

            local ok,
                err =
                pcall(function()

                    ZanjiDoubleRunOnce(
                        token
                    )
                end)

            if ok ~= true then

                ZanjiDoubleSetStatus(
                    "⚠️ Error: "
                    .. tostring(err)
                )

                task.wait(
                    1.25
                )

            else

                task.wait(
                    0.75
                )
            end
        end

        if ZANJI_SHOP_STATE.DoubleToken == token then

            ZANJI_SHOP_STATE.DoubleToken =
                nil
        end

        ZANJI_SHOP_STATE.DoubleWorkerRunning =
            false

        if ZANJI_SHOP_STATE.AutoDoubleOrNothing ~= true then

            ZanjiDoubleSetStatus(
                "Off"
            )
        end
    end)

    return true
end

function ZanjiDoubleStopWorker(reason)

    ZanjiDoubleEnsureState()

    ZANJI_SHOP_STATE.AutoDoubleOrNothing =
        false

    ZANJI_SHOP_STATE.DoubleToken =
        nil

    ZANJI_SHOP_STATE.DoubleWorkerRunning =
        false

