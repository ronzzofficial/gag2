function ZanjiSniperGetVariantValues()

    local values =
        {}

    local seen =
        {}

    ZanjiSniperAddSortedValue(
        values,
        seen,
        "Any"
    )

    ZanjiSniperAddSortedValue(
        values,
        seen,
        "Normal"
    )

    local petTypes =
        ZanjiSniperGetPetTypesModule()

    for key, value in pairs(petTypes) do

        if type(value) == "string" then

            local normalized =
                ZanjiSniperNormalizeVariantName(
                    value
                )

            if normalized ~= "Normal"
            and ZanjiSniperPetTypeIsValid(normalized) == true then

                ZanjiSniperAddSortedValue(
                    values,
                    seen,
                    normalized
                )
            end
        end

        if type(key) == "string"
        and type(value) ~= "function"
        and key ~= "BOOST_MULTIPLIER" then

            local normalized =
                ZanjiSniperNormalizeVariantName(
                    key
                )

            if normalized ~= "Normal"
            and ZanjiSniperPetTypeIsValid(normalized) == true then

                ZanjiSniperAddSortedValue(
                    values,
                    seen,
                    normalized
                )
            end
        end
    end

    -- Safe fallback only if the module did not expose string variants.
    if seen.Rainbow ~= true
    and ZanjiSniperPetTypeIsValid("Rainbow") == true then

        ZanjiSniperAddSortedValue(
            values,
            seen,
            "Rainbow"
        )
    end

    ZanjiSniperSortVariantValues(
        values
    )

    return values
end

