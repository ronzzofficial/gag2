function ZanjiLivePetsBuildDisplayName(petName, sizeName, variantName)

    local parts =
        {}

    sizeName =
        ZanjiSniperNormalizeSizeName(
            sizeName
        )

    variantName =
        ZanjiSniperNormalizeVariantName(
            variantName
        )

    if sizeName ~= ""
    and sizeName ~= "Normal"
    and sizeName ~= "Any" then

        table.insert(
            parts,
            sizeName
        )
    end

    if variantName ~= ""
    and variantName ~= "Normal"
    and variantName ~= "Any" then

        table.insert(
            parts,
            variantName
        )
    end

    table.insert(
        parts,
        tostring(petName or "?")
    )

    return table.concat(
        parts,
        " "
    )
end

function ZanjiLivePetsRarityRank(rarity)

    rarity =
        ZanjiCleanText(
            rarity
        )

    local ranks = {
        Super = 7,
        Mythic = 6,
        Legendary = 5,
        Epic = 4,
        Rare = 3,
        Uncommon = 2,
        Common = 1,
    }

    return ranks[rarity]
        or 0
end

function ZanjiLivePetsFilterMatches(entry)

    local watchlist =
        type(ZANJI_SNIPER_STATE.Watchlist) == "table"
        and ZANJI_SNIPER_STATE.Watchlist
        or {}

    if #watchlist <= 0 then
        return false
    end

    for _, rawFilter in ipairs(watchlist) do

        local filter =
            ZanjiSniperNormalizeFilter(
                rawFilter
            )

        if filter.Enabled ~= false then

            local entryPet =
                ZanjiSniperPetAliasKey(
                    entry.PetKey
                    or entry.Pet
                )

            local filterPet =
                ZanjiSniperPetAliasKey(
                    filter.PetKey
                    or filter.Pet
                )

            if entryPet == filterPet then

                local sizeOk =
                    ZanjiSniperSelectionHasAny(
                        filter.Sizes
                    )
                    or ZanjiSniperSelectionContains(
                        filter.Sizes,
                        entry.Size
                    )

                local variantOk =
                    ZanjiSniperSelectionHasAny(
                        filter.Variants
                    )
                    or ZanjiSniperSelectionContains(
                        filter.Variants,
                        entry.Variant
                    )

                if sizeOk == true
                and variantOk == true then
                    return true
                end
            end
        end
    end

    return false
end

function ZanjiLivePetsBuildEntryFromRef(ref)

    if typeof(ref) ~= "Instance" then
        return nil
    end

    local petName =
        ZanjiLivePetsReadAttr(
            ref,
            {
                "PetName",
                "Pet",
                "DisplayName",
                "Name",
            }
        )

    if petName == "" then
        return nil
    end

    petName =
        ZanjiSniperResolvePetDisplay(
            petName
        )

    local petKey =
        ZanjiSniperResolvePetKey(
            petName
        )

    local uuid =
        ZanjiLivePetsGetUuidFromRef(
            ref
        )

    if uuid == "" then
        uuid =
            tostring(ref.Name)
    end

    local spawnedAt =
        ZanjiLivePetsReadNumber(
            ref,
            {
                "SpawnedAt",
                "SpawnTime",
                "CreatedAt",
            }
        )

    local lifetime =
        ZanjiLivePetsReadNumber(
            ref,
            {
                "Lifetime",
                "LifeTime",
                "Duration",
            }
        )

    local timeLeft =
        lifetime > 0
        and spawnedAt > 0
        and (
            spawnedAt
            + lifetime
            - os.time()
        )
        or 0

    if lifetime > 0
    and timeLeft <= -4 then

        return nil
    end

    local ownerUserId =
        ZanjiLivePetsReadNumber(
            ref,
            {
                "OwnerUserId",
                "OwnerUserID",
                "Owner",
                "UserId",
                "UserID",
            }
        )

    local ownerName =
        ZanjiLivePetsReadAttr(
            ref,
            {
                "OwnerName",
                "OwnerDisplayName",
            }
        )

    local rawState =
        ZanjiLivePetsReadAttr(
            ref,
            {
                "State",
                "PetState",
            }
        )

    local lowerState =
        rawState:lower()

    local model =
        ZanjiLivePetsFindModelForRef(
            ref
        )

    local prompt =
        model
        and ZanjiSniperFindBuyPrompt(
            model
        )
        or nil

    local size =
        ZanjiLivePetsReadSize(
            ref,
            model
        )

    local variant =
        ZanjiLivePetsReadVariant(
            ref,
            model
        )

    local rarity =
        ZanjiLivePetsReadAttr(
            ref,
            {
                "Rarity",
                "PetRarity",
            }
        )

    local price =
        ZanjiLivePetsReadNumber(
            ref,
            {
                "Price",
                "Cost",
                "TameCost",
            }
        )

    if price <= 0 then
        price =
            ZanjiSniperGetBasePrice({
                Pet =
                    petName,

                PetKey =
                    petKey,
            })
    end

    local position =
        ZanjiLivePetsGetPosition(
            ref,
            model
        )

    local distance =
        ZanjiLivePetsGetDistance(
            position
        )

    local handledEntry = {
        UUID = uuid,
        Key = uuid,
    }

    local handled =
        ZanjiSniperIsHandled(
            handledEntry
        )

    local cooling =
        ZanjiSniperIsFailedCooling(
            handledEntry
        )

    local owned =
        ownerUserId ~= 0
        or ownerName ~= ""

    if owned == true
    and handled ~= true then

        return nil
    end

    if lowerState:find("owned", 1, true)
    or lowerState:find("collected", 1, true)
    or lowerState:find("tamed", 1, true) then

        if handled ~= true then
            return nil
        end
    end

    local entry = {
        Key =
            uuid,

        UUID =
            uuid,

        Ref =
            ref,

        Model =
            model,

        Prompt =
            prompt,

        Pet =
            petName,

        PetKey =
            petKey,

        Size =
            size,

        Variant =
            variant,

        Rarity =
            rarity,

        Price =
            price,

        SpawnedAt =
            spawnedAt,

        Lifetime =
            lifetime,

        TimeLeft =
            timeLeft,

        Distance =
            distance,

        Position =
            position,

        RawState =
            rawState,
    }

    local match =
        ZanjiLivePetsFilterMatches(
            entry
        )

    local displayName =
        ZanjiLivePetsBuildDisplayName(
            petName,
            size,
            variant
        )

    local priceText =
        ZanjiLivePetsFormatMoney(
            price
        )

    local distanceText =
        distance
        and (
            tostring(math.floor(distance + 0.5))
            .. " studs"
        )
        or "? studs"

    local timeText =
        lifetime > 0
        and ZanjiLivePetsFormatTime(timeLeft)
        or "? left"

    local metaParts =
        {}

    if rarity ~= "" then
        table.insert(
            metaParts,
            rarity
        )
    end

    table.insert(
        metaParts,
        priceText
    )

    table.insert(
        metaParts,
        distanceText
    )

    local rowState =
        "ready"

    local badge =
        "BUY"

    local clickable =
        true

    if handled == true then

        rowState =
            "sent"

        badge =
            "SENT"

        clickable =
            false

    elseif cooling == true then

        rowState =
            "blocked"

        badge =
            "WAIT"

        clickable =
            false

    elseif model == nil
    or prompt == nil then

        badge =
            "WAIT"

        clickable =
            true
    end

    return {
        Key =
            uuid,

        UUID =
            uuid,

        DisplayName =
            displayName,

        Pet =
            petName,

        PetKey =
            petKey,

        Size =
            size,

        Variant =
            variant,

        Rarity =
            rarity,

        RarityRank =
            ZanjiLivePetsRarityRank(
                rarity
            ),

        PriceNumber =
            tonumber(price)
            or 0,

        Price =
            priceText,

        SpawnedAt =
            tonumber(spawnedAt)
            or 0,

        Lifetime =
            tonumber(lifetime)
            or 0,

        DistanceNumber =
            tonumber(distance)
            or 999999,

        Distance =
            distanceText,

        TimeLeftNumber =
            tonumber(timeLeft)
            or 0,

        Timer =
            timeText,

        Meta =
            table.concat(
                metaParts,
                " · "
            ),

        Match =
            match == true,

        Badge =
            badge,

        State =
            rowState,

        Clickable =
            clickable,

        RawState =
            rawState,

        Ref =
            ref,
    }
end

function ZanjiLivePetsScanRows()

    local rows =
        {}

    local refRoot =
        ZanjiSniperGetWildPetRefRoot()

    if typeof(refRoot) ~= "Instance" then
        return rows
    end

    for _, ref in ipairs(refRoot:GetChildren()) do

        local row =
            ZanjiLivePetsBuildEntryFromRef(
                ref
            )

        if row then

            table.insert(
                rows,
                row
            )
        end
    end

    table.sort(rows, function(a, b)

        if a.Match ~= b.Match then
            return a.Match == true
        end

        if a.RarityRank ~= b.RarityRank then
            return a.RarityRank > b.RarityRank
        end

        if a.PriceNumber ~= b.PriceNumber then
            return a.PriceNumber > b.PriceNumber
        end

        if a.TimeLeftNumber ~= b.TimeLeftNumber then
            return a.TimeLeftNumber < b.TimeLeftNumber
        end

        return a.DistanceNumber < b.DistanceNumber
    end)

    return rows
end

function ZanjiLivePetsBuildTimer(rows)

    rows =
        rows
        or ZanjiLivePetsScanRows()

    ZANJI_LIVE_PETS_RUNTIME =
        type(ZANJI_LIVE_PETS_RUNTIME) == "table"
        and ZANJI_LIVE_PETS_RUNTIME
        or {}

    ZANJI_LIVE_PETS_RUNTIME.SpawnSequence =
        type(ZANJI_LIVE_PETS_RUNTIME.SpawnSequence) == "table"
        and ZANJI_LIVE_PETS_RUNTIME.SpawnSequence
        or {}

    local clean =
        {}

    for _, row in ipairs(rows) do

        local spawnedAt =
            tonumber(row.SpawnedAt)
            or 0

        if spawnedAt > 0 then

            table.insert(
                clean,
                row
            )
        end
    end

    table.sort(clean, function(a, b)

        return tonumber(a.SpawnedAt or 0)
            < tonumber(b.SpawnedAt or 0)
    end)

    if #clean > 0 then

        local latest =
            clean[#clean]

        local latestSpawnedAt =
            tonumber(latest.SpawnedAt)
            or 0

        local latestPet =
            tostring(latest.Pet or "None")

        local latestKey =
            tostring(latestSpawnedAt)
            .. "|"
            .. latestPet

        if latestSpawnedAt > 0
        and latestKey ~= tostring(ZANJI_LIVE_PETS_RUNTIME.LastSpawnKey or "") then

            ZANJI_LIVE_PETS_RUNTIME.LastSpawnedAt =
                latestSpawnedAt

            ZANJI_LIVE_PETS_RUNTIME.LastSpawnKey =
                latestKey

            ZANJI_LIVE_PETS_RUNTIME.LastPet =
                latestPet

            table.insert(
                ZANJI_LIVE_PETS_RUNTIME.SpawnSequence,
                latestPet
            )

            while #ZANJI_LIVE_PETS_RUNTIME.SpawnSequence > 4 do

                table.remove(
                    ZANJI_LIVE_PETS_RUNTIME.SpawnSequence,
                    1
                )
            end
        end
    end

    local lastSpawnedAt =
        tonumber(
            ZANJI_LIVE_PETS_RUNTIME.LastSpawnedAt
        )
        or 0

    local lastPet =
        ZanjiCleanText(
            ZANJI_LIVE_PETS_RUNTIME.LastPet
            or "None"
        )

    if lastSpawnedAt <= 0 then

        return {
            NextText = "--:--",
            Active = #rows,
            Last = "None",
            Sequence = "None",
        }
    end

    local nextSpawn =
        lastSpawnedAt + 100

    while nextSpawn <= os.time() - 3 do

        nextSpawn =
            nextSpawn + 100
    end

    local sequence =
        "None"

    if #ZANJI_LIVE_PETS_RUNTIME.SpawnSequence > 0 then

        sequence =
            table.concat(
                ZANJI_LIVE_PETS_RUNTIME.SpawnSequence,
                " > "
            )
    end

    return {
        NextText =
            ZanjiLivePetsFormatCountdown(
                nextSpawn - os.time()
            ),

        Active =
            #rows,

        Last =
            lastPet ~= ""
            and lastPet
            or "None",

        Sequence =
            sequence,
    }
end

function ZanjiLivePetsBuildSummary(rows)

    local timer =
        ZanjiLivePetsBuildTimer(
