function ZanjiSellFruitNameCandidates(fruitName)

    fruitName =
        ZanjiCleanText(
            fruitName
        )

    local candidates =
        {}

    local seen =
        {}

    local function add(value)

        value =
            ZanjiCleanText(
                value
            )

        if value == ""
        or seen[value] == true then
            return
        end

        seen[value] =
            true

        table.insert(
            candidates,
            value
        )
    end

    add(
        fruitName
    )

    local prefixes = {
        "Baby ",
        "Big ",
        "Huge ",
        "Mega ",
        "Small ",
        "Large ",
        "Giant ",
        "Gold ",
        "Golden ",
        "Rainbow ",
    }

    for _, prefix in ipairs(prefixes) do

        if fruitName:sub(1, #prefix):lower() == prefix:lower() then

            add(
                fruitName:sub(
                    #prefix + 1
                )
            )
        end
    end

    return candidates
end

