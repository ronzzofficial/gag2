    return {
        cframe:GetComponents()
    }
end

function ZanjiSniperDataToCFrame(data)

    if type(data) ~= "table" then
        return nil
    end

    local components =
        {}

    for index = 1, 12 do

        local value =
            tonumber(
                data[index]
                or data[tostring(index)]
            )

        if value == nil then
            return nil
        end

        components[index] =
            value
    end

    local unpackFunction =
        table.unpack
        or unpack

    return CFrame.new(
        unpackFunction(
            components
        )
    )
end

