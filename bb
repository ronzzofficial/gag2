function ZanjiMergeAutomationSelectionArray(value)

    local output =
        {}

    local seen =
        {}

    if type(value) ~= "table" then

        value = {
            value,
        }
    end

    for key, selected in pairs(value) do

        local item =
            nil

        if type(key) == "number" then

            item =
                selected

        elseif selected == true then

            item =
                key
        end

        item =
            ZanjiCleanText(
                item
            )

        if item ~= ""
        and seen[item] ~= true then

            seen[item] =
                true

            table.insert(
                output,
                item
            )
        end
    end

    table.sort(output, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

