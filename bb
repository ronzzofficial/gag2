function ZanjiFormatScale(value)

    value =
        math.clamp(
            math.floor(
                tonumber(value)
                or 100
            ),
            30,
            110
        )

    return tostring(value)
        .. "%"
end

function ZanjiParseScale(value)

    local rawValue =
        tostring(value or "100%")

    local cleanedValue =
        rawValue:gsub(
            "%%",
            ""
        )

    local scale =
        tonumber(
            cleanedValue
        )

    if not scale then

        scale =
            100
    end

    return math.clamp(
        math.floor(scale + 0.5),
        30,
        110
    )
end

function ZanjiServerFinderReadHudScale(value)

    local rawValue =
        tostring(value or "80%")

    local cleanedValue =
        rawValue:gsub(
            "%%",
            ""
        )

    local scale =
        tonumber(
            cleanedValue
        )

    if not scale then

        scale =
            80
    end

    return math.clamp(
        math.floor(scale + 0.5),
        60,
        110
    )
end

function ZanjiServerFinderFormatHudScale(value)

    return tostring(
        ZanjiServerFinderReadHudScale(
            value
        )
    )
        .. "%"
end

function ZanjiServerFinderGetHudScale()

    ZANJI_SERVER_FINDER_STATE =
        type(ZANJI_SERVER_FINDER_STATE) == "table"
        and ZANJI_SERVER_FINDER_STATE
        or {}

    ZANJI_SERVER_FINDER_STATE.HudScale =
        ZanjiServerFinderReadHudScale(
            ZANJI_SERVER_FINDER_STATE.HudScale
            or 80
        )

    return ZANJI_SERVER_FINDER_STATE.HudScale
end

function ZanjiServerFinderGetHudScaleFactor()

    return ZanjiServerFinderGetHudScale() / 100
end

function ZanjiServerFinderClampFrameToScreen(frame)

    if typeof(frame) ~= "Instance"
    or frame:IsA("GuiObject") ~= true then

        return false
    end

    task.defer(function()

        if typeof(frame) ~= "Instance"
        or frame.Parent == nil
        or frame:IsA("GuiObject") ~= true then

            return
        end

        local camera =
            workspace.CurrentCamera

        local viewport =
            camera
            and camera.ViewportSize
            or Vector2.new(
                1280,
                720
            )

        local size =
            frame.AbsoluteSize

        local width =
            math.max(
                60,
                tonumber(size.X)
                or 60
            )

        local height =
            math.max(
                40,
                tonumber(size.Y)
                or 40
            )

        local x =
            math.floor(
                frame.Position.X.Offset + 0.5
            )

        local y =
            math.floor(
                frame.Position.Y.Offset + 0.5
            )

        x =
            math.clamp(
                x,
                6,
                math.max(
                    6,
                    viewport.X - width - 6
                )
            )

        y =
            math.clamp(
                y,
                6,
                math.max(
                    6,
                    viewport.Y - height - 6
                )
            )

        frame.Position =
            UDim2.fromOffset(
                x,
                y
            )
    end)

    return true
end

function ZanjiServerFinderApplyScaleToFrame(frame, scale)

    if typeof(frame) ~= "Instance"
    or frame:IsA("GuiObject") ~= true then

        return false
    end

    scale =
        tonumber(scale)
        or ZanjiServerFinderGetHudScaleFactor()

    scale =
        math.clamp(
            scale,
            0.60,
            1.10
        )

    local uiScale =
        frame:FindFirstChild(
            "ZanjiServerFinderUIScale"
        )

    if typeof(uiScale) ~= "Instance"
    or uiScale:IsA("UIScale") ~= true then

        uiScale =
            Instance.new(
                "UIScale"
            )

        uiScale.Name =
            "ZanjiServerFinderUIScale"

        uiScale.Parent =
            frame
    end

    uiScale.Scale =
        scale

    ZanjiServerFinderClampFrameToScreen(
        frame
    )

    return true
end

function ZanjiServerFinderApplyScaleToUi(ui)

    if type(ui) ~= "table" then
        return false
    end

    return ZanjiServerFinderApplyScaleToFrame(
