function ZanjiDefenseUpdatePetDirection(targetPos)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    local root =
        ZanjiDefenseGetRoot()

    local now =
        os.clock()

    if runtime.StablePetDirection == nil then

        if typeof(root) == "Instance"
        and root:IsA("BasePart") then

            local fromPetToSelf =
                root.Position
                - targetPos

            local flat =
                Vector3.new(
                    fromPetToSelf.X,
                    0,
                    fromPetToSelf.Z
                )

            if flat.Magnitude > 0.2 then

                runtime.StablePetDirection =
                    -flat.Unit

            else

                runtime.StablePetDirection =
                    Vector3.new(0, 0, 1)
            end

        else

            runtime.StablePetDirection =
                Vector3.new(0, 0, 1)
        end
    end

    if runtime.LastPetSamplePos == nil then

        runtime.LastPetSamplePos =
            targetPos

        runtime.LastPetSampleAt =
            now

        return runtime.StablePetDirection
    end

    if now - (
        tonumber(runtime.LastPetSampleAt)
        or 0
    ) < 0.10 then

        return runtime.StablePetDirection
    end

    local delta =
        targetPos
        - runtime.LastPetSamplePos

    local flatDelta =
        Vector3.new(
            delta.X,
            0,
            delta.Z
        )

    runtime.LastPetSamplePos =
        targetPos

    runtime.LastPetSampleAt =
        now

    if flatDelta.Magnitude >= 0.22 then

        local fresh =
            flatDelta.Unit

        local mixed =
            runtime.StablePetDirection:Lerp(
                fresh,
                0.22
            )

        if mixed.Magnitude > 0.05 then

            runtime.StablePetDirection =
                mixed.Unit

        else

            runtime.StablePetDirection =
                fresh
        end
    end

    return runtime.StablePetDirection
end

function ZanjiDefenseSmoothGoal(rawGoal)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if typeof(rawGoal) ~= "Vector3" then
        return rawGoal
    end

    if runtime.SmoothedFollowGoal == nil
    or (
        runtime.SmoothedFollowGoal
        - rawGoal
    ).Magnitude >= 18 then

        runtime.SmoothedFollowGoal =
            rawGoal

    else

        runtime.SmoothedFollowGoal =
            runtime.SmoothedFollowGoal:Lerp(
                rawGoal,
                0.30
            )
    end

    return runtime.SmoothedFollowGoal
end

function ZanjiDefenseChooseGoal(targetPos, threat)

    local root =
        ZanjiDefenseGetRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return nil
    end

    if threat
    and threat.Root
    and threat.Distance <= 18 then

        local diff =
            threat.Root.Position
            - targetPos

        local flat =
            Vector3.new(
                diff.X,
                0,
                diff.Z
            )

        if flat.Magnitude > 0.1 then

            local threatDir =
                flat.Unit

            local guardDistance =
                threat.Distance <= 8
                and 3.85
                or 4.75

            return Vector3.new(
                targetPos.X,
                root.Position.Y,
                targetPos.Z
            )
            + threatDir * guardDistance
        end
    end

    local stableDir =
        ZanjiDefenseUpdatePetDirection(
            targetPos
        )

    local rawGoal =
        targetPos
        - stableDir * 5.75

    rawGoal =
        Vector3.new(
            rawGoal.X,
            root.Position.Y,
            rawGoal.Z
        )

    return ZanjiDefenseSmoothGoal(
        rawGoal
    )
end

function ZanjiDefenseSetWalkSpeed(distance, threat)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    local humanoid =
        ZanjiDefenseGetHumanoid()

    if typeof(humanoid) ~= "Instance" then
        return
    end

    if runtime.OriginalWalkSpeed == nil then

        runtime.OriginalWalkSpeed =
            humanoid.WalkSpeed
    end

    local base =
        tonumber(runtime.OriginalWalkSpeed)
        or humanoid.WalkSpeed

    local wanted =
        math.max(
            base,
            22
        )

    if threat
    and threat.Distance <= 8 then

        wanted =
            math.max(
                base,
                31
            )

    elseif threat
    and threat.Distance <= 24 then

        wanted =
            math.max(
                base,
                27
            )

    elseif distance >= 14 then

        wanted =
            math.max(
                base,
                27
            )
    end

    pcall(function()

        humanoid.WalkSpeed =
            wanted

        humanoid.AutoRotate =
            true
    end)
end

function ZanjiDefenseWalkTo(goal, threat)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    local humanoid =
        ZanjiDefenseGetHumanoid()

    local root =
        ZanjiDefenseGetRoot()

    if typeof(goal) ~= "Vector3"
    or typeof(humanoid) ~= "Instance"
    or typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return false
    end

    ZanjiDefenseDisableControls()

    local delta =
        goal
        - root.Position

    local flat =
        Vector3.new(
            delta.X,
            0,
            delta.Z
        )

    local distance =
        flat.Magnitude

    ZanjiDefenseSetWalkSpeed(
        distance,
        threat
    )

    if distance <= 2.30 then

        pcall(function()

            humanoid:Move(
                Vector3.zero,
                false
            )
        end)

        return true
    end

    local now =
        os.clock()

    if now - (
        tonumber(runtime.LastMoveAt)
        or 0
    ) >= 0.04 then

        runtime.LastMoveAt =
            now

        pcall(function()

            humanoid:Move(
                flat.Unit,
                false
            )
        end)
    end

    if now - (
        tonumber(runtime.LastMoveToAt)
        or 0
    ) >= 0.16 then

        runtime.LastMoveToAt =
            now

        pcall(function()

            humanoid:MoveTo(
                goal
            )
        end)
    end

    return true
end

function ZanjiDefenseTweenTo(goal)

    local root =
        ZanjiDefenseGetRoot()

    if typeof(goal) ~= "Vector3"
    or typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return false
    end

    local distance =
        (
            root.Position
            - goal
        ).Magnitude

    if distance <= 2.30 then
        return true
    end

    local speed =
        30

    local duration =
        math.clamp(
            distance / speed,
            0.10,
            0.35
        )

    local TweenService =
        game:GetService("TweenService")

    local tween =
        TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame =
                    CFrame.new(
                        goal,
                        goal + root.CFrame.LookVector
                    ),
            }
        )

    pcall(function()

        tween:Play()
    end)

    return true
end

function ZanjiDefenseMoveTo(goal, threat)

    local movement =
        ZanjiDefenseNormalizeMovement(
            ZANJI_SNIPER_STATE.DefendMovement
        )

    local root =
        ZanjiDefenseGetRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return false
    end

    local distance =
        typeof(goal) == "Vector3"
        and (
            root.Position
            - goal
        ).Magnitude
        or 0

    if movement == "Tween" then

        return ZanjiDefenseTweenTo(
            goal
        )
    end

    if movement == "Hybrid" then

        if distance >= 15
        or (
            threat
            and threat.Distance <= 8
        ) then

            return ZanjiDefenseTweenTo(
                goal
            )
        end
    end

    return ZanjiDefenseWalkTo(
        goal,
        threat
    )
end

function ZanjiDefenseRayClear(fromPos, toPos, targetCharacter)

    if typeof(fromPos) ~= "Vector3"
    or typeof(toPos) ~= "Vector3" then

        return false
    end

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local ignore =
        {}

    local character =
        ZanjiDefenseGetCharacter()

    if typeof(character) == "Instance" then

        table.insert(
            ignore,
            character
        )
    end

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if typeof(runtime.Target) == "Instance" then

        table.insert(
            ignore,
            runtime.Target
        )
    end

    params.FilterDescendantsInstances =
        ignore

    local result =
        workspace:Raycast(
            fromPos,
            toPos - fromPos,
            params
        )

    if result == nil then
        return true
    end

    if typeof(targetCharacter) == "Instance"
    and result.Instance
    and result.Instance:IsDescendantOf(
        targetCharacter
    ) then

        return true
    end

    return false
end

function ZanjiDefenseGetThreatParts(threat)

    local character =
        threat
        and threat.Player
        and threat.Player.Character
        or nil

    if typeof(character) ~= "Instance" then
        return nil
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )
        or character:FindFirstChild(
            "RootPart"
        )
        or character.PrimaryPart

    local head =
        character:FindFirstChild(
            "Head"
        )

    return {
        Character =
            character,

        Root =
            root,

        Head =
            head,
    }
end

function ZanjiDefenseGetVelocity(part)

    if typeof(part) ~= "Instance"
    or part:IsA("BasePart") ~= true then

        return Vector3.zero
    end

    local ok,
        velocity =
        pcall(function()

            return part.AssemblyLinearVelocity
        end)

    if ok == true
    and typeof(velocity) == "Vector3" then

        return velocity
    end

    return Vector3.zero
end

function ZanjiDefenseChooseAim(threat)

    local parts =
        ZanjiDefenseGetThreatParts(
            threat
        )

    if parts == nil
    or typeof(parts.Root) ~= "Instance"
    or parts.Root:IsA("BasePart") ~= true then

        return nil
    end

    local root =
        ZanjiDefenseGetRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return nil
    end

    local velocity =
        ZanjiDefenseGetVelocity(
            parts.Root
        )

    local distance =
        tonumber(threat.Distance)
        or 0

    local tinyLead =
        math.clamp(
            distance / 470,
            0.010,
            0.050
        )

    local softLead =
        math.clamp(
            distance / 330,
            0.020,
            0.090
        )

    local headPos =
        typeof(parts.Head) == "Instance"
        and parts.Head:IsA("BasePart")
        and (
            parts.Head.Position
            + Vector3.new(0, -0.05, 0)
        )
        or (
            parts.Root.Position
            + Vector3.new(0, 2.3, 0)
        )

    local rootHigh =
        parts.Root.Position
        + Vector3.new(0, 1.45, 0)

    local candidates = {
        headPos + velocity * tinyLead,
        headPos + velocity * softLead,
        rootHigh,
        rootHigh + velocity * tinyLead,
    }

    local camera =
        workspace.CurrentCamera

    local rootFrom =
        root.Position
        + Vector3.new(0, 1.5, 0)

    local cameraFrom =
        camera
        and camera.CFrame.Position
        or rootFrom

    for _, aim in ipairs(candidates) do

        if ZanjiDefenseRayClear(
            rootFrom,
            aim,
            parts.Character
        ) == true
        and ZanjiDefenseRayClear(
            cameraFrom,
            aim,
            parts.Character
        ) == true then

            return aim
        end
    end

    return nil
end

function ZanjiDefensePreAim(aim)

    local camera =
        workspace.CurrentCamera

    if typeof(camera) == "Instance"
    and typeof(aim) == "Vector3" then

        pcall(function()

            camera.CFrame =
                CFrame.new(
                    camera.CFrame.Position,
                    aim
                )
        end)
    end
end

function ZanjiDefenseFaceShot(aim)

    local root =
        ZanjiDefenseGetRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or typeof(aim) ~= "Vector3" then

        return
    end

    local lookAt =
        Vector3.new(
            aim.X,
            root.Position.Y,
            aim.Z
        )

    if (
        lookAt
        - root.Position
    ).Magnitude < 0.35 then

        return
    end

    pcall(function()

        root.CFrame =
            CFrame.lookAt(
                root.Position,
                lookAt
            )
    end)
end

function ZanjiDefenseUseStrawberry(threat)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if threat == nil
    or threat.Player == nil
    or threat.Root == nil then

        return false
    end

    if threat.Distance > 30 then
        return false
    end

    local velocity =
        ZanjiDefenseGetVelocity(
            threat.Root
        )

    local flatSpeed =
        Vector3.new(
            velocity.X,
            0,
            velocity.Z
        ).Magnitude

    if threat.Distance > 22
    and flatSpeed > 7 then

        return false
    end

    local cooldown =
        threat.Distance <= 8
        and 2.78
        or 3.00

    if os.clock() - (
        tonumber(runtime.LastShotAt)
        or 0
    ) < cooldown then

        return false
    end

    ZanjiDefenseResolvePackets()

    local packet =
        runtime.StrawberryPacket

    if type(packet) ~= "table" then
        return false
    end

    local aim =
        ZanjiDefenseChooseAim(
            threat
        )

    if typeof(aim) ~= "Vector3" then
        return false
    end

    if ZanjiDefenseSelectedGearEquipped() ~= true then
        return false
    end

    local tool =
        ZanjiDefenseGetEquippedTool()

    if ZanjiDefenseToolMatches(
        tool,
        "Strawberry Sniper"
    ) ~= true then

        return false
    end

    ZanjiDefensePreAim(
        aim
    )

    ZanjiDefenseFaceShot(
        aim
    )

    task.wait()

    local ok =
        ZanjiDefenseFirePacket(
            packet,
            aim,
            tool,
            threat.Player
        )

    if ok == true then

        runtime.LastShotAt =
            os.clock()
    end

    return ok
end

function ZanjiDefenseReadTargetPetId()

    local runtime =
        ZanjiDefenseEnsureRuntime()

    local target =
        runtime.Target

    if typeof(target) ~= "Instance" then
        return ""
    end

    local petId =
        ZanjiCleanText(
            ZanjiDefenseReadAttr(
                target,
                "PetId"
            )
            or ZanjiDefenseReadAttr(
                target,
                "PetID"
            )
            or ZanjiDefenseReadAttr(
                target,
                "UUID"
            )
            or ""
        )

    if petId ~= "" then
        return petId
    end

    return ZanjiSniperUuidFromName(
        target.Name
    )
end

function ZanjiDefenseUseShovel(threat)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if threat == nil
    or threat.Player == nil
    or threat.Distance > 7 then

        return false
    end

    if os.clock() - (
        tonumber(runtime.LastShovelAt)
        or 0
    ) < 0.85 then

        return false
    end

    ZanjiDefenseResolvePackets()

    if ZanjiDefenseSelectedGearEquipped() ~= true then
        return false
    end

    local ok =
        false

    if type(runtime.ShovelSwingPacket) == "table" then

        ok =
            ZanjiDefenseFirePacket(
                runtime.ShovelSwingPacket
            )
            or ok
    end

    if type(runtime.ShovelHitPacket) == "table" then

        ok =
            ZanjiDefenseFirePacket(
                runtime.ShovelHitPacket,
                threat.Player.UserId
            )
            or ok
    end

    local petId =
        ZanjiDefenseReadTargetPetId()

    if petId ~= ""
    and type(runtime.PetScarePacket) == "table" then

        ok =
            ZanjiDefenseFirePacket(
                runtime.PetScarePacket,
                threat.Player.UserId,
                petId
            )
            or ok
    end

    runtime.LastShovelAt =
        os.clock()

    return ok
end

function ZanjiDefenseUseGear(threat)

    local gear =
        ZanjiDefenseNormalizeGear(
            ZANJI_SNIPER_STATE.DefendGear
        )

    if gear == "Shovel" then

        return ZanjiDefenseUseShovel(
            threat
        )
    end

    return ZanjiDefenseUseStrawberry(
        threat
    )
end

function ZanjiDefenseStop(reason)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    local wasActive =
        runtime.Active == true
        or runtime.ControlsDisabled == true

    local wasConfirmed =
        runtime.InventoryConfirmed == true

    local completedKey =
        ZanjiDefenseNormalizeId(
            runtime.TargetPetId
        )

    if completedKey == ""
    and typeof(runtime.Target) == "Instance" then

        completedKey =
            ZanjiDefenseRefKey(
                runtime.Target
            )
    end

    runtime.GearLockActive =
        false

    ZanjiDefenseDisconnectGearLock()

    runtime.Token =
        nil

    runtime.Active =
        false

    ZanjiDefenseDisconnect()

    if wasActive == true then

        ZanjiDefenseRestoreControls()

        local humanoid =
            ZanjiDefenseGetHumanoid()

        if typeof(humanoid) == "Instance" then

            pcall(function()

                humanoid:Move(
                    Vector3.zero,
                    false
                )

                if runtime.OriginalWalkSpeed ~= nil then

                    humanoid.WalkSpeed =
                        runtime.OriginalWalkSpeed
                end

                humanoid.AutoRotate =
                    true
            end)
        end
    end

    if wasConfirmed == true
    and completedKey ~= "" then

        runtime.CompletedTargets[
            completedKey
        ] =
            os.clock() + 30
    end

    runtime.Target =
        nil

    runtime.Entry =
        nil

    runtime.Filter =
        nil

    runtime.TargetPetId =
        ""

    runtime.TargetPetName =
        ""

    runtime.TargetMissingAt =
        0

    runtime.CompletionStartedAt =
        0

    runtime.InventoryConfirmed =
        false

    runtime.InventoryConfirmationItem =
        nil

    runtime.InventoryBaselineInstances =
        {}

    runtime.InventoryBaselineIds =
        {}

    runtime.SmoothedFollowGoal =
        nil

    runtime.StablePetDirection =
        nil

    runtime.LastPetSamplePos =
        nil

    runtime.LastPetSampleAt =
        0

    runtime.OriginalWalkSpeed =
        nil

    runtime.LastStopReason =
        tostring(
            reason
            or "stopped"
        )

    if ZANJI_SNIPER_STATE.DefendBoughtPets == true
    and runtime.MonitorRunning == true then

        task.defer(function()

            ZanjiDefenseMonitorScan()
        end)
    end

    return true
end

function ZanjiDefenseCanRebuy(target)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
    or ZANJI_SNIPER_STATE.DefendRebuyIfStolen ~= true then

        return false
    end

    local filter =
        type(runtime.Filter) == "table"
        and ZanjiSniperNormalizeFilter(
            runtime.Filter
        )
        or {}

    local maxPrice =
        tonumber(filter.MaxPrice)
        or 0

    if maxPrice <= 0 then
        return false
    end

    if runtime.RebuyCount >= runtime.MaxRebuys then
        return false
    end

    local price =
        tonumber(
            ZanjiDefenseReadAttr(
                target,
                "Price"
            )
        )
        or 0

    if price <= 0
    or price > maxPrice then

        return false
    end

    local state =
        ZanjiCleanText(
            ZanjiDefenseReadAttr(
                target,
                "State"
            )
            or ""
        )

    return ZanjiSniperPetBuyStateLooksPending(
        state
    ) == true
end

function ZanjiDefenseTryRebuy(target)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if typeof(target) ~= "Instance"
    or ZanjiDefenseCanRebuy(
        target
    ) ~= true then

        return false
    end

    ZanjiDefenseResolvePackets()

    if type(runtime.WildTamePacket) ~= "table" then
        return false
    end

    local ok =
        ZanjiDefenseFirePacket(
            runtime.WildTamePacket,
            target
        )

    if ok == true then

        runtime.RebuyCount =
            (
                tonumber(runtime.RebuyCount)
                or 0
            )
            + 1

        runtime.Target =
            target
    end

    return ok
end

function ZanjiDefenseHandleOwnerChanged(target)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
    or runtime.Active ~= true
    or target ~= runtime.Target then

        return
    end

    task.delay(0.05, function()

        local liveRuntime =
            ZanjiDefenseEnsureRuntime()

        if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
        or liveRuntime.Active ~= true
        or target ~= liveRuntime.Target
        or typeof(target) ~= "Instance"
        or target.Parent == nil then

            return
        end

        local owner =
            tonumber(
                ZanjiDefenseReadAttr(
                    target,
                    "OwnerUserId"
                )
            )
            or 0

        if owner == 0
        or owner == tonumber(LocalPlayer.UserId) then

            return
        end

        if ZanjiDefenseTryRebuy(
            target
        ) == true then

            return
        end

        ZanjiDefenseStop(
            "stolen"
        )
    end)
end

function ZanjiDefenseWatchTarget(target)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    ZanjiDefenseDisconnect()

    for _, attrName in ipairs({
        "OwnerUserId",
        "OwnerName",
        "State",
        "Price",
    }) do

        pcall(function()

            ZanjiDefenseAddConnection(
                target:GetAttributeChangedSignal(
                    attrName
                ):Connect(function()

                    if attrName == "OwnerUserId" then

                        ZanjiDefenseHandleOwnerChanged(
                            target
                        )
                    end
                end)
            )
        end)
    end

    ZanjiDefenseAddConnection(
        target.AncestryChanged:Connect(function(_, parent)

            if parent == nil
            and runtime.Active == true
            and runtime.Target == target
            and (
                tonumber(runtime.TargetMissingAt)
                or 0
            ) <= 0 then

                runtime.TargetMissingAt =
                    os.clock()
            end
        end)
    )
end

function ZanjiDefenseStopMovementOnly()

    local humanoid =
        ZanjiDefenseGetHumanoid()

    local root =
        ZanjiDefenseGetRoot()

    if typeof(humanoid) == "Instance" then

        pcall(function()

            humanoid:Move(
                Vector3.zero,
                false
            )

            if typeof(root) == "Instance"
            and root:IsA("BasePart") then

                humanoid:MoveTo(
                    root.Position
                )
            end
        end)
    end
end

function ZanjiDefenseRunWorker(token)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    while runtime.Token == token
    and runtime.Active == true do

        local wateringState =
            type(ZANJI_WATERING_REJOIN_STATE) == "table"
            and ZANJI_WATERING_REJOIN_STATE
            or {}

        local wateringRuntime =
            type(ZANJI_WATERING_REJOIN_RUNTIME) == "table"
            and ZANJI_WATERING_REJOIN_RUNTIME
            or {}

        local wateringOwnsMovement =
            wateringState.Enabled == true
            and (
                wateringRuntime.Running == true
                or wateringRuntime.Busy == true
                or wateringRuntime.RespawnPending == true
                or wateringRuntime.RecoveryScheduled == true
            )

        if wateringOwnsMovement == true then

            task.wait(
                0.08
            )

            continue
        end

        if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true then

            ZanjiDefenseStop(
                "toggle off"
            )

            return
        end

        if ZanjiDefenseInventoryConfirmed(
            false
        ) == true then

            ZanjiDefenseStop(
                "inventory confirmed"
            )

            return
        end

        local target =
            runtime.Target

        if typeof(target) ~= "Instance"
        or target.Parent == nil then

            if (
                tonumber(runtime.TargetMissingAt)
                or 0
            ) <= 0 then

                runtime.TargetMissingAt =
                    os.clock()
            end

            ZanjiDefenseStopMovementOnly()

            task.wait(
                0.08
            )

            continue
        end

        runtime.TargetMissingAt =
            0

        local owner =
            tonumber(
                ZanjiDefenseReadAttr(
                    target,
                    "OwnerUserId"
                )
            )
            or 0

        if owner ~= tonumber(LocalPlayer.UserId) then

            ZanjiDefenseHandleOwnerChanged(
                target
            )

            task.wait(
                0.12
            )

            continue
        end

        local state =
            ZanjiCleanText(
                ZanjiDefenseReadAttr(
                    target,
                    "State"
                )
                or ""
            )

        local walking =
            ZanjiSniperPetBuyStateLooksPending(
                state
            ) == true

        if walking ~= true then

            if (
                tonumber(runtime.CompletionStartedAt)
                or 0
            ) <= 0 then

                runtime.CompletionStartedAt =
                    os.clock()
            end

            ZanjiDefenseStopMovementOnly()

            task.wait(
                0.08
            )

            continue
        end

        runtime.CompletionStartedAt =
            0

        local targetPos =
            ZanjiDefenseGetPosition(
                target
            )

        if typeof(targetPos) == "Vector3" then

            local threat =
                ZanjiDefenseFindThreat(
                    targetPos
                )

            local goal =
                ZanjiDefenseChooseGoal(
                    targetPos,
                    threat
                )

            if typeof(goal) == "Vector3" then

                ZanjiDefenseMoveTo(
                    goal,
                    threat
                )
            end

            if threat ~= nil then

                ZanjiDefenseUseGear(
                    threat
                )
            end
        end

        task.wait(
            0.04
        )
    end
end

function ZanjiDefenseWaitForOwnedTarget(entry)

    entry =
        type(entry) == "table"
        and entry
        or {}

    local ref =
        entry.Ref

    if typeof(ref) ~= "Instance"
    or ref.Parent == nil then

        ref =
            ZanjiSniperFindPetBuyProtectionRef({
                UUID =
                    entry.UUID
                    or entry.Key,

                Key =
                    entry.Key,
            })
    end

    if typeof(ref) ~= "Instance" then
        return nil
    end

    local deadline =
        os.clock() + 2.5

    while os.clock() <= deadline do

        if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
        or typeof(ref) ~= "Instance"
        or ref.Parent == nil then

            return nil
        end

        if ZanjiDefenseRefReady(
            ref
        ) == true then

            return ref
        end

        task.wait(
            0.05
        )
    end

    return nil
end

function ZanjiDefenseStartTarget(target, entry, filter, reason)

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
    or typeof(target) ~= "Instance"
    or target.Parent == nil
    or ZanjiDefenseRefReady(
        target
    ) ~= true then

        return false
    end

    if type(ZanjiFarmMiddleCancelForSniper) == "function" then

        ZanjiFarmMiddleCancelForSniper(
            "pet defense"
        )
    end

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if runtime.Active == true then

        return runtime.Target == target
    end

    runtime.Active =
        true

    runtime.Token =
        {}

    runtime.Target =
        target

    runtime.Entry =
        type(entry) == "table"
        and entry
        or ZanjiDefenseBuildEntryFromRef(
            target
        )

    runtime.Filter =
        type(filter) == "table"
        and filter
        or ZanjiDefenseFindFilterForEntry(
            runtime.Entry
            or {}
        )

    runtime.TargetPetId =
        ZanjiCleanText(
            ZanjiDefenseReadPetId(
                target
            )
        )

    if runtime.TargetPetId == "" then

        runtime.TargetPetId =
            ZanjiCleanText(
                runtime.Entry
                and (
                    runtime.Entry.UUID
                    or runtime.Entry.Key
                )
                or ""
            )
    end

    runtime.TargetPetName =
        ZanjiCleanText(
            runtime.Entry
            and runtime.Entry.Pet
            or ZanjiDefenseReadPetName(
                target
            )
        )

    runtime.TargetMissingAt =
        0

    runtime.CompletionStartedAt =
        0

    runtime.InventoryConfirmed =
        false

    runtime.InventoryConfirmationItem =
        nil

