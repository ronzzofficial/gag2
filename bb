function ZanjiGuildLeaderboardArray()

    local source =
        ZANJI_GUILD_STATE.Leaderboard

    if type(source) ~= "table" then
        return {}
    end

    local nested =
        ZanjiGuildField(
            source,
            {
                "Leaderboard",
                "Entries",
                "Rows",
                "Guilds",
                "Data",
            }
        )

    if type(nested) == "table" then
        source = nested
    end

    local rows = {}

    for key, rawRow in pairs(source) do

        if type(rawRow) == "table" then

            local rank =
                tonumber(
                    ZanjiGuildField(
                        rawRow,
                        {
                            "Rank",
                            "Placement",
                            "Position",
                        },
                        key
                    )
                )

            local guild =
                ZanjiGuildField(
                    rawRow,
                    {
                        "Guild",
                        "GuildData",
                    }
                )

            guild =
                type(guild) == "table"
                and guild
                or rawRow

            local name =
                ZanjiCleanText(
                    ZanjiGuildField(
                        guild,
                        {
                            "Name",
                            "GuildName",
                        },
                        ""
                    )
                )

            if name ~= "" then

                rows[#rows + 1] = {
                    Rank =
                        rank
                        or (
                            #rows
                            + 1
                        ),

                    Id =
                        ZanjiCleanText(
                            ZanjiGuildField(
                                guild,
                                {
                                    "GuildId",
                                    "GuildID",
                                    "Id",
                                    "ID",
                                },
                                ""
                            )
                        ),

                    Name = name,

                    Tag =
                        ZanjiCleanText(
                            ZanjiGuildField(
                                guild,
                                {
                                    "Tag",
                                    "GuildTag",
                                },
                                ""
                            )
                        ),

                    Score =
                        ZanjiGuildField(
                            rawRow,
                            {
                                "Score",
                                "Value",
                                "WeeklyScore",
                                "WeeklyContribution",
                            },
                            ZanjiGuildField(
                                guild,
                                {
                                    "Score",
                                    "WeeklyScore",
                                    "WeeklyContribution",
                                },
                                0
                            )
                        ),

                    Members =
                        ZanjiGuildField(
                            guild,
                            {
                                "MemberCount",
                                "MembersCount",
                            }
                        ),

                    MaxMembers =
                        ZanjiGuildField(
                            guild,
                            {
                                "MaxMembers",
                                "MemberLimit",
                                "Capacity",
                            }
                        ),

                    IconId =
                        ZanjiGuildField(
                            guild,
                            {
                                "IconId",
                                "GuildIconId",
                                "Icon",
                                "ImageId",
                            },
                            ZanjiGuildField(
                                rawRow,
                                {
                                    "IconId",
                                    "GuildIconId",
                                    "Icon",
                                    "ImageId",
                                }
                            )
                        ),

                    Raw =
                        rawRow,
                }
            end
        end
    end

    table.sort(
        rows,
        function(left, right)

            return (
                tonumber(left.Rank)
                or math.huge
            )
                < (
                    tonumber(right.Rank)
                    or math.huge
                )
        end
    )

    return rows
end

