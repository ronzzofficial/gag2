function ZanjiShopResolvePacket(category)

    local config =
        ZANJI_SHOP_CATEGORIES[category]

    if type(config) ~= "table" then
        return nil
    end

    ZANJI_SHOP_STATE.PacketCache =
        type(ZANJI_SHOP_STATE.PacketCache) == "table"
        and ZANJI_SHOP_STATE.PacketCache
        or {}

    if ZANJI_SHOP_STATE.PacketCache[category] ~= nil then

        return ZANJI_SHOP_STATE.PacketCache[category]
    end

    local networking =
        ZanjiShopRequireModule(
            "SharedModules.Networking"
        )

    local packet =
        type(networking) == "table"
        and networking[config.PacketShop]
        and networking[config.PacketShop][config.PacketName]
        or nil

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        ZANJI_SHOP_STATE.PacketCache[category] =
            false

        return nil
    end

    ZANJI_SHOP_STATE.PacketCache[category] =
        packet

    return packet
end

function ZanjiShopFireBurst(category, itemName, amount)

    local packet =
        ZanjiShopResolvePacket(category)

    if type(packet) ~= "table" then
        return 0
    end

    amount =
        math.clamp(
            math.floor(
                tonumber(amount)
                or 0
            ),
            0,
            tonumber(ZANJI_SHOP_STATE.MaxBurstFires)
            or 120
        )

    local fired =
        0

    local yieldEvery =
        math.max(
            1,
            math.floor(
                tonumber(ZANJI_SHOP_STATE.YieldEvery)
                or 24
            )
        )

    for index = 1, amount do

        local ok =
            pcall(function()

                packet:Fire(
                    itemName
                )
            end)

        if ok == true then

            fired =
                fired + 1
        end

        if index % yieldEvery == 0 then

            task.wait()
        end
    end

    return fired
end

function ZanjiShopIsItemSelected(category, itemName)

    local selection =
        ZanjiShopGetSelection(
            category
        )

    return selection.All == true
