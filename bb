                            result

                        local nameOk, name =
                            pcall(
                                Players.GetNameFromUserIdAsync,
                                Players,
                                userId
                            )

                        username =
                            nameOk
                                and name
                                or raw
                    end
                end

                if not userId
                    or not username
                    or userId == player.UserId
                then
                    recipientBox.Text =
                        ""

                    recipientBox.PlaceholderText =
                        "Recipient not found"

                    addButton.Text =
                        "+ Add"

                    return
                end

                for index, recipient in ipairs(
                    state.Recipients
                ) do
                    if index ~= state.Editing
                        and recipient.UserId == userId
                    then
                        recipientBox.Text =
                            ""

                        recipientBox.PlaceholderText =
                            "Already added"

                        addButton.Text =
                            "+ Add"

                        return
                    end
                end

                local record = {
                    UserId =
                        userId,

                    Name =
                        username,

                    Target =
                        target,
                }

                if state.Editing
                    and state.Recipients[state.Editing]
                then
                    state.Recipients[state.Editing] =
                        record
                else
                    table.insert(
                        state.Recipients,
                        record
                    )
