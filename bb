function ZanjiVisualRefreshGardenFruitESP()

    ZanjiVisualEnsureState()

    if ZANJI_VISUAL_STATE.GardenFruitESP ~= true then

        ZanjiVisualClearGardenFruitESP()

        return false
    end

    local runtime =
        ZanjiVisualGetRuntime()

    ZanjiVisualLoadValueCaches(
        false
    )

    if type(ZanjiFarmPrimeStaticCaches) == "function" then

        pcall(function()

            ZanjiFarmPrimeStaticCaches(
                false
            )
        end)
    end

    local rows =
        ZanjiVisualGardenBuildRows()

    local maxLabels =
        math.clamp(
            math.floor(
                tonumber(runtime.GardenFruitMaxLabels)
                or 160
            ),
            20,
            250
        )

    local touched =
        {}

    local shown =
        0

    for _, row in ipairs(rows) do

        if shown >= maxLabels then
            break
        end

        local label =
            ZanjiVisualGardenEnsureLabel(
                row
            )

        if label then

            label.Adornee =
                row.Adornee

            label.StudsOffset =
                Vector3.zero

            label.StudsOffsetWorldSpace =
                (
                    typeof(row.WorldOffset) == "Vector3"
                    and row.WorldOffset
                    or Vector3.zero
                )
                + Vector3.new(
                    0,
                    0.25,
                    0
                )

            label.MaxDistance =
                tonumber(
                    ZANJI_VISUAL_STATE.GardenFruitMaxDistance
                )
                or 150

            label.Size =
                UDim2.fromOffset(
                    285,
                    #row.Mutations > 0
                    and 44
                    or 28
                )

            local text =
                label:FindFirstChild(
                    "Text"
                )

            if typeof(text) == "Instance"
            and text:IsA("TextLabel") then

                text.Text =
                    ZanjiVisualGardenBuildRichText(
                        row
                    )

                text.TextSize =
                    12

                text.Font =
                    Enum.Font.GothamBold
            end

            label.Enabled =
                true

            touched[row.Key] =
                true

            shown =
                shown + 1
        end
    end

    local stale =
        {}

    for key in pairs(runtime.GardenFruitLabels or {}) do

        if touched[key] ~= true then

            table.insert(
                stale,
                key
            )
        end
    end

    for _, key in ipairs(stale) do

        ZanjiVisualGardenRemoveLabel(
            key
        )
    end

    return true
end

function ZanjiVisualStartGardenFruitESP(reason, skipSave)

    ZanjiVisualEnsureState()

    ZANJI_VISUAL_STATE.GardenFruitESP =
        true

    if skipSave ~= true then

        ZanjiSaveVisualSettings()
    end

    local runtime =
        ZanjiVisualGetRuntime()

    ZanjiVisualLoadValueCaches(
        true
    )

    if runtime.GardenFruitRunning == true then

        ZanjiVisualRefreshGardenFruitESP()

        return true
    end

    local token =
        {}

    runtime.GardenFruitToken =
        token

    runtime.GardenFruitRunning =
        true

    task.spawn(function()

        while runtime.GardenFruitToken == token
        and ZANJI_VISUAL_STATE.GardenFruitESP == true do

            pcall(function()

                ZanjiVisualRefreshGardenFruitESP()
            end)

            task.wait(
                runtime.GardenFruitUpdateDelay
            )
        end

        if runtime.GardenFruitToken == token then

            runtime.GardenFruitRunning =
                false
        end

        if ZANJI_VISUAL_STATE.GardenFruitESP ~= true then

            ZanjiVisualClearGardenFruitESP()
        end
    end)

    ZanjiVisualRefreshGardenFruitESP()

    return true
end

function ZanjiVisualStopGardenFruitESP(reason, skipSave)

    ZanjiVisualEnsureState()

    ZANJI_VISUAL_STATE.GardenFruitESP =
        false

    if skipSave ~= true then

        ZanjiSaveVisualSettings()
    end

    local runtime =
        ZanjiVisualGetRuntime()

    runtime.GardenFruitToken =
        nil

    runtime.GardenFruitRunning =
        false

    ZanjiVisualClearGardenFruitESP()

    return true
end

