function ZanjiGuildNormalizePage(value)

    local text =
        ZanjiCleanText(
            value
        )
        :lower()

    if text:find("member", 1, true) then
        return "Members"
    end

    if text:find("contest", 1, true) then
        return "Contest"
    end

    if text:find("leader", 1, true) then
        return "Leaderboard"
    end

    return "Overview"
end

function ZanjiGuildSetPage(value)

    local previousPage =
        ZANJI_GUILD_STATE.Page

    local page =
        ZanjiGuildNormalizePage(
            value
        )

    ZANJI_GUILD_STATE.Page =
        page

    if type(
        ZANJI_GUILD_RUNTIME.LastPageRefresh
    ) ~= "table" then

        ZANJI_GUILD_RUNTIME.LastPageRefresh =
            {}
    end

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.OverviewBox,
        page == "Overview"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.ActionsBox,
        page == "Overview"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.MembersBox,
        page == "Members"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.SelectedMemberBox,
        page == "Members"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.ContestBox,
        page == "Contest"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.ProgressBox,
        page == "Contest"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.LeaderboardBox,
        page == "Leaderboard"
    )

    ZanjiSetGroupboxVisible(
        ZANJI_GUILD_UI.SelectedGuildBox,
        page == "Leaderboard"
    )

    if ZANJI_GUILD_UI.Tab
    and type(ZANJI_GUILD_UI.Tab.RefreshSides)
        == "function" then

        task.defer(function()

            ZANJI_GUILD_UI.Tab:RefreshSides()
        end)
    end

    ZanjiGuildRefreshUI()

    local lastRefresh =
        ZANJI_GUILD_RUNTIME.LastPageRefresh[page]
        or 0

    if ZANJI_GUILD_RUNTIME.Running == true
    and previousPage ~= page
    and os.clock() - lastRefresh >= 12 then

        ZANJI_GUILD_RUNTIME.LastPageRefresh[page] =
            os.clock()

        task.spawn(function()

            if page == "Overview"
            or page == "Members" then

                ZanjiGuildRefreshSnapshot(
                    true
                )

                ZanjiGuildRefreshPresence(
                    true
                )

            elseif page == "Contest" then

                ZanjiGuildRefreshCompetition(
                    true
                )

                ZanjiGuildRefreshSnapshot(
                    true
                )

                ZanjiGuildRefreshPresence(
                    true
                )

            elseif page == "Leaderboard" then

                ZanjiGuildRefreshLeaderboard(
                    true
                )
            end
        end)
    end
end

function ZanjiGuildRefreshSnapshot(quiet)

    if ZANJI_GUILD_RUNTIME.Busy.Snapshot == true then
        return false
    end

    ZANJI_GUILD_RUNTIME.Busy.Snapshot =
        true

    local ok,
        first,
        second,
        third =
        ZanjiGuildCall(
            "GetMyGuild"
        )

    ZANJI_GUILD_RUNTIME.Busy.Snapshot =
        false

    if ok ~= true then

        if quiet ~= true then

            ZanjiGuildSetStatus(
                "Guild refresh failed: "
                .. tostring(first)
            )
        end

        return false
    end

    local snapshot =
        ZanjiGuildFirstTable(
            first,
            second,
            third
        )

    ZANJI_GUILD_STATE.Snapshot =
        snapshot

    ZANJI_GUILD_RUNTIME.LastSnapshotAt =
        os.clock()

    ZANJI_GUILD_STATE.NameCache[
        LocalPlayer.UserId
    ] =
        LocalPlayer.Name

    ZanjiGuildRefreshUI()

    return snapshot ~= nil
end

