function ZanjiVisualLoadValueCaches(forceRefresh)

    local runtime =
        ZanjiVisualGetRuntime()

    if forceRefresh ~= true
    and runtime.ValueCachesLoaded == true then

        return runtime
    end

    runtime.FruitValueCalc =
        nil

    runtime.SellValueData =
        nil

    runtime.MutationMultipliers =
        {}

    local fruitValueCalc =
        ZanjiShopRequireModule(
            "SharedModules.FruitValueCalc"
        )

    if type(fruitValueCalc) == "function" then

        runtime.FruitValueCalc =
            fruitValueCalc

    elseif type(fruitValueCalc) == "table" then

        runtime.FruitValueCalc =
            fruitValueCalc.Calculate
            or fruitValueCalc.GetValue
            or fruitValueCalc.GetFruitValue
            or fruitValueCalc.Value
    end

    runtime.SellValueData =
        ZanjiShopRequireModule(
            "SharedModules.SellValueData"
        )

    local sharedModules =
        ReplicatedStorage:FindFirstChild(
            "SharedModules"
        )

    local mutationData =
        sharedModules
        and sharedModules:FindFirstChild(
            "MutationData"
        )
        or nil

    if typeof(mutationData) == "Instance" then

        for _, module in ipairs(mutationData:GetChildren()) do

            if module:IsA("ModuleScript") then

                local ok,
                    result =
                    pcall(function()

                        return require(
                            module
                        )
                    end)

                if ok == true
                and type(result) == "table" then

                    local multiplier =
                        tonumber(
                            result.PriceMultiplier
                            or result.SellMultiplier
                            or result.ValueMultiplier
                            or result.Multiplier
                            or result.Boost
                        )

                    if multiplier ~= nil
                    and multiplier > 0 then

                        runtime.MutationMultipliers[module.Name] =
                            multiplier
                    end
                end
            end
        end
    end

    runtime.ValueCachesLoaded =
        true

    return runtime
end

function ZanjiVisualNameKey(value)

    local text =
        ZanjiCleanText(
            value
        )
        :lower()

    text =
        text:gsub(
            "%b[]",
            ""
        )

    text =
        text:gsub(
            "[%s_%-%[%]%(%)%.'\"_/{}]",
            ""
        )

    return text
end

function ZanjiVisualParseKg(value)

    local number =
        tonumber(
            tostring(value or "")
                :match("([%d%.]+)%s*[Kk][Gg]")
        )

    return tonumber(number)
        or 0
end

function ZanjiVisualStripBracketText(value)

    local text =
        ZanjiCleanText(
            value
        )

    text =
        text:gsub(
            "%s*%b[]",
            ""
        )

    text =
        text:gsub(
            "%s+",
            " "
        )

    return ZanjiCleanText(
        text
    )
end

function ZanjiVisualParseBracketMutation(value)

    local text =
        tostring(value or "")

    local bracket =
        text:match(
            "%[([^%]]+)%]"
        )

    bracket =
        ZanjiCleanText(
            bracket
        )

    if bracket == "" then
        return ""
    end

    if bracket:lower():find("kg", 1, true) then
        return ""
    end

    return bracket
end

function ZanjiVisualRoundKg(value)

    value =
        tonumber(value)
        or 0

    if value <= 0 then
        return 0
    end

    return math.floor(
        value * 100 + 0.5
    ) / 100
end

function ZanjiVisualMutationMultiplier(rawMutation)

    local runtime =
        ZanjiVisualLoadValueCaches(
            false
        )

    local multipliers =
        type(runtime.MutationMultipliers) == "table"
        and runtime.MutationMultipliers
        or {}

    rawMutation =
        ZanjiCleanText(
            rawMutation
        )

    if rawMutation == "" then
        return 1
    end

    local multiplier =
        1

    for part in rawMutation:gmatch("[^,%|/;]+") do

        part =
            ZanjiCleanText(
                part
            )

        if part ~= "" then

            for mutationName, mutationMultiplier in pairs(multipliers) do

                if ZanjiVisualNameKey(mutationName) == ZanjiVisualNameKey(part) then

                    multiplier =
                        multiplier
                        * (
                            tonumber(mutationMultiplier)
                            or 1
                        )
                end
            end
        end
    end

    return math.max(
        1,
        multiplier
    )
end

function ZanjiVisualFormatFruitValue(value)

    value =
        math.max(
            0,
            tonumber(value)
            or 0
        )

    if value >= 1000000000 then

        return "$"
            .. string.format(
                "%.1fB",
                value / 1000000000
            )
    end

    if value >= 1000000 then

        return "$"
            .. string.format(
                "%.1fM",
                value / 1000000
            )
    end

    if value >= 1000 then

        return "$"
            .. string.format(
                "%.1fK",
                value / 1000
            ):gsub(
                "%.0K",
                "K"
            )
    end

    return "$"
        .. tostring(
            math.floor(value + 0.5)
        )
end

function ZanjiVisualCalculateFruitValue(tool, row)

    row =
        type(row) == "table"
        and row
        or {}

    local runtime =
        ZanjiVisualLoadValueCaches(
            false
        )

    local value =
        nil

    local fruitValueCalc =
        runtime.FruitValueCalc

    if type(fruitValueCalc) == "function" then

        local unpackFunction =
            table.unpack
            or unpack

        local attempts = {
            {
                row.Name,
                row.SizeMultiplier,
                tool,
                tool,
                tool,
            },

            {
                row.Name,
                row.SizeMultiplier,
                tool,
            },

            {
                row.Name,
                row.SizeMultiplier,
            },

            {
                tool,
            },

            {
                row,
            },
        }

        for _, args in ipairs(attempts) do

            local ok,
                result =
                pcall(function()

                    return fruitValueCalc(
                        unpackFunction(
                            args
                        )
                    )
                end)

            result =
                tonumber(result)

            if ok == true
            and result ~= nil
            and result > 0 then

                value =
                    result

                break
            end
        end
    end

    if value == nil then

        local sellValueData =
            type(runtime.SellValueData) == "table"
            and runtime.SellValueData
            or {}

        local baseValue =
            tonumber(
                sellValueData[row.Name]
            )
            or tonumber(
                sellValueData[
                    ZanjiVisualStripBracketText(
                        row.Name
                    )
                ]
            )
            or 0

        local sizeMultiplier =
            tonumber(row.SizeMultiplier)
            or 1

        sizeMultiplier =
            math.max(
                0.01,
                sizeMultiplier
            )

        value =
            baseValue
            * (
                sizeMultiplier ^ 2.5
            )
    end

    value =
        value
        * ZanjiVisualMutationMultiplier(
            row.RawMutation
        )

    return math.max(
        0,
        math.floor(value + 0.5)
    )
end

function ZanjiVisualReadFruitTool(tool, index)

    if ZanjiSellLooksLikeFruitTool(tool) ~= true then
        return nil
    end

    local attrs =
        ZanjiSellGetToolAttributes(
            tool
        )

    local fruitName =
        ZanjiSellGetToolFruitName(
            tool
        )

    if fruitName == "" then

        fruitName =
            ZanjiVisualStripBracketText(
                tool.Name
            )
    end

    fruitName =
        ZanjiCleanText(
            fruitName
        )

    if fruitName == "" then
        return nil
    end

    local rawMutation =
        ZanjiSellGetRawToolMutation(
            tool
        )

    if rawMutation == "" then

        rawMutation =
            ZanjiVisualParseBracketMutation(
                tool.Name
            )
    end

    local weight =
        ZanjiSellGetToolWeight(
            tool
        )

    if weight <= 0 then

        weight =
            ZanjiVisualParseKg(
                tool.Name
            )
    end

    local sizeMultiplier =
        tonumber(
            attrs.SizeMultiplier
            or attrs.SizeMulti
            or attrs.ScaleMultiplier
            or attrs.ScaleMulti
            or attrs.Scale
            or attrs.SizeScale
        )

    if sizeMultiplier == nil
    or sizeMultiplier <= 0 then

        sizeMultiplier =
            math.max(
                0.01,
                weight
            )
    end

    local row = {
        Tool =
            tool,

        Name =
            fruitName,

        NameKey =
            ZanjiVisualNameKey(
                fruitName
            ),

        RawName =
            tostring(tool.Name or ""),

        RawNameKey =
            ZanjiVisualNameKey(
                tool.Name
            ),

        RawMutation =
            rawMutation,

        Weight =
            ZanjiVisualRoundKg(
                weight
            ),

        WeightKey =
            tostring(
                ZanjiVisualRoundKg(
                    weight
                )
            ),

        SizeMultiplier =
            tonumber(sizeMultiplier)
            or 1,

        Index =
            tonumber(index)
            or 0,
    }

    row.Value =
        ZanjiVisualCalculateFruitValue(
            tool,
            row
        )

    row.ValueText =
        ZanjiVisualFormatFruitValue(
            row.Value
        )

    return row
end

function ZanjiVisualAddFruitRowToMap(map, row)

    if type(row) ~= "table" then
        return false
    end

    local keys = {
        row.NameKey
            .. "|"
            .. row.WeightKey,

        row.RawNameKey
            .. "|"
            .. row.WeightKey,

        row.NameKey,
        row.RawNameKey,
    }

    for _, key in ipairs(keys) do

        key =
            ZanjiCleanText(
                key
            )

        if key ~= "" then

            map[key] =
                map[key]
                or {}

            table.insert(
                map[key],
                row
            )
        end
    end

    return true
end

function ZanjiVisualBuildFruitMaps()

    local map =
        {}

    local index =
        0

    for _, tool in ipairs(ZanjiSellGetFruitTools()) do

        index =
            index + 1

        local row =
            ZanjiVisualReadFruitTool(
                tool,
                index
            )

        if row then

            ZanjiVisualAddFruitRowToMap(
                map,
                row
            )
        end
    end

    return map
end

function ZanjiVisualTakeFruitRow(map, key, used)

    key =
        ZanjiCleanText(
            key
        )

    if key == "" then
        return nil
    end

    local rows =
        map[key]

    if type(rows) ~= "table" then
        return nil
    end

    for _, row in ipairs(rows) do

        if used[row] ~= true then

            used[row] =
                true

            return row
        end
    end

    return nil
end

function ZanjiVisualGetText(instance)

    if typeof(instance) ~= "Instance" then
        return ""
    end

    if instance:IsA("TextLabel")
    or instance:IsA("TextButton")
    or instance:IsA("TextBox") then

        return ZanjiCleanText(
            instance.Text
        )
    end

    return ""
end

function ZanjiVisualFindText(root, matcher)

    if typeof(root) ~= "Instance" then
        return ""
    end

    for _, descendant in ipairs(root:GetDescendants()) do

        local text =
            ZanjiVisualGetText(
                descendant
            )

        if text ~= ""
        and matcher(text) == true then

            return text
        end
    end

    return ""
end

function ZanjiVisualSlotLooksLikeInventoryItem(slot)

    if typeof(slot) ~= "Instance"
    or slot:IsA("GuiObject") ~= true then

        return false
    end

    if slot.Visible ~= true then
        return false
    end

    local blockedNames = {
        Backpack = true,
        Inventory = true,
        ScrollingFrame = true,
        UIGridFrame = true,
        Hotbar = true,
        Search = true,
        Tabs = true,
    }

    if blockedNames[tostring(slot.Name)] == true then
        return false
    end

    local size =
        slot.AbsoluteSize

    if typeof(size) == "Vector2" then

        if size.X < 32
        or size.Y < 32 then

            return false
        end

        -- Real inventory cards are small. Big containers should never get labels.
        if size.X > 180
        or size.Y > 180 then

            return false
        end
    end

    return true
end

function ZanjiVisualReadSlotInfo(slot)

    if ZanjiVisualSlotLooksLikeInventoryItem(slot) ~= true then
        return nil
    end

    local nameText =
        ZanjiVisualFindText(
            slot,
            function(text)

                local lower =
                    text:lower()

                if lower:find("kg", 1, true) then
                    return false
                end

                if text:match("^x%d") then
                    return false
                end

                if text:match("^%$") then
                    return false
                end

                if text == "" then
                    return false
                end

                return true
            end
        )

    local kgText =
        ZanjiVisualFindText(
            slot,
            function(text)

                return text:lower():find(
                    "kg",
                    1,
                    true
                ) ~= nil
            end
        )

    local weight =
        ZanjiVisualRoundKg(
            ZanjiVisualParseKg(
                kgText
            )
        )

    if nameText == ""
    or weight <= 0 then

        return nil
    end

    local cleanName =
        ZanjiVisualStripBracketText(
            nameText
        )

    if cleanName == "" then
        return nil
    end

    return {
        Name =
            cleanName,

        NameKey =
            ZanjiVisualNameKey(
                cleanName
            ),

        RawName =
            nameText,

        RawNameKey =
            ZanjiVisualNameKey(
                nameText
            ),

        Weight =
            weight,

        WeightKey =
            tostring(weight),
    }
end

function ZanjiVisualMatchSlotToFruit(slot, map, used)

    local slotInfo =
        ZanjiVisualReadSlotInfo(
            slot
        )

    if type(slotInfo) ~= "table" then
        return nil
    end

    local keys =
        {}

    if slotInfo.Weight > 0 then

        table.insert(
            keys,
            slotInfo.NameKey
                .. "|"
                .. slotInfo.WeightKey
        )

        table.insert(
            keys,
            slotInfo.RawNameKey
                .. "|"
                .. slotInfo.WeightKey
        )
    end

    table.insert(
        keys,
        slotInfo.NameKey
    )

    table.insert(
        keys,
        slotInfo.RawNameKey
    )

    for _, key in ipairs(keys) do

        local row =
            ZanjiVisualTakeFruitRow(
                map,
                key,
                used
            )

        if row then
            return row
        end
    end

    return nil
end

