function ZanjiFarmNormalizeMutationName(value)

    local text =
        ZanjiFarmCleanMutationName(
            value
        )

    if text == "" then
        return ""
    end

    local cache =
        ZanjiFarmBuildMutationNameCache(
            false
        )

    local map =
        type(cache) == "table"
        and type(cache.Map) == "table"
        and cache.Map
        or {}

    local canonical =
        map[
            ZanjiFarmMutationKey(
                text
            )
        ]

    if canonical ~= nil then
        return canonical
    end

    return text
end

function ZanjiFarmNormalizeMutationSelection(value)

    local raw =
        ZanjiShopSelectionArray(
            value
        )

    if #raw <= 0 then
        return {}
    end

    local validMap =
        ZanjiFarmGetMutationValueMap()

    local output =
        {}

    local seen =
        {}

    for _, mutationName in ipairs(raw) do

        mutationName =
            ZanjiFarmNormalizeMutationName(
                mutationName
            )

        if mutationName ~= ""
        and validMap[mutationName] == true
        and seen[mutationName] ~= true then

            seen[mutationName] =
                true

            table.insert(
                output,
                mutationName
            )
        end
    end

    table.sort(output, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

