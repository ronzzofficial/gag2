function ZanjiAuctionEstimatedServerNow()

    ZanjiAuctionEnsureState()

    local serverNow =
        tonumber(
            ZANJI_SHOP_STATE.AuctionServerNow
        )
        or 0

    local clockAt =
        tonumber(
            ZANJI_SHOP_STATE.AuctionServerClockAt
        )
        or 0

    if serverNow > 0
    and clockAt > 0 then

        return serverNow
            + math.max(
                0,
                os.clock() - clockAt
            )
    end

    local synchronizedTime =
        nil

    pcall(function()

        synchronizedTime =
            workspace:GetServerTimeNow()
    end)

    synchronizedTime =
        tonumber(
            synchronizedTime
        )

    if synchronizedTime ~= nil
    and synchronizedTime > 0 then

        return synchronizedTime
    end

    return os.time()
end

