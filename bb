--==================================================
-- ROLLBACK SYSTEM
--==================================================

function ZanjiRollbackResolvePacket()

    local runtime =
        ZANJI_ROLLBACK_RUNTIME

    if type(runtime.Packet) == "table"
    and type(runtime.Packet.Fire) == "function" then

        return runtime.Packet
    end

    local networking =
        nil

    if type(ZanjiShopRequireModule) == "function" then

        networking =
            ZanjiShopRequireModule(
                "SharedModules.Networking"
            )
    end

    if type(networking) ~= "table" then

        local sharedModules =
            ReplicatedStorage:FindFirstChild(
                "SharedModules"
            )

        local networkingModule =
            sharedModules
            and sharedModules:FindFirstChild(
                "Networking"
            )

        if typeof(networkingModule) == "Instance"
        and networkingModule:IsA("ModuleScript") then

            local success,
                result =
                pcall(function()

                    return require(
                        networkingModule
                    )
                end)

            if success == true
            and type(result) == "table" then

                networking =
                    result
            end
        end
    end

    local packet =
        type(networking) == "table"
        and type(networking.SignTool) == "table"
        and networking.SignTool.SetSignImage
        or nil

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        warn(
            "[ZANJI Rollback] SetSignImage packet is missing."
        )

        return nil
    end

    runtime.Packet =
        packet

    return packet
end

function ZanjiRollbackFire(payload)

    local packet =
        ZanjiRollbackResolvePacket()

    if packet == nil then
        return false
    end

    local success,
        errorMessage =
        pcall(function()

            packet:Fire(
                payload
            )
        end)

    if success ~= true then

        warn(
            "[ZANJI Rollback] "
            .. tostring(errorMessage)
        )
    end

    return success == true
end

function ZanjiRollbackHasAnyOwner()

    local runtime =
        ZANJI_ROLLBACK_RUNTIME

    return runtime.ManualRequested == true
        or runtime.WateringRequested == true
        or runtime.PersistenceRequested == true
end

function ZanjiRollbackRefreshWorker()

    local state =
        ZANJI_ROLLBACK_STATE

    local runtime =
        ZANJI_ROLLBACK_RUNTIME

    if ZanjiRollbackHasAnyOwner() ~= true then

        runtime.Running =
            false

        runtime.Generation +=
            1

        ZanjiRollbackFire(
            ""
        )

        return true
    end

    local packet =
        ZanjiRollbackResolvePacket()

    if packet == nil then

        runtime.Running =
            false

        return false
    end

    if runtime.Running == true then

        return true
    end

    runtime.Running =
        true

    runtime.Generation +=
        1

    local generation =
        runtime.Generation

    task.spawn(function()

        while runtime.Running == true
        and runtime.Generation == generation
        and ZanjiRollbackHasAnyOwner() == true do

            local success =
                ZanjiRollbackFire(
                    string.char(255)
                )

            if success ~= true then

                runtime.Running =
                    false

                runtime.Generation +=
                    1

                break
            end

            local delay =
                10

            if runtime.ManualRequested == true then

                delay =
                    math.min(
                        delay,
                        math.clamp(
                            tonumber(
                                state.FireDelay
                            )
                            or 0.1,
                            0,
                            10
                        )
                    )
            end

            if runtime.WateringRequested == true then

                delay =
                    math.min(
                        delay,
                        math.clamp(
                            tonumber(
                                runtime.WateringFireDelay
                            )
                            or 0.1,
                            0,
                            10
                        )
                    )
            end

            if runtime.PersistenceRequested == true then

                delay =
                    math.min(
                        delay,
                        0.1
                    )
            end

            task.wait(
                delay
            )
        end

        if runtime.Generation == generation then

            runtime.Running =
                false
        end
    end)

    return true
end

function ZanjiRollbackSetOwner(
    owner,
    value
)

    local state =
        ZANJI_ROLLBACK_STATE

    local runtime =
        ZANJI_ROLLBACK_RUNTIME

    value =
        value == true

    if owner == "Manual" then

        runtime.ManualRequested =
            value

        state.Enabled =
            value

    elseif owner == "Watering" then

        runtime.WateringRequested =
            value

    elseif owner == "Persistence" then

        runtime.PersistenceRequested =
            value

    else

        return false
    end

    if ZanjiRollbackHasAnyOwner() == true then

        return ZanjiRollbackRefreshWorker()
    end

    runtime.Running =
        false

    runtime.Generation +=
        1

    ZanjiRollbackFire(
        ""
    )

    return true
end

function ZanjiRollbackStop(reason)

    return ZanjiRollbackSetOwner(
        "Manual",
        false
    )
end

function ZanjiRollbackStart(reason)

    return ZanjiRollbackSetOwner(
        "Manual",
        true
    )
end

function ZanjiRollbackSetEnabled(value)

    return ZanjiRollbackSetOwner(
        "Manual",
        value == true
    )
end

function ZanjiRollbackStopAll(reason)

    local state =
        ZANJI_ROLLBACK_STATE

    local runtime =
        ZANJI_ROLLBACK_RUNTIME

    state.Enabled =
        false

    runtime.ManualRequested =
        false

    runtime.WateringRequested =
        false

    runtime.PersistenceRequested =
        false

    runtime.Running =
        false

    runtime.Generation +=
        1

    ZanjiRollbackFire(
        ""
    )

    return true
end

function ZanjiRollbackSetFireDelay(value)

    ZANJI_ROLLBACK_STATE.FireDelay =
        math.clamp(
            tonumber(value)
            or 0.1,
            0,
            10
        )

    return ZANJI_ROLLBACK_STATE.FireDelay
end

ZANJI_ROLLBACK_RUNTIME.Stop =
    ZanjiRollbackStopAll

