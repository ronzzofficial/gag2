function ZanjiShopRequireModule(path)

    local current =
        ReplicatedStorage

    for part in tostring(path or ""):gmatch("[^%.]+") do

        current =
            current
            and current:FindFirstChild(part)
            or nil
    end

    if typeof(current) ~= "Instance"
    or current:IsA("ModuleScript") ~= true then

        return nil
    end

    local ok,
        result =
        pcall(function()

            return require(
                current
            )
        end)

    if ok ~= true then
        return nil
    end

    return result
end

function ZanjiDataLogOnce(key, ...)

    ZANJI_DATA_STATE =
        type(ZANJI_DATA_STATE) == "table"
        and ZANJI_DATA_STATE
        or {}

    ZANJI_DATA_STATE.Logged =
        type(ZANJI_DATA_STATE.Logged) == "table"
        and ZANJI_DATA_STATE.Logged
        or {}

    key =
