function ZanjiSellPruneRecentFruitIds()

    ZANJI_SHOP_STATE.SellRecentFruitIds =
        type(ZANJI_SHOP_STATE.SellRecentFruitIds) == "table"
        and ZANJI_SHOP_STATE.SellRecentFruitIds
        or {}

    local now =
        os.clock()

    for fruitId, lastAt in pairs(ZANJI_SHOP_STATE.SellRecentFruitIds) do

        if now - (
            tonumber(lastAt)
            or 0
        ) > 6 then

            ZANJI_SHOP_STATE.SellRecentFruitIds[fruitId] =
                nil
        end
    end
end

function ZanjiSellFindToolByFruitId(fruitId)

    fruitId =
        ZanjiCleanText(
            fruitId
        )

    if fruitId == "" then
        return nil
    end

    for _, tool in ipairs(ZanjiSellGetFruitTools()) do

        local toolId =
            ZanjiCleanText(
                ZanjiSellResolveFruitId(
                    tool
                )
            )

        if toolId ~= ""
        and toolId == fruitId then

            return tool
        end
    end

    return nil
end

function ZanjiSellDescribeSkip(tool, fruitId, reason)

    local name =
        typeof(tool) == "Instance"
        and tostring(tool.Name)
        or tostring(fruitId or "unknown")

    return tostring(name)
        .. " skipped: "
        .. tostring(reason or "filter blocked")
end

function ZanjiSellLiveToolStillSafeToSell(fruitId)

    fruitId =
        ZanjiCleanText(
            fruitId
        )

    if fruitId == "" then
        return false, nil, "missing fruit id"
    end

    local tool =
        ZanjiSellFindToolByFruitId(
            fruitId
        )

    if typeof(tool) ~= "Instance"
    or tool.Parent == nil then

        return false, nil, "tool no longer in inventory"
    end

    if ZanjiSellLooksLikeFruitTool(tool) ~= true then

        return false, tool, "not a fruit tool"
    end

    if ZanjiSellPassesFilters(tool) ~= true then

        return false, tool, "live filters blocked"
    end

    if ZanjiSellValueFilterActive() == true then

        local liveValue =
            ZanjiSellGetToolValue(
                tool
            )

        liveValue =
            tonumber(liveValue)

        if liveValue == nil
        or liveValue <= 0 then

            return false, tool, "value missing"
        end

        local threshold =
            ZanjiSellReadValueThreshold(
                ZANJI_SHOP_STATE.SellValueThreshold
                or "0"
            )

        local mode =
            ZanjiSellNormalizeValueMode(
                ZANJI_SHOP_STATE.SellValueMode
                or "Below"
            )

        if mode == "Above"
        and liveValue < threshold then

            return false, tool, "value below threshold"
        end

        if mode ~= "Above"
        and liveValue > threshold then

            return false, tool, "value above threshold"
        end
    end

    return true, tool, "ok"
end

function ZanjiSellQueueFruitTool(tool, reason)

    if ZANJI_SHOP_STATE.AutoSellFruits ~= true then
        return false
    end

    if ZanjiSellIsFilteredMethod(
        ZANJI_SHOP_STATE.SellMethod
    ) ~= true then

        return false
    end

    if ZanjiSellPassesFilters(tool) ~= true then
        return false
    end

    local fruitId =
        ZanjiSellResolveFruitId(
            tool
        )

    if fruitId == "" then
        return false
    end

    local liveSafe =
        ZanjiSellLiveToolStillSafeToSell(
            fruitId
        )

    if liveSafe ~= true then
        return false
    end

    ZanjiSellPruneRecentFruitIds()

    ZANJI_SHOP_STATE.SellRecentFruitIds =
        type(ZANJI_SHOP_STATE.SellRecentFruitIds) == "table"
        and ZANJI_SHOP_STATE.SellRecentFruitIds
        or {}

    local recentAt =
        tonumber(
            ZANJI_SHOP_STATE.SellRecentFruitIds[fruitId]
        )
        or 0

    if recentAt > 0
    and os.clock() - recentAt < 6 then

        return false
    end

    ZANJI_SHOP_STATE.SellQueue =
        type(ZANJI_SHOP_STATE.SellQueue) == "table"
        and ZANJI_SHOP_STATE.SellQueue
        or {}

    ZANJI_SHOP_STATE.SellQueueMap =
        type(ZANJI_SHOP_STATE.SellQueueMap) == "table"
        and ZANJI_SHOP_STATE.SellQueueMap
        or {}

    if ZANJI_SHOP_STATE.SellQueueMap[fruitId] == true then
        return false
    end

    local value,
        valueText =
        ZanjiSellGetToolValue(
            tool
        )

    value =
        tonumber(value)
        or 0

    ZANJI_SHOP_STATE.SellQueueMap[fruitId] =
        true

    table.insert(
        ZANJI_SHOP_STATE.SellQueue,
        {
            Id =
                fruitId,

            Name =
                ZanjiSellGetToolFruitName(
                    tool
                ),

            Weight =
                ZanjiSellGetToolWeight(
                    tool
                ),

            Value =
                value,

            ValueText =
                valueText
                or ZanjiSellFormatValue(
                    value
                ),

            QueuedAt =
                os.clock(),

            ValueMode =
                ZanjiSellNormalizeValueMode(
                    ZANJI_SHOP_STATE.SellValueMode
                    or "Below"
                ),

            ValueThreshold =
                ZanjiSellReadValueThreshold(
                    ZANJI_SHOP_STATE.SellValueThreshold
                    or "0"
                ),

            Reason =
                tostring(reason or "detected"),
        }
    )

    ZanjiSellSortQueue()

    return true
end

function ZanjiSellScanExistingFruitTools(reason)

    if ZANJI_SHOP_STATE.AutoSellFruits ~= true then
        return 0
    end

    if ZanjiSellIsFilteredMethod(
        ZANJI_SHOP_STATE.SellMethod
    ) ~= true then

        return 0
    end

    local queued =
        0

    for _, tool in ipairs(ZanjiSellGetFruitTools()) do

        if ZanjiSellQueueFruitTool(
            tool,
            reason or "scan"
        ) == true then

            queued =
                queued + 1
        end
    end

    return queued
end

function ZanjiSellHookContainer(container, reason)

    if typeof(container) ~= "Instance" then
        return false
    end

    ZANJI_SHOP_STATE.SellConnections =
        type(ZANJI_SHOP_STATE.SellConnections) == "table"
        and ZANJI_SHOP_STATE.SellConnections
        or {}

    local function tryHandle(child, triggerReason)

        if ZANJI_SHOP_STATE.AutoSellFruits ~= true then
            return
        end

        if ZanjiSellIsFilteredMethod(
            ZANJI_SHOP_STATE.SellMethod
        ) == true then

            if ZanjiSellQueueFruitTool(
                child,
                triggerReason
            ) == true then

                ZanjiSellStartWorker()
            end

            return
        end

        if ZanjiSellLooksLikeFruitTool(child) == true then

            ZanjiSellScheduleSellAll(
                triggerReason
            )
        end
    end

    table.insert(
        ZANJI_SHOP_STATE.SellConnections,
        container.ChildAdded:Connect(function(child)

            task.defer(function()

                tryHandle(
                    child,
                    reason or "child added"
                )
            end)

            task.delay(0.12, function()

                tryHandle(
                    child,
                    tostring(reason or "child added")
                    .. " delayed"
                )
            end)

            task.delay(0.35, function()

                tryHandle(
                    child,
                    tostring(reason or "child added")
                    .. " settled"
                )
            end)
        end)
    )

    return true
end

function ZanjiSellStartWatcher()

    if ZANJI_SHOP_STATE.SellWatcherStarted == true then
        return
    end

    ZANJI_SHOP_STATE.SellWatcherStarted =
        true

    ZANJI_SHOP_STATE.SellConnections =
        type(ZANJI_SHOP_STATE.SellConnections) == "table"
        and ZANJI_SHOP_STATE.SellConnections
        or {}

    local backpack =
        LocalPlayer
        and (
            LocalPlayer:FindFirstChildOfClass("Backpack")
            or LocalPlayer:WaitForChild("Backpack", 10)
        )
        or nil

    ZanjiSellHookContainer(
        backpack,
        "backpack"
    )

    ZanjiSellHookContainer(
        LocalPlayer and LocalPlayer.Character,
        "character"
    )

    if LocalPlayer then

        table.insert(
            ZANJI_SHOP_STATE.SellConnections,
            LocalPlayer.CharacterAdded:Connect(function(character)

                task.defer(function()

                    ZanjiSellHookContainer(
                        character,
                        "character"
                    )

                    task.wait(
                        0.25
                    )

                    ZanjiSellScanExistingFruitTools(
                        "character added"
                    )

                    ZanjiSellStartWorker()
                end)
            end)
        )
    end
end

function ZanjiSellSelectedOnce()

    ZanjiSellScanExistingFruitTools(
        "selected pass"
    )

    ZANJI_SHOP_STATE.SellQueue =
        type(ZANJI_SHOP_STATE.SellQueue) == "table"
        and ZANJI_SHOP_STATE.SellQueue
        or {}

    ZANJI_SHOP_STATE.SellQueueMap =
        type(ZANJI_SHOP_STATE.SellQueueMap) == "table"
        and ZANJI_SHOP_STATE.SellQueueMap
        or {}

    ZANJI_SHOP_STATE.SellRecentFruitIds =
        type(ZANJI_SHOP_STATE.SellRecentFruitIds) == "table"
        and ZANJI_SHOP_STATE.SellRecentFruitIds
        or {}

    ZanjiSellSortQueue()

    local fruitsAtOnce =
        ZanjiSellReadFruitsAtOnce(
            ZANJI_SHOP_STATE.FruitsAtOnce
        )

    local batch =
        {}

    while ZANJI_SHOP_STATE.AutoSellFruits == true
    and ZanjiSellIsFilteredMethod(
        ZANJI_SHOP_STATE.SellMethod
    ) == true
    and #ZANJI_SHOP_STATE.SellQueue > 0
    and #batch < fruitsAtOnce do

        local row =
            table.remove(
                ZANJI_SHOP_STATE.SellQueue,
                1
            )

        local fruitId =
            row
            and ZanjiCleanText(row.Id)
            or ""

        if fruitId ~= "" then

            ZANJI_SHOP_STATE.SellQueueMap[fruitId] =
                nil

            local liveSafe,
                liveTool,
                liveReason =
                ZanjiSellLiveToolStillSafeToSell(
                    fruitId
                )

            if liveSafe == true then

                table.insert(
                    batch,
                    {
                        Id =
                            fruitId,

                        Tool =
                            liveTool,
                    }
                )

            elseif type(ZANJI_SHOP_STATE.LastSellSkipPrintAt) ~= "number"
            or os.clock() - ZANJI_SHOP_STATE.LastSellSkipPrintAt >= 1 then

                ZANJI_SHOP_STATE.LastSellSkipPrintAt =
                    os.clock()

                print(
                    "[ZANJI SELL]",
                    ZanjiSellDescribeSkip(
                        liveTool,
                        fruitId,
                        liveReason
                    )
                )
            end
        end
    end

    local launched =
        #batch

    if launched <= 0 then
        return 0
    end

    local completed =
        0

    local sold =
        0

    for _, item in ipairs(batch) do

        task.spawn(function()

            local success =
                false

            if ZANJI_SHOP_STATE.AutoSellFruits == true
            and ZanjiSellIsFilteredMethod(
                ZANJI_SHOP_STATE.SellMethod
            ) == true then

                success =
                    ZanjiSellFirePacket(
                        "SellFruit",
                        item.Id
                    ) == true
            end

            if success == true then

                ZANJI_SHOP_STATE.SellRecentFruitIds[item.Id] =
                    os.clock()

                sold =
                    sold + 1
            end

            completed =
                completed + 1
        end)
    end

    while completed < launched do
        task.wait()
    end

    return sold
end

function ZanjiSellRunOnce()

    if ZANJI_SHOP_STATE.AutoSellFruits ~= true then
        return false
    end

    local method =
        tostring(
            ZANJI_SHOP_STATE.SellMethod
            or "Sell All"
        )

    if ZanjiSellIsFilteredMethod(method) == true then

        ZanjiSellSelectedOnce()

        return true
    end

    local fruitTools =
        ZanjiSellGetFruitTools()

    if #fruitTools > 0 then

        ZanjiSellScheduleSellAll(
            "inventory rescan"
        )
    end

    return true
end

function ZanjiSellStartWorker()

    if ZANJI_SHOP_STATE.SellWorkerRunning == true then
        return
    end

    ZANJI_SHOP_STATE.SellWorkerRunning =
        true

    task.spawn(function()

        while ZANJI_SHOP_STATE.AutoSellFruits == true do

            ZanjiSellRunOnce()

            local filtered =
                ZanjiSellIsFilteredMethod(
                    ZANJI_SHOP_STATE.SellMethod
                )

            local waitTime

            if filtered == true then

                if type(ZANJI_SHOP_STATE.SellQueue) == "table"
                and #ZANJI_SHOP_STATE.SellQueue > 0 then

                    waitTime =
                        0

                else

                    waitTime =
                        math.clamp(
                            tonumber(ZANJI_SHOP_STATE.SelectedScanInterval)
                            or 0.10,
                            0.03,
                            2
                        )
                end

            else

                waitTime =
                    math.clamp(
                        tonumber(ZANJI_SHOP_STATE.SellAllRescanInterval)
                        or 0.50,
                        0.10,
                        5
                    )
            end

            task.wait(
                waitTime
            )
        end

        ZANJI_SHOP_STATE.SellWorkerRunning =
            false
    end)
end

