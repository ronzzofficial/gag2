function ZanjiSniperGetSafeRange(prompt)

    local maxRange =
        12

    if typeof(prompt) == "Instance"
    and prompt:IsA("ProximityPrompt") then

        maxRange =
            tonumber(prompt.MaxActivationDistance)
            or 12
    end

    local padding =
        tonumber(
            ZANJI_SNIPER_RUNTIME.SafeRangePadding
        )
        or 2.15

    return math.clamp(
        maxRange - padding,
        5,
        math.max(5, maxRange - 0.35)
    )
end

function ZanjiSniperDistanceToEntry(entry)

    if type(entry) ~= "table" then
        return math.huge
    end

    local root =
        ZanjiSniperGetCharacterRoot()

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true then

        return math.huge
    end

    local position =
        ZanjiSniperGetPromptPosition(
            entry.Prompt,
            entry.Model
        )

    if typeof(position) ~= "Vector3" then
        return math.huge
    end

    return (
        root.Position
        - position
    ).Magnitude
end

function ZanjiSniperValidateTargetForBuy(entry, filter)

    local refreshed =
        ZanjiSniperRefreshEntry(
            entry
        )

    if type(refreshed) ~= "table" then

        return false,
            nil,
            "target gone"
    end

    if refreshed.Buyable ~= true then

        return false,
            refreshed,
            refreshed.BuyableReason
            or "not buyable"
    end

    if ZanjiSniperEntryMatchesFilter(
        refreshed,
        filter
    ) ~= true then

        return false,
            refreshed,
            "no longer matches"
    end

    return true,
        refreshed,
        "ok"
end

