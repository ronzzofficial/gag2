function ZanjiDevRecorderFinish(
    copyResult,
    reason
)

    local runtime =
        ZANJI_DEV_SUITE_RUNTIME

    if runtime.RecorderActive ~= true then

        ZanjiNotify(
            "ZANJI Dev",
            "Start Test Recorder first.",
