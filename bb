function ZanjiServerFinderReportNow(reason)

    ZANJI_SERVER_FINDER_REPORTER =
        type(ZANJI_SERVER_FINDER_REPORTER) == "table"
        and ZANJI_SERVER_FINDER_REPORTER
        or {}

    local payload =
        ZanjiServerFinderBuildReportPayload()

    local data,
        requestReason =
        ZanjiServerFinderRequestJson(
            "POST",
            ZanjiServerFinderBackendUrl(
                "/report"
            ),
            payload
        )

    ZANJI_SERVER_FINDER_REPORTER.LastReportAt =
        os.time()

    if type(data) == "table"
    and data.ok == true then

        ZANJI_SERVER_FINDER_REPORTER.LastReportStatus =
            data.deleted == true
            and "Deleted empty server"
            or (
                "Reported "
                .. tostring(data.petCount or 0)
                .. " pet(s)"
            )

        return true,
            ZANJI_SERVER_FINDER_REPORTER.LastReportStatus
    end

    ZANJI_SERVER_FINDER_REPORTER.LastReportStatus =
        tostring(requestReason or "report failed")

    return false,
        ZANJI_SERVER_FINDER_REPORTER.LastReportStatus
end

function ZanjiServerFinderReportForRefresh(reason)

    ZANJI_SERVER_FINDER_REPORTER =
        type(ZANJI_SERVER_FINDER_REPORTER) == "table"
        and ZANJI_SERVER_FINDER_REPORTER
        or {}

    if type(ZanjiGetRequestFunction()) ~= "function" then

        ZANJI_SERVER_FINDER_REPORTER.LastReportStatus =
            "request unsupported"

        return false,
            "request unsupported"
    end

    if ZANJI_SERVER_FINDER_REPORTER.RefreshReportRunning == true then

        return false,
            "report already running"
    end

    local nowClock =
        os.clock()

    if nowClock - (
        tonumber(
            ZANJI_SERVER_FINDER_REPORTER.LastRefreshReportClock
        )
        or 0
    ) < 0.85 then

        return false,
            "refresh report cooldown"
    end

    ZANJI_SERVER_FINDER_REPORTER.RefreshReportRunning =
        true

    ZANJI_SERVER_FINDER_REPORTER.LastRefreshReportClock =
        nowClock

    local ok,
        success,
        status =
        pcall(function()

            return ZanjiServerFinderReportNow(
                reason or "refresh"
            )
        end)

    ZANJI_SERVER_FINDER_REPORTER.RefreshReportRunning =
        false

    if ok == true then

        return success == true,
            tostring(status or ZANJI_SERVER_FINDER_REPORTER.LastReportStatus or "reported")
    end

    ZANJI_SERVER_FINDER_REPORTER.LastReportStatus =
        tostring(success or "report failed")

    return false,
        ZANJI_SERVER_FINDER_REPORTER.LastReportStatus
end

function ZanjiServerFinderStartReporter()

    ZANJI_SERVER_FINDER_REPORTER =
        type(ZANJI_SERVER_FINDER_REPORTER) == "table"
        and ZANJI_SERVER_FINDER_REPORTER
        or {}

    if ZANJI_SERVER_FINDER_REPORTER.Running == true then
        return false
    end

    if type(ZanjiGetRequestFunction()) ~= "function" then

        ZANJI_SERVER_FINDER_REPORTER.LastReportStatus =
            "request unsupported"

        return false
    end

    local token =
        {}

    ZANJI_SERVER_FINDER_REPORTER.Token =
        token

    ZANJI_SERVER_FINDER_REPORTER.Running =
        true

    task.spawn(function()

        while ZANJI_SERVER_FINDER_REPORTER.Token == token do

            local interval =
                math.max(
                    3,
                    tonumber(SERVER_FINDER_REPORT_INTERVAL)
                    or 5
                )

            pcall(function()

                local lastReportAt =
                    tonumber(
                        ZANJI_SERVER_FINDER_REPORTER.LastReportAt
                    )
                    or 0

                if os.time() - lastReportAt >= interval then

                    ZanjiServerFinderReportNow(
                        "loop"
                    )
                end
            end)

            task.wait(
                interval
            )
        end

        if ZANJI_SERVER_FINDER_REPORTER.Token == token then

            ZANJI_SERVER_FINDER_REPORTER.Running =
                false
        end
    end)

    return true
end

