function ZanjiSniperBuildPetMaps()

    local values = {
        "Any Pet",
    }

    local seen = {
        ["Any Pet"] = true,
    }

    local displayToKey = {
        ["Any Pet"] = "*",
    }

    local keyToDisplay = {
        ["*"] = "Any Pet",
    }

    local petData =
        ZanjiSniperGetPetData()

    for key, row in pairs(petData) do

        if ZanjiSniperIsPetDataRow(key, row) == true then

            local internalKey =
                ZanjiCleanText(
                    key
                )

            local displayName =
                ZanjiCleanText(
                    row.DisplayName
                    or row.PetName
                    or row.Name
                    or key
                )

            if internalKey ~= ""
            and displayName ~= "" then

                if seen[displayName] ~= true then

                    seen[displayName] =
                        true

                    table.insert(
                        values,
                        displayName
                    )
                end

                displayToKey[displayName] =
                    internalKey

                keyToDisplay[internalKey] =
                    displayName
            end
        end
    end

    table.sort(values, function(a, b)

        if a == "Any Pet" then
            return true
        end

        if b == "Any Pet" then
            return false
        end

        return tostring(a) < tostring(b)
    end)

    if #values <= 1 then

        values = {
            "Any Pet",
            "Raccoon",
        }

        displayToKey["Any Pet"] =
            "*"

        displayToKey.Raccoon =
            "Raccoon"

        keyToDisplay["*"] =
            "Any Pet"

        keyToDisplay.Raccoon =
            "Raccoon"
    end

    ZANJI_SNIPER_STATE.PetDisplayToKey =
        displayToKey

    ZANJI_SNIPER_STATE.PetKeyToDisplay =
        keyToDisplay

    return values,
        displayToKey,
        keyToDisplay
end

