function ZanjiMailDestroyHud(reason)
    local deliveryState =
        ZANJI_MAIL_RUNTIME.DeliveryState

    if type(deliveryState) == "table"
        and deliveryState.Running == true
    then
        deliveryState.Stop =
            true

        if ZANJI_MAIL_RUNTIME.DestroyPending ~= true then
            ZANJI_MAIL_RUNTIME.DestroyPending =
                true

            task.spawn(function()
                local deadline =
                    os.clock() + 15

                while type(ZANJI_MAIL_RUNTIME.DeliveryState) == "table"
                    and ZANJI_MAIL_RUNTIME.DeliveryState.Running == true
                    and os.clock() < deadline
                do
                    task.wait(0.1)
                end

                ZANJI_MAIL_RUNTIME.DestroyPending =
                    false

                ZanjiMailDestroyHud(reason)
            end)
        end

        return false
    end

    local gui =
        ZANJI_MAIL_RUNTIME.Gui

    if typeof(gui) == "Instance" then
        pcall(function()
            gui:Destroy()
        end)
    end

    ZANJI_MAIL_RUNTIME.Gui =
        nil

    ZANJI_MAIL_RUNTIME.Window =
        nil

    ZANJI_MAIL_RUNTIME.DeliveryState =
        nil

    ZANJI_MAIL_RUNTIME.SetMinimized =
        nil

    ZANJI_MAIL_RUNTIME.ApplyScale =
        nil

    ZANJI_MAIL_RUNTIME.UpdateQuota =
        nil

    ZANJI_MAIL_RUNTIME.Status =
        "Closed"

    ZanjiMailRefreshControlUI()

    return true
end

