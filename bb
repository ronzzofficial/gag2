function ZanjiMailHistoryNormalizeIcon(value)
    if type(value) == "number" then
        if value <= 0 then
            return ""
        end

        return "rbxassetid://"
            .. tostring(
                math.floor(value)
            )
    end

    if type(value) ~= "string" then
        return ""
    end

    local result =
        value:gsub("^%s+", "")
            :gsub("%s+$", "")

    if result == "" then
        return ""
    end

    if result:match("^%d+$") then
        return "rbxassetid://"
