            ZANJI_WEBHOOK_STATE.Enabled = false

            ZanjiSaveWebhookSettings()

            ZanjiNotify(
                "Webhook",
                tostring(reason),
                4
            )

            task.defer(function()

                pcall(function()

                    ZANJI_WEBHOOK_UI.EnabledToggle
                        :SetValue(false, true)
                end)
            end)

            return
        end
    end

    ZANJI_WEBHOOK_STATE.Enabled =
        value == true

    ZanjiSaveWebhookSettings()

    if ZANJI_WEBHOOK_STATE.Enabled == true
    and type(
        ZANJI_WEBHOOK_RUNTIME.LastStockResult
    ) == "table" then

        task.defer(function()

            ZanjiWebhookProcessFruitStock(
                ZANJI_WEBHOOK_RUNTIME.LastStockResult
            )
        end)
    end
end)

