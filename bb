        return true
    end

    ZANJI_MAIL_STATE.TrackerUsed =
        math.clamp(
            math.floor(
                tonumber(ZANJI_MAIL_STATE.TrackerUsed)
                    or 0
            ),
            0,
            ZANJI_MAIL_DAILY_LIMIT
        )

    return false
end

