function ZanjiGuildGetOverviewData()

    local root =
        ZanjiGuildSnapshotRoot(
            ZANJI_GUILD_STATE.Snapshot
        )

    if type(root) ~= "table"
    or ZanjiGuildGetGuildId() == "" then

        return nil
    end

    local members =
        ZanjiGuildBuildMembers()

    local online = 0
    local elders = 0
    local weeklySum = 0
    local lifetimeSum = 0

    for _, member in ipairs(members) do

        if member.Online == true then
            online =
                online + 1
        end

        if member.Role == "Elder" then
            elders =
                elders + 1
        end

        weeklySum =
            weeklySum
            + member.Weekly

        lifetimeSum =
            lifetimeSum
            + member.Lifetime
    end

    local localMember =
        ZanjiGuildGetLocalMember()

    return {
        Root = root,

        Id =
            ZanjiGuildGetGuildId(),

        Name =
            ZanjiCleanText(
                ZanjiGuildField(
                    root,
                    {
                        "Name",
                        "GuildName",
                    },
                    "Unnamed Guild"
                )
            ),

        Tag =
            ZanjiCleanText(
                ZanjiGuildField(
                    root,
                    {
                        "Tag",
                        "GuildTag",
                    },
                    ""
                )
            ),

        Description =
            ZanjiCleanText(
                ZanjiGuildField(
                    root,
                    {
                        "Description",
                        "GuildDescription",
                    },
                    ""
                )
            ),

        IconId =
            tonumber(
                ZanjiGuildField(
                    root,
                    {
                        "IconId",
                        "GuildIconId",
                        "Icon",
                    }
                )
            ),

        Role =
            localMember
            and localMember.Role
            or "Member",

        Members =
            #members,

        Capacity =
            tonumber(
                ZanjiGuildField(
                    root,
                    {
                        "MaxMembers",
                        "MemberLimit",
                        "Capacity",
                        "MemberCapacity",
                        "Slots",
                        "SlotCount",
                    }
                )
            ),

        Online =
            online,

        Elders =
            elders,

        Coins =
            ZanjiGuildField(
                root,
                {
                    "GuildCoins",
                    "Coins",
                    "Balance",
                },
                0
            ),

        Weekly =
            ZanjiGuildField(
                root,
                {
                    "WeeklyContribution",
                    "WeeklyContributions",
                    "WeeklyScore",
                },
                weeklySum
            ),

        Lifetime =
            ZanjiGuildField(
                root,
                {
                    "LifetimeContribution",
                    "LifetimeContributions",
                    "TotalContribution",
                },
                lifetimeSum
            ),
    }
end

