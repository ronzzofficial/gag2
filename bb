function ZanjiVisualPositionTotalValueLabel(label, title)

    if typeof(label) ~= "Instance"
    or label:IsA("GuiObject") ~= true
    or typeof(title) ~= "Instance"
    or title:IsA("GuiObject") ~= true then

        return false
    end

    local parent =
        label.Parent

    if typeof(parent) ~= "Instance"
    or parent:IsA("GuiObject") ~= true then

        return false
    end

    local titlePosition =
        title.AbsolutePosition

    local parentPosition =
        parent.AbsolutePosition

    local titleSize =
        title.AbsoluteSize

    local textBounds =
        title.TextBounds

    local x =
        titlePosition.X
        - parentPosition.X
        + math.min(
            titleSize.X - 140,
            textBounds.X + 14
        )

    local y =
        titlePosition.Y
        - parentPosition.Y
        + 1

    label.Position =
        UDim2.fromOffset(
            math.floor(x + 0.5),
            math.floor(y + 0.5)
        )

    label.Size =
        UDim2.fromOffset(
            330,
            math.max(
                36,
                math.floor(titleSize.Y + 0.5)
            )
        )

    label.TextSize =
        math.clamp(
            tonumber(title.TextSize)
            or 32,
            26,
            36
        )

    label.ZIndex =
        (
            tonumber(title.ZIndex)
            or 1
        )
        + 80

    return true
end

function ZanjiVisualRefreshTotalValueLabel()

    ZanjiVisualEnsureState()

    if ZANJI_VISUAL_STATE.FruitTotalValue ~= true then

        ZanjiVisualClearTotalValueLabel()

        return false
    end

    local title =
        ZanjiVisualGetInventoryTitleLabel()

    if typeof(title) ~= "Instance"
    or ZanjiVisualTitleAllowsTotalValue(title) ~= true then

        local runtime =
            ZanjiVisualGetRuntime()

        if typeof(runtime.TotalValueLabel) == "Instance" then

            runtime.TotalValueLabel.Visible =
                false
        end

        return false
    end

    local _count,
        total =
        ZanjiVisualCalculateTotalFruitValue()

    local label =
        ZanjiVisualEnsureTotalValueLabel(
            title
        )

    if not label then
        return false
    end

    label.Text =
        '<font color="#EAEAEA">|</font> <font color="#39FF14">'
        .. ZanjiVisualFormatTotalFruitValue(
            total
        )
        .. '</font>'

    label.Visible =
        true

    ZanjiVisualPositionTotalValueLabel(
        label,
        title
    )

    return true
end

function ZanjiVisualRefreshFruitValueOverlay()

    ZanjiVisualEnsureState()

    if ZANJI_VISUAL_STATE.FruitValueOverlay ~= true then

        ZanjiVisualClearAllFruitValueLabels()

        return false
    end

    local runtime =
        ZanjiVisualGetRuntime()

    local fruitMap =
        ZanjiVisualBuildFruitMaps()

    local touched =
        {}

    for _, root in ipairs(ZanjiVisualGetSlotRoots(false)) do

        local used =
            {}

        local slots =
            root:GetChildren()

        for _, slot in ipairs(slots) do

            if typeof(slot) == "Instance"
            and slot:IsA("GuiObject") then

                local row =
                    ZanjiVisualMatchSlotToFruit(
                        slot,
                        fruitMap,
                        used
                    )

                if row then

                    local label =
                        ZanjiVisualEnsureSlotLabel(
                            slot
                        )

                    if label then

                        label.Text =
                            tostring(row.ValueText)

                        label.Visible =
                            true

                        runtime.Labels[slot] =
                            label

                        touched[slot] =
                            true
                    end

                else

                    if runtime.Labels[slot] ~= nil
                    or slot:FindFirstChild("ZanjiFruitValueSlotText") then

                        ZanjiVisualRemoveSlotLabel(
                            slot
                        )
                    end
                end
            end
        end
    end

    for slot, label in pairs(runtime.Labels) do

        if touched[slot] ~= true
        or typeof(slot) ~= "Instance"
        or slot.Parent == nil
        or typeof(label) ~= "Instance"
        or label.Parent == nil then

            ZanjiVisualRemoveSlotLabel(
                slot
            )
        end
    end

    return true
end

function ZanjiVisualAnyInventoryOverlayEnabled()

    ZanjiVisualEnsureState()

    return ZANJI_VISUAL_STATE.FruitValueOverlay == true
        or ZANJI_VISUAL_STATE.FruitTotalValue == true
end

function ZanjiVisualStartInventoryOverlayWorker(reason)

    ZanjiVisualEnsureState()

    local runtime =
        ZanjiVisualGetRuntime()

    ZanjiVisualLoadValueCaches(
        false
    )

    if runtime.Running == true then

        if ZANJI_VISUAL_STATE.FruitValueOverlay == true then

            ZanjiVisualRefreshFruitValueOverlay()
        end

        if ZANJI_VISUAL_STATE.FruitTotalValue == true then

            ZanjiVisualRefreshTotalValueLabel()
        end

        return true
    end

    local token =
        {}

    runtime.Token =
        token

    runtime.Running =
        true

    task.spawn(function()

        while runtime.Token == token
        and ZanjiVisualAnyInventoryOverlayEnabled() == true do

            if ZANJI_VISUAL_STATE.FruitValueOverlay == true then

                pcall(function()

                    ZanjiVisualRefreshFruitValueOverlay()
                end)
            end

            if ZANJI_VISUAL_STATE.FruitTotalValue == true then

                pcall(function()

                    ZanjiVisualRefreshTotalValueLabel()
                end)
            end

            task.wait(
                runtime.UpdateDelay
            )
        end

        if runtime.Token == token then

            runtime.Running =
                false
        end

        if ZANJI_VISUAL_STATE.FruitValueOverlay ~= true then

            ZanjiVisualClearAllFruitValueLabels()
        end

        if ZANJI_VISUAL_STATE.FruitTotalValue ~= true then

            ZanjiVisualClearTotalValueLabel()
        end
    end)

    return true
end

function ZanjiVisualStopInventoryOverlayWorkerIfIdle()

    if ZanjiVisualAnyInventoryOverlayEnabled() == true then
        return false
    end

    local runtime =
        ZanjiVisualGetRuntime()

    runtime.Token =
        nil

    runtime.Running =
        false

    return true
end

