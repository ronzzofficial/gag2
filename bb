    local runtime =
        ZanjiThemeDataToRuntime(
            draft
        )

    for key, value in pairs(
        runtime
    ) do

        Library.Scheme[
            key
        ] =
            value
    end

    Library.ThemeName =
        ZANJI_THEME_STATE.ActiveName

    Library.IsLightTheme =
        false

    Library:UpdateColorsUsingRegistry()

    if type(ZANJI_SHOP_STATE) == "table" then

