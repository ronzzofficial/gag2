function ZanjiAuctionFindCapturedLot(
    value,
    visited,
    depth
)

    if type(value) ~= "table" then
        return nil
    end

    visited =
        type(visited) == "table"
        and visited
        or {}

    if visited[value] == true then
        return nil
    end

    visited[value] =
        true

    local lotId =
        tostring(
            rawget(value, "lotId")
            or rawget(value, "LotId")
            or ""
        )

    if lotId:match(
        "^auction:%d+:%d+$"
    )
    and tonumber(
        rawget(value, "startPrice")
        or rawget(value, "StartPrice")
    ) ~= nil then

        return value
    end

    depth =
        tonumber(depth)
        or 0

    if depth <= 0 then
        return nil
    end

    local cursor =
        nil

    local inspected =
        0

    while inspected < 300 do

        local ok,
            key,
            child =
            pcall(
                next,
                value,
                cursor
            )

        if ok ~= true
        or key == nil then

            break
        end

        cursor =
            key

        inspected +=
            1

        if type(child) == "table" then

            local found =
                ZanjiAuctionFindCapturedLot(
                    child,
                    visited,
                    depth - 1
                )

            if type(found) == "table" then

                return found
            end
        end
    end

    return nil
end

function ZanjiAuctionCollectPassiveLots()

    local lotsById =
        {}

    if type(getconnections) ~= "function" then
        return {}
    end

    local auctionGui =
        ZanjiAuctionFindAuctionGui()

    if typeof(auctionGui) ~= "Instance" then
        return {}
    end

    for _, object in ipairs(
        auctionGui:GetDescendants()
    ) do

        if object:IsA("GuiButton")
        and tostring(object.Name) == "BuyButton" then

            local signal =
                nil

            pcall(function()

                signal =
                    object.Activated
            end)

            if signal ~= nil then

                local ok,
                    connections =
                    pcall(
                        getconnections,
                        signal
                    )

                if ok == true
                and type(connections) == "table" then

                    for _, connection in ipairs(connections) do

                        local callback =
                            nil

                        pcall(function()

                            callback =
                                connection.Function
                                or connection.Callback
                        end)

                        local upvalues =
                            ZanjiAuctionGetCallbackUpvalues(
                                callback
                            )

                        if type(upvalues) == "table" then

                            local lot =
                                ZanjiAuctionFindCapturedLot(
                                    upvalues,
                                    {},
                                    6
                                )

                            if type(lot) == "table" then

                                local lotId =
                                    tostring(
                                        lot.lotId
                                        or lot.LotId
                                        or ""
                                    )

                                if lotId ~= "" then

                                    lotsById[lotId] =
                                        lot
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local lots =
        {}

    for _, lot in pairs(lotsById) do

        lots[#lots + 1] =
            lot
    end

    table.sort(lots, function(a, b)

        return (
            ZanjiAuctionExtractSlot(
                a.lotId
                or a.LotId
            )
            or 999
        ) < (
            ZanjiAuctionExtractSlot(
                b.lotId
                or b.LotId
            )
            or 999
        )
    end)

    return lots
end

function ZanjiAuctionPassiveBootstrap(force)

    ZanjiAuctionEnsureState()

    local nowClock =
        os.clock()

    local previousScan =
        tonumber(
            ZANJI_SHOP_STATE.AuctionPassiveScanAt
        )
        or 0

    if force ~= true
    and nowClock - previousScan < 2 then

        return false
    end

    ZANJI_SHOP_STATE.AuctionPassiveScanAt =
        nowClock

    local lots =
        ZanjiAuctionCollectPassiveLots()

    if #lots < 5 then
        return false
    end

    local cycleCounts =
        {}

    local bestCycle =
        nil

    local bestCount =
        0

    for _, lot in ipairs(lots) do

        local lotId =
            tostring(
                lot.lotId
                or lot.LotId
                or ""
            )

        local cycle =
            ZanjiAuctionExtractCycle(
                lotId
            )

        if cycle ~= nil then

            cycleCounts[cycle] =
                (
                    cycleCounts[cycle]
                    or 0
                )
                + 1

            if cycleCounts[cycle] > bestCount then

                bestCycle =
                    cycle

                bestCount =
                    cycleCounts[cycle]
            end
        end
    end

    if bestCycle == nil
    or bestCount < 5 then

        return false
    end

    local serverNow =
        ZanjiAuctionEstimatedServerNow()

    local rollInterval =
        tonumber(
            ZANJI_SHOP_STATE.AuctionRollIntervalSeconds
        )
        or 1800

    local expectedCycle =
        math.floor(
            serverNow / rollInterval
        ) * rollInterval

    if bestCycle ~= expectedCycle then

        return false
    end

    if tonumber(
        ZANJI_SHOP_STATE.AuctionManifestCycle
    ) == bestCycle
    and #ZANJI_SHOP_STATE.AuctionManifest >= bestCount then

        return true
    end

    local applied =
        ZanjiAuctionApplyManifestPayload(
            {
                manifest = {
                    lots =
                        lots,
                },

                rollWindowUnix =
                    bestCycle,

                rollIntervalSeconds =
                    rollInterval,

                serverNow =
                    serverNow,
            },
            "Current auction"
        )

    if applied == true then

        ZanjiAuctionSetStatus(
            "Auctions loaded"
        )

        return true
    end

    return false
end

