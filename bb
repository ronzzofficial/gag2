end

function ZanjiMergeAutomationRecoverHeldPlant()

    local recovery =
        ZANJI_MERGE_AUTOMATION_RUNTIME.Recovery

    if type(recovery) ~= "table" then
        return true
    end

    if ZanjiMergeAutomationFindPlantById(
        recovery.PlantId
    ) then

        ZANJI_MERGE_AUTOMATION_RUNTIME.Recovery =
            nil

        return true
    end

    ZanjiMergeAutomationSetStatus(
        "Recovering potted plant",
        "Placing it back at the saved position."
    )

    local placed,
        reason =
        ZanjiMergeAutomationPlacePlant(
            recovery.PlantId,
            recovery.Position,
            recovery.RotationDegrees
        )

    if placed == true then

        ZANJI_MERGE_AUTOMATION_RUNTIME.Recovery =
            nil

        return true
    end

    return false,
        reason
end

function ZanjiMergeAutomationResolveEclipseTarget()

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local target =
        ZanjiMergeAutomationFindPlantById(
            runtime.EclipseTargetId
        )

    if target
    and ZanjiFarmPlantKey(
        ZanjiMergeAutomationPlantName(target)
    ) == ZanjiFarmPlantKey("Eclipse Bloom") then

        return target
    end

    target =
        ZanjiMergeAutomationFindPlantByName(
            "Eclipse Bloom",
            true
        )
        or ZanjiMergeAutomationFindPlantByName(
            "Eclipse Bloom",
            false
        )

    if target then

        runtime.EclipseTargetId =
            ZanjiFarmReadPlantId(
                target
            )
    end

    return target
end

function ZanjiMergeAutomationRunEclipseCycle(token)

    local recovered,
        recoveryReason =
        ZanjiMergeAutomationRecoverHeldPlant()

    if recovered ~= true then

        return false,
            recoveryReason
    end

    local plant =
        ZanjiMergeAutomationResolveEclipseTarget()

    if not plant then

        if ZanjiMergeAutomationFindPottedTool(
            "Eclipse Bloom"
        ) then

            return false,
                "Place your potted Eclipse Bloom in the garden once so its position can be captured."
        end

        return false,
            "No planted Eclipse Bloom was found."
    end

    if ZanjiFarmInstanceReady(plant) ~= true then

        if ZANJI_MERGE_AUTOMATION_STATE.AutoWatering ~= true then

            return false,
                "Enable Auto Watering to finish growing the Eclipse Bloom."
        end

        local grown,
            growReason =
            ZanjiMergeAutomationGrowPlant(
                plant,
                token
            )

        if grown ~= true then

            return false,
                growReason
        end

        plant =
            ZanjiMergeAutomationResolveEclipseTarget()

        if not plant then

            return false,
                "Eclipse Bloom disappeared after growing."
        end
    end

    if ZANJI_MERGE_AUTOMATION_STATE.AutoWatering ~= true then

        return false,
            "Enable Auto Watering; every Eclipse cycle needs one watering-can use."
    end

    ZanjiMergeAutomationSetStatus(
        "Preparing Eclipse Bloom",
        "Potting the fully grown plant."
    )

    local potted,
        pottedPlantOrReason =
        ZanjiMergeAutomationPotPlant(
            plant
        )

    if potted ~= true then

        return false,
            pottedPlantOrReason
    end

    plant =
        pottedPlantOrReason

    ZanjiMergeAutomationSetStatus(
        "Triggering Eclipse",
        "Using one "
            .. ZanjiMergeAutomationNormalizeCan(
                ZANJI_MERGE_AUTOMATION_STATE.WateringCan
            )
            .. "."
    )

    local watered,
        waterReason =
        ZanjiMergeAutomationWaterOnce(
            plant
        )

    if watered ~= true then

        return false,
            waterReason
    end

    local position,
        pivot =
        ZanjiMergeAutomationPlantPosition(
            plant
        )

    if not position
    or typeof(pivot) ~= "CFrame" then

        return false,
            "Could not save the Eclipse Bloom placement."
    end

    local _,
        yawRadians =
        pivot:ToOrientation()

    local plantId =
        ZanjiFarmReadPlantId(
            plant
        )

    ZANJI_MERGE_AUTOMATION_RUNTIME.Recovery = {
        PlantId =
            plantId,

        Position =
            position,

        RotationDegrees =
            math.deg(
                yawRadians
            ),
    }

    ZanjiMergeAutomationSetStatus(
        "Cycling Eclipse Bloom",
        "Picking up and placing the pot back."
    )

    local pickedUp,
        pickupReason =
        ZanjiMergeAutomationPickUpPlant(
            plant
        )

    if pickedUp ~= true then

        ZANJI_MERGE_AUTOMATION_RUNTIME.Recovery =
            nil

        return false,
            pickupReason
    end

    local placed,
        placedPlantOrReason =
        ZanjiMergeAutomationPlacePlant(
            plantId,
            position,
            math.deg(
                yawRadians
            )
        )

    if placed ~= true then

        return false,
            placedPlantOrReason
    end

    ZANJI_MERGE_AUTOMATION_RUNTIME.Recovery =
        nil

    ZANJI_MERGE_AUTOMATION_RUNTIME.EclipseTargetId =
        plantId

    ZANJI_MERGE_AUTOMATION_RUNTIME.Cycles =
        (
            ZANJI_MERGE_AUTOMATION_RUNTIME.Cycles
            or 0
        )
        + 1

    ZanjiMergeAutomationSetStatus(
        "Eclipse cycle complete",
        "Waiting "
            .. tostring(
                ZanjiMergeAutomationReadDelay(
                    ZANJI_MERGE_AUTOMATION_STATE.LoopDelay
                )
            )
            .. " second(s)."
    )

    return true,
        placedPlantOrReason
end

function ZanjiMergeAutomationPlantSelectionMap(selection)

    local map =
        {}

    for _, plantName in ipairs(selection or {}) do

        plantName =
            ZanjiCleanText(
                plantName
            )

        if plantName ~= "" then

            map[plantName] =
                true
        end
    end

    return map
end

function ZanjiMergeAutomationNormalizePlantSelection(
    value,
    displayToPlant,
    allValue
)

    local output =
        {}

    local seen =
        {}

    for _, selectedValue in ipairs(
        ZanjiMergeAutomationSelectionArray(
            value
        )
    ) do

        local plantName =
            type(displayToPlant) == "table"
            and displayToPlant[selectedValue]
            or nil

        plantName =
            ZanjiCleanText(
                plantName
                or selectedValue:gsub(
                    "%s+%([^)]*%)$",
                    ""
                )
            )

        if plantName == allValue then

            return {
                allValue,
            }
        end

        if plantName ~= ""
        and seen[plantName] ~= true then

            seen[plantName] =
                true

            table.insert(
                output,
                plantName
            )
        end
    end

    table.sort(output, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

function ZanjiMergeAutomationSelectionAllows(
    selection,
    plantName,
    allValue
)

    local map =
        ZanjiMergeAutomationPlantSelectionMap(
            selection
        )

    if map[allValue] == true then
        return true
    end

    return map[
        ZanjiCleanText(
            plantName
        )
    ] == true
end

function ZanjiMergeAutomationGetOwnedPlantsSorted()

    local plantsFolder =
        ZanjiMergeAutomationGetPlantsFolder()

    local plants =
        {}

    if typeof(plantsFolder) ~= "Instance" then
        return plants
    end

    for _, plant in ipairs(
        plantsFolder:GetChildren()
    ) do

        if ZanjiAutoTrowelOwnsPlant(
            plant,
            plantsFolder
        ) == true then

            table.insert(
                plants,
                plant
            )
        end
    end

    table.sort(plants, function(a, b)

        local aName =
            ZanjiMergeAutomationPlantName(
                a
            )

        local bName =
            ZanjiMergeAutomationPlantName(
                b
            )

        if aName ~= bName then

            return tostring(aName):lower()
                < tostring(bName):lower()
        end

        return tostring(
            ZanjiFarmReadPlantId(a)
        ) < tostring(
            ZanjiFarmReadPlantId(b)
        )
    end)

    return plants
end

function ZanjiMergeAutomationBuildPlantDropdownValues()

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local counts =
        {}

    local function ensureRow(plantName)

        plantName =
            ZanjiCleanText(
                plantName
            )

        if plantName == ""
        or plantName == "Unknown"
        or plantName == "All Plants"
        or plantName == "All Potted Plants" then

            return nil
        end

        counts[plantName] =
            counts[plantName]
            or {
                Ready = 0,
                Unpotted = 0,
                Potted = 0,
            }

        return counts[plantName]
    end

    for _, plant in ipairs(
        ZanjiMergeAutomationGetOwnedPlantsSorted()
    ) do

        local plantName =
            ZanjiMergeAutomationPlantName(
                plant
            )

        local row =
            ensureRow(
                plantName
            )

        if row then

            if ZanjiMergeAutomationIsPotted(
                plant
            ) == true then

                row.Potted =
                    row.Potted + 1
            else

                row.Unpotted =
                    row.Unpotted + 1

                if ZanjiFarmInstanceReady(
                    plant
                ) == true then

                    row.Ready =
                        row.Ready + 1
                end
            end
        end
    end

    for _, plantName in ipairs(
        ZANJI_MERGE_AUTOMATION_STATE.SelectedPotPlants
        or {}
    ) do

        ensureRow(
            plantName
        )
    end

    for _, plantName in ipairs(
        ZANJI_MERGE_AUTOMATION_STATE.SelectedPickupPlants
        or {}
    ) do

        ensureRow(
            plantName
        )
    end

    local names =
        {}

    for plantName in pairs(counts) do

        table.insert(
            names,
            plantName
        )
    end

    table.sort(names, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    runtime.PotDisplayToPlant = {
        ["All Plants"] =
            "All Plants",
    }

    runtime.PotPlantToDisplay = {
        ["All Plants"] =
            "All Plants",
    }

    runtime.PickupDisplayToPlant = {
        ["All Potted Plants"] =
            "All Potted Plants",
    }

    runtime.PickupPlantToDisplay = {
        ["All Potted Plants"] =
            "All Potted Plants",
    }

    local potValues = {
        "All Plants",
    }

    local pickupValues = {
        "All Potted Plants",
    }

    for _, plantName in ipairs(names) do

        local row =
            counts[plantName]

        local potDisplay =
            plantName
            .. " ("
            .. tostring(row.Ready)
            .. " ready / "
            .. tostring(row.Unpotted)
            .. ")"

        local pickupDisplay =
            plantName
            .. " ("
            .. tostring(row.Potted)
            .. " potted)"

        runtime.PotDisplayToPlant[potDisplay] =
            plantName

        runtime.PotPlantToDisplay[plantName] =
            potDisplay

        runtime.PickupDisplayToPlant[pickupDisplay] =
            plantName

        runtime.PickupPlantToDisplay[plantName] =
            pickupDisplay

        table.insert(
            potValues,
            potDisplay
        )

        table.insert(
            pickupValues,
            pickupDisplay
        )
    end

    return potValues,
        pickupValues
end

function ZanjiMergeAutomationGetSelectedPlantDisplays(
    selection,
    plantToDisplay
)

    local output =
        {}

    for _, plantName in ipairs(selection or {}) do

        local display =
            type(plantToDisplay) == "table"
            and plantToDisplay[plantName]
            or nil

        if display then

            table.insert(
                output,
                display
            )
        end
    end

    return output
end

function ZanjiMergeAutomationRefreshPlantDropdowns(forceRefresh)

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local ui =
        ZANJI_MERGE_AUTOMATION_UI

    local potValues,
        pickupValues =
        ZanjiMergeAutomationBuildPlantDropdownValues()

    local potSelected =
        ZanjiMergeAutomationGetSelectedPlantDisplays(
            ZANJI_MERGE_AUTOMATION_STATE.SelectedPotPlants,
            runtime.PotPlantToDisplay
        )

    local pickupSelected =
        ZanjiMergeAutomationGetSelectedPlantDisplays(
            ZANJI_MERGE_AUTOMATION_STATE.SelectedPickupPlants,
            runtime.PickupPlantToDisplay
        )

    local signature =
        table.concat(
            potValues,
            "\31"
        )
        .. "\30"
        .. table.concat(
            pickupValues,
            "\31"
        )
        .. "\30"
        .. table.concat(
            potSelected,
            "\31"
        )
        .. "\30"
        .. table.concat(
            pickupSelected,
            "\31"
        )

    if forceRefresh ~= true
    and signature == runtime.PlantListSignature then

        return false
    end

    runtime.PlantListSignature =
        signature

    runtime.UpdatingPlantLists =
        true

    local function refreshDropdown(
        dropdown,
        values,
        selected
    )

        if type(dropdown) ~= "table" then
            return
        end

        pcall(function()

            if type(dropdown.SetValues) == "function" then

                dropdown:SetValues(
                    values
                )

            elseif type(dropdown.SetItems) == "function" then

                dropdown:SetItems(
                    values
                )
            end
        end)

        pcall(function()

            if type(dropdown.SetValue) == "function" then

                dropdown:SetValue(
                    selected
                )
            end
        end)
    end

    refreshDropdown(
        ui.PotPlantsDropdown,
        potValues,
        potSelected
    )

    refreshDropdown(
        ui.PickupPlantsDropdown,
        pickupValues,
        pickupSelected
    )

    runtime.UpdatingPlantLists =
        false

    return true
end

function ZanjiMergeAutomationSetSelectedPotPlants(value)

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    ZANJI_MERGE_AUTOMATION_STATE.SelectedPotPlants =
        ZanjiMergeAutomationNormalizePlantSelection(
            value,
            runtime.PotDisplayToPlant,
            "All Plants"
        )

    runtime.PlantListSignature =
        nil

    ZanjiSaveFarmSettings()
    ZanjiMergeAutomationRefreshPlantDropdowns(true)
    ZanjiMergeAutomationWake()

    return ZANJI_MERGE_AUTOMATION_STATE.SelectedPotPlants
end

