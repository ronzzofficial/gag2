end

function ZanjiDailyDealRunUseAll(source)

    ZanjiDailyDealEnsureState()

    source =
        tostring(source or "manual")

    if ZANJI_SHOP_STATE.DailyDealManualBusy == true then

        ZanjiDailyDealSetStatus(
            "Busy"
        )

        return false,
            "busy"
    end

    ZANJI_SHOP_STATE.DailyDealManualBusy =
        true

    local success =
        false

    local reason =
        "unknown"

    local ok,
        err =
        pcall(function()

            local ready,
                readyReason,
                context =
                ZanjiDailyDealEvaluate(
                    source == "auto"
                    and "auto"
                    or "manual"
                )

            if ready ~= true then

                reason =
                    tostring(readyReason or "not ready")

                return
            end

            ZanjiDailyDealSetStatus(
                "Ready → selling"
            )

            local beforeMoney =
                type(ZanjiSniperReadSheckles) == "function"
                and ZanjiSniperReadSheckles()
                or nil

            local result,
                fireOk,
                fireReason =
                ZanjiDailyDealFireNpcPacket(
                    "UseDailyDealAll"
                )

            task.wait(
                0.25
            )

            local afterMoney =
                type(ZanjiSniperReadSheckles) == "function"
                and ZanjiSniperReadSheckles()
                or nil

            local moneyDelta =
                beforeMoney ~= nil
                and afterMoney ~= nil
                and afterMoney - beforeMoney
                or 0

            result =
                type(result) == "table"
                and result
                or {}

            local soldCount =
                tonumber(result.SoldCount)
                or 0

            local sellPrice =
                tonumber(result.SellPrice)
                or moneyDelta
                or 0

            if fireOk == true
            and (
                result.Success == true
                or soldCount > 0
                or moneyDelta > 0
            ) then

                success =
                    true

                reason =
                    "sold"

                ZanjiDailyDealSetLastText(
                    "Last: Sold "
                    .. tostring(soldCount)
                    .. " for "
                    .. ZanjiDailyDealFormatMoney(
                        sellPrice
                    )
                )

                if ZANJI_SHOP_STATE.DailyDealAutoDisable == true then

                    ZANJI_SHOP_STATE.AutoDailyDealAll =
                        false

                    ZANJI_SHOP_STATE.DailyDealToken =
                        nil

                    ZANJI_SHOP_STATE.DailyDealWorkerRunning =
                        false

                    ZanjiSaveShopSettings()

                    ZanjiDailyDealSyncAutoToggle()
                end

                ZanjiDailyDealSetStatus(
                    "Sold "
                    .. tostring(soldCount)
                    .. " for "
                    .. ZanjiDailyDealFormatMoney(
                        sellPrice
                    )
                )

                if type(ZanjiNotify) == "function" then

                    ZanjiNotify(
                        "ZANJI Daily Deal",
                        "Sold "
                        .. tostring(soldCount)
                        .. " fruit(s) for "
                        .. ZanjiDailyDealFormatMoney(sellPrice)
                        .. ".",
                        4
                    )
                end

            else

                reason =
                    tostring(fireReason or "sale failed")

                ZanjiDailyDealSetStatus(
                    "Failed: "
                    .. reason
                )

                ZanjiDailyDealSetLastText(
                    "Last: failed"
                )
            end
        end)

    if ok ~= true then

        reason =
            tostring(err)

        ZanjiDailyDealSetStatus(
            "Error: "
            .. reason
        )
    end

    ZANJI_SHOP_STATE.DailyDealManualBusy =
        false

    return success,
        reason
end

