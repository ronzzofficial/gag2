function ZanjiSellPassesSelectedMap(map, itemName)

    itemName =
        ZanjiCleanText(
            itemName
        )

    if type(map) ~= "table" then
        return true
    end

    local hasAny =
        false

    for _ in pairs(map) do

        hasAny =
            true

        break
    end

    if hasAny ~= true then
        return true
    end

    if map.All == true then
        return true
    end

    return itemName ~= ""
        and map[itemName] == true
end

function ZanjiSellPassesFilters(tool)

    if ZanjiSellLooksLikeFruitTool(tool) ~= true then
        return false
    end

    if ZANJI_SHOP_STATE.UseSellFilters ~= true then
        return true
    end

    local fruitMap =
        ZanjiSellSelectedMap(
            ZANJI_SHOP_STATE.SellFruits
        )

    local rarityMap =
        ZanjiSellSelectedMap(
            ZANJI_SHOP_STATE.SellRarities
        )

    local mutationMap =
        ZanjiSellSelectedMap(
            ZANJI_SHOP_STATE.SellMutations
        )

    local variantMap =
        ZanjiSellSelectedMap(
            ZANJI_SHOP_STATE.SellVariants
        )

    local protectMutationMap =
        ZanjiSellSelectedMap(
            ZANJI_SHOP_STATE.ProtectMutations
        )

    local protectVariantMap =
        ZanjiSellSelectedMap(
            ZANJI_SHOP_STATE.ProtectVariants
        )

    local fruitName =
        ZanjiSellGetToolFruitName(
            tool
        )

    local rarity =
        ZanjiSellGetToolRarity(
            tool
        )

    local mutation =
        ZanjiSellGetToolMutation(
            tool
        )

    local variant =
        ZanjiSellGetToolVariant(
            tool
        )

    if protectMutationMap[mutation] == true then
        return false
    end

    if protectVariantMap[variant] == true then
        return false
    end

    if ZanjiSellPassesSelectedMap(fruitMap, fruitName) ~= true then
        return false
    end

    if ZanjiSellPassesSelectedMap(rarityMap, rarity) ~= true then
        return false
    end

    if ZanjiSellPassesSelectedMap(mutationMap, mutation) ~= true then
        return false
    end

    if ZanjiSellPassesSelectedMap(variantMap, variant) ~= true then
        return false
    end

    local weight =
        ZanjiSellGetToolWeight(
            tool
        )

    local minWeight =
        ZanjiSellReadWeightSetting(
            ZANJI_SHOP_STATE.MinWeightKg
        )

    local maxWeight =
        ZanjiSellReadWeightSetting(
            ZANJI_SHOP_STATE.MaxWeightKg
        )

    if minWeight > 0
    and weight < minWeight then

        return false
    end

    if maxWeight > 0
    and weight > maxWeight then

        return false
    end

    if ZanjiSellPassesValueFilter(
        tool
    ) ~= true then

        return false
    end

    return true
end

function ZanjiSellGetFruitTools()

    local fruits =
        {}

    local roots = {
        LocalPlayer
        and LocalPlayer.Character
        or nil,

        LocalPlayer
        and LocalPlayer:FindFirstChildOfClass("Backpack")
        or nil,
    }

    for _, root in ipairs(roots) do

        if typeof(root) == "Instance" then

            for _, child in ipairs(root:GetChildren()) do

                if ZanjiSellLooksLikeFruitTool(child) == true then

                    table.insert(
                        fruits,
                        child
                    )
                end
            end
        end
    end

    table.sort(fruits, function(a, b)

        return tostring(a.Name) < tostring(b.Name)
    end)

    return fruits
end

