function ZanjiServerGetMemoryCounts()

    local state =
        ZanjiServerNormalizeState()

    local failedCount =
        0

    if type(ZanjiServerPruneFailedServers) == "function" then
        ZanjiServerPruneFailedServers()
    end

    for _ in pairs(state.FailedServers or {}) do

        failedCount =
            failedCount + 1
    end

