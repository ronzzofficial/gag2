function ZanjiSniperEntryMatchesFilter(entry, filter)

    if type(entry) ~= "table"
    or type(filter) ~= "table"
    or filter.Enabled == false then

        return false
    end

    if entry.Buyable ~= true then
        return false
    end

    if ZanjiSniperIsHandled(entry) == true then
        return false
    end

    if ZanjiSniperIsFailedCooling(entry) == true then
        return false
    end

    local entryPet =
        ZanjiSniperPetAliasKey(
            entry.PetKey
            or entry.Pet
        )

    local filterPetKey =
        ZanjiCleanText(
            filter.PetKey
            or ZanjiSniperResolvePetKey(
                filter.Pet
            )
        )

    local filterPet =
        ZanjiSniperPetAliasKey(
            filterPetKey ~= ""
            and filterPetKey
            or filter.Pet
        )

    if filterPetKey ~= "*"
    and filterPet ~= "*"
    and entryPet ~= filterPet then

        return false
    end

    local maxPrice =
        tonumber(filter.MaxPrice)
        or 0

    local entryPrice =
        tonumber(entry.Price)
        or 0

    if maxPrice > 0
    and entryPrice > maxPrice then

        return false
    end

    if ZanjiSniperSelectionHasAny(filter.Sizes) ~= true
    and ZanjiSniperSelectionContains(filter.Sizes, entry.Size) ~= true then

        return false
    end

    if ZanjiSniperSelectionHasAny(filter.Variants) ~= true
    and ZanjiSniperSelectionContains(filter.Variants, entry.Variant) ~= true then

        return false
    end

    return true
end

