function ZanjiServerFinderReadSingleValue(value)

    if type(value) ~= "table" then

        return ZanjiCleanText(
            value
        )
    end

    for key, enabled in pairs(value) do

        if enabled == true then

            return ZanjiCleanText(
                key
            )
        end
    end

    return ZanjiCleanText(
        value[1]
    )
end

function ZanjiServerFinderTargetSelectionList(value, anyLabel)

    local values =
        {}

    if type(value) == "table" then

        values =
            ZanjiServerFinderSelectionValues(
                value
            )

    else

        local text =
            ZanjiCleanText(
                value
            )

        if text ~= "" then

            values[1] =
                text
        end
    end

    anyLabel =
        ZanjiCleanText(
            anyLabel
        )

    for _, item in ipairs(values) do

        local lower =
            ZanjiCleanText(
                item
            )
            :lower()

        if lower == "any"
        or lower == "all"
        or lower == anyLabel:lower() then

            return {
                "Any",
            }
        end
    end

    local output =
        {}

    local seen =
        {}

    for _, item in ipairs(values) do

        local text =
            ZanjiCleanText(
                item
            )

        local key =
            text:lower()

        if text ~= ""
        and seen[key] ~= true then

            seen[key] =
                true

            table.insert(
                output,
                text
            )
        end
    end

    if #output == 0 then

        return {
            "Any",
        }
    end

    table.sort(output, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

