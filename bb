function ZanjiLoadingStartAutoSkip(reason)

    ZANJI_LOADING_SKIP_STATE =
        type(ZANJI_LOADING_SKIP_STATE) == "table"
        and ZANJI_LOADING_SKIP_STATE
        or {}

    if ZANJI_LOADING_SKIP_STATE.Running == true then
        return false
    end

    ZANJI_LOADING_SKIP_STATE.Running =
        true

    ZANJI_LOADING_SKIP_STATE.ClickedSkip =
        false

    ZANJI_LOADING_SKIP_STATE.PressedFinal =
        false

    ZANJI_LOADING_SKIP_STATE.LogsPrinted =
        0

    local token =
        {}

    ZANJI_LOADING_SKIP_STATE.Token =
        token

    local startedAt =
        os.clock()

    ZanjiLoadingLog(
        "started",
        tostring(reason or "startup")
    )

    task.spawn(function()

        while ZANJI_LOADING_SKIP_STATE.Token == token
        and os.clock() - startedAt <= 75 do

            local skipPrompt =
                ZanjiLoadingGetSkipPrompt()

            if ZANJI_LOADING_SKIP_STATE.ClickedSkip ~= true
            and ZanjiLoadingSkipPromptReady(skipPrompt) == true then

                ZanjiLoadingClickSkip(
                    skipPrompt
                )
            end

            local counterPrompt =
                ZanjiLoadingGetCounterPrompt()

            if ZanjiLoadingFullyLoaded(counterPrompt) == true then

                if ZANJI_LOADING_SKIP_STATE.PressedFinal ~= true then

                    ZanjiLoadingPressFinal(
                        counterPrompt
                    )
                end

                task.wait(
                    1
                )

                ZANJI_LOADING_SKIP_STATE.Token =
                    nil

                break
            end

            if ZANJI_LOADING_SKIP_STATE.ClickedSkip == true
            and ZanjiLoadingGetWorkspaceLoadingGui() == nil then

                ZANJI_LOADING_SKIP_STATE.Token =
                    nil

                break
            end

            task.wait(
                0.05
            )
        end

        if ZANJI_LOADING_SKIP_STATE.Token == token then

            ZANJI_LOADING_SKIP_STATE.Token =
                nil

            ZanjiLoadingLog(
                "timeout",
                "clickedSkip="
                    .. tostring(ZANJI_LOADING_SKIP_STATE.ClickedSkip),
                "pressedFinal="
                    .. tostring(ZANJI_LOADING_SKIP_STATE.PressedFinal)
            )
        end

        ZANJI_LOADING_SKIP_STATE.Running =
            false
    end)

    return true
end

