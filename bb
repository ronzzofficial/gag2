function ZanjiLivePetsReadVariant(ref, model)

    local raw =
        ZanjiLivePetsReadAttr(
            ref,
            {
                "PetType",
                "Type",
                "Variant",
                "PetVariant",
                "Mutation",
                "WildPetType",
            }
        )

