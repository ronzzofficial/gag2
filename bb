            ZANJI_DAILY_DEAL_LIVE_RUNTIME.LastResult =
                "Live: error"

            warn(
                "[ZANJI DAILY DEAL LIVE]",
                tostring(success)
            )

            return
        end

        return success,
            reason
    end)

    return true
end

function ZanjiDailyDealLiveResolveWait(stockResult)

    stockResult =
        type(stockResult) == "table"
        and stockResult
        or {}

    local nextRestockAt =
        ZanjiDailyDealLiveResolveNextRestockAt(
            stockResult
        )

    if nextRestockAt <= 0 then

        return 30
    end

    local seconds =
        nextRestockAt
        - ZanjiDailyDealLiveServerNow()
        + 1

    if seconds <= 0 then

        return 1
    end

    return math.max(
        1,
        seconds
    )
end

function ZanjiDailyDealSetNextWait(seconds)

    ZANJI_DAILY_DEAL_RUNTIME.NextWait =
        math.clamp(
            tonumber(seconds)
            or 10,
            3,
            60
        )

    return ZANJI_DAILY_DEAL_RUNTIME.NextWait
end

function ZanjiDailyDealGetNextWait()

    return math.clamp(
        tonumber(ZANJI_DAILY_DEAL_RUNTIME.NextWait)
        or 10,
        3,
        60
    )
end

function ZanjiDailyDealEvaluate(mode)

    ZanjiDailyDealEnsureState()

    mode =
        tostring(mode or "check")

    ZanjiDailyDealSetNextWait(
        10
    )

    if mode == "auto"
    and ZanjiDailyDealTextBoxFocused() == true then

        ZanjiDailyDealSetStatus(
            "Paused while typing"
        )

        ZanjiDailyDealSetNextWait(
            3
        )

        return false,
            "typing"
    end

    local settingsOk,
        settings =
        ZanjiDailyDealValidateSettings()

    if settingsOk ~= true then

        ZanjiDailyDealSetStatus(
            "⚠️ "
            .. tostring(settings)
        )

        ZanjiDailyDealSetNextWait(
            3
        )

        return false,
            tostring(settings)
    end

    if mode ~= "check" then

        local blocked =
            ZanjiDailyDealOtherSystemBlocked()

        if blocked ~= "" then

            ZanjiDailyDealSetStatus(
                "Blocked: "
                .. blocked
            )

            ZanjiDailyDealSetNextWait(
                8
            )

            return false,
                blocked
        end
    end

    ZanjiDailyDealSetStatus(
        "Checking stock..."
    )

    local stockResult,
        stockOk,
        stockReason =
        ZanjiDailyDealFireFruitStockRequest()

    if stockOk ~= true
    or type(stockResult) ~= "table"
    or type(stockResult.entries) ~= "table" then

        ZanjiDailyDealSetStatus(
            "Stock check failed"
        )

        ZanjiDailyDealSetStockText(
            "Stock: "
            .. tostring(stockReason or "missing")
        )

        return false,
            "stock failed"
    end

    if type(ZanjiDailyDealLiveHandleStockResult)
    == "function" then

        ZanjiDailyDealLiveHandleStockResult(
            stockResult,
            mode
        )

    else

        ZanjiDailyDealSendLiveReportAsync(
            stockResult,
            mode
        )
    end

    local best,
        triggerReason =
        ZanjiDailyDealFindBestTrigger(
            stockResult.entries
        )

    if best == nil then

        ZanjiDailyDealSetStatus(
            tostring(triggerReason)
        )

        ZanjiDailyDealSetStockText(
            "Stock: no trigger fruit"
        )

        return false,
            tostring(triggerReason)
    end

    ZanjiDailyDealSetStockText(
        "Stock: "
        .. tostring(best.StockName)
        .. " X"
        .. ZanjiDailyDealFormatDecimal(best.Multiplier)
        .. " / Need X"
        .. ZanjiDailyDealFormatDecimal(settings.MinStockMultiplier)
    )

    if tonumber(best.Multiplier) < tonumber(settings.MinStockMultiplier) then

        ZanjiDailyDealSetStatus(
            "Waiting stock X"
            .. ZanjiDailyDealFormatDecimal(settings.MinStockMultiplier)
        )

        local waitSeconds =
            30

        if tonumber(stockResult.nextRefreshUnix)
        and tonumber(stockResult.server_now_unix) then

            waitSeconds =
                tonumber(stockResult.nextRefreshUnix)
                - tonumber(stockResult.server_now_unix)
        end

        ZanjiDailyDealSetNextWait(
            waitSeconds
        )

        return false,
            "stock too low"
    end

    local boost,
        boostText =
        ZanjiDailyDealReadFriendBoost()

    if boost < settings.MinFriendBoost then

        ZanjiDailyDealSetStatus(
            "Waiting boost "
            .. ZanjiDailyDealFormatDecimal(settings.MinFriendBoost)
            .. "%"
        )

        ZanjiDailyDealSetNextWait(
            20
        )

        return false,
            "boost too low"
    end

    ZanjiDailyDealSetStatus(
        "Checking availability..."
    )

    local checkResult,
        checkOk,
        checkReason =
        ZanjiDailyDealFireNpcPacket(
            "CheckDailyDeal"
        )

    if checkOk ~= true
    or type(checkResult) ~= "table" then

        ZanjiDailyDealSetStatus(
            "Daily check failed"
        )

        return false,
            tostring(checkReason or "check failed")
    end

    if checkResult.Available ~= true then

        local remaining =
            tonumber(checkResult.TimeRemaining)
            or 0

        ZanjiDailyDealSetStatus(
            "Cooldown "
            .. ZanjiDailyDealFormatDuration(
                remaining
            )
        )

        ZanjiDailyDealSetPreviewText(
            "Preview: skipped, cooldown"
        )

        ZanjiDailyDealSetNextWait(
            remaining
        )

        return false,
            "cooldown"
    end

    ZanjiDailyDealSetStatus(
        "Checking preview..."
    )

    local preview,
        previewOk,
        previewReason =
        ZanjiDailyDealFireNpcPacket(
            "PreviewSellAll"
        )

    if previewOk ~= true
    or type(preview) ~= "table" then

        ZanjiDailyDealSetStatus(
            "Preview failed"
        )

        ZanjiDailyDealSetPreviewText(
            "Preview: "
            .. tostring(previewReason or "failed")
        )

        return false,
            "preview failed"
    end

    local fruitCount =
        tonumber(preview.FruitCount)
        or 0

    local expectedDaily,
        baseValue,
        dailyMultiplier =
        ZanjiDailyDealExpectedValue(
            preview
        )

    ZanjiDailyDealSetPreviewText(
        "Preview: "
        .. tostring(fruitCount)
        .. " fruits | Inv "
        .. ZanjiDailyDealFormatMoney(
            baseValue
        )
        .. " → Daily "
        .. ZanjiDailyDealFormatMoney(
            expectedDaily
        )
    )

    if fruitCount <= 0 then

        ZanjiDailyDealSetStatus(
            "Preview has no fruit"
        )

        return false,
            "no preview fruit"
    end

    if settings.MinInventoryValue > 0
    and baseValue < settings.MinInventoryValue then

        ZanjiDailyDealSetStatus(
            "Inventory too low"
        )

        ZanjiDailyDealSetNextWait(
            20
        )

        return false,
            "inventory too low"
    end

    if settings.MinValue > 0
    and expectedDaily < settings.MinValue then

        ZanjiDailyDealSetStatus(
            "Daily payout too low"
        )

        ZanjiDailyDealSetNextWait(
            20
        )

        return false,
            "daily payout too low"
    end

    ZanjiDailyDealSetStatus(
        "Ready"
    )

    return true,
        "ready",
        {
            Settings =
                settings,

            Stock =
                stockResult,

            Best =
                best,

            FriendBoost =
                boost,

            FriendBoostText =
                boostText,

            Check =
                checkResult,

            Preview =
                preview,

            ExpectedDaily =
                expectedDaily,

            BaseValue =
                baseValue,

            DailyMultiplier =
                dailyMultiplier,
        }
end

