function ZanjiPetInventoryEscapeRichText(value)

    return tostring(value or "")
        :gsub("&", "&amp;")
        :gsub("<", "&lt;")
        :gsub(">", "&gt;")
        :gsub('"', "&quot;")
        :gsub("'", "&apos;")
end

function ZanjiPetInventoryScanRows()

    local sharedModules =
        ReplicatedStorage:FindFirstChild(
            "SharedModules"
        )

    local petModulesObject =
        sharedModules
        and sharedModules:FindFirstChild(
            "PetModules"
        )
        or nil

    if typeof(petModulesObject) ~= "Instance"
    or petModulesObject:IsA("ModuleScript") ~= true then

        return {}
    end

    local requireOk,
        petModules =
        pcall(
            require,
            petModulesObject
        )

    if requireOk ~= true
    or type(petModules) ~= "table" then

        return {}
    end

    local petCatalog =
        {}

    local function prettyPetName(value)

        local text =
            ZanjiCleanText(
                value
            )
            :gsub("_", " ")
            :gsub("(%l)(%u)", "%1 %2")
            :gsub("(%u)(%u%l)", "%1 %2")

        return ZanjiCleanText(
            text
        )
    end

    local function addCatalogAlias(
        alias,
        catalogEntry
    )

        alias =
            ZanjiSniperPetAliasKey(
                alias
            )

        if alias == "" then
            return
        end

        petCatalog[alias] =
            catalogEntry
    end

    for moduleKey, moduleData in pairs(
        petModules
    ) do

        if type(moduleKey) == "string"
        and type(moduleData) == "table" then

            local displayName =
                ZanjiCleanText(
                    moduleData.DisplayName
                    or moduleData.Name
                    or ""
                )

            if displayName == "" then

                displayName =
                    prettyPetName(
                        moduleKey
                    )
            end

            local catalogEntry = {
                Key =
                    moduleKey,

                Name =
                    displayName,
            }

            addCatalogAlias(
                moduleKey,
                catalogEntry
            )

            addCatalogAlias(
                moduleData.AssetName,
                catalogEntry
            )

            addCatalogAlias(
                displayName,
                catalogEntry
            )
        end
    end

    local grouped =
        {}

    local seenTools =
        {}

    local roots = {
        LocalPlayer
        and LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )
        or nil,

        LocalPlayer
        and LocalPlayer.Character
        or nil,
    }

    for _, root in ipairs(roots) do

        if typeof(root) == "Instance" then

            for _, tool in ipairs(
                root:GetChildren()
            ) do

                if tool:IsA("Tool")
                and seenTools[tool] ~= true then

                    seenTools[tool] =
                        true

                    local rawPetName =
                        ZanjiCleanText(
                            tool:GetAttribute(
                                "Pet"
                            )
                            or ""
                        )

                    local petId =
                        ZanjiCleanText(
                            tool:GetAttribute(
                                "PetId"
                            )
                            or ""
                        )

                    if rawPetName ~= ""
                    and petId ~= "" then

                        local catalogEntry =
                            petCatalog[
                                ZanjiSniperPetAliasKey(
                                    rawPetName
                                )
                            ]

                        if type(catalogEntry) == "table" then

                            local petName =
                                catalogEntry.Name

                            local sizeName =
                                ZanjiSniperNormalizeSizeName(
                                    ZanjiSniperReadLiveSize(
                                        tool,
                                        nil
                                    )
                                )

                            if sizeName == "Normal" then

                                local lowerToolName =
                                    tostring(tool.Name or "")
                                        :lower()

                                if lowerToolName:match(
                                    "^huge%s+"
                                )
                                or lowerToolName:match(
                                    "^mega%s+"
                                ) then

                                    sizeName =
                                        "Huge"

                                elseif lowerToolName:match(
                                    "^big%s+"
                                ) then

                                    sizeName =
                                        "Big"
                                end
                            end

                            local variantName =
                                ZanjiSniperNormalizeVariantName(
                                    ZanjiSniperReadLiveVariant(
                                        tool,
                                        nil
                                    )
                                )

                            local groupKey =
                                ZanjiSniperPetAliasKey(
                                    petName
                                )
                                .. "|"
                                .. ZanjiSniperPetAliasKey(
                                    sizeName
                                )
                                .. "|"
                                .. ZanjiSniperPetAliasKey(
                                    variantName
                                )

                            local group =
                                grouped[groupKey]

                            if type(group) ~= "table" then

                                group = {
                                    Key =
                                        groupKey,

                                    Name =
                                        petName,

                                    Size =
                                        sizeName,

                                    Variant =
                                        variantName,

                                    Amount =
                                        0,
                                }

                                grouped[groupKey] =
                                    group
                            end

                            group.Amount +=
                                1
                        end
                    end
                end
            end
        end
    end

    local rows =
        {}

    for _, group in pairs(grouped) do

        local details =
            {}

        if group.Size ~= ""
        and group.Size ~= "Normal"
        and group.Size ~= "Any" then

            table.insert(
                details,
                group.Size
            )
        end

        if group.Variant ~= ""
        and group.Variant ~= "Normal"
        and group.Variant ~= "Any" then

            table.insert(
                details,
                group.Variant
            )
        end

        table.insert(
            rows,
            {
                Key =
                    group.Key,

                Name =
                    group.Name,

                Details =
                    table.concat(
                        details,
                        " · "
                    ),

                Size =
                    group.Size,

                Variant =
                    group.Variant,

                Amount =
                    group.Amount,
            }
        )
    end

    local sizeOrder = {
        Normal =
            1,

        Big =
            2,

        Huge =
            3,
    }

    table.sort(rows, function(a, b)

        local nameA =
            tostring(a.Name or "")
                :lower()

        local nameB =
            tostring(b.Name or "")
                :lower()

        if nameA ~= nameB then
            return nameA < nameB
        end

        local sizeA =
            sizeOrder[a.Size]
            or 50

        local sizeB =
            sizeOrder[b.Size]
            or 50

        if sizeA ~= sizeB then
            return sizeA < sizeB
        end

        return tostring(a.Variant or "")
            < tostring(b.Variant or "")
    end)

    return rows
end

function ZanjiPetInventoryBuildSignature(rows)

    local parts =
        {}

    for _, row in ipairs(rows or {}) do

        table.insert(
            parts,
            tostring(row.Key or "")
            .. ":"
            .. tostring(row.Amount or 0)
        )
    end

    return table.concat(
        parts,
        "|"
    )
end

function ZanjiPetInventoryApplyListStyle(list)

    if type(list) ~= "table" then
        return
    end

    for _, row in ipairs(
        list.Rows
        or {}
    ) do

        if row.KeyLabel then

            row.KeyLabel.Font =
                Enum.Font.GothamBold

            row.KeyLabel.TextSize =
                14

            row.KeyLabel.TextTransparency =
                0

            row.KeyLabel.TextXAlignment =
                Enum.TextXAlignment.Left
        end

        if row.ValueLabel then

            row.ValueLabel.Font =
                Enum.Font.GothamBold

            row.ValueLabel.TextSize =
                14

            row.ValueLabel.TextTransparency =
                0

            row.ValueLabel.TextXAlignment =
                Enum.TextXAlignment.Right
        end
    end
end

function ZanjiPetInventoryRefreshUI(force)

    local rows =
        ZanjiPetInventoryScanRows()

    ZANJI_PET_INVENTORY_RUNTIME.LastRows =
        rows

    ZANJI_PET_INVENTORY_RUNTIME.LastRefreshAt =
        os.clock()

    ZANJI_PET_INVENTORY_RUNTIME.RefreshQueued =
        false

    local list =
        ZANJI_PET_INVENTORY_UI.List

    if type(list) ~= "table"
    or type(list.SetRows) ~= "function" then

        return rows
    end

    local signature =
        ZanjiPetInventoryBuildSignature(
            rows
        )

    if force ~= true
    and signature
        == ZANJI_PET_INVENTORY_RUNTIME.LastSignature then

        return rows
    end

    ZANJI_PET_INVENTORY_RUNTIME.LastSignature =
        signature

    local renderedRows =
        {}

    if #rows <= 0 then

        table.insert(
            renderedRows,
            {
                Key =
                    '<font color="#8E95A5">'
                    .. "No pets in inventory."
                    .. "</font>",

                Value =
                    "",
            }
        )

    else

        for _, row in ipairs(rows) do

            local leftText =
                '<font color="#F2F4F8">'
                .. ZanjiPetInventoryEscapeRichText(
                    row.Name
                )
                .. "</font>"

            if row.Details ~= "" then

                leftText =
                    leftText
                    .. '<font color="#8E95A5">'
                    .. " · "
                    .. ZanjiPetInventoryEscapeRichText(
                        row.Details
                    )
                    .. "</font>"
            end

            table.insert(
                renderedRows,
                {
                    Key =
                        leftText,

                    Value =
                        '<font color="#FF2F68">'
                        .. "×"
                        .. tostring(row.Amount)
                        .. "</font>",
                }
            )
        end
    end

    list:SetRows(
        renderedRows
    )

    ZanjiPetInventoryApplyListStyle(
        list
    )

    return rows
end

function ZanjiPetInventoryIsPetTool(instance)

    if typeof(instance) ~= "Instance"
    or instance:IsA("Tool") ~= true then

        return false
    end

    local petName =
        ZanjiCleanText(
            instance:GetAttribute(
                "Pet"
            )
            or ""
        )

    local petId =
        ZanjiCleanText(
            instance:GetAttribute(
                "PetId"
            )
            or ""
        )

    return petName ~= ""
        and petId ~= ""
end

function ZanjiPetInventoryScheduleRefresh()

    ZANJI_PET_INVENTORY_RUNTIME.RefreshQueued =
        true
end

function ZanjiPetInventoryDisconnect()

    for _, connection in ipairs(
        ZANJI_PET_INVENTORY_RUNTIME.Connections
        or {}
    ) do

        pcall(function()

            connection:Disconnect()
        end)
    end

    ZANJI_PET_INVENTORY_RUNTIME.Connections =
        {}

    ZANJI_PET_INVENTORY_RUNTIME.ConnectedRoots =
        {}
end

function ZanjiPetInventoryStop(reason)

    ZANJI_PET_INVENTORY_RUNTIME.Token =
        nil

    ZANJI_PET_INVENTORY_RUNTIME.Running =
        false

    ZanjiPetInventoryDisconnect()

    return true
end

function ZanjiPetInventoryStart()

    if ZANJI_PET_INVENTORY_RUNTIME.Running == true then

        ZanjiPetInventoryStop(
            "restart"
        )
    end

    ZANJI_PET_INVENTORY_RUNTIME.Running =
        true

    ZANJI_PET_INVENTORY_RUNTIME.LastSignature =
        ""

    local token =
        {}

    ZANJI_PET_INVENTORY_RUNTIME.Token =
        token

    local function addConnection(connection)

        if connection ~= nil then

            table.insert(
                ZANJI_PET_INVENTORY_RUNTIME.Connections,
                connection
            )
        end
    end

    local function connectRoot(root)

        if typeof(root) ~= "Instance"
        or ZANJI_PET_INVENTORY_RUNTIME.ConnectedRoots[root] == true then

            return
        end

        ZANJI_PET_INVENTORY_RUNTIME.ConnectedRoots[root] =
            true

        addConnection(
            root.ChildAdded:Connect(function(child)

                if ZanjiPetInventoryIsPetTool(
                    child
                ) == true then

                    ZanjiPetInventoryScheduleRefresh()
                end
            end)
        )

        addConnection(
            root.ChildRemoved:Connect(function(child)

                if ZanjiPetInventoryIsPetTool(
                    child
                ) == true then

                    ZanjiPetInventoryScheduleRefresh()
                end
            end)
        )
    end

    local function connectCurrentRoots()

        if not LocalPlayer then
            return
        end

        connectRoot(
            LocalPlayer.Character
        )

        connectRoot(
            LocalPlayer:FindFirstChildOfClass(
                "Backpack"
            )
        )
    end

    connectCurrentRoots()

    if LocalPlayer then

        addConnection(
            LocalPlayer.CharacterAdded:Connect(function(character)

                connectRoot(
                    character
                )

                ZanjiPetInventoryScheduleRefresh()
            end)
        )

        addConnection(
            LocalPlayer.ChildAdded:Connect(function(child)

                if child:IsA("Backpack") then

                    connectRoot(
                        child
                    )

                    ZanjiPetInventoryScheduleRefresh()
                end
            end)
        )
    end

    ZANJI_PET_INVENTORY_RUNTIME.LastRefreshAt =
        0

    ZANJI_PET_INVENTORY_RUNTIME.RefreshQueued =
        true

    ZanjiPetInventoryRefreshUI(
        true
    )

    task.spawn(function()

        while ZANJI_PET_INVENTORY_RUNTIME.Token == token do

            connectCurrentRoots()

            local lowEnd =
                ZanjiLowEndModeEnabled()

            local dirtyInterval =
                lowEnd == true
                and 0.75
                or 0.15

            local safetyInterval =
                lowEnd == true
                and 15
                or 5

            local elapsed =
                os.clock()
                - (
                    tonumber(
                        ZANJI_PET_INVENTORY_RUNTIME.LastRefreshAt
                    )
                    or 0
                )

            local dirtyReady =
                ZANJI_PET_INVENTORY_RUNTIME.RefreshQueued == true
                and elapsed >= dirtyInterval

            local safetyReady =
                elapsed >= safetyInterval

            if dirtyReady
            or safetyReady then

                ZanjiPetInventoryRefreshUI()
            end

            task.wait(
                lowEnd == true
                and 0.25
                or 0.10
            )
        end
    end)

    return true
end


