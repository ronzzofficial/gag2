function ZanjiGuildApplyPendingInvites(source)

    local rows =
        ZanjiGuildNormalizePendingInvites(
            source
        )

    ZANJI_GUILD_STATE.PendingInvites =
        rows

    ZANJI_GUILD_STATE.InvitesKnown =
        true

    local selectedStillExists =
        false

    for _, invite in ipairs(rows) do

        if invite.Id
            == ZANJI_GUILD_STATE.SelectedInviteId then

            selectedStillExists =
                true
        end

        if invite.GuildId ~= ""
        and type(
            ZANJI_GUILD_STATE.GuildDetails[
                invite.GuildId
            ]
        ) ~= "table"
        and ZANJI_GUILD_RUNTIME.GuildDetailsLoading[
            invite.GuildId
        ] ~= true then

            task.spawn(function()

                ZanjiGuildRefreshGuildDetails(
                    invite.GuildId,
                    true
                )
            end)
        end
    end

    if selectedStillExists ~= true then

        ZANJI_GUILD_STATE.SelectedInviteId =
            rows[1]
            and rows[1].Id
            or nil
    end

    for inviteId in pairs(
        ZANJI_GUILD_RUNTIME.InviteAttempts
    ) do

        local exists =
            false

        for _, invite in ipairs(rows) do

            if invite.Id == inviteId then

                exists =
                    true

                break
            end
        end

        if exists ~= true then

            ZANJI_GUILD_RUNTIME.InviteAttempts[
                inviteId
            ] =
                nil
        end
    end

    ZanjiGuildInvalidateInvitePanels()
    ZanjiGuildRefreshInfoPanels()
    ZanjiGuildRunInviteAutomation()

    return true
end

function ZanjiGuildApplyMailboxUpdate(...)

    local packed =
        table.pack(...)

    for index = 1, packed.n do

        local pending,
            found =
            ZanjiGuildFindPendingInvites(
                packed[index],
                0,
                {}
            )

        if found == true then

            return ZanjiGuildApplyPendingInvites(
                pending
            )
        end
    end

    return false
end

function ZanjiGuildRefreshInvites(quiet)

    if ZANJI_GUILD_RUNTIME.Busy.Invites == true then
        return false
    end

    local networking,
        networkingError =
        ZanjiGuildGetNetworking()

    local listPacket =
        type(networking) == "table"
        and type(networking.Mailbox) == "table"
        and networking.Mailbox.List
        or nil

    if type(listPacket) ~= "table"
    or type(listPacket.Fire) ~= "function" then

        if quiet ~= true then

            ZanjiGuildSetStatus(
                networkingError
                or "Mailbox.List is unavailable"
            )
        end

        return false
    end

    ZANJI_GUILD_RUNTIME.Busy.Invites =
        true

    local callOk,
        first,
        second,
        third =
        pcall(function()

            return listPacket:Fire()
        end)

    ZANJI_GUILD_RUNTIME.Busy.Invites =
        false

    ZANJI_GUILD_RUNTIME.LastInviteRefreshAt =
        os.clock()

    if callOk ~= true then

        if quiet ~= true then

            ZanjiGuildSetStatus(
                "Invite refresh failed: "
                .. tostring(first)
            )
        end

        return false
    end

    local applied =
        ZanjiGuildApplyMailboxUpdate(
            first,
            second,
            third
        )

    if applied ~= true
    and quiet ~= true then

        ZanjiGuildSetStatus(
            "Mailbox refreshed. Waiting for pending-invite data."
        )
    end

    ZanjiGuildRefreshInviteActions()

    return applied
end

function ZanjiGuildGetSelectedInvite()

    local selectedId =
        tostring(
            ZANJI_GUILD_STATE.SelectedInviteId
            or ""
        )

    for _, invite in ipairs(
        ZANJI_GUILD_STATE.PendingInvites
        or {}
    ) do

        if tostring(invite.Id)
            == selectedId then

            return invite
        end
    end

    local first =
        (
            ZANJI_GUILD_STATE.PendingInvites
            or {}
        )[1]

    ZANJI_GUILD_STATE.SelectedInviteId =
        first
        and first.Id
        or nil

    return first
