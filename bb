function ZanjiFarmNormalizePageMode(mode)

    local text =
        ZanjiCleanText(
            mode
        )

    local lower =
        text:lower()

    if lower:find("plant", 1, true) then
        return "Plant"
    end

    if lower:find("tool", 1, true) then
        return "Tools"
    end

    if lower:find("extra", 1, true)
    or lower:find("misc", 1, true)
    or lower:find("setting", 1, true) then

        return "Extra"
    end

    return "Collect"
end

