function ZanjiAutoTrowelBuildMoveList()

    local plot =
        ZanjiFarmResolveOwnPlot(
            false
        )

    local plantsFolder =
        plot
        and plot:FindFirstChild(
            "Plants"
        )

    if typeof(plantsFolder) ~= "Instance" then

        return {},
            "Your Plants folder is not ready."
    end

    local selected =
        ZanjiAutoTrowelSelectedPlantMap()

    local allPlants =
        selected["All Plants"] == true

    if allPlants ~= true
    and next(selected) == nil then

        return {},
            "Select at least one plant type."
    end

    local rows =
        {}

    for _, plant in ipairs(plantsFolder:GetChildren()) do

        if ZanjiAutoTrowelOwnsPlant(
            plant,
            plantsFolder
        ) == true then

            local plantType =
                ZanjiAutoTrowelReadPlantType(
                    plant
                )

            if allPlants == true
            or selected[plantType] == true then

                table.insert(rows, {
                    Plant =
                        plant,

                    PlantName =
                        plantType,

                    PlantId =
                        tostring(
                            plant.Name
                        ),
                })
            end
        end
    end

    table.sort(rows, function(a, b)

        if a.PlantName ~= b.PlantName then

            return tostring(a.PlantName):lower()
                < tostring(b.PlantName):lower()
        end

        return tostring(a.PlantId)
            < tostring(b.PlantId)
    end)

    local amount =
        ZanjiAutoTrowelReadMoveAmount(
            ZANJI_AUTO_TROWEL_STATE.MoveAmount
        )

    if amount > 0
    and #rows > amount then

        local limited =
            {}

        for index = 1, amount do

            limited[index] =
                rows[index]
        end

        rows =
            limited
    end

    return rows
end

function ZanjiAutoTrowelGetDestination(target, index)

    local layout =
        ZanjiAutoTrowelNormalizeLayout(
            ZANJI_AUTO_TROWEL_STATE.Layout
        )

    if layout ~= "Compact Spiral"
    or index <= 1 then

        return target
    end

    local spacing =
        ZanjiAutoTrowelReadSpacing(
            ZANJI_AUTO_TROWEL_STATE.Spacing
        )

    if spacing <= 0 then
        return target
    end

    local angle =
        (index - 1)
        * 2.399963229728653

    local radius =
        spacing
        * math.sqrt(
            index - 1
        )

    return target
        + Vector3.new(
            math.cos(angle) * radius,
            0,
            math.sin(angle) * radius
        )
end

function ZanjiAutoTrowelPlantReachedTarget(plant, target)

    if typeof(plant) ~= "Instance"
    or plant.Parent == nil then

        return false
    end

    local ok,
        pivot =
        pcall(function()

            return plant:GetPivot()
        end)

    if ok ~= true then
        return false
    end

    return (
        pivot.Position
        - target
    ).Magnitude <= 0.15
end

function ZanjiAutoTrowelStop(notifyUser)

    local runtime =
        ZANJI_AUTO_TROWEL_RUNTIME

    runtime.Token =
        nil

    ZanjiAutoTrowelCancelClickPosition(
        false
    )

    if notifyUser == true then

        ZanjiNotify(
            "Auto Trowel",
            runtime.Running == true
            and "Stopping Auto Trowel."
            or "Auto Trowel is not running.",
            3
        )
    end

    return true
end

function ZanjiAutoTrowelStart()

    local runtime =
        ZANJI_AUTO_TROWEL_RUNTIME

    if runtime.Running == true then

        ZanjiNotify(
            "Auto Trowel",
            "Auto Trowel is already running.",
            3
        )

        return false
    end

    ZanjiAutoTrowelCancelClickPosition(
        false
    )

    local target,
        plot,
        anchor =
        ZanjiAutoTrowelGetWorldTarget()

    if typeof(target) ~= "Vector3" then

        ZanjiNotify(
            "Auto Trowel",
            tostring(plot),
            4
        )

        return false
    end

    local moveList,
        listReason =
        ZanjiAutoTrowelBuildMoveList()

    if #moveList <= 0 then

        ZanjiNotify(
            "Auto Trowel",
            tostring(
                listReason
                or "No matching plants were found."
            ),
            4
        )

        return false
    end

    local movePacket,
        rejectionPacket,
        packetReason =
        ZanjiAutoTrowelResolvePackets()

    if not movePacket then

        ZanjiNotify(
            "Auto Trowel",
            tostring(packetReason),
            4
        )

        return false
    end

    local tool,
        toolReason =
        ZanjiAutoTrowelFindTool()

    if not tool then

        ZanjiNotify(
            "Auto Trowel",
            tostring(toolReason),
            4
        )

        return false
    end

    local toolCount =
        ZanjiAutoTrowelReadToolCount()

    if toolCount
    and toolCount < #moveList then

        ZanjiNotify(
            "Auto Trowel",
            "Not enough Trowel uses. Need "
                .. tostring(#moveList)
                .. ", have "
                .. tostring(toolCount)
                .. ".",
            5
        )

        return false
    end

    local entries =
        {}

    for index, row in ipairs(moveList) do

        local destination =
            ZanjiAutoTrowelGetDestination(
                target,
                index
            )

        if ZanjiAutoTrowelPointInsideAnchor(
            destination,
            anchor
        ) ~= true then

            ZanjiNotify(
                "Auto Trowel",
                "The selected layout leaves your garden. Reduce the amount or spacing.",
                5
            )

            return false
        end

        local pivot =
            row.Plant:GetPivot()

        local _,
            yawRadians =
            pivot:ToOrientation()

        entries[index] = {
            Plant =
                row.Plant,

            PlantId =
                row.PlantId,

            Destination =
                destination,

            RotationDegrees =
                math.deg(
                    yawRadians
                ),

            Sent =
                false,

            Rejected =
                false,
        }
    end

    runtime.Running =
        true

    runtime.Token =
        {}

    local token =
        runtime.Token

    local rejected =
        {}

    ZanjiAutoTrowelDisconnect(
        runtime.RejectionConnection
    )

    runtime.RejectionConnection =
        nil

    local rejectionSignal =
        rejectionPacket
        and rejectionPacket.OnClientEvent

    if rejectionSignal
    and type(rejectionSignal.Connect) == "function" then

        local connection =
            rejectionSignal:Connect(function(plantId)

                plantId =
                    tostring(
                        plantId
                        or ""
                    )

                rejected[plantId] =
                    true
            end)

        runtime.RejectionConnection =
            connection
    end

    ZanjiNotify(
        "Auto Trowel",
        "Moving "
            .. tostring(#entries)
            .. " plant"
            .. (
                #entries == 1
                and ""
                or "s"
            )
            .. ".",
        3
    )

    task.spawn(function()

        local batchSize =
            8

        for index, entry in ipairs(entries) do

            if runtime.Token ~= token then
                break
            end

            local ok =
                pcall(function()

                    movePacket:Fire(
                        entry.PlantId,
                        entry.Destination,
                        entry.RotationDegrees
                    )
                end)

            entry.Sent =
                ok == true

            if ok ~= true then

                entry.FireFailed =
                    true
            end

            if index % batchSize == 0
            and index < #entries then

                task.wait()
            end
        end

        task.wait(
            0.75
        )

        if runtime.Token ~= token then

            if runtime.RejectionConnection then

                ZanjiAutoTrowelDisconnect(
                    runtime.RejectionConnection
                )

                runtime.RejectionConnection =
                    nil
            end

            runtime.Running =
                false

            return
        end

        local retry =
            {}

        for _, entry in ipairs(entries) do

            entry.Rejected =
                rejected[entry.PlantId] == true

            if entry.Sent ~= true
            or ZanjiAutoTrowelPlantReachedTarget(
                entry.Plant,
                entry.Destination
            ) ~= true then

                table.insert(
                    retry,
                    entry
                )
            end
        end

        for index, entry in ipairs(retry) do

            if runtime.Token ~= token then
                break
            end

            pcall(function()

                movePacket:Fire(
                    entry.PlantId,
                    entry.Destination,
                    entry.RotationDegrees
                )
            end)

            if index % batchSize == 0
            and index < #retry then

                task.wait()
            end
        end

        if #retry > 0 then

            task.wait(
                0.75
            )
        end

        local moved =
            0

        local failed =
            0

        for _, entry in ipairs(entries) do

            if ZanjiAutoTrowelPlantReachedTarget(
                entry.Plant,
                entry.Destination
            ) == true then

                moved =
                    moved + 1

            else

                failed =
                    failed + 1
            end
        end

        local stopped =
            runtime.Token ~= token

        if runtime.Token == token then

            runtime.Token =
                nil
        end

        runtime.Running =
            false

        ZanjiAutoTrowelDisconnect(
            runtime.RejectionConnection
        )

        runtime.RejectionConnection =
            nil

        ZanjiAutoTrowelRefreshPlantDropdown()

        if stopped ~= true then

            if failed <= 0 then

                ZanjiNotify(
                    "Auto Trowel",
                    "Moved "
                        .. tostring(moved)
                        .. " plant"
                        .. (
                            moved == 1
                            and ""
                            or "s"
                        )
                        .. " successfully.",
                    4
                )

            else

                ZanjiNotify(
                    "Auto Trowel",
                    "Moved "
                        .. tostring(moved)
                        .. ". Failed "
                        .. tostring(failed)
                        .. ".",
                    5
                )
            end
        end
    end)

    return true
end

