function ZanjiServerFinderAddUniqueChoice(list, seen, value)

    value =
        ZanjiCleanText(
            value
        )

    if value == "" then
        return false
    end

    if value == "Mega" then
        value =
            "Huge"
    end

    if value == "Any" then
        return false
    end

    local key =
        value:lower()

    if seen[key] == true then
        return false
    end

    seen[key] =
        true

    table.insert(
        list,
        value
    )

    return true
end

function ZanjiServerFinderSortChoices(list)

    table.sort(list, function(a, b)

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return list
end

function ZanjiServerFinderBuildFilterOptions()

    local pets =
        {}

    local rarities =
        {}

    local sizes =
        {}

    local variants =
        {}

    local seenPets =
        {}

    local seenRarities =
        {}

    local seenSizes =
        {}

    local seenVariants =
        {}

    for _, petName in ipairs(ZanjiSniperGetPetValues()) do

        ZanjiServerFinderAddUniqueChoice(
            pets,
            seenPets,
            petName
        )
    end

    local petData =
        ZanjiSniperGetPetData()

    for key, row in pairs(petData) do

        if ZanjiSniperIsPetDataRow(
            key,
            row
        ) == true then

            ZanjiServerFinderAddUniqueChoice(
                rarities,
                seenRarities,
                row.Rarity
            )
        end
    end

    for _, sizeName in ipairs({
        "Normal",
        "Big",
        "Huge",
    }) do

        ZanjiServerFinderAddUniqueChoice(
            sizes,
            seenSizes,
            sizeName
        )
    end

    for _, variantName in ipairs({
        "Regular",
        "Rainbow",
    }) do

        ZanjiServerFinderAddUniqueChoice(
            variants,
            seenVariants,
            variantName
        )
    end

    return {
        Pets =
            ZanjiServerFinderSortChoices(
                pets
            ),

        Rarities =
            ZanjiServerFinderSortChoices(
                rarities
            ),

        Sizes =
            sizes,

        Variants =
            variants,
    }
end

