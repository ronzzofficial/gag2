        and ZANJI_SNIPER_RUNTIME.BoughtCounts
        or {}

    local entryKey =
        ZanjiSniperEntryKey(
            entry
        )

    if entryKey ~= "" then

        ZANJI_SNIPER_RUNTIME.Handled[entryKey] =
            true
    end

    local filter =
        match
        and match.Filter
        or nil

    if type(filter) == "table" then

        local filterKey =
            ZanjiSniperFilterKey(
