function ZanjiAuctionHudCreateUI()

    ZanjiAuctionHudDestroy(
        true
    )

    local playerGui =
        ZanjiAuctionGetPlayerGui()

    if typeof(playerGui) ~= "Instance" then
        return false
    end

    local screenGui =
        ZanjiAuctionHudCreate(
            "ScreenGui",
            {
                Name = "ZanjiAuctionFloatingHud",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
                Parent = playerGui,
