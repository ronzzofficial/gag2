    )
end

function ZanjiServerFinderAutoJoinValueIsAny(value)

    local text =
        ZanjiCleanText(
            value
        )
        :lower()

    return text == ""
        or text == "any"
        or text == "any pet"
        or text == "all"
end

function ZanjiServerFinderHoldMatchesRow(hold, row)

    hold =
        ZanjiServerFinderNormalizeAutoJoinHold(
            hold
        )

    if type(hold) ~= "table"
    or type(row) ~= "table" then
        return false
    end

    if ZanjiServerFinderRowAlive(row) ~= true then
        return false
    end

    if ZanjiServerFinderAutoJoinValueIsAny(hold.Pet) ~= true then

        local holdPet =
            ZanjiSniperPetAliasKey(
                hold.Pet
            )

        local rowPet =
            ZanjiSniperPetAliasKey(
                ZanjiServerFinderRowBasePet(
                    row
                )
            )

        if holdPet == ""
        or rowPet ~= holdPet then
            return false
        end
    end

    if ZanjiServerFinderAutoJoinValueIsAny(hold.Size) ~= true then

        if ZanjiSniperNormalizeSizeName(
            row.Size
            or row.size
            or "Normal"
        ) ~= ZanjiSniperNormalizeSizeName(
            hold.Size
        ) then

            return false
        end
    end

    if ZanjiServerFinderAutoJoinValueIsAny(hold.Variant) ~= true then

        if ZanjiServerFinderAutoJoinRowVariant(
            row
        ) ~= ZanjiServerFinderNormalizeAutoJoinVariantName(
            hold.Variant
        ) then

            return false
        end
    end

    if ZanjiServerFinderAutoJoinValueIsAny(hold.Rarity) ~= true then

        if ZanjiCleanText(
            row.Rarity
            or row.rarity
        ):lower() ~= ZanjiCleanText(
            hold.Rarity
        ):lower() then

            return false
        end
    end

    return true
end

function ZanjiServerFinderFindHoldTargetInCurrentRows(rows, hold)

    rows =
        type(rows) == "table"
        and rows
        or {}

    for _, row in ipairs(rows) do

        if type(row) == "table"
        and ZanjiServerFinderRowIsCurrent(row) == true
        and ZanjiServerFinderHoldMatchesRow(
            hold,
            row
        ) == true then

            return row
        end
    end

    return nil
end

function ZanjiServerFinderFindCurrentAutoJoinTarget(rows)

    ZanjiServerFinderEnsureAutoJoinState()

    rows =
        type(rows) == "table"
        and rows
        or {}

    for ruleIndex, rule in ipairs(ZANJI_SERVER_FINDER_STATE.AutoJoinRules or {}) do

        for _, row in ipairs(rows) do

            if type(row) == "table"
            and ZanjiServerFinderRowIsCurrent(row) == true
            and ZanjiServerFinderRowAlive(row) == true
            and ZanjiServerFinderAutoJoinRuleMatchesRow(
                rule,
                row
            ) == true then

                return {
                    RuleIndex =
                        ruleIndex,

                    Rule =
                        rule,

                    Row =
                        row,
                }
            end
        end
    end

    return nil
end

