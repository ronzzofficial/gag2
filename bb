        or ZanjiServerFinderRarityRank(
            copy.Rarity
        )

    copy.PriceNumber =
        tonumber(
            copy.PriceNumber
            or copy.Price
            or copy.price
        )
        or 0

    copy.Price =
        copy.PriceNumber

    return copy
end

function ZanjiServerFinderBuildPetDisplayRows(serverRows)

    local output =
        {}

    local now =
        os.time()

    for _, serverRow in ipairs(serverRows or {}) do

        if type(serverRow) ~= "table" then
            continue
        end

        local jobId =
            ZanjiCleanText(
                serverRow.JobId
                or serverRow.jobId
                or serverRow.ServerId
                or serverRow.Id
                or serverRow.Key
            )

        if jobId == "" then
            continue
        end

        local pets =
            {}

        if type(serverRow.Pets) == "table" then

            for _, pet in ipairs(serverRow.Pets) do

                if type(pet) == "table" then

                    local copy =
                        ZanjiServerFinderClonePetForDisplay(
                            pet
                        )

                    table.insert(
                        pets,
                        copy
                    )
                end
            end
        end

        if #pets <= 0 then

            local copy =
                ZanjiServerFinderClonePetForDisplay(
                    serverRow
                )

            if ZanjiCleanText(copy.DisplayName) ~= ""
            and ZanjiCleanText(copy.DisplayName) ~= "Unknown Pet" then

                table.insert(
                    pets,
                    copy
                )
            end
        end

        if #pets <= 0 then
            continue
        end

        local groups =
            {}

        local order =
            {}

        for _, pet in ipairs(pets) do

            local key =
                ZanjiServerFinderPetGroupKey(
                    pet
                )

            if groups[key] == nil then

                groups[key] = {
                    Key =
                        key,

                    Count =
                        0,

                    Pets =
                        {},

                    DisplayName =
                        ZanjiCleanText(
                            pet.DisplayName
                        ),

                    BasePet =
                        ZanjiCleanText(
                            pet.Pet
                            or pet.PetName
                        ),

                    Rarity =
                        ZanjiCleanText(
                            pet.Rarity
                        ),

                    RarityRank =
                        tonumber(pet.RarityRank)
                        or ZanjiServerFinderRarityRank(
                            pet.Rarity
                        ),

                    Size =
                        ZanjiSniperNormalizeSizeName(
                            pet.Size
                            or "Normal"
                        ),

                    Variant =
                        ZanjiSniperNormalizeVariantName(
                            pet.Variant
                            or pet.Mutation
                            or "Normal"
                        ),

                    PriceNumber =
                        tonumber(
                            pet.PriceNumber
                            or pet.Price
                        )
                        or 0,

                    ExpiresAt =
                        0,
                }

                table.insert(
                    order,
                    key
                )
            end

            local group =
                groups[key]

            group.Count =
                group.Count + 1

            group.PriceNumber =
                math.max(
                    tonumber(group.PriceNumber)
                    or 0,
                    tonumber(
                        pet.PriceNumber
                        or pet.Price
                    )
                    or 0
                )

            group.RarityRank =
                math.max(
                    tonumber(group.RarityRank)
                    or 0,
                    tonumber(pet.RarityRank)
                    or ZanjiServerFinderRarityRank(
                        pet.Rarity
                    )
                )

            local expiresAt =
                tonumber(
                    pet.ExpiresAt
                    or pet.expiresAt
                )
                or 0

            if expiresAt <= 0 then

                local spawnedAt =
                    tonumber(
                        pet.SpawnedAt
                        or pet.spawnedAt
                    )
                    or 0

                local lifetime =
                    tonumber(
                        pet.Lifetime
                        or pet.lifetime
                    )
                    or 0

                if spawnedAt > 0
                and lifetime > 0 then

                    expiresAt =
                        spawnedAt
                        + lifetime
                end
            end

            if expiresAt > group.ExpiresAt then

                group.ExpiresAt =
                    expiresAt
            end

            table.insert(
                group.Pets,
                pet
            )
        end

        for _, key in ipairs(order) do

            local group =
                groups[key]

            local displayName =
                ZanjiCleanText(
                    group.DisplayName
                )

            if displayName == "" then

                displayName =
                    ZanjiLivePetsBuildDisplayName(
                        group.BasePet,
                        group.Size,
                        group.Variant
                    )
            end

            if group.Count > 1 then

                displayName =
                    displayName
                    .. " x"
                    .. tostring(group.Count)
            end

            local expiresAt =
                tonumber(group.ExpiresAt)
                or tonumber(serverRow.ExpiresAt)
                or 0

            local otherPetCount =
                math.max(
                    0,
                    #pets - group.Count
                )

            local searchBlob =
                ZanjiServerFinderBuildPetSearchBlob(
                    group.Pets
                )

            table.insert(
                output,
                {
                    Key =
                        tostring(jobId)
                        .. "|pet|"
                        .. tostring(key),

                    Id =
                        tostring(jobId)
                        .. "|pet|"
                        .. tostring(key),

                    JobId =
                        jobId,

                    PlaceId =
                        tonumber(
                            serverRow.PlaceId
                            or serverRow.placeId
                        )
                        or game.PlaceId,

                    DisplayName =
                        displayName,

                    Name =
                        searchBlob,

                    Pet =
                        displayName,

                    PetName =
                        displayName,

                    BasePet =
                        group.BasePet,

                    BestPet =
                        group.BasePet,

                    BestDisplayName =
                        displayName,

                    Rarity =
                        group.Rarity,

                    RarityRank =
                        group.RarityRank,

                    Size =
                        group.Size,

                    Variant =
                        group.Variant,

                    Mutation =
                        group.Variant,

                    Price =
                        group.PriceNumber,

                    PriceNumber =
                        group.PriceNumber,

                    Playing =
                        tonumber(
                            serverRow.Playing
                            or serverRow.playing
                        )
                        or 0,

                    MaxPlayers =
                        tonumber(
                            serverRow.MaxPlayers
                            or serverRow.maxPlayers
                        )
                        or 8,

                    ServerVersion =
                        ZanjiCleanText(
                            serverRow.ServerVersion
                            or serverRow.serverVersion
                        ),

                    ReportedAt =
                        tonumber(
                            serverRow.ReportedAt
                            or serverRow.reportedAt
                        )
                        or now,

                    ExpiresAt =
                        expiresAt,

                    TimeLeft =
                        math.max(
                            0,
                            expiresAt > 0
                            and expiresAt - now
                            or 0
                        ),

                    PetCount =
                        group.Count,

                    ServerPetCount =
                        #pets,

                    OtherPetCount =
                        otherPetCount,

                    Pets =
                        group.Pets,

                    Source =
                        serverRow.Source
                        or "Cloudflare",

                    IsCurrentServer =
                        serverRow.IsCurrentServer == true
                        or jobId == tostring(game.JobId),

                    ParentServerRow =
                        serverRow,
                }
            )
        end
    end

    table.sort(output, function(a, b)

        if a.IsCurrentServer ~= b.IsCurrentServer then
            return a.IsCurrentServer == true
        end

        local rarityA =
            tonumber(a.RarityRank)
            or 0

        local rarityB =
            tonumber(b.RarityRank)
            or 0

        if rarityA ~= rarityB then
            return rarityA > rarityB
        end

        local priceA =
            tonumber(a.PriceNumber)
            or 0

        local priceB =
            tonumber(b.PriceNumber)
            or 0

        if priceA ~= priceB then
            return priceA > priceB
        end

        local timeA =
            tonumber(a.TimeLeft)
            or 0

        local timeB =
            tonumber(b.TimeLeft)
            or 0

        if timeA ~= timeB then
            return timeA > timeB
        end

        return tostring(a.DisplayName or "")
            < tostring(b.DisplayName or "")
    end)

    return output
end

function ZanjiServerFinderRefreshRows(hud, reason)

    if ZanjiAuthRequireServerSniper(
        "Server Finder Refresh",
        true
    ) ~= true then

        return false
    end

    if type(hud) ~= "table"
    or type(hud.SetRows) ~= "function" then
        return false
    end

    ZanjiServerFinderReportForRefresh(
        reason or "refresh"
    )

    local localRows =
        ZanjiServerFinderBuildLocalRows()

    local backendRows =
        nil

    local ok,
        result =
        pcall(function()

            return ZanjiServerFinderFetchBackendRows()
        end)

    if ok == true
    and type(result) == "table" then

        backendRows =
            result
    end

    local mergedRows =
        ZanjiServerFinderMergeRows(
            backendRows,
            localRows
        )

    local displayRows =
        ZanjiServerFinderAnnotateDisplayRows(
            ZanjiServerFinderBuildPetDisplayRows(
                mergedRows
            )
        )

    hud:SetRows(
        displayRows
    )

    ZanjiServerFinderEvaluateAutoJoin(
        hud
    )

    return true
end

function ZanjiServerFinderPullStateFromHud(hud)

    if type(hud) ~= "table"
    or type(hud.GetSettings) ~= "function" then
        return false
    end

    local settings =
        hud:GetSettings()

    if type(settings) ~= "table" then
        return false
    end

    ZANJI_SERVER_FINDER_STATE.AutoRefresh =
        settings.AutoRefresh == true

    ZANJI_SERVER_FINDER_STATE.RefreshDelay =
        math.clamp(
            tonumber(settings.RefreshDelay)
            or 5,
            1,
            60
        )

    ZANJI_SERVER_FINDER_STATE.HideFull =
        settings.HideFull ~= false

    ZANJI_SERVER_FINDER_STATE.SelectedPets =
        ZanjiServerFinderMapFromArray(
            settings.SelectedPets
        )

    ZANJI_SERVER_FINDER_STATE.SelectedRarities =
        ZanjiServerFinderMapFromArray(
            settings.SelectedRarities
        )

    ZANJI_SERVER_FINDER_STATE.SelectedSizes =
        ZanjiServerFinderSizeMapFromArray(
            settings.SelectedSizes
            or settings.SelectedTraits
        )

    ZANJI_SERVER_FINDER_STATE.SelectedVariants =
        ZanjiServerFinderVariantMapFromArray(
            settings.SelectedVariants
            or settings.SelectedTraits
        )

    ZANJI_SERVER_FINDER_STATE.SelectedTraits =
        {}

    ZANJI_SERVER_FINDER_STATE.Minimized =
        settings.Minimized == true

    ZANJI_SERVER_FINDER_STATE.Position =
        ZanjiServerFinderReadPosition(
            settings.Position
        )

    ZANJI_SERVER_FINDER_STATE.FilterPosition =
        ZanjiServerFinderReadPosition(
            settings.FilterPosition
        )

    ZANJI_SERVER_FINDER_STATE.HudScale =
        ZanjiServerFinderReadHudScale(
            settings.HudScale
            or settings.Scale
            or ZANJI_SERVER_FINDER_STATE.HudScale
            or 80
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinMode =
        ZanjiServerFinderNormalizeAutoJoinMode(
            settings.AutoJoinMode
            or ZANJI_SERVER_FINDER_STATE.AutoJoinMode
            or "Off"
        )

    ZanjiServerFinderEnsureAutoJoinState()

    return true
end

function ZanjiServerFinderApplyStateToHud(hud)

    if type(hud) ~= "table"
    or type(hud.ApplySettings) ~= "function" then
        return false
    end

    ZanjiServerFinderEnsureAutoJoinState()

    hud:ApplySettings({
        AutoRefresh =
            ZANJI_SERVER_FINDER_STATE.AutoRefresh == true,

        RefreshDelay =
            ZANJI_SERVER_FINDER_STATE.RefreshDelay,

        HideFull =
            ZANJI_SERVER_FINDER_STATE.HideFull ~= false,

        AutoJoinMode =
            ZanjiServerFinderNormalizeAutoJoinMode(
                ZANJI_SERVER_FINDER_STATE.AutoJoinMode
            ),

        SelectedPets =
            ZanjiServerFinderArrayFromMap(
                ZANJI_SERVER_FINDER_STATE.SelectedPets
            ),

        SelectedRarities =
            ZanjiServerFinderArrayFromMap(
                ZANJI_SERVER_FINDER_STATE.SelectedRarities
            ),

        SelectedSizes =
            ZanjiServerFinderArrayFromMap(
                ZANJI_SERVER_FINDER_STATE.SelectedSizes
            ),

        SelectedVariants =
            ZanjiServerFinderArrayFromMap(
                ZANJI_SERVER_FINDER_STATE.SelectedVariants
            ),

        Minimized =
            ZANJI_SERVER_FINDER_STATE.Minimized == true,

        Position =
            ZANJI_SERVER_FINDER_STATE.Position,

        FilterPosition =
            ZANJI_SERVER_FINDER_STATE.FilterPosition,

        HudScale =
            ZanjiServerFinderGetHudScale(),

        Scale =
            ZanjiServerFinderGetHudScaleFactor(),
    })

    ZanjiServerFinderApplyScaleToHud(
        hud
    )

    return true
end

function ZanjiServerFinderSyncToggle(value)

