        or type(raw) ~= "string"
        or raw == ""
    then
        return false
    end

    local decodeOk, decoded =
        pcall(function()
            return HttpService:JSONDecode(
                raw
            )
        end)

    if decodeOk ~= true
        or type(decoded) ~= "table"
        or type(decoded.Records) ~= "table"
    then
        return false
    end

    local storedUserId =
        math.floor(
            tonumber(
                decoded.UserId
            )
            or 0
        )

    if storedUserId > 0
        and storedUserId
            ~= ZANJI_MAIL_ACCOUNT_USER_ID
    then
        return false
    end

    ZANJI_MAIL_HISTORY.Version =
        2

    ZANJI_MAIL_HISTORY.UserId =
        ZANJI_MAIL_ACCOUNT_USER_ID

    ZANJI_MAIL_HISTORY.Username =
        tostring(
            LocalPlayer.Name
