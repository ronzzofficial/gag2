function ZanjiGuildLeaderboardRowId(row)

    if type(row) ~= "table" then
        return ""
    end

    return row.Id ~= ""
        and tostring(row.Id)
        or (
            tostring(row.Rank)
            .. ":"
            .. tostring(row.Name)
        )
end

function ZanjiGuildGetOwnLeaderboardRow()

    local data =
        ZanjiGuildGetOverviewData()

    if type(data) ~= "table" then
        return nil
    end

    local rank =
        tonumber(
            ZanjiGuildField(
                data.Root,
                {
                    "GlobalRank",
                    "LeaderboardRank",
                    "Rank",
                    "Placement",
                }
            )
        )

    return {
        Rank =
            rank
            or "—",

        Id =
            data.Id,

        Name =
            data.Name,

        Tag =
            data.Tag,

        Score =
            data.Weekly,

        Members =
            data.Members,

        MaxMembers =
            data.Capacity,

        IconId =
            data.IconId,

        IsOwn =
            true,
    }
end

