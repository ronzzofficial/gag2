            0.35,
            0.75,
            1.20,
            1.80,
            2.50,
        }

        local lastReason =
            "not started"

        for _, delay in ipairs(retryDelays) do

            if delay > 0 then

                task.wait(
                    delay
                )
            end

            ZanjiDataTryRequireModule(
                "PetSizes"
            )

            ZanjiDataTryRequireModule(
                "PetTypes"
            )

            local petData,
                petReason =
                ZanjiDataTryRequireModule(
                    "PetData"
                )

            lastReason =
                tostring(petReason or "unknown")

            local count =
                ZanjiDataCountPetDataRows(
                    petData
                )

            if count > 0 then

                ZANJI_DATA_STATE.PetDataReady =
                    true

                ZANJI_DATA_STATE.PetDataCount =
                    count

                ZanjiDataLogOnce(
                    "petdata-loaded",
                    "PetData loaded: "
                        .. tostring(count)
                        .. " pets."
                )

                ZanjiDataRefreshPetDropdowns()

                return
            end
        end

        ZANJI_DATA_STATE.PetDataReady =
            false

        ZANJI_DATA_STATE.PetDataCount =
            0

        ZanjiDataLogOnce(
            "petdata-failed",
            "PetData unavailable after startup retries. Using Raccoon fallback. Last: "
                .. tostring(lastReason)
        )
    end)

    return true
end

function ZanjiShopAddItemRow(rows, name, price)

    name =
        ZanjiCleanText(name)

    if name == "" then
        return
    end

    rows[name] =
        rows[name]
        or {
            Name = name,
            Price = 0,
        }

    rows[name].Price =
        math.max(
            tonumber(rows[name].Price)
            or 0,
            tonumber(price)
            or 0
        )
end

function ZanjiShopModuleEnabled(modulePath, functionName, itemName, fallback)

    local module =
        ZanjiShopRequireModule(
            modulePath
        )

    local callback =
        type(module) == "table"
        and module[functionName]
        or nil

    if type(callback) ~= "function" then
        return fallback ~= false
    end

    local ok,
        result =
        pcall(
            callback,
            itemName
        )

    if ok ~= true then

        ok,
            result =
            pcall(
                callback,
                module,
                itemName
            )
    end

    if ok == true
    and type(result) == "boolean" then

        return result
    end

    return fallback ~= false
end

function ZanjiShopFlagEnabled(modulePath, itemName, fallback)

    local module =
        ZanjiShopRequireModule(
