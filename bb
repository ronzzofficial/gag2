end

function ZanjiServerFinderNormalizeAutoJoinPriority(value)

    local text =
        ZanjiCleanText(
            value
        )
        :lower()

    if text:find(
        "high",
        1,
        true
    ) then

        return "High"
    end

    if text:find(
        "low",
        1,
        true
    ) then

        return "Low"
    end

    return "Medium"
end

function ZanjiServerFinderAutoJoinPriorityRank(value)

    value =
        ZanjiServerFinderNormalizeAutoJoinPriority(
            value
        )

    if value == "High" then
        return 1
    end

    if value == "Low" then
        return 3
    end

    return 2
end

function ZanjiServerFinderNormalizeAutoJoinRule(rule)

    rule =
        type(rule) == "table"
        and rule
        or {}

    local petScope =
        ZanjiServerFinderNormalizeAutoJoinPetScope(
            rule.PetScope
            or rule.Scope
            or "Selected Pets"
        )

    local pets =
        ZanjiServerFinderAutoJoinUniqueList(
            rule.Pets
            or rule.Pet
            or rule.SelectedPets,
            ZanjiServerFinderNormalizeAutoJoinPetName,
            "Any"
        )

    if petScope == "Any Pet" then

        pets =
            {
                "Any",
            }
    end

    if petScope ~= "Any Pet"
    and ZanjiServerFinderAutoJoinListHasAny(pets) == true then

        pets =
            {
                "Bunny",
            }
    end

    local sizes =
        ZanjiServerFinderAutoJoinUniqueList(
            rule.Sizes
            or rule.Size,
            ZanjiServerFinderNormalizeAutoJoinSizeName,
            "Any"
        )

    local variants =
        ZanjiServerFinderAutoJoinUniqueList(
            rule.Variants
            or rule.Variant
            or rule.Mutations
            or rule.Mutation,
            ZanjiServerFinderNormalizeAutoJoinVariantName,
            "Any"
        )

    local rarities =
        ZanjiServerFinderAutoJoinUniqueList(
            rule.Rarities
            or rule.Rarity,
            ZanjiServerFinderNormalizeAutoJoinRarityName,
            "Any"
        )

    return {
        PetScope =
            petScope,

        Pets =
            pets,

        Sizes =
            sizes,

        Variants =
            variants,

        Rarities =
            rarities,

        MatchMode =
            "All Selected",

        Priority =
            ZanjiServerFinderNormalizeAutoJoinPriority(
                rule.Priority
                or "Medium"
            ),
    }
end

function ZanjiServerFinderNormalizeAutoJoinRules(rules)

    local output =
        {}

    local suppliedList =
        type(rules) == "table"

    if suppliedList then

        for _, target in ipairs(rules) do

            if type(target) == "table" then

                table.insert(
                    output,
                    ZanjiServerFinderNormalizeAutoJoinRule(
                        target
                    )
                )
            end
        end
    end

    if suppliedList ~= true then

        for _, target in ipairs(
            ZanjiServerFinderGetDefaultAutoJoinRules()
        ) do

            table.insert(
                output,
                ZanjiServerFinderNormalizeAutoJoinRule(
                    target
                )
            )
        end
    end

    return output
end

function ZanjiServerFinderNormalizeAutoJoinHold(hold)

    if type(hold) ~= "table"
    or hold.Active ~= true then

        return nil
    end

    local jobId =
        ZanjiCleanText(
            hold.JobId
            or hold.TargetJobId
            or hold.ServerId
        )

    if jobId == "" then
        return nil
    end

    local expiresAt =
        tonumber(
            hold.ExpiresAt
            or hold.expiresAt
        )
        or 0

    if expiresAt > 0
    and expiresAt <= os.time() - 8 then

        return nil
    end

    local size =
        ZanjiCleanText(
            hold.Size
            or "Any"
        )

    if size == ""
    or size:lower() == "any" then

        size =
            "Any"

    else

        size =
            ZanjiSniperNormalizeSizeName(
                size
            )
    end

    local variant =
        ZanjiCleanText(
            hold.Variant
            or hold.Mutation
            or "Any"
        )

    if variant == ""
    or variant:lower() == "any" then

        variant =
            "Any"

    else

        variant =
            ZanjiServerFinderNormalizeAutoJoinVariantName(
                variant
            )
    end

    local rarity =
        ZanjiCleanText(
            hold.Rarity
            or "Any"
        )

    if rarity == "" then
        rarity =
            "Any"
    end

    return {
        Active =
            true,

        JobId =
            jobId,

        PlaceId =
            tonumber(
                hold.PlaceId
                or hold.placeId
                or game.PlaceId
            )
            or game.PlaceId,

        Pet =
            ZanjiCleanText(
                hold.Pet
                or hold.BasePet
                or hold.BestPet
            ),

        Size =
            size,

        Variant =
            variant,

        Rarity =
            rarity,

        DisplayName =
            ZanjiCleanText(
                hold.DisplayName
                or hold.Name
                or hold.Pet
            ),

        RuleIndex =
            tonumber(
                hold.RuleIndex
            )
            or 0,

        ExpiresAt =
            expiresAt,

        CreatedAt =
            tonumber(
                hold.CreatedAt
            )
            or os.time(),

        Source =
            ZanjiCleanText(
                hold.Source
                or "Auto Join"
            ),
    }
end

function ZanjiServerFinderEnsureAutoJoinState()

    ZANJI_SERVER_FINDER_STATE =
        type(ZANJI_SERVER_FINDER_STATE) == "table"
        and ZANJI_SERVER_FINDER_STATE
        or {}

    ZANJI_SERVER_FINDER_STATE.AutoJoinMode =
        ZanjiServerFinderNormalizeAutoJoinMode(
            ZANJI_SERVER_FINDER_STATE.AutoJoinMode
            or "Off"
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinMinLife =
        math.clamp(
            tonumber(
                ZANJI_SERVER_FINDER_STATE.AutoJoinMinLife
            )
            or 30,
            0,
            420
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinCooldown =
        math.clamp(
            tonumber(
                ZANJI_SERVER_FINDER_STATE.AutoJoinCooldown
            )
            or 10,
            1,
            120
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinHoldLoadGrace =
        math.clamp(
            tonumber(
                ZANJI_SERVER_FINDER_STATE.AutoJoinHoldLoadGrace
            )
            or 22,
            5,
            90
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinRules =
        ZanjiServerFinderNormalizeAutoJoinRules(
            ZANJI_SERVER_FINDER_STATE.AutoJoinRules
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinSelectedRuleIndex =
        math.clamp(
            math.floor(
                tonumber(
                    ZANJI_SERVER_FINDER_STATE.AutoJoinSelectedRuleIndex
                )
                or 1
            ),
            1,
            math.max(
                1,
                #ZANJI_SERVER_FINDER_STATE.AutoJoinRules
            )
        )

    ZANJI_SERVER_FINDER_STATE.AutoJoinHold =
        ZanjiServerFinderNormalizeAutoJoinHold(
            ZANJI_SERVER_FINDER_STATE.AutoJoinHold
        )

    return ZANJI_SERVER_FINDER_STATE
end

function ZanjiServerFinderSetAutoJoinMode(value)

    ZanjiServerFinderEnsureAutoJoinState()

    local wantedMode =
        ZanjiServerFinderNormalizeAutoJoinMode(
            value
        )

    if wantedMode ~= "Off"
    and ZanjiAuthRequireServerSniper(
        "Auto Join",
        true
    ) ~= true then

        ZANJI_SERVER_FINDER_STATE.AutoJoinMode =
            "Off"

        if type(ZANJI_SERVER_FINDER_HUD) == "table"
        and type(ZANJI_SERVER_FINDER_HUD.SetAutoJoinMode) == "function" then

            pcall(function()

                ZANJI_SERVER_FINDER_HUD:SetAutoJoinMode(
                    "Off"
                )
            end)
        end

        ZanjiQueueSaveServerFinderSettings()

        if type(ZanjiServerFinderRefreshAutoJoinRulesPopup) == "function" then

            ZanjiServerFinderRefreshAutoJoinRulesPopup()
        end

        return "Off"
    end

    ZANJI_SERVER_FINDER_STATE.AutoJoinMode =
        wantedMode

    if type(ZANJI_SERVER_FINDER_HUD) == "table"
    and type(ZANJI_SERVER_FINDER_HUD.SetAutoJoinMode) == "function" then

        pcall(function()

            ZANJI_SERVER_FINDER_HUD:SetAutoJoinMode(
                ZANJI_SERVER_FINDER_STATE.AutoJoinMode
            )
        end)
    end

    ZanjiQueueSaveServerFinderSettings()

    ZanjiServerFinderRefreshAutoJoinRulesPopup()

    return ZANJI_SERVER_FINDER_STATE.AutoJoinMode
end

function ZanjiServerFinderRowKey(row)

    if type(row) ~= "table" then
        return ""
    end

    return ZanjiCleanText(
        row.Key
        or row.Id
        or row.JobId
        or row.jobId
        or ""
    )
end

function ZanjiServerFinderRowJobId(row)

    if type(row) ~= "table" then
        return ""
    end

    return ZanjiCleanText(
        row.JobId
        or row.jobId
        or row.ServerId
        or row.id
        or row.Id
        or row.Key
    )
end

function ZanjiServerFinderRowTimeLeft(row)

    if type(row) ~= "table" then
        return 0
    end

    local expiresAt =
        tonumber(
            row.ExpiresAt
            or row.expiresAt
        )
        or 0

    if expiresAt > 0 then

        return math.max(
            0,
            expiresAt - os.time()
        )
    end

    local timeLeft =
        tonumber(
            row.TimeLeft
            or row.timeLeft
        )
        or 0

    local reportedAt =
        tonumber(
            row.ReportedAt
            or row.reportedAt
        )
        or 0

    if reportedAt > 0 then

        timeLeft =
            timeLeft
            - math.max(
                0,
                os.time() - reportedAt
            )
    end

    return math.max(
        0,
        timeLeft
    )
end

function ZanjiServerFinderRowIsFull(row)

    if type(row) ~= "table" then
        return true
    end

    local playing =
        tonumber(
            row.Playing
            or row.playing
        )
        or 0

    local maxPlayers =
        tonumber(
            row.MaxPlayers
            or row.maxPlayers
        )
        or 8

    return maxPlayers > 0
        and playing >= maxPlayers
end

function ZanjiServerFinderRowIsCurrent(row)

    local jobId =
        ZanjiServerFinderRowJobId(
            row
        )

    return jobId ~= ""
        and jobId == tostring(game.JobId)
end

function ZanjiServerFinderRowReportAge(row)

    if type(row) ~= "table" then
        return 999999
    end

    local reportedAt =
        tonumber(
            row.ReportedAt
            or row.reportedAt
        )
        or 0

    if reportedAt <= 0 then
        return 0
    end

    return math.max(
        0,
        os.time() - reportedAt
    )
end

function ZanjiServerFinderRowIsHiddenByAge(row)

    if type(row) ~= "table" then
        return true
    end

    if row.HideFromFinder == true
    or row.Expired == true then

        return true
    end

    local expiresAt =
        tonumber(
            row.ExpiresAt
            or row.expiresAt
        )
        or 0

    if expiresAt > 0
    and expiresAt <= os.time() then

        return true
    end

    local reportedAt =
        tonumber(
            row.ReportedAt
            or row.reportedAt
        )
        or 0

    if reportedAt <= 0 then
        return false
    end

    local maxAge =
        tonumber(
            row.MaxReportAge
            or row.maxReportAge
        )
        or tonumber(SERVER_FINDER_ROW_HIDE_AFTER_SECONDS)
        or 45

    return ZanjiServerFinderRowReportAge(row) > maxAge
end

function ZanjiServerFinderRowIsStale(row)

    local maxAge =
        tonumber(
            row
            and (
                row.ManualJoinMaxAge
                or row.manualJoinMaxAge
            )
        )
        or tonumber(SERVER_FINDER_MANUAL_JOIN_FRESH_SECONDS)
        or 20

    return ZanjiServerFinderRowReportAge(row) > maxAge
end

function ZanjiServerFinderRowIsTooLate(row, minLife)

    if type(row) ~= "table" then
        return true
    end

    local expiresAt =
        tonumber(
            row.ExpiresAt
            or row.expiresAt
        )
        or 0

    local rawTimeLeft =
        tonumber(
            row.TimeLeft
            or row.timeLeft
        )

    if expiresAt <= 0
    and rawTimeLeft == nil then

        return false
    end

    local timeLeft =
        ZanjiServerFinderRowTimeLeft(
            row
        )

    if timeLeft <= 0 then
        return true
    end

    minLife =
        tonumber(minLife)
        or tonumber(SERVER_FINDER_TOO_LATE_SECONDS)
        or 15

    return timeLeft < minLife
end

function ZanjiServerFinderRowManualJoinAllowed(row)

    if type(row) ~= "table" then
        return false
    end

    if ZanjiServerFinderRowIsCurrent(row) == true then
        return false
    end

    if ZanjiServerFinderRowIsFull(row) == true then
        return false
    end

    if ZanjiServerFinderRowIsHiddenByAge(row) == true then
        return false
    end

    return true
end

function ZanjiServerFinderRowAutoJoinFresh(row, minLife)

    return ZanjiServerFinderRowManualJoinAllowed(
        row
    ) == true
end

function ZanjiServerFinderAnnotateJoinState(row)

    if type(row) ~= "table" then
        return nil
    end

    row.MaxReportAge =
        tonumber(SERVER_FINDER_ROW_HIDE_AFTER_SECONDS)
        or 45

    row.ManualJoinMaxAge =
        tonumber(SERVER_FINDER_MANUAL_JOIN_FRESH_SECONDS)
        or 20

    row.AutoJoinMaxAge =
        tonumber(SERVER_FINDER_AUTO_JOIN_FRESH_SECONDS)
        or 12

    row.ManualMinLife =
        tonumber(SERVER_FINDER_TOO_LATE_SECONDS)
        or 15

    row.ReportAge =
        ZanjiServerFinderRowReportAge(
            row
        )

    row.JoinEnabled =
        true

    row.JoinDisabled =
        false

    row.JoinText =
        "Join"

    row.JoinState =
        "fresh"

    row.Freshness =
        "Fresh"

    if ZanjiServerFinderRowIsHiddenByAge(row) == true then

        row.Expired =
            true

        row.HideFromFinder =
            true

        row.JoinEnabled =
            false

        row.JoinDisabled =
            true

        row.JoinText =
            "Gone"

        row.JoinState =
            "gone"

        row.Freshness =
            "Gone"

        return row
    end

    if ZanjiServerFinderRowIsCurrent(row) == true then

        row.JoinEnabled =
            false

        row.JoinDisabled =
            true

        row.JoinText =
            "Current"

        row.JoinState =
            "current"

        row.Freshness =
            "Current"

        return row
    end

    if ZanjiServerFinderRowIsFull(row) == true then

        row.JoinEnabled =
            false

        row.JoinDisabled =
            true

        row.JoinText =
            "Full"

        row.JoinState =
            "full"

        row.Freshness =
            "Full"

        return row
    end

    if ZanjiServerFinderRowIsTooLate(
        row,
        SERVER_FINDER_TOO_LATE_SECONDS
    ) == true then

        row.JoinEnabled =
            true

        row.JoinDisabled =
            false

        row.JoinText =
            "Join"

        row.JoinState =
            "late"

        row.Freshness =
            "Late"

        return row
    end

    if ZanjiServerFinderRowIsStale(row) == true then

        row.JoinEnabled =
            true

        row.JoinDisabled =
            false

        row.JoinText =
            "Join"

        row.JoinState =
            "stale"

        row.Freshness =
            "Stale"

        return row
    end

    if ZanjiServerFinderRowReportAge(row)
    > (
        tonumber(SERVER_FINDER_AUTO_JOIN_FRESH_SECONDS)
        or 12
    ) then

        row.JoinState =
            "aging"

        row.Freshness =
            "Aging"

    else

        row.JoinState =
            "fresh"

        row.Freshness =
            "Fresh"
    end

    return row
end

function ZanjiServerFinderAnnotateDisplayRows(rows)

    local output =
        {}

    rows =
        type(rows) == "table"
        and rows
        or {}

    for _, row in ipairs(rows) do

        row =
            ZanjiServerFinderAnnotateJoinState(
                row
            )

        if type(row) == "table"
        and row.HideFromFinder ~= true then

            table.insert(
                output,
                row
            )
        end
    end

    return output
end

function ZanjiServerFinderSelectionMatchesText(selection, text)

    if ZanjiServerFinderAutoJoinListHasAny(selection) == true then
        return true
    end

    local haystack =
        ZanjiSniperPetAliasKey(
            text
        )

    for _, value in ipairs(selection or {}) do

        local needle =
            ZanjiSniperPetAliasKey(
                value
            )

        if needle ~= ""
        and haystack == needle then

            return true
        end
    end

    return false
end

function ZanjiServerFinderAutoJoinRowSize(row)

    return ZanjiSniperNormalizeSizeName(
        row.Size
        or row.size
        or "Normal"
    )
end

function ZanjiServerFinderAutoJoinRowVariant(row)

    local variant =
        ZanjiSniperNormalizeVariantName(
            row.Variant
            or row.variant
            or row.Mutation
            or row.mutation
            or "Normal"
        )

    if variant == "Normal" then
        return "Regular"
    end

    return variant
end

function ZanjiServerFinderSelectionContainsValue(selection, value, normalizer)

    if ZanjiServerFinderAutoJoinListHasAny(selection) == true then
        return true
    end

    if type(normalizer) == "function" then

        value =
            normalizer(
                value
            )
    end

    value =
        ZanjiCleanText(
            value
        )
        :lower()

    for _, wanted in ipairs(selection or {}) do

        wanted =
            type(normalizer) == "function"
            and normalizer(wanted)
            or wanted

        wanted =
            ZanjiCleanText(
                wanted
            )
            :lower()

        if wanted == value then
            return true
        end
    end

    return false
end

function ZanjiServerFinderRaritySelectionMatches(selection, value)

    if ZanjiServerFinderAutoJoinListHasAny(selection) == true then
        return true
    end

    local rarity =
        ZanjiCleanText(
            value
        )
        :lower()

    for _, wanted in ipairs(selection or {}) do

        if rarity == ZanjiCleanText(wanted):lower() then
            return true
        end
    end

    return false
end

function ZanjiServerFinderAutoJoinRuleMatchesRow(rule, row)

    if type(rule) ~= "table"
    or type(row) ~= "table" then

        return false
    end

    rule =
        ZanjiServerFinderNormalizeAutoJoinRule(
            rule
        )

    if rule.PetScope ~= "Any Pet" then

        local basePet =
            ZanjiCleanText(
                row.BasePet
                or row.BestPet
                or row.PetName
                or row.Pet
                or row.DisplayName
                or row.Name
            )

        if ZanjiServerFinderSelectionMatchesText(
            rule.Pets,
            basePet
        ) ~= true then

            return false
        end
    end

    if ZanjiServerFinderRaritySelectionMatches(
        rule.Rarities,
        row.Rarity
        or row.rarity
    ) ~= true then

        return false
    end

    local sizeAny =
        ZanjiServerFinderAutoJoinListHasAny(
            rule.Sizes
        )

    local variantAny =
        ZanjiServerFinderAutoJoinListHasAny(
            rule.Variants
        )

    if sizeAny == true
    and variantAny == true then

        return true
    end

    local sizeMatch =
        ZanjiServerFinderSelectionContainsValue(
            rule.Sizes,
            ZanjiServerFinderAutoJoinRowSize(row),
            ZanjiServerFinderNormalizeAutoJoinSizeName
        )

    local variantMatch =
        ZanjiServerFinderSelectionContainsValue(
            rule.Variants,
            ZanjiServerFinderAutoJoinRowVariant(row),
            ZanjiServerFinderNormalizeAutoJoinVariantName
        )

    local matchMode =
        ZanjiServerFinderNormalizeAutoJoinMatchMode(
            rule.MatchMode
        )

    if matchMode == "All Selected" then

        if sizeAny ~= true
        and sizeMatch ~= true then
            return false
        end

        if variantAny ~= true
        and variantMatch ~= true then
            return false
        end

        return true
    end

    if sizeAny ~= true
    and sizeMatch == true then
        return true
    end

    if variantAny ~= true
    and variantMatch == true then
        return true
    end

    return false
end

function ZanjiServerFinderAutoJoinScoreRow(row)

    if type(row) ~= "table" then
        return 0
    end

    local score =
        0

    score =
        score
        + (
            tonumber(row.RarityRank)
            or ZanjiServerFinderRarityRank(
                row.Rarity
            )
        ) * 100000

    local freshness =
        ZanjiCleanText(
            row.Freshness
            or row.JoinState
            or ""
        )
        :lower()

    if ZanjiServerFinderRowIsTooLate(
        row,
        SERVER_FINDER_TOO_LATE_SECONDS
    ) == true then

        freshness =
            "late"

    elseif ZanjiServerFinderRowIsStale(row) == true then

        freshness =
            "stale"

    elseif ZanjiServerFinderRowReportAge(row)
    > (
        tonumber(SERVER_FINDER_AUTO_JOIN_FRESH_SECONDS)
        or 12
    ) then

        freshness =
            "aging"

    elseif freshness == "" then

        freshness =
            "fresh"
    end

    if freshness == "fresh" then

        score =
            score + 4500

    elseif freshness == "aging" then

        score =
            score + 3000

    elseif freshness == "stale" then

        score =
            score + 1500
    end

    local variant =
        ZanjiServerFinderAutoJoinRowVariant(
            row
        )

    local size =
        ZanjiServerFinderAutoJoinRowSize(
            row
        )

    if variant == "Rainbow" then
        score =
            score + 10000
    end

    if size == "Huge" then
        score =
            score + 5000

    elseif size == "Big" then

        score =
            score + 2500
    end

    score =
        score
        + math.min(
            999,
            math.floor(
                ZanjiServerFinderRowTimeLeft(row)
            )
        )

    local playing =
        tonumber(row.Playing)
        or 0

    local maxPlayers =
        tonumber(row.MaxPlayers)
        or 8

    score =
        score
        + math.max(
            0,
            maxPlayers - playing
        ) * 10

    return score
end

function ZanjiServerFinderFindAutoJoinTarget(rows)

    ZanjiServerFinderEnsureAutoJoinState()

    rows =
        type(rows) == "table"
        and rows
        or {}

    local minLife =
        tonumber(
            ZANJI_SERVER_FINDER_STATE.AutoJoinMinLife
        )
        or 30

    local orderedFilters =
        {}

    for sourceIndex, filter in ipairs(
        ZANJI_SERVER_FINDER_STATE.AutoJoinRules
        or {}
    ) do

        table.insert(
            orderedFilters,
            {
                SourceIndex =
                    sourceIndex,

                Filter =
                    ZanjiServerFinderNormalizeAutoJoinRule(
                        filter
                    ),
            }
        )
    end

    table.sort(orderedFilters, function(a, b)

        local rankA =
            ZanjiServerFinderAutoJoinPriorityRank(
                a.Filter.Priority
            )

        local rankB =
            ZanjiServerFinderAutoJoinPriorityRank(
                b.Filter.Priority
            )

        if rankA ~= rankB then
            return rankA < rankB
        end

        return a.SourceIndex
            < b.SourceIndex
    end)

    for _, entry in ipairs(orderedFilters) do

        local candidates =
            {}

        for _, row in ipairs(rows) do

            if type(row) == "table"
            and ZanjiServerFinderRowAutoJoinFresh(
                row,
                minLife
            ) == true
            and ZanjiServerFinderAutoJoinRuleMatchesRow(
                entry.Filter,
                row
            ) == true then

                table.insert(
                    candidates,
                    {
                        RuleIndex =
                            entry.SourceIndex,

                        Rule =
                            entry.Filter,

                        Row =
                            row,

                        Score =
                            ZanjiServerFinderAutoJoinScoreRow(
                                row
                            ),
                    }
                )
            end
        end

        if #candidates > 0 then

            table.sort(candidates, function(a, b)

                if a.Score ~= b.Score then
                    return a.Score > b.Score
                end

                return tostring(
                    a.Row.DisplayName
                    or ""
                ) < tostring(
                    b.Row.DisplayName
                    or ""
                )
            end)

            return candidates[1]
        end
    end

    return nil
end

function ZanjiServerFinderRowAlive(row)

    if type(row) ~= "table" then
        return false
    end

    local expiresAt =
        tonumber(
            row.ExpiresAt
            or row.expiresAt
        )
        or 0

    if expiresAt <= 0 then
        return true
    end

    return expiresAt > os.time() - 2
        and ZanjiServerFinderRowTimeLeft(row) > 0
end

function ZanjiServerFinderRowBasePet(row)

    if type(row) ~= "table" then
