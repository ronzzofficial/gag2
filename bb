function ZanjiRareAlertBuildPayload()

    ZanjiRareAlertPruneSent()

    local rows =
        {}

    local ok,
        result =
        pcall(function()

            return ZanjiLivePetsScanRows()
        end)

    if ok == true
    and type(result) == "table" then

        rows =
            result
    end

    local pets =
        {}

    local sentKeys =
        {}

    for _, row in ipairs(rows) do

        if ZanjiRareAlertShouldReportRow(row) == true then

            local rowKey =
                ZanjiRareAlertRowKey(
                    row
                )

            if ZANJI_RARE_ALERT_STATE.Sent[rowKey] ~= true
            and ZANJI_RARE_ALERT_STATE.Sent[rowKey] == nil then

                table.insert(
                    pets,
                    ZanjiRareAlertBuildPetPayload(
                        row
                    )
                )

                table.insert(
                    sentKeys,
                    {
                        Key =
                            rowKey,

                        ExpiresAt =
                            ZanjiRareAlertRowExpiresAt(
                                row
                            ),
                    }
                )
            end
        end
    end

    if #pets <= 0 then
        return nil,
            sentKeys
    end

    local playing,
        maxPlayers =
        0,
        8

    if type(ZanjiServerFinderGetPlayerCounts) == "function" then

        playing,
            maxPlayers =
            ZanjiServerFinderGetPlayerCounts()

    else

        playing =
            #Players:GetPlayers()

        maxPlayers =
            tonumber(Players.MaxPlayers)
            or 8
    end

    return {
        Key =
            tostring(
                SERVER_FINDER_API_KEY
                or ""
            ),

        PlaceId =
            game.PlaceId,

        JobId =
            tostring(
                game.JobId
            ),

        Playing =
            playing,

        MaxPlayers =
            maxPlayers,

        ServerVersion =
            type(ZanjiServerFinderReadServerVersion) == "function"
            and ZanjiServerFinderReadServerVersion()
            or "",

        Reporter =
            tostring(
                LocalPlayer
                and LocalPlayer.Name
                or "unknown"
            ),

        Pets =
            pets,
    },
        sentKeys
end

function ZanjiRareAlertSendPayload(payload, sentKeys)

    if type(payload) ~= "table" then
        return false,
            "empty"
    end

    if type(ZanjiServerFinderRequestJson) ~= "function"
    or type(ZanjiServerFinderBackendUrl) ~= "function" then

        return false,
            "request helper missing"
    end

    local data,
        reason =
        ZanjiServerFinderRequestJson(
            "POST",
            ZanjiServerFinderBackendUrl(
                "/rare-alert"
            ),
            payload
        )

    if type(data) == "table"
    and data.ok == true then

        ZANJI_RARE_ALERT_STATE.LastReportAt =
            os.time()

        ZANJI_RARE_ALERT_STATE.LastStatus =
            "Reported "
            .. tostring(
                #(
                    payload.Pets
                    or {}
                )
            )
            .. " pet(s)"

        for _, row in ipairs(sentKeys or {}) do

            local key =
                ZanjiCleanText(
                    row.Key
                )

            if key ~= "" then

                ZANJI_RARE_ALERT_STATE.Sent[key] =
                    tonumber(row.ExpiresAt)
                    or (
                        os.time() + 300
                    )
            end
        end

        return true,
            "ok"
    end

    ZANJI_RARE_ALERT_STATE.LastError =
        tostring(reason or "request failed")

    return false,
        ZANJI_RARE_ALERT_STATE.LastError
end

function ZanjiRareAlertTick()

    ZANJI_RARE_ALERT_STATE.LastScanAt =
        os.time()

    local payload,
        sentKeys =
        ZanjiRareAlertBuildPayload()

    if type(payload) ~= "table" then
        return false
    end

    return ZanjiRareAlertSendPayload(
        payload,
        sentKeys
    )
end

function ZanjiRareAlertStart(reason)

    ZANJI_RARE_ALERT_STATE =
        type(ZANJI_RARE_ALERT_STATE) == "table"
        and ZANJI_RARE_ALERT_STATE
        or {}

    if ZANJI_RARE_ALERT_STATE.Running == true then
        return false
    end

    ZANJI_RARE_ALERT_STATE.Running =
        true

    ZANJI_RARE_ALERT_STATE.Sent =
        type(ZANJI_RARE_ALERT_STATE.Sent) == "table"
        and ZANJI_RARE_ALERT_STATE.Sent
        or {}

    local token =
        {}

    ZANJI_RARE_ALERT_STATE.Token =
        token

    task.spawn(function()

        task.wait(
            1.25
        )

        while ZANJI_RARE_ALERT_STATE.Token == token do

            pcall(function()

                ZanjiRareAlertTick()
            end)

            task.wait(
                tonumber(
                    ZANJI_RARE_ALERT_STATE.ScanInterval
                )
                or 0.85
            )
        end

        if ZANJI_RARE_ALERT_STATE.Token == token then

            ZANJI_RARE_ALERT_STATE.Running =
                false
        end
    end)

    return true
end

