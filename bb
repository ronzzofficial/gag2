function ZanjiWateringRejoinRestorePlantCollision()

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    for _, connection in ipairs(
        runtime.PlantConnections
        or {}
    ) do

        pcall(function()

            connection:Disconnect()
        end)
    end

    runtime.PlantConnections =
        {}

    for object, original in pairs(
        runtime.PlantCollisionOriginal
        or {}
    ) do

        if typeof(object) == "Instance"
        and object:IsA("BasePart")
        and type(original) == "table" then

            pcall(function()

                object.CanCollide =
                    original.CanCollide == true

                object.LocalTransparencyModifier =
                    tonumber(
                        original.LocalTransparencyModifier
                    )
                    or 0
            end)
        end
    end

    runtime.PlantCollisionOriginal =
        {}
end

function ZanjiWateringRejoinApplyPlantCollision(garden)

    ZanjiWateringRejoinRestorePlantCollision()

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local gardensRoot =
        workspace:FindFirstChild(
            "Gardens"
        )

    local scanRoot =
        gardensRoot
        or garden

    if typeof(scanRoot) ~= "Instance" then

        return false
    end

    local function isInsidePlants(object)

        local current =
            object.Parent

        while current do

            if current.Name == "Plants" then

                return true
            end

            if current == scanRoot then
                break
            end

            current =
                current.Parent
        end

        return false
    end

    local function apply(object)

        if typeof(object) ~= "Instance"
        or object:IsA("BasePart") ~= true
        or isInsidePlants(object) ~= true then

            return
        end

        if runtime.PlantCollisionOriginal[object] == nil then

            runtime.PlantCollisionOriginal[object] = {
                CanCollide =
                    object.CanCollide == true,

                LocalTransparencyModifier =
                    object.LocalTransparencyModifier,
            }
        end

        pcall(function()

            object.CanCollide =
                false

            if state.HidePlants == true then

                object.LocalTransparencyModifier =
                    1
            end
        end)
    end

    for _, object in ipairs(
        scanRoot:GetDescendants()
    ) do

        apply(
            object
        )
    end

    table.insert(
        runtime.PlantConnections,
        scanRoot.DescendantAdded:Connect(function(object)

            task.defer(function()

                if state.Enabled == true then

                    apply(
                        object
                    )
                end
            end)
        end)
    )

    return true
end

function ZanjiWateringRejoinDistanceTo(
    root,
    destination
)

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or typeof(destination) ~= "Vector3" then

        return math.huge
    end

    return (
        root.Position
        - destination
    ).Magnitude
end

function ZanjiWateringRejoinHorizontalDistanceTo(
    root,
    destination
)

    if typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or typeof(destination) ~= "Vector3" then

        return math.huge
    end

    local difference =
        root.Position
        - destination

    return Vector3.new(
        difference.X,
        0,
        difference.Z
    ).Magnitude
end

function ZanjiWateringRejoinBuildRoute(
    root,
    destination
)

    local route =
        {}

    local path =
        PathfindingService:CreatePath({
            AgentRadius = 1,
            AgentHeight = 4,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 6,
        })

    local success =
        pcall(function()

            path:ComputeAsync(
                root.Position,
                destination
            )
        end)

    if success == true
    and path.Status == Enum.PathStatus.Success then

        local waypoints =
            path:GetWaypoints()

        for index = 2, #waypoints do

            table.insert(
                route,
                waypoints[index]
            )
        end
    end

    if #route == 0 then

        table.insert(
            route,
            {
                Position =
                    destination,

                Action =
                    Enum.PathWaypointAction.Walk,
            }
        )
    end

    return route
end

function ZanjiWateringRejoinWalkTo(
    destinationCFrame,
    generation
)

    if typeof(destinationCFrame) ~= "CFrame" then

        return false,
            math.huge
    end

    local character,
        humanoid,
        root =
        ZanjiWateringRejoinGetCharacter()

    if typeof(character) ~= "Instance"
    or typeof(humanoid) ~= "Instance"
    or typeof(root) ~= "Instance"
    or root:IsA("BasePart") ~= true
    or humanoid.Health <= 0 then

        return false,
            math.huge
    end

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local destination =
        destinationCFrame.Position

    local arrivalDistance =
        4

    local startedAt =
        os.clock()

    local maximumDuration =
        90

    local lastMoveCommandAt =
        0

    local lastProgressPosition =
        root.Position

    local lastProgressAt =
        os.clock()

    local lastJumpAt =
        0

    local function isActive()

        return ZANJI_WATERING_REJOIN_STATE.Enabled == true
            and runtime.Running == true
            and runtime.Generation == generation
            and runtime.RespawnPending ~= true
            and LocalPlayer.Character == character
            and character.Parent ~= nil
            and humanoid.Parent ~= nil
            and humanoid.Health > 0
            and root.Parent ~= nil
            and os.clock() - startedAt < maximumDuration
    end

    local function faceSavedDirection()

        local lookVector =
            destinationCFrame.LookVector

        local flatLook =
            Vector3.new(
                lookVector.X,
                0,
                lookVector.Z
            )

        if flatLook.Magnitude <= 0.01 then
            return
        end

        pcall(function()

            root.CFrame =
                CFrame.lookAt(
                    root.Position,
                    root.Position
                    + flatLook.Unit
                )
        end)
    end

    local function stopAtDestination()

        pcall(function()

            humanoid:MoveTo(
                root.Position
            )

            humanoid:Move(
                Vector3.zero,
                false
            )

            humanoid.AutoRotate =
                true
        end)

        faceSavedDirection()
    end

    pcall(function()

        humanoid:UnequipTools()

        humanoid.Sit =
            false

        humanoid.PlatformStand =
            false

        humanoid.AutoRotate =
            true
    end)

    while isActive() do

        local currentDistance =
            ZanjiWateringRejoinHorizontalDistanceTo(
                root,
                destination
            )

        if currentDistance <= arrivalDistance then

            stopAtDestination()

            return true,
                currentDistance
        end

        local now =
            os.clock()

        local progressDelta =
            root.Position
            - lastProgressPosition

        local horizontalProgress =
            Vector3.new(
                progressDelta.X,
                0,
                progressDelta.Z
            ).Magnitude

        if horizontalProgress >= 0.35 then

            lastProgressPosition =
                root.Position

            lastProgressAt =
                now

        elseif now - lastProgressAt >= 1.25
        and now - lastJumpAt >= 1 then

            lastJumpAt =
                now

            lastProgressAt =
                now

            lastProgressPosition =
                root.Position

            pcall(function()

                humanoid.Sit =
                    false

                humanoid.PlatformStand =
                    false

                humanoid.Jump =
                    true
            end)
        end

        if now - lastMoveCommandAt >= 0.12 then

            lastMoveCommandAt =
                now

            pcall(function()

                humanoid.Sit =
                    false

                humanoid.PlatformStand =
                    false

                humanoid.AutoRotate =
                    true

                humanoid:MoveTo(
                    destination
                )
            end)
        end

        task.wait(
            0.04
        )
    end

    local finalDistance =
        ZanjiWateringRejoinHorizontalDistanceTo(
            root,
            destination
        )

    if finalDistance <= arrivalDistance then

        stopAtDestination()

        return true,
            finalDistance
    end

    -- Do not issue MoveTo(root.Position) here.
    -- Keeping the existing destination prevents a visible pause
    -- while recovery prepares the next movement worker.

    return false,
        finalDistance
end

function ZanjiWateringRejoinCancelTween()

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local tween =
        runtime.ActiveTween

    runtime.ActiveTween =
        nil

    if tween then

        pcall(function()

            tween:Cancel()
        end)
    end
end

function ZanjiWateringRejoinTweenTo(
    destinationCFrame,
    generation
)

    if typeof(destinationCFrame) ~= "CFrame" then

        return false,
            math.huge
    end

    local character,
        humanoid,
        root =
        ZanjiWateringRejoinGetCharacter()

    if not character
    or not humanoid
    or not root then

        return false,
            math.huge
    end

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local destination =
        destinationCFrame.Position

    local startingDistance =
        ZanjiWateringRejoinHorizontalDistanceTo(
            root,
            destination
        )

    if startingDistance <= 4 then

        pcall(function()

            root.CFrame =
                destinationCFrame
        end)

        return true,
            startingDistance
    end

    pcall(function()

        humanoid:UnequipTools()

        humanoid.Sit =
            false

        humanoid.PlatformStand =
            false

        humanoid.AutoRotate =
            false
    end)

    local speed =
        math.clamp(
            tonumber(
                state.TweenSpeed
            )
            or 30,
            5,
            100
        )

    local duration =
        math.max(
            0.1,
            (
                root.Position
                - destination
            ).Magnitude
            / speed
        )

    local TweenService =
        game:GetService(
            "TweenService"
        )

    local tween =
        TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame =
                    destinationCFrame,
            }
        )

    runtime.ActiveTween =
        tween

    local completed =
        false

    local completedConnection =
        tween.Completed:Connect(function()

            completed =
                true
        end)

    tween:Play()

    local deadline =
        os.clock()
        + duration
        + 3

    while state.Enabled == true
    and runtime.Running == true
    and runtime.Generation == generation
    and runtime.RespawnPending ~= true
    and completed ~= true
    and os.clock() < deadline do

        task.wait(
            0.05
        )
    end

    pcall(function()

        completedConnection:Disconnect()
    end)

    if runtime.ActiveTween == tween then

        runtime.ActiveTween =
            nil
    end

    if state.Enabled ~= true
    or runtime.Running ~= true
    or runtime.Generation ~= generation
    or runtime.RespawnPending == true then

        pcall(function()

            tween:Cancel()
        end)

        return false,
            ZanjiWateringRejoinHorizontalDistanceTo(
                root,
                destination
            )
    end

    pcall(function()

        humanoid.AutoRotate =
            true
    end)

    local finalDistance =
        ZanjiWateringRejoinHorizontalDistanceTo(
            root,
            destination
        )

    return finalDistance <= 4,
        finalDistance
end

function ZanjiWateringRejoinMoveTo(
    destinationCFrame,
    generation
)

    if ZANJI_WATERING_REJOIN_STATE.MovementMode
        == "Tween" then

        return ZanjiWateringRejoinTweenTo(
            destinationCFrame,
            generation
        )
    end

    return ZanjiWateringRejoinWalkTo(
        destinationCFrame,
        generation
    )
end

function ZanjiWateringRejoinBuildSafeCFrame(
    savedStandCFrame,
    savedAimPosition
)

    if typeof(savedStandCFrame) ~= "CFrame"
    or typeof(savedAimPosition) ~= "Vector3" then

        return nil
    end

    local standPosition =
        savedStandCFrame.Position

    local awayDirection =
        Vector3.new(
            standPosition.X - savedAimPosition.X,
            0,
            standPosition.Z - savedAimPosition.Z
        )

    if awayDirection.Magnitude <= 0.01 then

        local lookVector =
            savedStandCFrame.LookVector

        awayDirection =
            Vector3.new(
                -lookVector.X,
                0,
                -lookVector.Z
            )
    end

    if awayDirection.Magnitude <= 0.01 then

        return nil
    end

    local retreatDistance =
        math.clamp(
            tonumber(
                ZANJI_WATERING_REJOIN_STATE.RetreatDistance
            )
            or 30,
            15,
            80
        )

    local safePosition =
        standPosition
        + awayDirection.Unit
        * retreatDistance

    local flatAim =
        Vector3.new(
            savedAimPosition.X,
            safePosition.Y,
            savedAimPosition.Z
        )

    if (
        flatAim
        - safePosition
    ).Magnitude <= 0.01 then

        return CFrame.new(
            safePosition
        )
    end

    return CFrame.lookAt(
        safePosition,
        flatAim
    )
end

function ZanjiWateringRejoinIsNight()

    return workspace:GetAttribute(
        "ActivePhase"
    ) == "Night"
end

function ZanjiWateringRejoinShouldAvoidPlantAttacks()

    local mode =
        tostring(
            ZANJI_WATERING_REJOIN_STATE.AvoidPlantAttacksMode
            or "Night Only"
        )

    if mode == "Always" then

        return true
    end

    if mode == "Night Only" then

        return ZanjiWateringRejoinIsNight()
    end

    return false
end

function ZanjiWateringRejoinRetreatToSafety(
    savedStandCFrame,
    savedAimPosition,
    generation
)

    local safeCFrame =
        ZanjiWateringRejoinBuildSafeCFrame(
            savedStandCFrame,
            savedAimPosition
        )

    if typeof(safeCFrame) ~= "CFrame" then

        return false
    end

    local arrived =
        ZanjiWateringRejoinMoveTo(
            safeCFrame,
            generation
        )

    return arrived == true
end

function ZanjiWateringRejoinRestoreSetupHook()

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if type(runtime.SetupHookRestore) == "function" then

        pcall(
            runtime.SetupHookRestore
        )
    end

    runtime.SetupHookRestore =
        nil

    runtime.SetupArmed =
        false
end

function ZanjiWateringRejoinFinishSetupCapture(
    aimPosition,
    canName,
    tool,
    standCFrame,
    startingCount,
    setupGeneration
)

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local deadline =
        os.clock()
        + 5

    local finalCount =
        startingCount

    while runtime.SetupGeneration == setupGeneration
    and os.clock() < deadline do

        finalCount =
            tonumber(
                tool:GetAttribute(
                    "Count"
                )
            )
            or startingCount

        if finalCount < startingCount then
            break
        end

        task.wait(
            0.02
        )
    end

    ZanjiWateringRejoinRestoreSetupHook()

    pcall(function()

        tool:Deactivate()
    end)

    if finalCount >= startingCount then

        ZanjiNotify(
            "Watering Rejoin",
            "Position was not saved because watering was not confirmed.",
            5
        )

        return false
    end

    local garden =
        ZanjiWateringRejoinFindGardenAtPosition(
            aimPosition
        )

    local anchorCFrame =
        ZanjiWateringRejoinGetGardenAnchor(
            garden
        )

    local ownerUserId,
        ownerName =
        ZanjiWateringRejoinGetGardenOwner(
            garden
        )

    if not garden
    or not anchorCFrame
    or not ownerUserId then

        ZanjiNotify(
            "Watering Rejoin",
            "Could not detect the target garden owner.",
            5
        )

        return false
    end

    local state =
        ZANJI_WATERING_REJOIN_STATE

    state.TargetOwnerUserId =
        ownerUserId

    state.TargetUsername =
        ownerName

    state.WateringCan =
        canName

    state.StandOffset =
        ZanjiWateringRejoinCFrameToData(
            anchorCFrame:ToObjectSpace(
                standCFrame
            )
        )

    state.AimOffset =
        ZanjiWateringRejoinVectorToData(
            anchorCFrame:PointToObjectSpace(
                aimPosition
            )
        )

    ZanjiWateringRejoinSaveSettings()

    ZanjiNotify(
        "Watering Rejoin",
        "Target position saved for "
        .. tostring(
            ownerName ~= ""
            and ownerName
            or ownerUserId
        )
        .. ".",
        5
    )

    return true
end

function ZanjiWateringRejoinInstallSetupHook()

    if type(hookfunction) ~= "function" then

        ZanjiNotify(
            "Watering Rejoin",
            "Position capture is unavailable.",
            5
        )

        return false
    end

    ZanjiWateringRejoinRestoreSetupHook()

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local packet =
        ZanjiWateringRejoinResolvePacket()

    if not packet then
        return false
    end

    local hookTarget =
        packet.Fire

    local originalFunction =
        nil

    local wrapper =
        function(self, ...)

            local arguments =
                table.pack(...)

            local shouldCapture =
                runtime.SetupArmed == true
                and self == packet
                and typeof(arguments[1]) == "Vector3"
                and type(arguments[2]) == "string"
                and typeof(arguments[3]) == "Instance"
                and arguments[2] == ZANJI_WATERING_REJOIN_STATE.WateringCan

            local aimPosition =
                nil

            local canName =
                nil

            local tool =
                nil

            local standCFrame =
                nil

            local startingCount =
                nil

            local setupGeneration =
                nil

            if shouldCapture then

                local _,
                    _,
                    root =
                    ZanjiWateringRejoinGetCharacter()

                if root then

                    aimPosition =
                        arguments[1]

                    canName =
                        arguments[2]

                    tool =
                        arguments[3]

                    standCFrame =
                        root.CFrame

                    startingCount =
                        tonumber(
                            tool:GetAttribute(
                                "Count"
                            )
                        )

                    if startingCount then

                        runtime.SetupArmed =
                            false

                        runtime.SetupGeneration +=
                            1

                        setupGeneration =
                            runtime.SetupGeneration
                    else

                        shouldCapture =
                            false
                    end
                else

                    shouldCapture =
                        false
                end
            end

            local returnValues =
                table.pack(
                    originalFunction(
                        self,
                        table.unpack(
                            arguments,
                            1,
                            arguments.n
                        )
                    )
                )

            if shouldCapture then

                task.defer(function()

                    pcall(function()

                        tool:Deactivate()
                    end)
                end)

                task.spawn(
                    ZanjiWateringRejoinFinishSetupCapture,
                    aimPosition,
                    canName,
                    tool,
                    standCFrame,
                    startingCount,
                    setupGeneration
                )
            end

            return table.unpack(
                returnValues,
                1,
                returnValues.n
            )
        end

    if type(newcclosure) == "function" then

        wrapper =
            newcclosure(
                wrapper
            )
    end

    local success,
        result =
        pcall(
            hookfunction,
            hookTarget,
            wrapper
        )

    if success ~= true
    or type(result) ~= "function" then

        ZanjiNotify(
            "Watering Rejoin",
            "Could not install position capture.",
            5
        )

        return false
    end

    originalFunction =
        result

    runtime.SetupHookRestore =
        function()

            hookfunction(
                hookTarget,
                originalFunction
            )
        end

    return true
end

function ZanjiWateringRejoinArmSetup()

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if state.Enabled == true
    or runtime.Running == true then

        ZanjiNotify(
            "Watering Rejoin",
            "Disable Auto Watering Rejoin before setting a position.",
            5
        )

        return false
    end

    local tool =
        ZanjiWateringRejoinFindTool(
            state.WateringCan
        )

    if not tool then

        ZanjiNotify(
            "Watering Rejoin",
            state.WateringCan
            .. " was not found.",
            5
        )

        return false
    end

    if ZanjiWateringRejoinEquipTool(
        tool
    ) ~= true then

        ZanjiNotify(
            "Watering Rejoin",
            "Could not equip "
            .. state.WateringCan
            .. ".",
            5
        )

        return false
    end

    pcall(function()

        tool:Deactivate()
    end)

    if ZanjiWateringRejoinInstallSetupHook() ~= true then
        return false
    end

    runtime.SetupArmed =
        true

    runtime.SetupGeneration +=
        1

    local generation =
        runtime.SetupGeneration

    ZanjiNotify(
        "Watering Rejoin",
        "Manually water the target spot once to save it.",
        6
    )

    task.delay(
        15,
        function()

            if runtime.SetupArmed == true
            and runtime.SetupGeneration == generation then

                ZanjiWateringRejoinRestoreSetupHook()

                ZanjiNotify(
                    "Watering Rejoin",
                    "Position capture timed out.",
                    4
                )
            end
        end
    )

    return true
end

function ZanjiWateringRejoinConfirmUse(
    packet,
    aimPosition,
    toolName,
    tool,
    generation
)

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local startingCount =
        tonumber(
            tool:GetAttribute(
                "Count"
            )
        )

    if not startingCount
    or startingCount <= 0 then

        return false,
            startingCount or 0,
            false
    end

    local fireSuccess,
        fireError =
        pcall(function()

            packet:Fire(
                aimPosition,
                toolName,
                tool
            )
        end)

    if fireSuccess ~= true then

        warn(
            "[ZANJI Watering Rejoin] "
            .. tostring(fireError)
        )

        return false,
            startingCount,
            false
    end

    local deadline =
        os.clock()
        + 5

    local finalCount =
        startingCount

    local missingSince =
        nil

    while ZANJI_WATERING_REJOIN_STATE.Enabled == true
    and runtime.Running == true
    and runtime.Generation == generation
    and os.clock() < deadline do

        local observedCount =
            tonumber(
                tool:GetAttribute(
                    "Count"
                )
            )

        if observedCount then

            finalCount =
                observedCount
        end

        if finalCount < startingCount then

            return true,
                finalCount,
                true
        end

        local usableTool =
            ZanjiWateringRejoinFindUsableTool(
                toolName
            )

        if not usableTool then

            missingSince =
                missingSince
                or os.clock()

            if os.clock() - missingSince >= 0.25 then

                return true,
                    0,
                    true
            end

        else

            missingSince =
                nil
        end

        task.wait(
            0.02
        )
    end

    return false,
        finalCount,
        true
end

function ZanjiWateringRejoinOfflineAnimationActive()

    local playerGui =
        LocalPlayer
        and LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local offlineAnimation =
        playerGui
        and playerGui:FindFirstChild(
            "OfflineAnimation"
        )

    if typeof(offlineAnimation) ~= "Instance" then

        return false
    end

    if offlineAnimation:IsA("ScreenGui")
    and offlineAnimation.Enabled ~= true then

        return false
    end

    local holdLabel =
        offlineAnimation:FindFirstChild(
            "HTSLabel",
            true
        )

    if typeof(holdLabel) == "Instance"
    and holdLabel:IsA("GuiObject") then

        return holdLabel.Visible == true
    end

    return true
end

function ZanjiWateringRejoinScheduleRecovery(
    reason,
    delay
)

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if state.Enabled ~= true
    or runtime.Teleporting == true then

        return false
    end

    if runtime.RecoveryScheduled == true then

        return true
    end

    runtime.RecoveryScheduled =
        true

    runtime.Running =
        false

    runtime.Busy =
        false

    runtime.Generation +=
        1

    local recoveryGeneration =
        runtime.Generation

    ZanjiWateringRejoinCancelTween()
    ZanjiWateringRejoinEnsureRollback()

    task.spawn(function()

        task.wait(
            math.clamp(
                tonumber(delay)
                or 1,
                0.25,
                10
            )
        )

        local readyDeadline =
            os.clock()
            + 30

        while state.Enabled == true
        and runtime.Teleporting ~= true
        and runtime.Generation == recoveryGeneration
        and os.clock() < readyDeadline do

            local character,
                humanoid,
                root =
                ZanjiWateringRejoinGetCharacter()

            if character
            and humanoid
            and root
            and humanoid.Health > 0
            and ZanjiWateringRejoinOfflineAnimationActive() ~= true then

                runtime.RecoveryScheduled =
                    false

                runtime.RespawnPending =
                    false

                ZanjiWateringRejoinStart(
                    "recovery"
                )

                return
            end

            task.wait(
                0.25
            )
        end

        if runtime.Generation == recoveryGeneration then

            runtime.RecoveryScheduled =
                false
        end
    end)

    return true
end

function ZanjiWateringRejoinAbort(message)

    if type(ZanjiNotify) == "function" then

        ZanjiNotify(
            "Watering Rejoin",
            tostring(message),
            5
        )
    end

    if type(ZANJI_WATERING_REJOIN_RUNTIME.Stop) == "function" then

        ZANJI_WATERING_REJOIN_RUNTIME.Stop(
            "abort",
            false
        )
    end

    return false
end

function ZanjiWateringRejoinFinishRejoin(generation)

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    if runtime.RejoinAt == nil then

        runtime.RejoinAt =
            os.clock()
            + math.clamp(
                tonumber(
                    state.RejoinDelay
                )
                or 5,
                1,
                60
            )
    end

    ZanjiWateringRejoinEnsureRollback()

    while state.Enabled == true
    and runtime.Running == true
    and runtime.Generation == generation
    and os.clock() < runtime.RejoinAt do

        task.wait(
            0.05
        )
    end

    if state.Enabled ~= true
    or runtime.Running ~= true
    or runtime.Generation ~= generation then

        return false
    end

    ZanjiWateringRejoinEnsureRollback()
    ZanjiWateringRejoinSaveSettings()

    runtime.Teleporting =
        true

    local teleportSuccess,
        teleportError =
        pcall(function()

            TeleportService:Teleport(
                game.PlaceId,
                LocalPlayer
            )
        end)

    if teleportSuccess ~= true then

        runtime.Teleporting =
            false

        warn(
            "[ZANJI Watering Rejoin] Rejoin failed: "
            .. tostring(teleportError)
        )

        ZanjiWateringRejoinAbort(
            "Rejoin failed."
        )

        return false
    end

    return true
end

function ZanjiWateringRejoinRunCycle(generation)

    local state =
        ZANJI_WATERING_REJOIN_STATE

    local runtime =
        ZANJI_WATERING_REJOIN_RUNTIME

    local packet =
        ZanjiWateringRejoinResolvePacket()

    if not packet then

        ZanjiWateringRejoinAbort(
            "Watering packet is unavailable."
        )

        return
    end

    if ZanjiWateringRejoinEnsureRollback() ~= true then

        ZanjiWateringRejoinAbort(
            "Rollback could not be started."
        )

        return
    end

    if runtime.WateringFinished == true then

        ZanjiWateringRejoinFinishRejoin(
            generation
        )

        return
    end

    local garden,
        anchor,
        savedStandCFrame,
        savedAimPosition =
        nil,
        nil,
        nil,
        nil

    local tool =
        nil

    local loadDeadline =
        os.clock()
        + 30

    while state.Enabled == true
    and runtime.Running == true
    and runtime.Generation == generation
    and os.clock() < loadDeadline do

        garden,
            anchor,
            savedStandCFrame,
            savedAimPosition =
            ZanjiWateringRejoinResolveSavedPositions()

        tool =
            ZanjiWateringRejoinFindTool(
                state.WateringCan
            )

        local _,
            humanoid,
            root =
            ZanjiWateringRejoinGetCharacter()

        if garden
        and anchor
        and savedStandCFrame
        and savedAimPosition
        and tool
        and humanoid
        and root then

            break
        end

        task.wait(
            0.5
        )
    end

    if state.Enabled ~= true
    or runtime.Running ~= true
    or runtime.Generation ~= generation then

        return
    end

    if not garden
    or not savedStandCFrame
    or not savedAimPosition then

        ZanjiWateringRejoinAbort(
            "The saved target garden is unavailable."
        )

        return
    end

    if not tool then

        ZanjiWateringRejoinScheduleRecovery(
            state.WateringCan
            .. " is not ready yet.",
            1
        )

        return
    end

    ZanjiWateringRejoinApplyPlantCollision(
        garden
    )

    local arrived,
        finalDistance =
        ZanjiWateringRejoinMoveTo(
            savedStandCFrame,
            generation
        )

    if arrived ~= true then

        if state.Enabled == true
        and (
            runtime.Generation ~= generation
            or runtime.RespawnPending == true
        ) then

            return
        end

        ZanjiWateringRejoinScheduleRecovery(
            "Movement to the saved position was interrupted.",
            1
        )

        return
    end

    if state.Enabled ~= true
    or runtime.Running ~= true
    or runtime.Generation ~= generation then

        return
    end

    ZanjiWateringRejoinEnsureRollback()

    tool =
        ZanjiWateringRejoinFindTool(
            state.WateringCan
        )

    if not tool
    or ZanjiWateringRejoinEquipTool(tool) ~= true then

        ZanjiWateringRejoinScheduleRecovery(
            "Could not equip "
            .. state.WateringCan
            .. ".",
            1
        )

        return
    end

    local useLimit =
        math.huge

    if state.UseMode == "Custom Amount" then

        useLimit =
            math.max(
                1,
                math.floor(
                    tonumber(
                        state.UseAmount
                    )
                    or 1
                )
            )
    end

    local attemptedUses =
        math.max(
            0,
            math.floor(
                tonumber(
                    runtime.CompletedUses
                )
                or 0
            )
        )

    local confirmedUses =
        0

    local depleted =
        false

    local wateringFailure =
        nil

    while state.Enabled == true
    and runtime.Running == true
    and runtime.Generation == generation
    and attemptedUses < useLimit do

        ZanjiWateringRejoinEnsureRollback()

        local usableCount

        tool,
            usableCount =
            ZanjiWateringRejoinFindUsableTool(
                state.WateringCan
            )

        if not tool
        or usableCount <= 0 then

            depleted =
                true

            break
        end

        if ZanjiWateringRejoinEquipTool(tool) ~= true then

            wateringFailure =
                "Could not equip "
                .. state.WateringCan
                .. " while watering."

            break
        end

        local sentAt =
            os.clock()

        local confirmed,
            remainingCount,
            packetSent =
            ZanjiWateringRejoinConfirmUse(
                packet,
                savedAimPosition,
                state.WateringCan,
                tool,
                generation
            )

        if state.Enabled ~= true
        or runtime.Running ~= true
        or runtime.Generation ~= generation then

            return
        end

        if packetSent ~= true then

            wateringFailure =
                "The watering packet could not be fired."

            break
        end

        attemptedUses +=
            1

        runtime.CompletedUses =
            attemptedUses

        if confirmed == true then

            confirmedUses +=
                1
        end

        local remainingTool,
            detectedRemainingCount =
            ZanjiWateringRejoinFindUsableTool(
                state.WateringCan
            )

        remainingCount =
            tonumber(
                remainingCount
            )
            or detectedRemainingCount
            or 0

        if not remainingTool
        or detectedRemainingCount <= 0
        or remainingCount <= 0 then

            depleted =
                true
        end

        local shouldContinue =
            attemptedUses < useLimit
            and depleted ~= true
            and not (
                confirmed ~= true
                and state.UseMode == "All Available"
            )

        local retreatedForPlantAttacks =
            false

        local function retreatFromPlantAttacks()

            if retreatedForPlantAttacks == true then

                return true
            end

            local retreated =
                ZanjiWateringRejoinRetreatToSafety(
                    savedStandCFrame,
                    savedAimPosition,
                    generation
                )

            if retreated ~= true then

                if state.Enabled == true
                and runtime.Generation == generation
                and runtime.RespawnPending ~= true then

                    ZanjiWateringRejoinScheduleRecovery(
                        "Could not retreat from the plants.",
                        1
                    )
                end

                return false
            end

            retreatedForPlantAttacks =
                true

            return true
        end

        local function returnToWateringPosition()

            if retreatedForPlantAttacks ~= true then

                return true
            end

            local returnedToTarget =
                ZanjiWateringRejoinMoveTo(
                    savedStandCFrame,
                    generation
                )

            if returnedToTarget ~= true then

                if state.Enabled == true
                and runtime.Generation == generation
                and runtime.RespawnPending ~= true then

                    ZanjiWateringRejoinScheduleRecovery(
                        "Could not return to the watering position.",
                        1
                    )
                end

                return false
            end

            retreatedForPlantAttacks =
                false

            return true
        end

        if ZanjiWateringRejoinShouldAvoidPlantAttacks() == true then

            if retreatFromPlantAttacks() ~= true then

                return
            end
        end

        if shouldContinue ~= true then

            break
        end

        local interval

        if state.WateringMode == "Decay" then

            interval =
                state.WateringCan == "Super Watering Can"
                and 15
                or 10
        else

            interval =
                math.clamp(
                    tonumber(
                        state.WateringDelay
                    )
                    or 1,
                    0.1,
                    10
                )
        end

        local nextUseAt =
            sentAt
            + interval

        while state.Enabled == true
        and runtime.Running == true
        and runtime.Generation == generation
        and os.clock() < nextUseAt do

            local shouldAvoidNow =
                ZanjiWateringRejoinShouldAvoidPlantAttacks()

            if shouldAvoidNow == true
            and retreatedForPlantAttacks ~= true then

                if retreatFromPlantAttacks() ~= true then

                    return
                end

            elseif shouldAvoidNow ~= true
            and retreatedForPlantAttacks == true then

                if returnToWateringPosition() ~= true then

                    return
                end
            end

            task.wait(
                0.05
            )
        end

        if state.Enabled ~= true
        or runtime.Running ~= true
        or runtime.Generation ~= generation then

            return
        end

        if retreatedForPlantAttacks == true then

            if returnToWateringPosition() ~= true then

                return
            end
        end
    end

    if wateringFailure then

        ZanjiWateringRejoinScheduleRecovery(
            wateringFailure,
            1
        )

        return
    end

    local requestedAmountReached =
        attemptedUses >= useLimit

    local wateringCompleted =
        requestedAmountReached == true
        or depleted == true
        or attemptedUses > 0
        or confirmedUses > 0

    if wateringCompleted ~= true then

        ZanjiWateringRejoinAbort(
            "No watering attempt was completed. Rejoin cancelled."
        )

        return
    end
    if state.Enabled ~= true
    or runtime.Running ~= true
    or runtime.Generation ~= generation then

        return
    end

    runtime.WateringFinished =
        true

    if runtime.RejoinAt == nil then

        runtime.RejoinAt =
            os.clock()
            + math.clamp(
                tonumber(
                    state.RejoinDelay
                )
                or 5,
                1,
                60
            )
    end

    ZanjiWateringRejoinFinishRejoin(
        generation
    )
end

