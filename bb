function ZanjiSniperReadLiveSize(model, ref)

    local rawSize =
        ZanjiSniperReadModelAttribute(
            ref,
            {
                "PetSize",
                "Size",
                "DisplaySize",
                "ScaleType",
                "WildPetSize",
                "PetScaleType",
                "VariantSize",
            }
        )

    if rawSize == "" then

        rawSize =
            ZanjiSniperReadModelAttribute(
                model,
                {
                    "PetSize",
                    "Size",
                    "DisplaySize",
                    "ScaleType",
                    "WildPetSize",
                    "PetScaleType",
                    "VariantSize",
                }
            )
    end

    if rawSize ~= "" then

        return ZanjiSniperNormalizeSizeName(
            rawSize
        )
    end

    local scale =
        ZanjiSniperReadModelNumberAttribute(
            ref,
            {
                "Scale",
                "PetScale",
                "SizeScale",
                "SizeMulti",
                "ScaleMultiplier",
            }
        )

    if scale == nil then

        scale =
            ZanjiSniperReadModelNumberAttribute(
                model,
                {
                    "Scale",
                    "PetScale",
                    "SizeScale",
                    "SizeMulti",
                    "ScaleMultiplier",
                }
            )
    end

    if scale == nil then

        scale =
            1

        if typeof(model) == "Instance" then

            pcall(function()

                scale =
                    model:GetScale()
            end)
        end
    end

    scale =
        tonumber(scale)
        or 1

    if scale >= 3.25 then
        return "Huge"
    end

    if scale >= 1.50 then
        return "Big"
    end

    return "Normal"
end

function ZanjiSniperReadLiveVariant(model, ref)

    if ZanjiSniperReadModelBooleanAttribute(
