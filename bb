function ZanjiAutoTrowelNormalizePositionMethod(value)

    local text =
        ZanjiCleanText(
            value
        )

    if text:lower():find(
        "standing",
        1,
        true
    ) then

        return "Standing Position"
    end

    return "Click Position"
end

function ZanjiAutoTrowelNormalizeLayout(value)

    local text =
        ZanjiCleanText(
            value
        )

    if text:lower():find(
        "spiral",
        1,
        true
    ) then

        return "Compact Spiral"
    end

    return "Exact Point"
end

function ZanjiAutoTrowelReadMoveAmount(value)

    local amount =
        math.floor(
            tonumber(value)
            or 1
        )

    return math.clamp(
        amount,
        0,
        100000
    )
end

function ZanjiAutoTrowelReadSpacing(value)

    return math.clamp(
        tonumber(value)
        or 0.75,
        0,
        25
    )
end

function ZanjiAutoTrowelNormalizeSelection(value)

    local raw =
        ZanjiShopSelectionArray(
            value
        )

    local runtime =
        ZANJI_AUTO_TROWEL_RUNTIME

    local output =
        {}

    local seen =
        {}

    for _, selectedValue in ipairs(raw) do

        local displayText =
            ZanjiCleanText(
                selectedValue
            )

        local plantName =
            runtime.DisplayToPlant[displayText]
            or displayText:gsub(
                "%s+%(%d+%)$",
                ""
            )

        plantName =
            ZanjiCleanText(
                plantName
            )

        if plantName:lower() == "all plants" then

            plantName =
                "All Plants"
        end

        if plantName ~= ""
        and seen[plantName] ~= true then

            seen[plantName] =
                true

            table.insert(
                output,
                plantName
            )
        end
    end

    table.sort(output, function(a, b)

        if a == "All Plants" then
            return true
        end

        if b == "All Plants" then
            return false
        end

        return tostring(a):lower()
            < tostring(b):lower()
    end)

    return output
end

function ZanjiAutoTrowelGetSettingsData()

    local state =
        ZANJI_AUTO_TROWEL_STATE

    local targetLocal =
        nil

    if type(state.TargetLocal) == "table" then

        local x =
            tonumber(state.TargetLocal.X)

        local y =
            tonumber(state.TargetLocal.Y)

        local z =
            tonumber(state.TargetLocal.Z)

        if x and y and z then

            targetLocal = {
                X = x,
                Y = y,
                Z = z,
            }
        end
    end

    return {
        PositionMethod =
            ZanjiAutoTrowelNormalizePositionMethod(
                state.PositionMethod
            ),

        TargetLocal =
            targetLocal,

        SelectedPlants =
            ZanjiAutoTrowelNormalizeSelection(
                state.SelectedPlants
            ),

        MoveAmount =
            ZanjiAutoTrowelReadMoveAmount(
                state.MoveAmount
            ),

        Layout =
            ZanjiAutoTrowelNormalizeLayout(
                state.Layout
            ),

        Spacing =
            ZanjiAutoTrowelReadSpacing(
                state.Spacing
            ),
    }
end

