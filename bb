function ZanjiLivePetsResolveEntryForBuy(rowData)

    rowData =
        type(rowData) == "table"
        and rowData
        or {}

    local key =
        ZanjiCleanText(
            rowData.Key
            or rowData.UUID
            or ""
        )

    if key == "" then
        return nil, "missing key"
    end

    local deadline =
        os.clock() + 3

    while os.clock() <= deadline do

        local ref =
            ZanjiLivePetsFindRefByKey(
                key
            )

        if typeof(ref) ~= "Instance" then

            return nil,
                "pet gone"
        end

        local model =
            ZanjiLivePetsFindModelForRef(
                ref
            )

        if typeof(model) == "Instance"
        and model:IsA("Model") then

            local entry =
                ZanjiSniperBuildLiveEntry(
                    model
                )

            if type(entry) == "table" then

                return entry,
                    "ok"
            end
        end

        task.wait(
            0.05
        )
    end

    return nil,
        "prompt missing"
end

function ZanjiLivePetsMakeManualFilter(entry)

    entry =
        type(entry) == "table"
        and entry
        or {}

    return ZanjiSniperNormalizeFilter({
        Pet =
            entry.Pet
            or "Raccoon",

        Sizes = {
            entry.Size
            or "Any",
        },

        Variants = {
            entry.Variant
            or "Any",
        },

        Amount =
            999,

        Priority =
            "High",

        Enabled =
            true,
    })
end

function ZanjiLivePetsManualBuy(rowData)

    if type(rowData) ~= "table" then
        return false
    end

    if ZANJI_SNIPER_RUNTIME.Buying == true
    or ZANJI_SNIPER_RUNTIME.Returning == true then

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Live Pets",
                "Already buying or returning.",
                3
            )
        end

        return false
    end

    local key =
        ZanjiCleanText(
            rowData.Key
            or rowData.UUID
            or ""
        )

    local list =
        ZANJI_SNIPER_UI
        and ZANJI_SNIPER_UI.LivePetsList
        or nil

    if type(list) == "table"
    and type(list.SetStateByKey) == "function"
    and key ~= "" then

        list:SetStateByKey(
            key,
            "buying"
        )
    end

    local token =
        {}

    ZANJI_SNIPER_RUNTIME.ManualBuying =
        true

    ZANJI_SNIPER_RUNTIME.ManualToken =
        token

    local success =
        false

    local reason =
        "unknown"

    local ok,
        err =
        pcall(function()

            local entry,
                resolveReason =
                ZanjiLivePetsResolveEntryForBuy(
                    rowData
                )

            if type(entry) ~= "table" then

                reason =
                    resolveReason
                    or "target missing"

                return
            end

            local filter =
                ZanjiLivePetsMakeManualFilter(
                    entry
                )

            local match = {
                Entry =
                    entry,

                Filter =
                    filter,

                FilterIndex =
                    0,

                Manual =
                    true,
            }

            ZanjiSniperSetStatus(
                "Manual buy: "
                .. ZanjiSniperDescribeEntry(entry)
            )

            local executeReason =
                nil

            success,
                executeReason =
                ZanjiSniperExecuteMatch(
                    match,
                    token
                )

            reason =
                executeReason
                or (
                    success == true
                    and "bought"
                    or "buy failed"
                )
        end)

    if ok ~= true then

        reason =
            tostring(err)
    end

    ZANJI_SNIPER_RUNTIME.ManualBuying =
        false

    ZANJI_SNIPER_RUNTIME.ManualToken =
        nil

    if type(list) == "table"
    and type(list.SetStateByKey) == "function"
    and key ~= "" then

        list:SetStateByKey(
            key,
            success == true
            and "sent"
            or "ready"
        )
    end

    ZanjiLivePetsRefreshUI()

    if success == true then

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Live Pets",
                "Bought "
                .. tostring(rowData.DisplayName or rowData.Pet or "pet")
                .. ".",
                3
            )
        end

    else

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Live Pets",
                "Buy failed: "
                .. tostring(reason),
                4
            )
        end
    end

    return success
end

function ZanjiLivePetsCopySnapshot()

    local rows =
        ZanjiLivePetsScanRows()

    local lines =
        {}

    local function add(line)

        table.insert(
            lines,
            tostring(line or "")
        )
    end

    add("========== ZANJI LIVE WILD PETS ==========")
    add("PlaceId: " .. tostring(game.PlaceId))
    add("JobId: " .. tostring(game.JobId))
    add(ZanjiLivePetsBuildSummary(rows))
    add("Mode: " .. ZanjiSniperNormalizeMovementMode(ZANJI_SNIPER_STATE.MovementMode) .. " / " .. ZanjiSniperNormalizeBuyMode(ZANJI_SNIPER_STATE.BuyMode))
    add("")

    if #rows <= 0 then

        add("No active wild pets.")

    else

        for index, row in ipairs(rows) do

            add(
                tostring(index)
                .. ". "
                .. tostring(row.DisplayName)
                .. " | "
                .. tostring(row.Meta)
                .. " | "
                .. tostring(row.Timer)
                .. " | "
                .. tostring(row.Badge)
