        themeName

    ZANJI_DEV_UI_STATE.InterfaceTransparency =
        math.clamp(
            tonumber(
                data.InterfaceTransparency
            )
            or 0,
            0,
            70
        )

    if type(data.InterfaceAnimations) == "boolean" then

        ZANJI_DEV_UI_STATE.InterfaceAnimations =
            data.InterfaceAnimations
    end

    if type(data.ShowZanjiLoadingScreen) == "boolean" then

        ZANJI_DEV_UI_STATE.ShowZanjiLoadingScreen =
            data.ShowZanjiLoadingScreen
