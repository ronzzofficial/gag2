function ZanjiDoubleSetRowsFavorite(rows, favorite, reason)

    ZanjiDoubleEnsureState()

    rows =
        type(rows) == "table"
        and rows
        or {}

    if #rows <= 0 then

        ZanjiDoubleSetStatus(
            "🛡️ Fav skipped: no fruits"
        )

        return 0
    end

    local packet =
        ZanjiDoubleResolveFavoritePacket(
            false
        )

    if ZanjiDoubleFavoritePacketIsValid(packet) ~= true then

        task.wait(
            0.05
        )

        packet =
            ZanjiDoubleResolveFavoritePacket(
                true
            )
    end

    if ZanjiDoubleFavoritePacketIsValid(packet) ~= true then

        ZanjiDoubleSetStatus(
            "⚠️ Favorite packet missing: "
            .. tostring(
                ZANJI_SHOP_STATE.DoubleFavoritePacketLastError
                or "not found"
            )
        )

        return 0
    end

    favorite =
        favorite == true

    if favorite == true then

        ZanjiDoubleRememberTouchedRows(
            rows
        )
    end

    local completed =
        0

    local success =
        0

    local total =
        0

    for _, row in ipairs(rows) do

        local fruitId =
            ZanjiCleanText(
                row
                and row.Id
                or ""
            )

        if fruitId ~= "" then

            total =
                total + 1

            task.spawn(function()

                local ok,
                    result =
                    pcall(function()

                        return packet:Fire(
                            fruitId,
                            favorite
                        )
                    end)

                if ok == true
                and result ~= false then

                    success =
                        success + 1
                end

                completed =
                    completed + 1
            end)
        end
    end

    if total <= 0 then

        ZanjiDoubleSetStatus(
            "🛡️ Fav skipped: no fruit IDs"
        )

        return 0
    end

    local startedAt =
        os.clock()

    while completed < total
    and os.clock() - startedAt <= 2.5 do

        task.wait(
            0.02
        )
    end

    if favorite ~= true then

        ZanjiDoubleForgetTouchedRows(
            rows
        )
    end

    local actionText =
        favorite == true
        and "Fav"
        or "Unfav"

    local actionIcon =
        favorite == true
        and "🛡️"
        or "🔓"

    local packetPath =
        ZanjiCleanText(
            ZANJI_SHOP_STATE.DoubleFavoritePacketPath
            or ""
        )

    if packetPath == "" then

        packetPath =
            "favorite packet"
    end

    ZanjiDoubleSetStatus(
        actionIcon
        .. " "
        .. actionText
        .. " sent: "
        .. tostring(success)
        .. "/"
        .. tostring(total)
    )

    return success
end

function ZanjiDoubleReleaseRows(rows, reason, delayOverride)

    rows =
        type(rows) == "table"
        and rows
        or {}

    if #rows <= 0 then
        return 0
    end

    local delaySeconds =
        delayOverride

    if delaySeconds == nil then

        delaySeconds =
            ZanjiDoubleReadDelay(
                ZANJI_SHOP_STATE.DoubleUnfavoriteDelay,
                1.00,
                10
            )
    end

    delaySeconds =
        math.max(
            0,
            tonumber(delaySeconds)
            or 0
        )

    if delaySeconds > 0 then

        task.wait(
            delaySeconds
        )
    end

    return ZanjiDoubleSetRowsFavorite(
        rows,
        false,
        reason or "release"
    )
end

function ZanjiDoubleUnfavoriteTouchedRows(reason)

    local touchedRows =
        ZanjiDoubleGetTouchedRows()

    if #touchedRows <= 0 then
        return 0
    end

    return ZanjiDoubleReleaseRows(
        touchedRows,
        reason or "restore touched",
        0
    )
end

function ZanjiDoubleUpdateFromRollResult(result)

    ZanjiDoubleEnsureState()

    result =
        type(result) == "table"
        and result
        or {}

    if result.Won == true then

        ZANJI_SHOP_STATE.DoubleLastResult =
            "Won"

        ZANJI_SHOP_STATE.DoubleLastWins =
            tonumber(result.Wins)
            or ZANJI_SHOP_STATE.DoubleLastWins
            or 0

        ZANJI_SHOP_STATE.DoubleLastPot =
            tonumber(result.Pot)
            or ZANJI_SHOP_STATE.DoubleLastPot
            or 0

        ZANJI_SHOP_STATE.DoubleLastMultiplier =
            tonumber(result.Multiplier)
            or ZANJI_SHOP_STATE.DoubleLastMultiplier
            or 1

        ZANJI_SHOP_STATE.DoubleLastStakeCount =
            tonumber(result.StakeCount)
            or ZANJI_SHOP_STATE.DoubleLastStakeCount
            or 0

    elseif result.Busted == true then

        ZANJI_SHOP_STATE.DoubleLastResult =
            "Busted"

        ZANJI_SHOP_STATE.DoubleLastWins =
            tonumber(result.Wins)
            or 0

        ZANJI_SHOP_STATE.DoubleLastPot =
            0

        ZANJI_SHOP_STATE.DoubleLastStakeCount =
            tonumber(result.LostCount)
            or ZANJI_SHOP_STATE.DoubleLastStakeCount
            or 0
    end

    ZanjiDoubleUpdateHud()
end

function ZanjiDoubleUpdateFromCashout(result)

