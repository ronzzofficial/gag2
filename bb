-- [2.005] TOP LAYER COLOR
--==================================================

local previousTopLayerRuntime =
    type(ZANJI_TOP_LAYER_RUNTIME) == "table"
    and ZANJI_TOP_LAYER_RUNTIME
    or nil

if previousTopLayerRuntime
and previousTopLayerRuntime.WatchConnection then

    pcall(function()

        previousTopLayerRuntime.WatchConnection:Disconnect()
    end)
end

ZANJI_TOP_LAYER_RUNTIME = {
    OriginalColors =
        previousTopLayerRuntime
        and previousTopLayerRuntime.OriginalColors
        or setmetatable(
            {},
            {
                __mode = "k",
            }
        ),

    PrimaryOriginal =
        previousTopLayerRuntime
        and previousTopLayerRuntime.PrimaryOriginal
        or nil,

    WatchConnection = nil,
    ApplyGeneration = 0,
    SaveGeneration = 0,
}

function ZanjiTopLayerGetParts()

    local baseplate =
        workspace:FindFirstChild(
            "Baseplate"
        )

    local topLayer =
        baseplate
        and baseplate:FindFirstChild(
            "TopLayer"
        )
        or nil

    local parts = {}

    if not topLayer then

        return parts,
            nil
    end

    if topLayer:IsA("BasePart") then

        table.insert(
            parts,
            topLayer
        )

    else

        for _, descendant in ipairs(
            topLayer:GetDescendants()
        ) do

            if descendant:IsA("BasePart") then

                table.insert(
                    parts,
                    descendant
                )
            end
        end
    end

    return parts,
        topLayer
end

function ZanjiTopLayerGetSavedColor()

    local saved =
        type(ZANJI_DEV_UI_STATE.TopLayerColor) == "table"
        and ZANJI_DEV_UI_STATE.TopLayerColor
        or {}

    return Color3.fromRGB(
        math.clamp(
            math.floor(
                tonumber(saved.R)
                or 211
            ),
            0,
            255
        ),

        math.clamp(
            math.floor(
                tonumber(saved.G)
                or 190
            ),
            0,
            255
        ),

        math.clamp(
            math.floor(
                tonumber(saved.B)
                or 150
            ),
            0,
            255
        )
    )
end

function ZanjiTopLayerCaptureOriginal()

    local parts =
        ZanjiTopLayerGetParts()

    for _, part in ipairs(parts) do

        if ZANJI_TOP_LAYER_RUNTIME.OriginalColors[
            part
        ] == nil then

            ZANJI_TOP_LAYER_RUNTIME.OriginalColors[
                part
            ] =
                part.Color
        end

        if ZANJI_TOP_LAYER_RUNTIME.PrimaryOriginal == nil then

            ZANJI_TOP_LAYER_RUNTIME.PrimaryOriginal =
                ZANJI_TOP_LAYER_RUNTIME.OriginalColors[
                    part
                ]
        end
    end

    return #parts > 0
end

function ZanjiTopLayerRestore()

    local parts =
        ZanjiTopLayerGetParts()

    for _, part in ipairs(parts) do

        local original =
            ZANJI_TOP_LAYER_RUNTIME.OriginalColors[
                part
            ]

        if typeof(original) == "Color3" then

            pcall(function()

                part.Color =
                    original
            end)
        end
    end

    return #parts > 0
end

function ZanjiTopLayerApply()

    ZanjiTopLayerCaptureOriginal()

    if ZANJI_DEV_UI_STATE.TopLayerColorEnabled ~= true then

        return ZanjiTopLayerRestore()
    end

    local selectedColor =
        ZanjiTopLayerGetSavedColor()

    local parts =
        ZanjiTopLayerGetParts()

    for _, part in ipairs(parts) do

        pcall(function()

            part.Color =
                selectedColor
        end)
    end

    return #parts > 0
end

function ZanjiTopLayerQueueSave()

    ZANJI_TOP_LAYER_RUNTIME.SaveGeneration +=
        1

    local generation =
        ZANJI_TOP_LAYER_RUNTIME.SaveGeneration

    task.delay(
        0.3,
        function()

            if ZANJI_TOP_LAYER_RUNTIME.SaveGeneration
                ~= generation
            then

                return
            end

            ZanjiSaveUISettings()
        end
    )
end

function ZanjiTopLayerSetColor(value)

    if typeof(value) ~= "Color3" then

        return false
    end

    ZANJI_DEV_UI_STATE.TopLayerColor = {
        R =
            math.clamp(
                math.floor(
                    value.R * 255
                    + 0.5
                ),
                0,
                255
            ),

        G =
            math.clamp(
                math.floor(
                    value.G * 255
                    + 0.5
                ),
                0,
                255
            ),

        B =
            math.clamp(
                math.floor(
                    value.B * 255
                    + 0.5
                ),
                0,
                255
            ),
    }

    if ZANJI_DEV_UI_STATE.TopLayerColorEnabled == true then

        ZanjiTopLayerApply()
    end

    ZanjiTopLayerQueueSave()

    return true
end

function ZanjiTopLayerSetEnabled(value)

    ZANJI_DEV_UI_STATE.TopLayerColorEnabled =
        value == true

    ZanjiTopLayerApply()
    ZanjiSaveUISettings()

    return ZANJI_DEV_UI_STATE.TopLayerColorEnabled
end

function ZanjiTopLayerReset()

    ZanjiTopLayerCaptureOriginal()

    local original =
        ZANJI_TOP_LAYER_RUNTIME.PrimaryOriginal

    ZANJI_DEV_UI_STATE.TopLayerColorEnabled =
        false

    if typeof(original) == "Color3" then

        ZANJI_DEV_UI_STATE.TopLayerColor = {
            R =
                math.floor(
                    original.R * 255
                    + 0.5
                ),

            G =
                math.floor(
                    original.G * 255
                    + 0.5
                ),

            B =
                math.floor(
                    original.B * 255
                    + 0.5
                ),
        }
    end

    ZanjiTopLayerRestore()
    ZanjiSaveUISettings()

    return original
end

function ZanjiTopLayerScheduleApply()

    ZANJI_TOP_LAYER_RUNTIME.ApplyGeneration +=
        1

    local generation =
        ZANJI_TOP_LAYER_RUNTIME.ApplyGeneration

    task.delay(
        0.1,
        function()

            if ZANJI_TOP_LAYER_RUNTIME.ApplyGeneration
                ~= generation
            then

                return
            end

            ZanjiTopLayerApply()
        end
    )
end

function ZanjiTopLayerStart()

    ZanjiTopLayerApply()

    if ZANJI_TOP_LAYER_RUNTIME.WatchConnection then

        ZANJI_TOP_LAYER_RUNTIME.WatchConnection:Disconnect()
    end

    ZANJI_TOP_LAYER_RUNTIME.WatchConnection =
        workspace.DescendantAdded:Connect(function(instance)

            local current =
                instance

            while current
            and current ~= workspace
            do

                if current.Name == "TopLayer" then

                    local parent =
                        current.Parent

                    if parent
                    and parent.Name == "Baseplate"
                    and parent.Parent == workspace
                    then

                        ZanjiTopLayerScheduleApply()

                        return
                    end
                end

                current =
                    current.Parent
            end
        end)

    return true
end

function ZanjiTopLayerStop(restoreOriginal)

    if ZANJI_TOP_LAYER_RUNTIME.WatchConnection then

        pcall(function()

            ZANJI_TOP_LAYER_RUNTIME.WatchConnection:Disconnect()
        end)

        ZANJI_TOP_LAYER_RUNTIME.WatchConnection =
            nil
    end

    if restoreOriginal == true then

        ZanjiTopLayerRestore()
    end

    return true
end


