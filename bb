function ZanjiFarmMutatedWeightOverrideAllowsEntry(entry)

    ZanjiFarmEnsureState()

    if type(entry) ~= "table"
    or ZANJI_FARM_STATE.MutatedWeightOverride ~= true then

        return false
    end

    local threshold =
        ZanjiFarmReadWeightThresholdKg(
            ZANJI_FARM_STATE.MutatedWeightOverrideKg
        )

    if threshold <= 0 then
        return false
    end

    local mutations =
        ZanjiFarmReadEntryMutations(
            entry
        )

    if type(mutations) ~= "table"
    or #mutations <= 0 then

        return false
    end

    local predictedKg =
        ZanjiFarmPredictEntryWeightKg(
            entry
        )

    predictedKg =
        tonumber(predictedKg)

    if predictedKg == nil then
        return false
    end

    return predictedKg >= threshold
end

function ZanjiFarmCollectionAllowsEntry(entry)

    if type(entry) ~= "table" then
        return false
    end

    if ZanjiFarmMutatedWeightOverrideAllowsEntry(
        entry
    ) == true then

        return true
    end

    if ZanjiFarmSelectionAllowsPlant(
        entry.PlantName
    ) ~= true then

        return false
    end

    if ZanjiFarmMutationAllowsEntry(
        entry
    ) ~= true then

