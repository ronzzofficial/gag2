            true
        ) then
            return {
                Group =
                    "Gear",

                Category =
                    "WateringCans",

                ItemKey =
                    name,

                Name =
                    name,

                Details =
                    "Watering Can",

                Unique =
                    false,

                Supported =
                    true,

                Favorite =
                    readOwnedFavorite(
                        item
                    ),

                Count =
                    readOwnedCount(
                        item,
                        false
                    ),

                Instance =
                    item,
            }
        end

        if gearKey:find(
