function ZanjiServerFinderAutoJoinHoldBlocks(rows)

    ZanjiServerFinderEnsureAutoJoinState()

    rows =
        type(rows) == "table"
        and rows
        or {}

    local hold =
        ZANJI_SERVER_FINDER_STATE.AutoJoinHold

    if type(hold) == "table"
    and hold.Active == true then

        if hold.JobId == tostring(game.JobId) then

            if ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.HoldArrivedJobId ~= tostring(game.JobId) then

                ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.HoldArrivedJobId =
                    tostring(game.JobId)

                ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.HoldArrivedAt =
                    os.clock()
            end

            local targetRow =
                ZanjiServerFinderFindHoldTargetInCurrentRows(
                    rows,
                    hold
                )

            if targetRow then

                ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.LastHoldStatus =
                    "Holding "
                    .. tostring(
                        targetRow.DisplayName
                        or hold.DisplayName
                        or "target"
                    )

                return true,
                    "hold target present"
            end

            local arrivedAt =
                tonumber(
                    ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.HoldArrivedAt
                )
                or os.clock()

            local grace =
                tonumber(
                    ZANJI_SERVER_FINDER_STATE.AutoJoinHoldLoadGrace
                )
                or 22

            if os.clock() - arrivedAt < grace then

                ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.LastHoldStatus =
                    "Waiting for target data"

                return true,
                    "waiting for target data"
            end

            ZanjiServerFinderClearAutoJoinHold(
                "hold target gone"
            )

        elseif os.time() - (
            tonumber(hold.CreatedAt)
            or os.time()
        ) > 120 then

            ZanjiServerFinderClearAutoJoinHold(
                "stale hold"
            )
        end
    end

    local currentTarget =
        ZanjiServerFinderFindCurrentAutoJoinTarget(
            rows
        )

    if type(currentTarget) == "table"
    and type(currentTarget.Row) == "table" then

        ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.LastHoldStatus =
            "Current match "
            .. tostring(
                currentTarget.Row.DisplayName
                or currentTarget.Row.Pet
                or "pet"
            )

        return true,
            "current server has matching pet"
    end

    return false,
        "clear"
end

function ZanjiServerFinderJoinRow(row, source, targetInfo)

    if ZanjiAuthRequireServerSniper(
        tostring(source or "Server Finder Join"),
        true
    ) ~= true then

        return false
    end

    if type(row) ~= "table" then
        return false
    end

    local jobId =
        ZanjiServerFinderRowJobId(
            row
        )

    local placeId =
        tonumber(
            row.PlaceId
            or row.placeId
            or game.PlaceId
        )
        or game.PlaceId

    if jobId == "" then
        return false
    end

    if jobId == tostring(game.JobId) then

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Server Finder",
                "Already in this server.",
                3
            )
        end

        return false
    end

    if ZanjiSniperServerSwitchBlocked(
        "Server Finder",
        true
    ) == true then

        return false
    end

    if ZanjiServerFinderRowManualJoinAllowed(row) ~= true then

        local reason =
            tostring(
                row.JoinText
                or row.Freshness
                or "not fresh"
            )

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Server Finder",
                "Join blocked: "
                .. reason
                .. ". Refresh or wait for a fresh report.",
                4
            )
        end

        return false
    end

    ZanjiServerFinderArmAutoJoinHold(
        row,
        source,
        targetInfo
    )

    ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.Teleporting =
        true

    ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.LastTargetKey =
        ZanjiServerFinderRowKey(
            row
        )

    if type(ZanjiNotify) == "function" then

        ZanjiNotify(
            "ZANJI Server Finder",
            tostring(source or "Joining")
            .. ": "
            .. tostring(row.DisplayName or row.Pet or "server"),
            3
        )
    end

    local startedJobId =
        tostring(game.JobId)

    local ok,
        err =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                placeId,
                jobId,
                LocalPlayer
            )
        end)

    if ok ~= true then

        ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.Teleporting =
            false

        ZanjiServerFinderClearAutoJoinHold(
            "teleport failed"
        )

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Server Finder",
                "Teleport failed: "
                .. tostring(err),
                4
            )
        end

        return false
    end

    task.delay(12, function()

        if tostring(game.JobId) == startedJobId
        and type(ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME) == "table" then

            ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.Teleporting =
                false
        end
    end)

    return true
end

function ZanjiServerFinderEvaluateAutoJoin(hud)

    ZanjiServerFinderEnsureAutoJoinState()

    local mode =
        ZanjiServerFinderNormalizeAutoJoinMode(
            ZANJI_SERVER_FINDER_STATE.AutoJoinMode
        )

    if mode == "Off" then
        return false
    end

    if ZanjiAuthRequireServerSniper(
        "Auto Join",
        false
    ) ~= true then

        ZANJI_SERVER_FINDER_STATE.AutoJoinMode =
            "Off"

        if type(hud) == "table"
        and type(hud.SetAutoJoinMode) == "function" then

            pcall(function()

                hud:SetAutoJoinMode(
                    "Off"
                )
            end)
        end

        ZanjiQueueSaveServerFinderSettings()

        return false
    end

    if ZanjiSniperServerSwitchBlocked(
        "Auto Join",
        false
    ) == true then

        return false
    end

    if ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.Teleporting == true then
        return false
    end

    local rows =
        type(hud) == "table"
        and type(hud.Rows) == "table"
        and hud.Rows
        or {}

    local holdBlocked =
        ZanjiServerFinderAutoJoinHoldBlocks(
            rows
        )

    if holdBlocked == true then
        return false
    end

    local now =
        os.clock()

    local cooldown =
        tonumber(
            ZANJI_SERVER_FINDER_STATE.AutoJoinCooldown
        )
        or 10

    if now - (
        tonumber(
            ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.LastAttemptAt
        )
        or 0
    ) < cooldown then

        return false
    end

    local target =
        ZanjiServerFinderFindAutoJoinTarget(
            rows
        )

    if type(target) ~= "table"
    or type(target.Row) ~= "table" then

        return false
    end

    local row =
        target.Row

    ZANJI_SERVER_FINDER_AUTO_JOIN_RUNTIME.LastAttemptAt =
        now

    if mode == "Notify" then

        if type(ZanjiNotify) == "function" then

            ZanjiNotify(
                "ZANJI Auto Join",
                "Matched target #"
                .. tostring(target.RuleIndex)
                .. ": "
                .. tostring(row.DisplayName or row.Pet or "server"),
                5
            )
        end

        return true
    end

    return ZanjiServerFinderJoinRow(
        row,
        "Auto Join",
        target
    )
end

