function ZanjiSniperFormatMoney(value)

    value =
        math.max(
            0,
            tonumber(value)
            or 0
        )

    if value >= 1000000 then

        return "$"
            .. string.format(
                "%.1fM",
                value / 1000000
            )
    end

    if value >= 1000 then

        return "$"
            .. string.format(
                "%.0fK",
                value / 1000
            )
    end

    return "$"
        .. tostring(
            math.floor(value)
        )
end

