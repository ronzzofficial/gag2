function ZanjiDefenseGetInventoryPetRows()

    local rows =
        {}

    local seen =
        {}

    local roots = {
        ZanjiDefenseGetCharacter(),

        LocalPlayer
        and LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )
        or nil,
    }

    local function inspect(instance)

        if typeof(instance) ~= "Instance"
        or seen[instance] == true then

            return
        end

        seen[instance] =
            true

        local petId =
            ZanjiDefenseReadPetId(
                instance
            )

        local petName =
            ZanjiDefenseReadPetName(
                instance
            )

        if petId == ""
        and petName == "" then

            return
        end

        if petName == ""
        and instance:IsA("Tool") then

            petName =
                ZanjiCleanText(
                    instance.Name
                )
        end

        table.insert(
            rows,
            {
                Instance =
                    instance,

                PetIdKey =
                    ZanjiDefenseNormalizeId(
                        petId
                    ),

                PetNameKey =
                    ZanjiSniperPetAliasKey(
                        petName
                    ),
            }
        )
    end

    for _, root in ipairs(roots) do

        if typeof(root) == "Instance" then

            for _, descendant in ipairs(
                root:GetDescendants()
            ) do

                inspect(
                    descendant
                )
            end
        end
    end

    return rows
end

function ZanjiDefenseCaptureInventoryBaseline()

    local runtime =
        ZanjiDefenseEnsureRuntime()

    runtime.InventoryBaselineInstances =
        {}

    runtime.InventoryBaselineIds =
        {}

    for _, row in ipairs(
        ZanjiDefenseGetInventoryPetRows()
    ) do

        runtime.InventoryBaselineInstances[
            row.Instance
        ] =
            true

        if row.PetIdKey ~= "" then

            runtime.InventoryBaselineIds[
                row.PetIdKey
            ] =
                true
        end
    end
end

function ZanjiDefenseInventoryConfirmed(forceCheck)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if runtime.InventoryConfirmed == true then

        return true,
            runtime.InventoryConfirmationItem
    end

    local now =
        os.clock()

    if forceCheck ~= true
    and now - (
        tonumber(runtime.LastInventoryCheckAt)
        or 0
    ) < 0.10 then

        return false,
            nil
    end

    runtime.LastInventoryCheckAt =
        now

    local targetIdKey =
        ZanjiDefenseNormalizeId(
            runtime.TargetPetId
        )

    local targetNameKey =
        ZanjiSniperPetAliasKey(
            runtime.TargetPetName
        )

    for _, row in ipairs(
        ZanjiDefenseGetInventoryPetRows()
    ) do

        local exactId =
            targetIdKey ~= ""
            and row.PetIdKey ~= ""
            and row.PetIdKey == targetIdKey

        local newMatchingPet =
            targetNameKey ~= ""
            and row.PetNameKey == targetNameKey
            and (
                runtime.InventoryBaselineInstances[
                    row.Instance
                ] ~= true
                or (
                    row.PetIdKey ~= ""
                    and runtime.InventoryBaselineIds[
                        row.PetIdKey
                    ] ~= true
                )
            )

        if exactId == true
        or newMatchingPet == true then

            runtime.InventoryConfirmed =
                true

            runtime.InventoryConfirmationItem =
                row.Instance

            return true,
                row.Instance
        end
    end

    return false,
        nil
end

function ZanjiDefenseSelectedGearEquipped()

    return ZanjiDefenseToolMatches(
        ZanjiDefenseGetEquippedTool(),
        ZANJI_SNIPER_STATE.DefendGear
    ) == true
end

function ZanjiDefenseEquipSelectedGear(reason)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
    or runtime.Active ~= true
    or runtime.GearLockActive ~= true
    or runtime.InventoryConfirmed == true then

        return false
    end

    if ZanjiDefenseSelectedGearEquipped() == true then

        runtime.DefenseTool =
            ZanjiDefenseGetEquippedTool()

        return true
    end

    if runtime.EquipPending == true then
        return false
    end

    local now =
        os.clock()

    if now - (
        tonumber(runtime.LastEquipAt)
        or 0
    ) < runtime.ReequipCooldown then

        return false
    end

    local tool =
        ZanjiDefenseFindTool(
            ZANJI_SNIPER_STATE.DefendGear
        )

    local humanoid =
        ZanjiDefenseGetHumanoid()

    if typeof(tool) ~= "Instance"
    or typeof(humanoid) ~= "Instance" then

        return false
    end

    runtime.EquipPending =
        true

    local ok =
        pcall(function()

            humanoid:EquipTool(
                tool
            )
        end)

    runtime.EquipPending =
        false

    if ok == true then

        runtime.DefenseTool =
            tool

        runtime.LastEquipAt =
            os.clock()

        runtime.LastEquipReason =
            tostring(
                reason
                or "defense"
            )
    end

    return ok == true
end

function ZanjiDefenseQueueReequip(reason)

    local runtime =
        ZanjiDefenseEnsureRuntime()

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
    or runtime.Active ~= true
    or runtime.GearLockActive ~= true
    or runtime.InventoryConfirmed == true then

        return false
    end

    runtime.ReequipToken =
        (
            tonumber(runtime.ReequipToken)
            or 0
        )
        + 1

    local token =
        runtime.ReequipToken

    task.delay(0.12, function()

        local liveRuntime =
            ZanjiDefenseEnsureRuntime()

        if liveRuntime.ReequipToken ~= token
        or ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
        or liveRuntime.Active ~= true
        or liveRuntime.GearLockActive ~= true
        or liveRuntime.InventoryConfirmed == true
        or ZanjiDefenseSelectedGearEquipped() == true then

            return
        end

        ZanjiDefenseEquipSelectedGear(
            reason
            or "defense tool unequipped"
        )
    end)

    return true
end

function ZanjiDefenseStartGearLock()

    local runtime =
        ZanjiDefenseEnsureRuntime()

    ZanjiDefenseDisconnectGearLock()

    if ZANJI_SNIPER_STATE.DefendBoughtPets ~= true
    or runtime.Active ~= true then

        return false
    end

    runtime.GearLockActive =
        true

    runtime.InventoryConfirmed =
        false

    runtime.InventoryConfirmationItem =
        nil

    runtime.LastEquipAt =
        0

    ZanjiDefenseCaptureInventoryBaseline()

    local character =
        ZanjiDefenseGetCharacter()

    if typeof(character) == "Instance" then

        ZanjiDefenseAddGearConnection(
            character.ChildRemoved:Connect(function(child)

                if child == runtime.DefenseTool
                or ZanjiDefenseToolMatches(
                    child,
                    ZANJI_SNIPER_STATE.DefendGear
                ) == true then

                    ZanjiDefenseQueueReequip(
                        "defense tool unequipped"
                    )
                end
            end)
        )

        ZanjiDefenseAddGearConnection(
            character.ChildAdded:Connect(function(child)

                if child:IsA("Tool")
                and ZanjiDefenseToolMatches(
                    child,
                    ZANJI_SNIPER_STATE.DefendGear
                ) ~= true then

                    ZanjiDefenseQueueReequip(
                        "another tool equipped"
                    )
                end
            end)
        )
    end

    local backpack =
        LocalPlayer
        and LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )
        or nil

    if typeof(backpack) == "Instance" then

        ZanjiDefenseAddGearConnection(
            backpack.ChildAdded:Connect(function(child)

                if ZanjiDefenseToolMatches(
                    child,
                    ZANJI_SNIPER_STATE.DefendGear
                ) == true then

                    ZanjiDefenseQueueReequip(
                        "defense tool returned to backpack"
                    )
                end
            end)
        )
    end

    ZanjiDefenseEquipSelectedGear(
        "defense start"
    )

    return true
end

function ZanjiDefenseBuildEntryFromRef(ref)

    if typeof(ref) ~= "Instance"
    or ref.Parent == nil then

        return nil
    end

    local model =
        nil

    if type(ZanjiLivePetsFindModelForRef) == "function" then

        model =
            ZanjiLivePetsFindModelForRef(
                ref
            )
    end

    local petName =
        ZanjiSniperReadLivePetName(
            model,
            ref
        )

    petName =
        ZanjiSniperResolvePetDisplay(
            petName
        )

    if petName == "" then
        return nil
    end

    local uuid =
        ZanjiSniperUuidFromName(
            ref.Name
        )

    if uuid == "" then

        uuid =
            ZanjiDefenseReadPetId(
                ref
            )
    end

    return {
        Key =
            uuid,

        UUID =
            uuid,

        Ref =
            ref,

        Model =
            model,

        Pet =
            petName,

        PetKey =
            ZanjiSniperResolvePetKey(
                petName
            ),

        Size =
            ZanjiSniperReadLiveSize(
                model,
                ref
            ),

        Variant =
            ZanjiSniperReadLiveVariant(
                model,
                ref
            ),

        Price =
            tonumber(
                ZanjiDefenseReadAnyAttr(
                    ref,
                    {
                        "Price",
                        "Cost",
                        "TameCost",
                    }
                )
            )
            or 0,
    }
end

function ZanjiDefenseFindFilterForEntry(entry)

    local best =
        nil

    local bestRank =
        math.huge

    for _, rawFilter in ipairs(
        type(ZANJI_SNIPER_STATE.Watchlist) == "table"
        and ZANJI_SNIPER_STATE.Watchlist
        or {}
    ) do

        local filter =
            ZanjiSniperNormalizeFilter(
                rawFilter
            )

        local filterPetKey =
            ZanjiCleanText(
                filter.PetKey
            )

        local petMatches =
            filterPetKey == "*"
            or ZanjiSniperPetAliasKey(
                filterPetKey
            ) == ZanjiSniperPetAliasKey(
                entry.PetKey
                or entry.Pet
            )

        local sizeMatches =
            ZanjiSniperSelectionHasAny(
                filter.Sizes
            )
            or ZanjiSniperSelectionContains(
                filter.Sizes,
                entry.Size
            )

        local variantMatches =
            ZanjiSniperSelectionHasAny(
                filter.Variants
            )
            or ZanjiSniperSelectionContains(
                filter.Variants,
                entry.Variant
            )

        local rank =
            ZanjiSniperPriorityRank(
                filter.Priority
            )

        if filter.Enabled ~= false
        and petMatches == true
        and sizeMatches == true
        and variantMatches == true
        and rank < bestRank then

            best =
                filter

            bestRank =
                rank
        end
    end

    if type(best) == "table" then
        return best
    end

    return ZanjiSniperNormalizeFilter({
        Pet =
            entry.Pet,

        Sizes = {
            entry.Size
            or "Any",
        },

        Variants = {
            entry.Variant
            or "Any",
        },

        MaxPrice =
            0,

        Priority =
            "Medium",

        Enabled =
            true,
    })
end

function ZanjiDefenseRefReady(ref)

    if typeof(ref) ~= "Instance"
    or ref.Parent == nil then

