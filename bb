function ZanjiServerPruneFailedServers()

    local state =
        ZanjiServerNormalizeState()

    local now =
        os.time()

    for jobId, row in pairs(state.FailedServers or {}) do

        local expiresAt =
            0

        if type(row) == "table" then

            expiresAt =
                tonumber(row.ExpiresAt)
                or 0

        else

            expiresAt =
                tonumber(row)
                or 0
        end

        if expiresAt <= now then

            state.FailedServers[jobId] =
                nil
        end
    end
end

