function ZanjiGuildBuildContestText()

    local root =
        ZanjiGuildContestRoot()

    if type(root) ~= "table" then
        return "Competition data is not loaded."
    end

    local phase =
        ZanjiCleanText(
            ZanjiGuildField(
                root,
                {
                    "Phase",
                    "Status",
                    "State",
                },
                "Unknown"
            )
        )

    local phaseLower =
        phase:lower()

    local active =
        ZanjiGuildField(
            root,
            {
                "CurrentCompetition",
                "Current",
                "ActiveCompetition",
                "Competition",
            }
        )

    local previous =
        ZanjiGuildField(
            root,
            {
                "PreviousCompetition",
                "Previous",
                "LastCompetition",
            }
        )

    local shown =
        phaseLower == "active"
        and type(active) == "table"
        and active
        or (
            type(previous) == "table"
            and previous
            or (
                type(active) == "table"
                and active
                or root
            )
        )

    local name =
        ZanjiCleanText(
            ZanjiGuildField(
                shown,
                {
                    "Name",
                    "Title",
                    "DisplayName",
                },
                phaseLower == "pending"
                and "Next Guild Competition"
                or "Guild Competition"
            )
        )

    local objective =
        ZanjiCleanText(
            ZanjiGuildField(
                shown,
                {
                    "Objective",
                    "Description",
                    "ObjectiveDescription",
                    "ObjectiveTag",
                    "Tag",
                },
                "Objective unavailable"
            )
        )

    local mode =
        ZanjiCleanText(
            ZanjiGuildField(
                shown,
                {
                    "Mode",
                    "WinMode",
                    "ScoringMode",
                },
                ""
            )
        )

    local scoreFormat =
        ZanjiCleanText(
            ZanjiGuildField(
                shown,
                {
                    "ScoreFormat",
                    "Format",
                    "Unit",
                },
                "Number"
            )
        )

    local startsAt =
        ZanjiGuildEpoch(
            ZanjiGuildField(
                root,
                {
                    "NextCompetitionStart",
                    "NextStartAt",
                    "StartsAt",
                    "StartTime",
                }
            )
            or ZanjiGuildField(
                shown,
                {
                    "StartsAt",
                    "StartTime",
                }
            )
        )

    local endsAt =
        ZanjiGuildEpoch(
            ZanjiGuildField(
                shown,
                {
                    "EndsAt",
                    "EndTime",
                }
            )
        )

    local timing =
        "Timing unavailable"

    if phaseLower == "pending"
    and startsAt then

        timing =
            "Starts in "
            .. ZanjiGuildFormatDuration(
                startsAt
                - os.time()
            )

    elseif phaseLower == "active"
    and endsAt then

        timing =
            "Ends in "
            .. ZanjiGuildFormatDuration(
                endsAt
                - os.time()
            )
    end

    return "Status: "
        .. phase
        .. "\n"
        .. name
        .. "\n"
        .. timing
        .. "\nObjective: "
        .. objective
        .. (
            mode ~= ""
            and (
                "\nMode: "
                .. mode
            )
            or ""
        )
        .. "\nScore Format: "
        .. scoreFormat
end

