function ZanjiFarmDetailsSetBest(fruit)

    local label =
        ZANJI_FARM_DETAILS_UI.BestLabel

    if typeof(label) ~= "Instance" then
        return
    end

    if type(fruit) ~= "table"
    or tonumber(fruit.Weight) == nil then

        label.Text =
            '<font color="#969CAB">Best: —</font>'

        return
    end

    local plantName =
        ZanjiFarmDetailsCleanName(
            fruit.PlantName
            or "Unknown"
        )

    if plantName == "" then

        plantName =
            "Unknown"
    end

    local mutationParts =
        {}

    for _,
        mutation in ipairs(
            fruit.Mutations
            or {
                "Normal",
            }
        ) do

        table.insert(
            mutationParts,
            '<font color="'
            .. ZanjiFarmDetailsMutationHex(
                mutation
            )
            .. '">'
            .. ZanjiFarmDetailsEscape(
                mutation
            )
            .. "</font>"
        )
    end

    if #mutationParts <= 0 then

        mutationParts[1] =
            '<font color="#DCDDE6">Normal</font>'
    end

    label.Text =
        '<font color="#969CAB">Best: </font>'
        .. '<font color="#F5F6F9"><b>'
        .. ZanjiFarmDetailsEscape(
            plantName
        )
        .. "</b></font>"
        .. '<font color="#707684"> · </font>'
        .. table.concat(
            mutationParts,
            '<font color="#707684"> + </font>'
        )
        .. '<font color="#707684"> · </font>'
        .. '<font color="#42EB8B"><b>'
        .. ZanjiFarmDetailsEscape(
            ZanjiFarmDetailsFormatKg(
                fruit.Weight
            )
        )
        .. "</b></font>"
end

