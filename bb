function ZanjiDefenseFindTool(gearName)

    gearName =
        ZanjiDefenseNormalizeGear(
            gearName
        )

    local containers =
        {}

    local character =
        ZanjiDefenseGetCharacter()

    if typeof(character) == "Instance" then

        table.insert(
            containers,
            character
        )
    end

    local backpack =
        LocalPlayer
        and LocalPlayer:FindFirstChildOfClass("Backpack")
        or nil

    if typeof(backpack) == "Instance" then

        table.insert(
            containers,
            backpack
        )
    end

    for _, container in ipairs(containers) do

        for _, child in ipairs(container:GetChildren()) do

            if ZanjiDefenseToolMatches(
                child,
                gearName
            ) == true then

                return child
            end
        end
    end

    return nil
end

function ZanjiDefenseDisconnectGearLock()

