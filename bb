local function ZanjiMailPrepareAccountFiles()
    if ZanjiCanUseFiles() ~= true
        or ZANJI_MAIL_ACCOUNT_USER_ID <= 0
    then
        return false
    end

    ZanjiEnsureFolder()

    local migration =
        ZanjiMailReadJsonFile(
            ZANJI_MAIL_MIGRATION_FILE
        )

    if type(migration) ~= "table" then
        migration = {
            Version = 1,
        }
    end

    local migrationOwner =
        math.floor(
            tonumber(
                migration.OwnerUserId
            )
            or 0
        )

    if migrationOwner <= 0 then
        migrationOwner =
            ZANJI_MAIL_ACCOUNT_USER_ID

        migration.OwnerUserId =
            ZANJI_MAIL_ACCOUNT_USER_ID

        migration.OwnerName =
            tostring(
                LocalPlayer.Name
            )

        migration.ClaimedAt =
            os.time()

        if not ZanjiMailWriteJsonFile(
            ZANJI_MAIL_MIGRATION_FILE,
            migration
        ) then
            return false
        end
    end

    if migrationOwner
        ~= ZANJI_MAIL_ACCOUNT_USER_ID
    then
        return true
    end

    local settingsReady =
        ZanjiMailAccountFileExists(
            ZANJI_MAIL_SETTINGS_FILE
        )

    if not settingsReady then
        settingsReady =
            ZanjiMailCopyLegacyFile(
                ZANJI_MAIL_LEGACY_SETTINGS_FILE,
                ZANJI_MAIL_SETTINGS_FILE
            )
    end

    local historyReady =
        ZanjiMailAccountFileExists(
            ZANJI_MAIL_HISTORY_FILE
        )

    if not historyReady then
        historyReady =
            ZanjiMailCopyLegacyFile(
                ZANJI_MAIL_LEGACY_HISTORY_FILE,
                ZANJI_MAIL_HISTORY_FILE
            )
    end

    migration.Version =
        1

    migration.OwnerUserId =
        ZANJI_MAIL_ACCOUNT_USER_ID

    migration.OwnerName =
        tostring(
            LocalPlayer.Name
        )

    migration.SettingsMigrated =
        settingsReady == true

    migration.HistoryMigrated =
        historyReady == true

    migration.LastCheckedAt =
        os.time()

    ZanjiMailWriteJsonFile(
        ZANJI_MAIL_MIGRATION_FILE,
        migration
    )

    return true
end

