function ZanjiMergeAutomationReservedMergePlantIds()

    local reserved =
        {}

    if ZANJI_MERGE_AUTOMATION_STATE.AutoMergePlants ~= true then
        return reserved
    end

    local ingredientNames =
        {}

    for _, recipe in ipairs(
        ZanjiMergeAutomationGetSelectedRecipes()
    ) do

        if ZanjiMergeAutomationOutputExists(
            recipe.Result
        ) ~= true then

            ingredientNames[
                ZanjiFarmPlantKey(
                    recipe.Left
                )
            ] =
                true

            ingredientNames[
                ZanjiFarmPlantKey(
                    recipe.Right
                )
            ] =
                true
        end
    end

    for _, plant in ipairs(
        ZanjiMergeAutomationGetOwnedPlantsSorted()
    ) do

        if ingredientNames[
            ZanjiFarmPlantKey(
                ZanjiMergeAutomationPlantName(
                    plant
                )
            )
        ] == true then

            reserved[
                ZanjiFarmReadPlantId(
                    plant
                )
            ] =
                true
        end
    end

    return reserved
end

function ZanjiMergeAutomationFindPotCandidate()

    local selection =
        ZANJI_MERGE_AUTOMATION_STATE.SelectedPotPlants
        or {}

    if #selection <= 0 then

        return nil,
            "Select at least one plant type to pot."
    end

    local reserved =
        ZanjiMergeAutomationReservedMergePlantIds()

    for _, plant in ipairs(
        ZanjiMergeAutomationGetOwnedPlantsSorted()
    ) do

        local plantName =
            ZanjiMergeAutomationPlantName(
                plant
            )

        local plantId =
            ZanjiFarmReadPlantId(
                plant
            )

        if ZanjiMergeAutomationIsPotted(
            plant
        ) ~= true
        and ZanjiMergeAutomationSelectionAllows(
            selection,
            plantName,
            "All Plants"
        ) == true
        and reserved[plantId] ~= true
        and (
            ZANJI_MERGE_AUTOMATION_STATE.OnlyPotFullyGrown ~= true
            or ZanjiFarmInstanceReady(plant) == true
        ) then

            return plant
        end
    end

    if ZANJI_MERGE_AUTOMATION_STATE.OnlyPotFullyGrown == true then

        return nil,
            "No matching fully grown unpotted plants are ready."
    end

    return nil,
        "No matching unpotted plants are ready."
end

function ZanjiMergeAutomationEclipseOwnsPlant(plant)

    if ZANJI_MERGE_AUTOMATION_STATE.AutoEclipseLoop ~= true
    and ZANJI_MERGE_AUTOMATION_RUNTIME.RunOnceRequested ~= true then

        return false
    end

    local target =
        ZanjiMergeAutomationResolveEclipseTarget()

    if not target then
        return false
    end

    return ZanjiFarmReadPlantId(
        target
    ) == ZanjiFarmReadPlantId(
        plant
    )
end

function ZanjiMergeAutomationFindPickupCandidate()

    local selection =
        ZANJI_MERGE_AUTOMATION_STATE.SelectedPickupPlants
        or {}

    if #selection <= 0 then

        return nil,
            "Select at least one potted plant type to pick up."
    end

    for _, plant in ipairs(
        ZanjiMergeAutomationGetOwnedPlantsSorted()
    ) do

        local plantName =
            ZanjiMergeAutomationPlantName(
                plant
            )

        if ZanjiMergeAutomationIsPotted(
            plant
        ) == true
        and ZanjiMergeAutomationSelectionAllows(
            selection,
            plantName,
            "All Potted Plants"
        ) == true
        and ZanjiMergeAutomationEclipseOwnsPlant(
            plant
        ) ~= true then

            return plant
        end
    end

    return nil,
        "No matching potted plants are ready to pick up."
end

function ZanjiMergeAutomationProcessPickupAction(token, manual)

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local plant,
        reason =
        ZanjiMergeAutomationFindPickupCandidate()

    if not plant then

        if manual == true then

            runtime.ManualPickupRequested =
                false

            ZanjiMergeAutomationSetStatus(
                "Pickup waiting",
                reason
            )
        end

        return false,
            false
    end

    local plantName =
        ZanjiMergeAutomationPlantName(
            plant
        )

    ZanjiMergeAutomationSetStatus(
        "Picking up potted plant",
        plantName
    )

    local pickedUp,
        pickupReason =
        ZanjiMergeAutomationPickUpPlant(
            plant
        )

    if pickedUp == true then

        runtime.PickedUp =
            (
                runtime.PickedUp
                or 0
            )
            + 1

        runtime.PlantListSignature =
            nil

        ZanjiMergeAutomationSetStatus(
            "Potted plant picked up",
            plantName
                .. " was moved to your backpack."
        )

        ZanjiMergeAutomationRefreshPlantDropdowns(
            true
        )
    else

        if manual == true then

            runtime.ManualPickupRequested =
                false
        end

        ZanjiMergeAutomationSetStatus(
            "Pickup failed",
            pickupReason
        )
    end

    ZanjiMergeAutomationWaitDelay(
        token,
        ZANJI_MERGE_AUTOMATION_STATE.PottedActionDelay
    )

    return true,
        pickedUp == true
end

function ZanjiMergeAutomationProcessPotAction(token, manual)

    local runtime =
        ZANJI_MERGE_AUTOMATION_RUNTIME

    local plant,
        reason =
        ZanjiMergeAutomationFindPotCandidate()

    if not plant then

        if manual == true then

            runtime.ManualPotRequested =
                false

            ZanjiMergeAutomationSetStatus(
                "Potting waiting",
                reason
            )
        end

        return false,
            false
    end

    local plantName =
        ZanjiMergeAutomationPlantName(
            plant
        )

    ZanjiMergeAutomationSetStatus(
        "Potting plant",
        plantName
    )

    local potted,
        pottedPlantOrReason =
        ZanjiMergeAutomationPotPlant(
            plant
        )

    if potted == true then

        runtime.Potted =
            (
                runtime.Potted
                or 0
            )
            + 1

        runtime.PlantListSignature =
            nil

        ZanjiMergeAutomationSetStatus(
            "Plant potted",
            plantName
                .. " is ready for pickup or placement."
        )

        ZanjiMergeAutomationRefreshPlantDropdowns(
            true
        )
    else

        if manual == true then

            runtime.ManualPotRequested =
                false
        end

        ZanjiMergeAutomationSetStatus(
            "Potting failed",
            pottedPlantOrReason
        )
    end

    ZanjiMergeAutomationWaitDelay(
