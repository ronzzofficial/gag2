function ZanjiAuctionReadFlagNumber(
    flagName,
    fallback
)

    local flags =
        ZanjiAuctionGetFlags()

    local flag =
        type(flags) == "table"
        and flags[flagName]
        or nil

    local value =
        nil

    if type(flag) == "table" then

        value =
            flag.Value

        if type(value) == "function" then

            local ok,
                result =
                pcall(
                    value,
                    flag
                )

            if ok == true then

                value =
                    result
            end
        end

        if tonumber(value) == nil then

            value =
                flag.DefaultValue
        end

    elseif tonumber(flag) ~= nil then

        value =
            flag
    end

    return tonumber(value)
        or tonumber(fallback)
        or 0
end

function ZanjiAuctionReadDebounce()

    return math.clamp(
        ZanjiAuctionReadFlagNumber(
            "PurchaseDebounceSeconds",
            0.2
        ),
        0.05,
        5
    )
end

function ZanjiAuctionReadServerCooldown()

    return math.clamp(
        ZanjiAuctionReadFlagNumber(
            "PurchaseCooldownSeconds",
            10
        ),
        0.2,
        120
    )
end

function ZanjiAuctionReadCooldownGuard()

    local storedGuard =
        type(ZANJI_SHOP_STATE) == "table"
        and tonumber(
            ZANJI_SHOP_STATE.AuctionCooldownGuard
        )
        or nil

    return math.clamp(
        math.max(
            0.35,
            ZanjiAuctionReadDebounce(),
            storedGuard
                or 0.35
        ),
        0.35,
        1.85
    )
end

function ZanjiAuctionReadCooldown()

    return ZanjiAuctionReadServerCooldown()
        + ZanjiAuctionReadCooldownGuard()
end

function ZanjiAuctionIncreaseCooldownGuard()

    ZanjiAuctionEnsureState()

    local previousGuard =
        ZanjiAuctionReadCooldownGuard()

    local nextGuard =
        math.clamp(
            previousGuard + 0.25,
            0.35,
            1.85
        )

    ZANJI_SHOP_STATE.AuctionCooldownGuard =
        nextGuard

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "CooldownGuardIncreased",
            {
                PreviousGuard =
                    previousGuard,

                NextGuard =
                    nextGuard,
            },
            "Warning"
        )
    end

    return nextGuard
end

function ZanjiAuctionScheduleCooldown(
    anchorAt,
    source,
    synchronized,
    unknownOutcome
)

    ZanjiAuctionEnsureState()

    anchorAt =
        tonumber(anchorAt)
        or os.clock()

    source =
        tostring(
            source
            or "unknown"
        )

    local serverCooldown =
        ZanjiAuctionReadServerCooldown()

    local normalGuard =
        ZanjiAuctionReadCooldownGuard()

    local appliedGuard =
        unknownOutcome == true
        and math.max(
            1,
            normalGuard
        )
        or normalGuard

    local cooldownUntil =
        anchorAt
        + serverCooldown
        + appliedGuard

    ZANJI_SHOP_STATE.AuctionCooldownAnchorAt =
        anchorAt

    ZANJI_SHOP_STATE.AuctionCooldownAnchorReason =
        source

    ZANJI_SHOP_STATE.AuctionCooldownBase =
        serverCooldown

    ZANJI_SHOP_STATE.AuctionCooldownGuard =
        normalGuard

    ZANJI_SHOP_STATE.AuctionCooldownAppliedGuard =
        appliedGuard

    ZANJI_SHOP_STATE.AuctionCooldownSynchronized =
        synchronized == true

    ZANJI_SHOP_STATE.AuctionUnknownOutcome =
        unknownOutcome == true

    ZANJI_SHOP_STATE.AuctionNextBuyAt =
        cooldownUntil

    ZANJI_SHOP_STATE.AuctionNextRetryAt =
        0

    ZANJI_SHOP_STATE.AuctionSchedulerState =
        "Cooldown"

    if type(ZanjiDevTrace) == "function" then

        ZanjiDevTrace(
            "Auction",
            "CooldownScheduled",
            {
                Source =
                    source,

                AnchorAt =
                    anchorAt,

                ServerCooldown =
                    serverCooldown,

                Guard =
                    appliedGuard,

                CooldownUntil =
                    cooldownUntil,

                Remaining =
                    math.max(
                        0,
                        cooldownUntil
                            - os.clock()
                    ),

                Synchronized =
                    synchronized == true,

                UnknownOutcome =
                    unknownOutcome == true,
            },
            unknownOutcome == true
            and "Warning"
            or "Info"
        )
    end

    return cooldownUntil
end

function ZanjiAuctionAddCandidate(rows, name, source, data)

    name =
        ZanjiCleanText(
            name
        )

    if name == ""
    or name == "All"
    or name == "None"
    or name == "Normal"
    or name == "Big"
    or name == "Huge"
    or name == "Mega"
    or #name > 80
    or name:find("table:", 1, true) then

        return false
    end

    source =
        ZanjiCleanText(
            source
        )

    local blockedUnlessLive = {
        Gold = true,
        Rainbow = true,
        Mega = true,
        Default = true,
        Wood = true,
        Stone = true,
        White = true,
        Light = true,
        Star = true,
        Flower = true,
        Pole = true,
        Stick = true,
        Spike = true,
        Cupid = true,
        Lantern = true,
        Futuristic = true,
    }

    if blockedUnlessLive[name] == true
    and source ~= "LiveAuctionGui"
    and source ~= "KnownAuctionItems" then

        return false
    end

    if name == "Test Egg"
    and source ~= "LiveAuctionGui"
    and source ~= "KnownAuctionItems" then

        return false
    end

    local key =
        ZanjiAuctionItemKey(
            name
        )

    if key == "" then
        return false
    end

    rows[key] =
        rows[key]
        or {
            Name = name,
            Sources = {},
            Price = 0,
        }

    rows[key].Sources[source ~= "" and source or "Unknown"] =
        true

    data =
        type(data) == "table"
        and data
        or {}

    rows[key].Category =
        rows[key].Category
        or data.Category

    rows[key].Rarity =
        rows[key].Rarity
        or data.Rarity

    rows[key].Price =
        math.max(
            tonumber(rows[key].Price)
            or 0,
            tonumber(data.Price)
            or tonumber(data.Cost)
            or 0
        )

    return true
end

function ZanjiAuctionScanCrateCandidates(rows)

    local data =
        ZanjiShopRequireModule(
            "SharedModules.CrateData"
        )

    if type(data) == "table"
    and type(data.GetAllCrates) == "function" then

        local ok,
            crates =
            pcall(function()

                return data.GetAllCrates()
            end)

        if ok ~= true
        or type(crates) ~= "table" then

            ok,
                crates =
                pcall(
                    data.GetAllCrates,
                    data
                )
        end

        if ok == true
        and type(crates) == "table" then

            for key, row in pairs(crates) do

                if type(row) == "table" then

                    ZanjiAuctionAddCandidate(
                        rows,
                        row.Name
                            or key,
                        "CrateData",
