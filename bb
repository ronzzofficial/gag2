            1,
            true
        ) then
            return {
                Group =
                    "Gear",

                Category =
                    "Trowels",

                ItemKey =
                    name,

                Name =
                    name,

                Details =
                    "Trowel",

                Unique =
                    false,

                Supported =
                    true,

                Favorite =
                    readOwnedFavorite(
                        item
                    ),

                Count =
                    readOwnedCount(
