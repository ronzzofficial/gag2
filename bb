function ZanjiSellResolvePacket(packetName)

    packetName =
        ZanjiCleanText(
            packetName
        )

    if packetName == "" then
        return nil
    end

    ZANJI_SHOP_STATE.SellPacketCache =
        type(ZANJI_SHOP_STATE.SellPacketCache) == "table"
        and ZANJI_SHOP_STATE.SellPacketCache
        or {}

    if ZANJI_SHOP_STATE.SellPacketCache[packetName] ~= nil then

        return ZANJI_SHOP_STATE.SellPacketCache[packetName]
    end

    local networking =
        ZanjiShopRequireModule(
            "SharedModules.Networking"
        )

    local packet =
        type(networking) == "table"
        and type(networking.NPCS) == "table"
        and networking.NPCS[packetName]
        or nil

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        ZANJI_SHOP_STATE.SellPacketCache[packetName] =
            false

        return nil
    end

    ZANJI_SHOP_STATE.SellPacketCache[packetName] =
        packet

    return packet
end

function ZanjiSellFirePacket(packetName, ...)

    local packet =
        ZanjiSellResolvePacket(
            packetName
        )

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return false
    end

    local ok =
        pcall(function(...)

            packet:Fire(...)

        end, ...)

    return ok == true
end

