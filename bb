function ZanjiFarmPlantKey(value)

    return ZanjiCleanText(
        value
    )
        :lower()
        :gsub("[%s_%-%[%]%(%)%.'\"_/{}]", "")
end

function ZanjiFarmCleanPlantName(value)

    local text =
        ZanjiCleanText(
            value
        )

    if text == "" then
        return ""
    end

    if text:match("^%d+$") then
        return ""
    end

    local lower =
        text:lower()

    if lower == "partfruit"
    or lower == "gold"
    or lower == "rainbow"
    or lower == "mega"
    or lower == "huge"
    or lower == "big"
    or lower == "normal"
    or lower == "moon bloom old" then

        return ""
    end

    if lower:find("table:", 1, true) then
        return ""
    end

    if #text > 64 then
        return ""
    end

    return text
end

function ZanjiFarmPlantCacheAddName(cache, value)

    cache =
        type(cache) == "table"
        and cache
        or {}

    cache.Values =
        type(cache.Values) == "table"
        and cache.Values
        or {}

    cache.Map =
        type(cache.Map) == "table"
        and cache.Map
        or {}

    local plantName =
        ZanjiFarmCleanPlantName(
            value
        )

    if plantName == "" then
        return false
    end

    local key =
        ZanjiFarmPlantKey(
            plantName
        )

    if key == "" then
        return false
    end

    if cache.Map[key] ~= nil then
        return false
    end

    cache.Map[key] =
        plantName

    table.insert(
        cache.Values,
        plantName
    )

    return true
end

function ZanjiFarmPlantCacheSort(cache)

    cache =
        type(cache) == "table"
        and cache
        or {}

    cache.Values =
        type(cache.Values) == "table"
