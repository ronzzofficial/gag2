            name = tostring(record.Name):sub(1, 100),
            variant = tostring(record.Variant or ""):sub(1, 80),
            mutation = tostring(record.Mutation or ""):sub(1, 240),
            weight = record.Weight,
            quantity = quantity,
            is_favorited = record.Favorite == true,
            is_mailable = record.Supported == true,
            item_value = itemValue ~= ""
                and itemValue
                or nil,
            metadata = {
                mail_category = record.MailCategory,
                mail_item_key = record.ItemKey,
                source = source,
                source_name = sourceName,
                icon = icon,
                unique = record.Unique == true,
                item_value = itemValue ~= ""
                    and itemValue
                    or nil,
            },
        }
    end

    for _, rootData in ipairs(roots) do

        local root =
            rootData.Instance

        if typeof(root) == "Instance" then

            for _, item in ipairs(
                root:GetChildren()
            ) do

                if not usedInstances[item] then

                    usedInstances[item] = true

                    local record =
                        ZanjiAccountInventoryClassify(
                            item,
                            catalogs
                        )

                    if record then

                        local quantity =
                            math.clamp(
                                math.floor(
                                    tonumber(record.Quantity)
                                    or 1
                                ),
                                1,
                                1000000000
                            )

                        local summaryField =
                            summaryFields[
                                record.WebCategory
                            ]

                        if summaryField then
                            summary[summaryField] =
                                summary[summaryField]
                                + quantity
                        end

                        local icon =
                            lightweight
                            and ""
                            or ZanjiAccountInventoryReadIcon(
                                item,
                                record,
                                catalogs
                            )

                        local itemValue =
                            lightweight
                            and ""
                            or ZanjiAccountInventoryReadFruitValue(
                                item,
                                record
                            )

                        if record.Unique == true then

                            local rawClientId =
                                record.WebCategory == "fruit"
                                and record.ItemKey
                                or (
                                    record.IdPrefix
                                    .. ":"
                                    .. record.ItemKey
                                )

                            local clientItemId =
                                ZanjiAccountInventorySafeId(
                                    rawClientId
                                )

                            if clientItemId
                            and not usedUniqueIds[
                                clientItemId
                            ] then

                                usedUniqueIds[
                                    clientItemId
                                ] = true

                                table.insert(
                                    items,
                                    makeItem(
                                        record,
                                        clientItemId,
                                        1,
                                        tostring(item.Name),
                                        rootData.Name,
                                        icon,
                                        itemValue
                                    )
                                )
                            end
                        else

                            local groupKey =
                                record.IdPrefix
                                .. ":"
                                .. ZanjiAccountInventoryKey(
                                    record.ItemKey
                                )

                            local group =
                                grouped[groupKey]

                            if not group then

                                group = {
                                    Record = record,
                                    Quantity = 0,
                                    Favorite = false,
                                    SourceName = tostring(item.Name),
                                    Source = rootData.Name,
                                    Icon = icon,
                                }

                                grouped[groupKey] =
                                    group
                            end

                            group.Quantity =
                                math.clamp(
                                    group.Quantity
                                    + quantity,
                                    1,
                                    1000000000
                                )

                            group.Favorite =
                                group.Favorite
                                or record.Favorite == true

                            if group.Icon == ""
                            and icon ~= "" then
                                group.Icon = icon
                            end
                        end
                    end
                end
            end
        end
    end

    for groupKey, group in pairs(grouped) do

        local clientItemId =
            ZanjiAccountInventorySafeId(
                groupKey
            )

        if clientItemId then

            group.Record.Favorite =
                group.Favorite

            table.insert(
                items,
                makeItem(
                    group.Record,
                    clientItemId,
                    group.Quantity,
                    group.SourceName,
                    group.Source,
                    group.Icon
                )
            )
        end
    end

    table.sort(
        items,
        function(left, right)

            return tostring(
                left.client_item_id
            ) < tostring(
                right.client_item_id
            )
        end
    )

    local fingerprintParts = {}

    for _, item in ipairs(items) do

        table.insert(
            fingerprintParts,
            table.concat(
                {
                    tostring(item.client_item_id),
                    tostring(item.category),
                    tostring(item.name),
                    tostring(item.variant or ""),
                    tostring(item.mutation or ""),
                    tostring(item.weight or ""),
                    tostring(item.quantity or 1),
                    item.is_favorited == true and "1" or "0",
                    item.is_mailable == true and "1" or "0",
                    tostring(
                        type(item.metadata) == "table"
                        and item.metadata.icon
                        or ""
                    ),
                    tostring(
                        type(item.metadata) == "table"
                        and item.metadata.item_value
                        or ""
                    ),
                },
                "\30"
            )
        )
    end

    summary.ItemRows = #items

    return items,
        table.concat(
            fingerprintParts,
            "\31"
        ),
        summary
end

function ZanjiAccountInventoryDescription(
    summary
)

    summary =
        type(summary) == "table"
        and summary
        or {}

    local parts = {}

    local rows = {
        {
            Field = "FruitCount",
            Label = "fruits",
        },
        {
            Field = "SeedCount",
            Label = "seeds",
        },
        {
            Field = "GearCount",
            Label = "gear",
        },
        {
            Field = "PropCount",
            Label = "props",
        },
        {
            Field = "PetCount",
            Label = "pets",
        },
        {
            Field = "EggCount",
            Label = "eggs",
        },
    }

    for _, row in ipairs(rows) do

        table.insert(
            parts,
            tostring(
                math.max(
                    0,
                    math.floor(
                        tonumber(
                            summary[row.Field]
                        )
                        or 0
                    )
                )
            )
            .. " "
            .. row.Label
        )
    end

    return table.concat(
        parts,
        " · "
    )
end


function ZanjiAccountInventoryFriendlyError(
    value
)

    local code =
        ZanjiCleanText(
            value
            or "inventory_sync_failed"
        )

    local messages = {
        inventory_item_limit_exceeded =
            "This account has more inventory rows than the service currently supports.",

        body_too_large =
            "This inventory snapshot is too large to upload.",

        invalid_inventory_item_id =
            "One inventory item had an invalid ID.",

        duplicate_inventory_item_id =
            "Two inventory items returned the same ID.",

        invalid_inventory_category =
            "An inventory category was rejected.",

        invalid_inventory_item_name =
            "An inventory item had an invalid name.",

        invalid_inventory_item_quantity =
            "An inventory stack returned an invalid amount.",

        inventory_snapshot_failed =
            "The ZANJI account service could not save this inventory snapshot.",

        account_identity_mismatch =
            "This saved login belongs to another Roblox account.",

        account_token_required =
            "The saved account login is missing.",

        invalid_account_token =
            "The saved account login is invalid.",

        account_token_revoked =
            "The saved account login was revoked.",

        account_unlinked =
            "This Roblox account is no longer linked.",
    }

    return messages[
        code
    ]
        or ZanjiAccountFriendlyError(
            code
        )
end

function ZanjiAccountSendMailInventory(
    force,
    notifyUser
)

    if ZANJI_ACCOUNT_RUNTIME.InventoryBusy == true then

        return false
    end

    local token =
        ZANJI_ACCOUNT_RUNTIME.Token

    if ZanjiAccountTokenValid(
        token
    ) ~= true then

        ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
            "Waiting for account connection"

        ZanjiAccountRefreshUI()

        return false
    end

    ZANJI_ACCOUNT_RUNTIME.InventoryBusy =
        true

    ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
        "Scanning mail inventory..."

    ZanjiAccountRefreshUI()

    local scanOk,
        items,
        fingerprint,
        summary =
        pcall(
            ZanjiAccountBuildMailInventory
        )

    if scanOk ~= true
    or type(items) ~= "table"
    or type(fingerprint) ~= "string"
    or type(summary) ~= "table" then

        ZANJI_ACCOUNT_RUNTIME.InventoryBusy =
            false

        ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
            "Inventory scan failed"

        ZanjiAccountRefreshUI()

        if notifyUser == true then

            ZanjiNotify(
                "ZANJI Inventory",
                "Could not scan this account's mail inventory.",
                6
            )
        end

        return false
    end

    if #items > 5000 then

        ZANJI_ACCOUNT_RUNTIME.InventoryBusy =
            false

        ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
            "Too many inventory rows to upload"

        ZanjiAccountRefreshUI()

        if notifyUser == true then

            ZanjiNotify(
                "ZANJI Inventory",
                "This account has more than 5,000 mail inventory rows.",
                7
            )
        end

        return false
    end

    local now =
        os.time()

    local unchanged =
        fingerprint
        == ZANJI_ACCOUNT_RUNTIME
            .InventoryFingerprint

    local recentlyUploaded =
        ZANJI_ACCOUNT_RUNTIME
            .InventoryLastUpload > 0
        and now
            - ZANJI_ACCOUNT_RUNTIME
                .InventoryLastUpload
            < 300

    if force ~= true
    and unchanged
    and recentlyUploaded then

        ZANJI_ACCOUNT_RUNTIME.InventoryBusy =
            false

        ZANJI_ACCOUNT_RUNTIME.InventoryFruitCount =
            summary.FruitCount

        ZANJI_ACCOUNT_RUNTIME.InventoryEggCount =
            summary.EggCount

        ZANJI_ACCOUNT_RUNTIME.InventoryItemRows =
            summary.ItemRows

        ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
            ZanjiAccountInventoryDescription(
                summary
            )
            .. " synced"

        ZanjiAccountRefreshUI()

        return true
    end

    ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
        "Uploading "
        .. ZanjiAccountInventoryDescription(
            summary
        )
        .. "..."

    ZanjiAccountRefreshUI()

    local statusCode,
        data,
        requestError =
        ZanjiAccountRequest(
            "/api/account/mail/inventory",
            "POST",
            {
                roblox_user_id =
                    tostring(
                        LocalPlayer.UserId
                    ),

                revision =
                    tostring(
                        LocalPlayer.UserId
                    )
                    .. "-"
                    .. tostring(
                        now
                    )
                    .. "-"
                    .. tostring(
                        #items
                    ),

                captured_at =
                    now,

                items =
                    items,
            },
            token
        )

    ZANJI_ACCOUNT_RUNTIME.InventoryBusy =
        false

    if statusCode == 200
    and type(data) == "table"
    and data.ok == true then

        ZANJI_ACCOUNT_RUNTIME.InventoryFingerprint =
            fingerprint

        ZANJI_ACCOUNT_RUNTIME.InventoryLastUpload =
            now

        ZANJI_ACCOUNT_RUNTIME.InventoryFruitCount =
            summary.FruitCount

        ZANJI_ACCOUNT_RUNTIME.InventoryEggCount =
            summary.EggCount

        ZANJI_ACCOUNT_RUNTIME.InventoryItemRows =
            summary.ItemRows

        ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
            ZanjiAccountInventoryDescription(
                summary
            )
            .. " synced"

        ZanjiAccountRefreshUI()

        if notifyUser == true then

            ZanjiNotify(
                "ZANJI Inventory",
                "Uploaded "
                .. ZanjiAccountInventoryDescription(
                    summary
                )
                .. " to ZANJI HUB.",
                5
            )
        end

        return true
    end

    local message =
        requestError
        or ZanjiAccountInventoryFriendlyError(
            type(data) == "table"
            and data.error
            or "inventory_sync_failed"
        )

    ZANJI_ACCOUNT_RUNTIME.InventoryStatus =
        "Sync failed: "
        .. tostring(
            message
        )

    ZanjiAccountRefreshUI()

    if notifyUser == true then

        ZanjiNotify(
            "ZANJI Inventory",
            message,
            7
        )
    end

    return false
end

function ZanjiAccountQueueMailInventorySync(
    force,
    notifyUser
)

    if ZANJI_ACCOUNT_RUNTIME.InventoryBusy == true then

        return false
    end

    local now =
        os.clock()

    if force ~= true
    and now
        - (
            tonumber(
                ZANJI_ACCOUNT_RUNTIME
                    .InventoryLastScanClock
            )
            or 0
        )
        < 10 then

        return false
    end

    ZANJI_ACCOUNT_RUNTIME.InventoryLastScanClock =
        now

    task.spawn(function()

        ZanjiAccountSendMailInventory(
            force,
            notifyUser
        )
    end)

    return true
end

function ZanjiAccountMailJobSetStatus(value)

    ZANJI_ACCOUNT_RUNTIME.MailJobStatus =
        tostring(value or "Watching for queued orders")

    ZanjiAccountRefreshUI()
end

function ZanjiAccountMailJobGetPacket()

    local sharedModules =
        ReplicatedStorage:FindFirstChild("SharedModules")

    local networkingModule =
        sharedModules
        and sharedModules:FindFirstChild("Networking")

    if not networkingModule
    or not networkingModule:IsA("ModuleScript") then

        return nil,
            "SharedModules.Networking was not found"
    end

    local ok, networking =
        pcall(require, networkingModule)

    local packet =
        ok
        and type(networking) == "table"
        and type(networking.Mailbox) == "table"
        and networking.Mailbox.SendBatch
        or nil

    if type(packet) ~= "table"
    or type(packet.Fire) ~= "function" then

        return nil,
            "Networking.Mailbox.SendBatch is unavailable"
    end

    return packet
end

function ZanjiAccountMailJobLocalInventory()

    local ok,
        items =
        pcall(function()

            return ZanjiAccountBuildMailInventory(
                true
            )
        end)

    if not ok
    or type(items) ~= "table" then

        return nil,
            "Could not scan the current inventory"
    end

    local itemMap = {}

    for _, item in ipairs(items) do

        if type(item) == "table" then

            local id =
                ZanjiCleanText(
                    item.client_item_id
                )

            if id ~= "" then
                itemMap[id] =
                    item
            end
        end
    end

    return itemMap
end

function ZanjiAccountMailJobBuildBatch(job)

    if type(job) ~= "table"
    or type(job.recipient) ~= "table"
    or type(job.items) ~= "table" then

        return nil,
            "The claimed mail job was malformed",
            "failed"
    end

    local recipientUserId =
        math.floor(
            tonumber(job.recipient.roblox_user_id)
            or 0
        )

    if recipientUserId <= 0
    or recipientUserId == LocalPlayer.UserId then

        return nil,
            "The mail recipient is invalid",
            "failed"
    end

    if #job.items < 1
    or #job.items > 20 then

        return nil,
            "The claimed mail job has an invalid row count",
            "failed"
    end

    local localItems, scanError =
        ZanjiAccountMailJobLocalInventory()

    if type(localItems) ~= "table" then

        return nil,
            scanError or "Inventory scan failed",
            "retry"
    end

    local batch = {
        RecipientUserId = recipientUserId,

        RecipientName =
            ZanjiCleanText(
                job.recipient.roblox_username
                or job.recipient.alias
            ),

        Payload = {},
        Before = {},
        Required = {},
        Total = 0,
    }

    local supportedCategories = {
        HarvestedFruits = true,
        Seeds = true,
        SeedPacks = true,
        WateringCans = true,
        Trowels = true,
        Sprinklers = true,
        Props = true,
        Pets = true,
        Eggs = true,
    }

    for _, jobItem in ipairs(job.items) do

        if type(jobItem) ~= "table" then
            return nil,
                "One claimed mail row was malformed",
                "failed"
        end

        local id =
            ZanjiCleanText(jobItem.client_item_id)

        local quantity =
            math.floor(
                tonumber(jobItem.quantity)
                or 0
            )

        local localItem =
            localItems[id]

        local available =
            type(localItem) == "table"
            and math.max(
                0,
                math.floor(
                    tonumber(localItem.quantity)
                    or 0
                )
            )
            or 0

        if id == ""
        or quantity <= 0 then

            return nil,
                "One claimed mail row was invalid",
                "failed"
        end

        if available < quantity then

            return nil,
                tostring(jobItem.item_name or "A selected item")
                .. " is no longer available in the requested quantity",
                "failed"
        end

        if localItem.is_favorited == true
        and jobItem.allow_favorited ~= true then

            return nil,
                tostring(jobItem.item_name or "A selected item")
                .. " is now favorited and protected",
                "failed"
        end

        local metadata =
            type(localItem.metadata) == "table"
            and localItem.metadata
            or {}

        local category =
            ZanjiCleanText(
                metadata.mail_category
                or jobItem.mail_category
            )

        local itemKey =
            ZanjiCleanText(
                metadata.mail_item_key
                or jobItem.mail_item_key
            )

        if supportedCategories[
            category
        ] ~= true then

            return nil,
                "One selected item has an unsupported mail category",
                "failed"
        end

        if itemKey == "" then
            return nil,
                "One selected item is missing its in-game mail key",
                "failed"
        end

        table.insert(
            batch.Payload,
            {
                ItemKey = itemKey,
                Count = quantity,
                Category = category,
            }
        )

        batch.Before[id] = available

        batch.Required[id] =
            (batch.Required[id] or 0)
            + quantity

        batch.Total =
            batch.Total
            + quantity
    end

    return batch
end

function ZanjiAccountMailJobWaitForRemoval(batch)

    local deadline =
        os.clock()
        + ZANJI_ACCOUNT_MAIL_CONFIRM_TIMEOUT

    repeat

        local currentItems =
            ZanjiAccountMailJobLocalInventory()

        if type(currentItems) == "table" then

            local complete = true

            for id, required in pairs(batch.Required) do

                local currentItem =
                    currentItems[id]

                local current =
                    type(currentItem) == "table"
                    and math.max(
                        0,
                        math.floor(
                            tonumber(currentItem.quantity)
                            or 0
                        )
                    )
                    or 0

                if current
                    > math.max(
                        0,
                        (batch.Before[id] or 0)
                            - required
                    )
                then
                    complete = false
                    break
                end
            end

            if complete then
                return true
            end
        end

        task.wait(0.2)

    until os.clock() >= deadline

    return false
end

function ZanjiAccountMailJobReport(
    claimId,
    result,
    errorText
)

    local statusCode, data, requestError =
        ZanjiAccountRequest(
            "/api/account/mail/jobs/report",
            "POST",
            {
                roblox_user_id =
                    tostring(LocalPlayer.UserId),

                claim_id = claimId,
                result = result,

                error =
                    tostring(errorText or ""):sub(1, 500),
            },
            ZANJI_ACCOUNT_RUNTIME.Token
        )

    if statusCode == 200
    and type(data) == "table"
    and data.ok == true then
        return true
    end

    if statusCode == 409
    and type(data) == "table"
    and data.error == "mail_claim_not_found" then

        if result ~= "sent" then
            return true
        end

        return false,
            "Fleet has not recorded the accepted delivery yet."
    end

    return false,
        requestError
        or ZanjiAccountFriendlyError(
            type(data) == "table"
            and data.error
            or "mail_job_result_failed"
        )
end

function ZanjiAccountMailJobSubmitResult(
    claimId,
    result,
    errorText
)

    ZANJI_ACCOUNT_RUNTIME.MailJobPendingReport = {
        ClaimId = claimId,
        Result = result,
        Error = tostring(errorText or ""),
    }

    local reported, reportError =
        ZanjiAccountMailJobReport(
            claimId,
            result,
            errorText
        )

    if reported then
        ZANJI_ACCOUNT_RUNTIME.MailJobPendingReport = nil
        return true
    end

    ZanjiAccountMailJobSetStatus(
        "Result saved; API report retry pending: "
        .. tostring(reportError or "service unavailable")
    )

    return false
end

function ZanjiAccountMailJobRetryPendingReport()

    local pending =
        ZANJI_ACCOUNT_RUNTIME.MailJobPendingReport

    if type(pending) ~= "table" then
        return true
    end

    local reported, reportError =
        ZanjiAccountMailJobReport(
            pending.ClaimId,
            pending.Result,
            pending.Error
        )

    if not reported then

        ZanjiAccountMailJobSetStatus(
            "Waiting to report the previous result: "
            .. tostring(reportError or "service unavailable")
        )

        return false
    end

    local wasSent =
        pending.Result == "sent"

    ZANJI_ACCOUNT_RUNTIME.MailJobPendingReport = nil

    ZanjiAccountMailJobSetStatus(
        wasSent
        and "Previous delivery reported successfully"
        or "Previous order result reported successfully"
    )

    return true
end

function ZanjiAccountMailJobRecordAccepted()

    ZANJI_ACCOUNT_RUNTIME.MailJobNextSendClock =
        os.clock()
        + ZANJI_ACCOUNT_MAIL_SEND_COOLDOWN

    if type(ZanjiMailCheckDay) == "function" then
        pcall(ZanjiMailCheckDay)
    end

    if type(ZANJI_MAIL_STATE) == "table" then

        ZANJI_MAIL_STATE.TrackerUsed =
            math.clamp(
                math.floor(
                    tonumber(ZANJI_MAIL_STATE.TrackerUsed)
                    or 0
                )
                + 1,
                0,
                50
            )

        if type(ZanjiMailSaveSettings) == "function" then
            pcall(ZanjiMailSaveSettings)
        end
    end

    if type(ZANJI_MAIL_RUNTIME) == "table"
    and type(ZANJI_MAIL_RUNTIME.UpdateQuota) == "function" then
        pcall(ZANJI_MAIL_RUNTIME.UpdateQuota)
    end
end

function ZanjiAccountProcessMailJob()

    if ZANJI_ACCOUNT_RUNTIME.MailJobBusy == true
    or ZANJI_ACCOUNT_RUNTIME.Status ~= "Online"
    or ZANJI_ACCOUNT_RUNTIME.InventoryBusy == true
    or ZANJI_ACCOUNT_RUNTIME.HeartbeatBusy == true
    or ZANJI_ACCOUNT_RUNTIME.PairingBusy == true then
        return false
    end

    local deliveryState =
        type(ZANJI_MAIL_RUNTIME) == "table"
        and ZANJI_MAIL_RUNTIME.DeliveryState
        or nil

    if type(deliveryState) == "table"
    and deliveryState.Running == true then

        ZanjiAccountMailJobSetStatus(
            "Waiting for the current manual delivery"
        )

        return false
    end

    if os.clock()
        < (ZANJI_ACCOUNT_RUNTIME.MailJobNextSendClock or 0)
    then
        return false
    end

    ZANJI_ACCOUNT_RUNTIME.MailJobBusy = true

    local activeClaimId = ""

    local processOk, processError =
        xpcall(
            function()

                if not ZanjiAccountMailJobRetryPendingReport() then
                    return
                end

                local packet, packetError =
                    ZanjiAccountMailJobGetPacket()

                if not packet then
                    ZanjiAccountMailJobSetStatus(packetError)
                    return
                end

                ZanjiAccountMailJobSetStatus(
                    "Checking for queued orders..."
                )

                local statusCode, data, requestError =
                    ZanjiAccountRequest(
                        "/api/account/mail/jobs/claim",
                        "POST",
                        {
                            roblox_user_id =
                                tostring(LocalPlayer.UserId),
                        },
                        ZANJI_ACCOUNT_RUNTIME.Token
                    )

                if statusCode ~= 200
                or type(data) ~= "table"
                or data.ok ~= true then

                    ZanjiAccountMailJobSetStatus(
                        "Order check failed: "
                        .. tostring(
                            requestError
                            or ZanjiAccountFriendlyError(
                                type(data) == "table"
                                and data.error
                                or "mail_job_claim_failed"
                            )
                        )
                    )

                    return
                end

                if type(data.job) ~= "table" then
                    ZanjiAccountMailJobSetStatus(
                        "Watching for queued orders"
                    )

                    return
                end

                activeClaimId =
                    ZanjiCleanText(data.job.claim_id)

                if activeClaimId == "" then
                    error("Claimed order has no claim ID")
                end

                local batch, batchError, invalidResult =
                    ZanjiAccountMailJobBuildBatch(data.job)

                if type(batch) ~= "table" then

                    ZanjiAccountMailJobSubmitResult(
                        activeClaimId,
                        invalidResult == "retry"
                            and "retry"
                            or "failed",
                        batchError or "Inventory validation failed"
                    )

                    activeClaimId = ""

                    ZanjiAccountMailJobSetStatus(
                        "Order not sent: "
                        .. tostring(batchError)
                    )

                    return
                end

                deliveryState =
                    type(ZANJI_MAIL_RUNTIME) == "table"
                    and ZANJI_MAIL_RUNTIME.DeliveryState
                    or nil

                if type(deliveryState) == "table"
                and deliveryState.Running == true then

                    ZanjiAccountMailJobSubmitResult(
                        activeClaimId,
                        "retry",
                        "A manual delivery started"
                    )

                    activeClaimId = ""
                    return
                end

                local recipientName =
                    batch.RecipientName ~= ""
                    and batch.RecipientName
                    or tostring(batch.RecipientUserId)

                ZanjiAccountMailJobSetStatus(
                    "Sending "
                    .. tostring(batch.Total)
                    .. (batch.Total == 1 and " item" or " items")
                    .. " to "
                    .. recipientName
                    .. "..."
                )

                local fireOk, accepted, serverMessage =
                    pcall(function()

                        return packet:Fire(
                            batch.RecipientUserId,
                            batch.Payload,
                            ""
                        )
                    end)

                if not fireOk then

                    ZanjiAccountMailJobSubmitResult(
                        activeClaimId,
                        "uncertain",
                        "Mailbox call ended without a confirmed result: "
                        .. tostring(accepted)
                    )

                    activeClaimId = ""

                    ZanjiAccountMailJobSetStatus(
                        "Delivery failed because its result was uncertain"
                    )

                    return
                end

                local responseText =
                    tostring(serverMessage or "")

                if accepted == true then

                    ZanjiAccountMailJobRecordAccepted()

                    local reported =
                        ZanjiAccountMailJobSubmitResult(
                            activeClaimId,
                            "sent",
                            ""
                        )

                    activeClaimId = ""

                    ZanjiAccountMailJobSetStatus(
                        reported
                        and (
                            "Delivered "
                            .. tostring(batch.Total)
                            .. (
                                batch.Total == 1
                                and " item"
                                or " items"
                            )
                            .. " to "
                            .. recipientName
                        )
                        or "Delivery confirmed; API report retry pending"
                    )

                    return
                end

                local waitSeconds =
                    tonumber(
                        responseText:lower():match(
                            "wait%s+(%d+)%s*s"
                        )
                    )

                if waitSeconds then

                    ZANJI_ACCOUNT_RUNTIME.MailJobNextSendClock =
                        os.clock()
                        + waitSeconds
                        + 0.25

                    ZanjiAccountMailJobSubmitResult(
                        activeClaimId,
                        "retry",
                        responseText ~= ""
                            and responseText
                            or "Mailbox cooldown"
                    )

                    activeClaimId = ""

                    ZanjiAccountMailJobSetStatus(
                        "Mailbox cooldown; create a new delivery after the cooldown"
                    )

                    return
                end

                ZanjiAccountMailJobSubmitResult(
                    activeClaimId,
                    "failed",
                    responseText ~= ""
                        and responseText
                        or "The server rejected this mail"
                )

                activeClaimId = ""

                ZanjiAccountMailJobSetStatus(
                    "Order failed: "
                    .. (
                        responseText ~= ""
                        and responseText
                        or "server rejected the mail"
                    )
                )
            end,
            function(value)

                return tostring(value)
            end
        )

    if not processOk then

        if activeClaimId ~= "" then

            ZanjiAccountMailJobSubmitResult(
                activeClaimId,
                "uncertain",
                "Processor error after claim: "
                .. tostring(processError)
            )
        end

        ZanjiAccountMailJobSetStatus(
            "Order processor paused: "
            .. tostring(processError)
        )
    end

    ZANJI_ACCOUNT_RUNTIME.MailJobBusy = false

    ZanjiAccountRefreshUI()

    return processOk == true
end

function ZanjiAccountStartMailJobWorker(generation)

    task.spawn(function()

        task.wait(2)

        while ZANJI_ACCOUNT_RUNTIME.Active == true
        and ZANJI_ACCOUNT_RUNTIME.Generation == generation do

            if ZANJI_ACCOUNT_RUNTIME.Status == "Online" then

                ZanjiAccountProcessMailJob()
            end

            local elapsed = 0

            while elapsed < ZANJI_ACCOUNT_MAIL_JOB_INTERVAL
            and ZANJI_ACCOUNT_RUNTIME.Active == true
            and ZANJI_ACCOUNT_RUNTIME.Generation == generation do

                task.wait(0.5)

                elapsed =
                    elapsed
                    + 0.5
            end
        end
    end)
end

