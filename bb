        and ZANJI_SHOP_STATE.BurstItems[key]
        or {
            Running = false,
            BlockedSignature = "",
            RetryAfter = 0,
        }

    return ZANJI_SHOP_STATE.BurstItems[key]
end

function ZanjiShopRunVerifiedBurst(category, itemName)

    if ZanjiShopCategoryEnabled(category) ~= true
    or ZanjiShopIsItemSelected(category, itemName) ~= true then

        return false
    end

    local firstStock =
        ZanjiShopGetStockValue(
            category,
            itemName
        )

    if firstStock <= 0 then

        return false
    end

    local state =
        ZanjiShopGetBurstItemState(
            category,
            itemName
        )

    if state.Running == true then

        return false
    end

    local restockKey =
        ZanjiShopGetRestockKey(
            category
        )

    local signature =
        tostring(restockKey)
        .. "|"
        .. tostring(firstStock)

    if state.BlockedSignature == signature
    and os.clock() < (
        tonumber(state.RetryAfter)
        or 0
    ) then

        return false
    end

    state.Running =
        true

    state.BlockedSignature =
        ""

    state.RetryAfter =
        0

    local retryDelays =
        type(ZANJI_SHOP_STATE.BurstRetryDelays) == "table"
        and ZANJI_SHOP_STATE.BurstRetryDelays
        or {
            0,
            0.75,
            1.50,
        }

    local progressed =
        false

    local completed =
        false

    local cancelled =
        false

    local restockChanged =
        false

    for passIndex, retryDelay in ipairs(retryDelays) do

        if passIndex > 1 then

            task.wait(
                math.max(
                    0,
                    tonumber(retryDelay)
                    or 0
                )
            )
        end

        if ZanjiShopCategoryEnabled(category) ~= true
        or ZanjiShopIsItemSelected(category, itemName) ~= true then

            cancelled =
                true

            break
        end

        if ZanjiShopGetRestockKey(category) ~= restockKey then

            restockChanged =
                true

            break
        end

        local beforeStock =
            ZanjiShopGetStockValue(
                category,
                itemName
            )

        if beforeStock <= 0 then

            completed =
                true

            break
        end

        local fired =
            ZanjiShopFireBurst(
                category,
                itemName,
                beforeStock
            )

        if fired <= 0 then

            break
        end

        task.wait(
            math.max(
                0.05,
                tonumber(
                    ZANJI_SHOP_STATE.BurstConfirmDelay
                )
                or 0.75
            )
        )

        local afterStock =
            ZanjiShopGetStockValue(
                category,
                itemName
            )

        if afterStock < beforeStock then

            progressed =
                true
        end

        if afterStock <= 0 then

            completed =
                true

            break
        end
    end

    local remainingStock =
        ZanjiShopGetStockValue(
            category,
            itemName
        )

    state.Running =
        false

    if cancelled == true
    or completed == true
    or restockChanged == true
    or remainingStock <= 0 then

        state.BlockedSignature =
            ""

        state.RetryAfter =
            0

    else

        state.BlockedSignature =
            tostring(
                ZanjiShopGetRestockKey(
                    category
                )
            )
            .. "|"
            .. tostring(remainingStock)

        state.RetryAfter =
            os.clock()
            + math.max(
                0,
                tonumber(
                    ZANJI_SHOP_STATE.BurstFailureCooldown
                )
                or 5
            )
    end

    if restockChanged == true
    and ZanjiShopCategoryEnabled(category) == true then

        ZanjiShopQueueCategory(
            category
        )
    end

    return completed == true
        or progressed == true
end

function ZanjiShopRunCategory(category)

    if ZanjiShopCategoryEnabled(category) ~= true then

        return false
    end

    if category == "Seeds" then

        ZANJI_SHOP_STATE.ItemCache =
            type(ZANJI_SHOP_STATE.ItemCache) == "table"
            and ZANJI_SHOP_STATE.ItemCache
            or {}

        ZANJI_SHOP_STATE.ItemCache.Seeds =
            nil
    end

    local rows =
        ZanjiShopGetSelectedRows(
            category
        )

    if #rows <= 0 then

        return false
    end

    for _, row in ipairs(rows) do

        if ZanjiShopCategoryEnabled(category) ~= true then

            return true
        end

        local stock =
            ZanjiShopGetStockValue(
                category,
                row.Name
            )

        if stock > 0 then

            ZanjiShopRunVerifiedBurst(
                category,
                row.Name
            )
        end
    end

    return true
end

function ZanjiShopQueueCategory(category)

    ZANJI_SHOP_STATE.PendingCategories =
        type(ZANJI_SHOP_STATE.PendingCategories) == "table"
        and ZANJI_SHOP_STATE.PendingCategories
        or {}

    ZANJI_SHOP_STATE.PendingCategories[category] =
        true

    if ZANJI_SHOP_STATE.WorkerRunning == true then
        return
    end

    ZANJI_SHOP_STATE.WorkerRunning =
        true

    task.spawn(function()

        while true do

            local pending =
                ZANJI_SHOP_STATE.PendingCategories

            ZANJI_SHOP_STATE.PendingCategories =
                {}

            local hasPending =
                false

            for _ in pairs(pending) do

                hasPending =
                    true

                break
            end

            if hasPending ~= true then
                break
            end

            if pending.Seeds == true then

                ZanjiShopRunCategory(
                    "Seeds"
                )
            end

            if pending.Gear == true then

                ZanjiShopRunCategory(
                    "Gear"
                )
            end

            if pending.Props == true then

                ZanjiShopRunCategory(
                    "Props"
                )
            end

            task.wait()
        end

        ZANJI_SHOP_STATE.WorkerRunning =
            false
    end)
end

function ZanjiShopQueueAll()

    if ZANJI_SHOP_STATE.AutoBuySeeds == true then

        ZanjiShopQueueCategory(
            "Seeds"
        )
    end

    if ZANJI_SHOP_STATE.AutoBuyGear == true then

        ZanjiShopQueueCategory(
            "Gear"
        )
    end

    if ZANJI_SHOP_STATE.AutoBuyProps == true then

        ZanjiShopQueueCategory(
            "Props"
        )
    end
end

function ZanjiShopConnectStockValue(category, child)

    if typeof(child) ~= "Instance"
    or child:IsA("ValueBase") ~= true then

        return false
    end

    table.insert(
        ZANJI_SHOP_STATE.StockConnections,
        child.Changed:Connect(function()

            ZanjiShopQueueCategory(
                category
            )
        end)
    )

    return true
end

function ZanjiShopConnectStockSignals()

    if ZANJI_SHOP_STATE.StockConnected == true then

        return
    end

    ZANJI_SHOP_STATE.StockConnected =
        true

    ZANJI_SHOP_STATE.StockConnections =
        type(ZANJI_SHOP_STATE.StockConnections) == "table"
        and ZANJI_SHOP_STATE.StockConnections
        or {}

    for category, config in pairs(ZANJI_SHOP_CATEGORIES) do

        local items =
            ReplicatedStorage:FindFirstChild(
                "StockValues"
            )
            and ReplicatedStorage.StockValues:FindFirstChild(
                config.ShopName
            )
            and ReplicatedStorage.StockValues[
                config.ShopName
            ]:FindFirstChild(
                "Items"
            )
            or nil

        if typeof(items) == "Instance" then

            for _, child in ipairs(items:GetChildren()) do

                ZanjiShopConnectStockValue(
                    category,
                    child
                )
            end

            table.insert(
                ZANJI_SHOP_STATE.StockConnections,
                items.ChildAdded:Connect(function(child)

                    if child:IsA("ValueBase") then

                        ZanjiShopConnectStockValue(
                            category,
                            child
                        )

                        ZANJI_SHOP_STATE.ItemCache =
                            type(ZANJI_SHOP_STATE.ItemCache) == "table"
                            and ZANJI_SHOP_STATE.ItemCache
                            or {}

                        ZANJI_SHOP_STATE.ItemCache[category] =
                            nil

                        task.defer(function()

                            ZanjiShopQueueCategory(
                                category
                            )
                        end)
                    end
                end)
            )
        end
    end
end

