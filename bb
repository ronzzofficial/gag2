function ZanjiAuctionScanSeedPackCandidates(rows)

    local data =
        ZanjiShopRequireModule(
            "SharedModules.SeedPackData"
        )

    if type(data) ~= "table" then
        return false
    end

    local seen =
        {}

    local function visit(value, depth)

        if type(value) ~= "table" then
            return
        end

        if seen[value] == true then
            return
        end

        seen[value] =
            true

        depth =
            tonumber(depth)
            or 0

        if depth > 5 then
            return
        end

        local name =
            value.Name
            or value.PackName
            or value.SeedPackName
            or value.ItemName
            or value.DisplayName

        if type(name) == "string"
        and name ~= ""
        and name:lower():find("pack", 1, true) then

            ZanjiAuctionAddCandidate(
                rows,
                name,
                "SeedPackData",
                {
                    Category =
                        "Seed Pack",

                    Rarity =
                        value.Rarity,

                    Cost =
                        value.Cost
                        or value.Price,
                }
            )
        end

        for _, child in pairs(value) do

            if type(child) == "table" then

                visit(
                    child,
                    depth + 1
                )
            end
        end
    end

    visit(
        data.Data
        or data.Packs
        or data,
        0
    )

    return true
end

function ZanjiAuctionScanMiscCandidates(rows)

    local paths = {
        "SharedModules.SprinklerData",
        "SharedModules.MushroomData",
        "SharedModules.WateringcanData",
        "SharedModules.TrowelData",
        "SharedModules.RakeData",
        "SharedModules.TeleporterData",
        "SharedModules.PetTeleporterData",
        "SharedModules.PetLureData",
        "SharedModules.GnomeData",
        "SharedModules.MagicDiceConfig",
        "SharedModules.CrowbarData",
        "SharedModules.MagnetData",
        "SharedModules.PowerHoseData",
        "SharedModules.FreezeRayData",
    }

    local nameKeys = {
        "Name",
        "ItemName",
        "DisplayName",
        "GearName",
        "SprinklerName",
        "MushroomName",
        "ToolName",
    }

    for _, path in ipairs(paths) do

        local data =
            ZanjiShopRequireModule(
                path
            )

        local source =
            path:match("([^%.]+)$")
            or path

        local seen =
            {}

        local function visit(value, depth)

            if type(value) ~= "table" then
                return
            end

            if seen[value] == true then
                return
            end

            seen[value] =
                true

            depth =
                tonumber(depth)
                or 0

            if depth > 4 then
                return
            end

            for _, key in ipairs(nameKeys) do

                if type(value[key]) == "string"
                and value[key] ~= "" then

                    ZanjiAuctionAddCandidate(
                        rows,
                        value[key],
                        source,
                        {
                            Category =
                                "Misc",

                            Rarity =
                                value.Rarity,

                            Cost =
                                value.Cost
                                or value.Price,
                        }
                    )
                end
            end

            for _, child in pairs(value) do

                if type(child) == "table" then

                    visit(
                        child,
                        depth + 1
                    )
                end
            end
        end

        visit(
            data,
            0
        )
    end
end

function ZanjiAuctionRememberKnownItem(itemName)

    ZanjiAuctionEnsureState()

    itemName =
        ZanjiCleanText(
            itemName
        )

    if itemName == "" then
        return false
    end

    local key =
        ZanjiAuctionItemKey(
            itemName
        )

    local has =
        false

    for _, known in ipairs(ZANJI_SHOP_STATE.AuctionKnownItems or {}) do

        if ZanjiAuctionItemKey(known) == key then

            has =
                true

            break
        end
    end

    if has == true then
        return false
    end

    table.insert(
        ZANJI_SHOP_STATE.AuctionKnownItems,
        itemName
    )

    ZANJI_SHOP_STATE.AuctionItemCache =
        nil

    ZanjiSaveShopSettings()

    return true
end

function ZanjiAuctionBuildItemRows(forceRefresh)

    ZanjiAuctionEnsureState()

    if forceRefresh ~= true
    and type(ZANJI_SHOP_STATE.AuctionItemCache) == "table" then

        return ZANJI_SHOP_STATE.AuctionItemCache
    end

    local map =
        {}

    ZanjiAuctionScanCrateCandidates(
        map
    )

    ZanjiAuctionScanGuildCrateCandidates(
        map
    )

    ZanjiAuctionScanGearCandidates(
        map
    )

    ZanjiAuctionScanEggCandidates(
        map
    )

    ZanjiAuctionScanSeedPackCandidates(
        map
    )

    ZanjiAuctionScanSeedCandidates(
        map
    )

    ZanjiAuctionScanMiscCandidates(
        map
    )

    for _, itemName in ipairs(ZANJI_SHOP_STATE.AuctionKnownItems or {}) do

        ZanjiAuctionAddCandidate(
            map,
            itemName,
            "KnownAuctionItems",
            {
                Category =
                    "Known",
            }
        )
    end

    local rows =
        {}

    for _, row in pairs(map) do

        table.insert(
            rows,
            row
        )
    end

    table.sort(rows, function(a, b)

        local nameA =
            tostring(a.Name or "")

        local nameB =
            tostring(b.Name or "")

        return nameA:lower() < nameB:lower()
    end)

    ZANJI_SHOP_STATE.AuctionItemCache =
        rows

    return rows
end

