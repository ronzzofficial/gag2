function ZanjiWebhookNormalizeFilters(value)

    local byKey = {}

    if type(value) == "table" then

        for key, row in pairs(value) do

            local name = ""
            local minimum = nil

            if type(row) == "table" then

                name = ZanjiCleanText(
                    row.Name
                    or row.Fruit
                    or row.FruitName
                    or (
                        type(key) == "string"
                        and key
                        or ""
                    )
                )

                minimum = ZanjiWebhookReadMultiplier(
                    row.Minimum
                    or row.MinMultiplier
                    or row.Multiplier
                    or row.Value
                )

            elseif type(key) == "string" then

                name = ZanjiCleanText(key)
                minimum = ZanjiWebhookReadMultiplier(row)
            end

            local normalizedKey =
                ZanjiWebhookFilterKey(name)

            if normalizedKey ~= ""
            and normalizedKey ~= "all"
            and minimum ~= nil then

                byKey[normalizedKey] = {
                    Name = name,
                    Minimum = minimum,
                }
            end
        end
    end

    local output = {}

    for _, entry in pairs(byKey) do

        output[#output + 1] = entry
    end

    table.sort(output, function(a, b)

        return tostring(a.Name):lower()
            < tostring(b.Name):lower()
    end)

    return output
end

