        Player = {
            Name = LocalPlayer.Name,
            UserId = LocalPlayer.UserId,
        },

        Target =
            session.Target,

        BeforeCount =
            session.BeforeCount,

        AfterUseCount =
            found == true
            and afterCount
            or nil,

        StartedAt =
